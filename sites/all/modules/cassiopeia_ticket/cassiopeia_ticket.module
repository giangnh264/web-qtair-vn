//        die;
        $_Adt = $_SESSION['booking_payment']['adt'];
        $_Chd = $_SESSION['booking_payment']['chd'];
        $_Inf = $_SESSION['booking_payment']['inf'];
        $_array = explode(" ", $_contact->full_name);
        $_contact_first_name = $_array[0];
        $_contact_last_name = str_replace($_contact_first_name, "", $_contact->full_name);
        $PNR_CODE = "";
        $Bookings = null;
        $Booking_Airline = "";
        $stt = 0;
        $booking_code = "VE" . REQUEST_TIME;
        $total_price = 0;
        $TotalNetPrice = 0;
        $TotalPartnerPrice = 0;
        $TotalPax = 0;
        $DepartureFlight = $_SESSION['booking']['DepartureFlights']['Flight'];
        $ReturnFlight = !empty($_SESSION['booking']['ReturnFlights']['Flight']) ? $_SESSION['booking']['ReturnFlights']['Flight'] : null;
        $DepartureFlightDetail = $DepartureFlight->FlightDetail;
        $ReturnFlightDetail = !empty($ReturnFlight) ? $ReturnFlight->FlightDetail : null;
//        print_r($DepartureFlightDetail);
//        print_r($ReturnFlightDetail);
//        die;
        $Expired_Date = 0;
        if (!empty($_SESSION['booking'])) {
            $_data = new stdClass();
            $_data->booking_code = $booking_code;
            $_data->ContactInfo = array(
                "Gender" => 1,
                "FirstName" => vn_to_str($_contact_first_name),
                "LastName" => vn_to_str($_contact_last_name),
                "Phone" => $_contact->tel,
                "Email" => $_contact->email,
                "Address" => "",
            );

            $Content = "XN " . $DepartureFlight->StartPoint . $DepartureFlight->EndPoint . " " . date("d/m/Y", strtotime($DepartureFlight->StartDate));
            $_data->DataSession = $DataSession;

            $_data->DepartureFlightSession = $DepartureFlightDetail->FareOptionSession;
            $_data->ReturnFlightSession = !empty($ReturnFlightDetail) ? $ReturnFlightDetail->FareOptionSession : "";
            $totalDepartureBaggageFee = 0;
            $totalReturnBaggageFee = 0;
            $guest_index = 1;
            
            //UPDATE PRICE!!!
            if (!empty($_data->DepartureFlightSession) && $DepartureFlight->AirlineCode == 'VN') {
                $FlightPricingParams = array(
                    "DataSession"  => $_data->DataSession,
                    "GroupSession"  => "",
                    "DepartureFlightSession"      => $_data->DepartureFlightSession,
                    //"ReturnFlightSession"      => $_data->ReturnFlightSession
                );
                
                $updated_1way_price = cassiopeia_meta_api_FlightPricing($FlightPricingParams);
                $DepartureFlightDetail->PriceAdult = $updated_1way_price->Data->PriceAdult;
                $DepartureFlightDetail->FeeAdult = $updated_1way_price->Data->FeeAdult;
                $DepartureFlightDetail->TaxAdult = $updated_1way_price->Data->TaxAdult;

                $DepartureFlightDetail->PriceChild = $updated_1way_price->Data->PriceChild;
                $DepartureFlightDetail->FeeChild = $updated_1way_price->Data->FeeChild;
                $DepartureFlightDetail->TaxChild = $updated_1way_price->Data->TaxChild;

                $DepartureFlightDetail->PriceInfant = $updated_1way_price->Data->PriceInfant;
                $DepartureFlightDetail->FeeInfant = $updated_1way_price->Data->FeeInfant;
                $DepartureFlightDetail->TaxInfant = $updated_1way_price->Data->TaxInfant;
                
                $DepartureFlightDetail->TotalPrice = $updated_1way_price->Data->TotalPrice;

                //$DepartureFlightDetail->ServiceFee = $updated_1way_price->Data->ServiceFee;
                $DepartureFlightDetail->IssueFee = $updated_1way_price->Data->IssueFee;

                $DepartureFlight->FlightDetail = $DepartureFlightDetail;
                
                
                if (!empty($_data->ReturnFlightSession)) {
                    $FlightPricingParams = array(
                        "DataSession"  => $_data->DataSession,
                        "GroupSession"  => "",
                        "DepartureFlightSession"      => $_data->DepartureFlightSession,
                        "ReturnFlightSession"      => $_data->ReturnFlightSession
                    );

                    $updated_2way_price = cassiopeia_meta_api_FlightPricing($FlightPricingParams);
                    $ReturnFlightDetail->PriceAdult = $updated_2way_price->Data->PriceAdult - $updated_1way_price->Data->PriceAdult;
                    $ReturnFlightDetail->FeeAdult = $updated_2way_price->Data->FeeAdult - $updated_1way_price->Data->FeeAdult;
                    $ReturnFlightDetail->TaxAdult = $updated_2way_price->Data->TaxAdult - $updated_1way_price->Data->TaxAdult;

                    $ReturnFlightDetail->PriceChild = $updated_2way_price->Data->PriceChild - $updated_1way_price->Data->PriceChild;
                    $ReturnFlightDetail->FeeChild = $updated_2way_price->Data->FeeChild - $updated_1way_price->Data->FeeChild;
                    $ReturnFlightDetail->TaxChild = $updated_2way_price->Data->TaxChild - $updated_1way_price->Data->TaxChild;

                    $ReturnFlightDetail->PriceInfant = $updated_2way_price->Data->PriceInfant - $updated_1way_price->Data->PriceInfant;
                    $ReturnFlightDetail->FeeInfant = $updated_2way_price->Data->FeeInfant - $updated_1way_price->Data->FeeInfant;
                    $ReturnFlightDetail->TaxInfant = $updated_2way_price->Data->TaxInfant - $updated_1way_price->Data->TaxInfant;

                    $ReturnFlightDetail->TotalPrice = $updated_2way_price->Data->TotalPrice - $updated_1way_price->Data->TotalPrice;
                    
                    //$ReturnFlightDetail->ServiceFee = $updated_2way_price->Data->ServiceFee - $updated_1way_price->Data->ServiceFee;
                    $ReturnFlightDetail->IssueFee = $updated_2way_price->Data->IssueFee - $updated_1way_price->Data->IssueFee;

                    $ReturnFlight->FlightDetail = $ReturnFlightDetail;
                }
                
            }
            
            if (!empty($_Adt)) {
                foreach ($_Adt as $item) {
