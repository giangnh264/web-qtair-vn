        '#type' => 'submit',
        '#value' => t('Tiếp tục'),
        '#submit' => array("cassiopeia_ticket_booking_form_submit"),
        '#ajax' => array(
            'callback' => 'cassiopeia_ticket_booking_form_ajax_submit',
        ),
        '#attributes' => array("class" => array("btn bg-secondary clr-white text ff-bold mt-4 btn-ajax"))
    );
    $form['#attached']['js'] = array(
        drupal_get_path("module", "cassiopeia_ticket") . "/js/cassiopeia-ticket-booking-form.js"
    );
    return $form;
}

function cassiopeia_ticket_telegram_send_order_info($info)
{
    $apiToken = '7564695233:AAFpUQZZLDtQ3M-Iis9lnyAOi-yjH9YHS1M';
 
    $data = [ 
        'chat_id' => $info['chat_id'], 
        'text' => $info['message'],
        'parse_mode' => 'HTML'
    ]; 
 
    $response = file_get_contents("http://api.telegram.org/bot$apiToken/sendMessage?" . http_build_query($data) ); 
}

function cassiopeia_ticket_telegram_send_order_error($info)
{
    $apiToken = '8192729762:AAGKTxMy1GSMaI5d6z9asnyzf2ns5zDra-Y';
 
    $data = [ 
        'chat_id' => $info['chat_id'], 
        'text' => $info['message'],
        'parse_mode' => 'HTML'
    ]; 
 
    $response = file_get_contents("http://api.telegram.org/bot$apiToken/sendMessage?" . http_build_query($data) ); 
    $log_file = 'sites/default/files/logs/telegram_log_' . date('Y-m-d') . '.log';
    $log_data = date('Y-m-d H:i:s') . ' - ' .
                'Telegram response: ' . print_r($response, TRUE);
    file_put_contents($log_file, $log_data . PHP_EOL, FILE_APPEND);
}



function cassiopeia_ticket_booking_form_ajax_submit($form, &$form_state)
{
    if ($form_state['#status'] == "OK") {
        ctools_include('ajax');
        ctools_add_js('ajax-responder');
        $commands[] = ctools_ajax_command_redirect($form_state['#return_url']);
        print ajax_render($commands);
        exit;
    } else {
        drupal_set_message($form_state['#message']);
    }
}

function cassiopeia_ticket_open_payment($form, &$form_state) {
    global $viewing_booking_code;
    try {
        $booking_code = empty($viewing_booking_code) ? $form_state["values"]['booking_code']  : $viewing_booking_code;
        
        $fbooking = cassiopeia_qt_ticket_booking_load_by_code($booking_code);
        
        $ContactGender = $fbooking->contact_Gender;
        $ContactFirstName = $fbooking->contact_FirstName;
        $ContactLastName = $fbooking->contact_LastName;
        $ContactPhone = $fbooking->contact_Phone;
        $ContactEmail = $fbooking->contact_Email;

        $_PNR = $booking->pnr_code;
        $_splitter = explode("-", $_PNR);
        $Passengers = $fbooking->passengers;
        $tickets = $fbooking->tickets;
        $B_status = $fbooking->status;
        $total_price = 0;
        
        

        if (in_array($form_state['values']['payment']['method'], array(DOMESTIC_CARD, INTERNATIONAL_CARD, INTERNET_BANKING, QR_PAY))) {
            $fbooking->alefee = !empty($form_state['#alefee']) ? $form_state['#alefee'] : 0;
            $fbooking->total_pay = $fbooking->book_price;
            $fbooking->payment_method = $form_state['values']['payment']['method'];
            
            $result = cassiopeia_ticket_alepay_request_payment($fbooking);
            
            $fbooking->transactionCode = $result->transactionCode;
            $fbooking->errorCode = $result->errorCode;
            if ($result->code == "000") {
                $data['return_url'] = $result->checkoutUrl;
            } else {
                $data['return_url'] = "/booking/view/" . $booking_code;
                $data['status'] = "OK";
            }
            $data['status'] = "OK";
            
            $saved = cassiopeia_qt_ticket_booking_save($fbooking);
        } else {
            
        }
    } catch (Exception $e) {
        print_r($e);
        $data['status'] = "FAIL";
        $data['message'] = "Đã xảy ra lỗi, vui lòng liên hệ với người quản trị.";
        $db_transaction->rollback();
    }
    
    $form_state['#return_url'] = $data['return_url'];
    $form_state['#messages'] = $data['message'];
    $form_state['#status'] = $data['status'];
}

function cassiopeia_ticket_booking_form_submit($form, &$form_state)
{
    global $user;
    $message = "Phiên làm việc đã hết hạn!";
    $Flag = true;
    if (empty($_SESSION['booking'])) {
        drupal_set_message($message);
    } else {
        $DataSession = $_SESSION['DataSession'];
        $_agent = user_load($user->uid);
        $_payment_method = $form_state['values']['payment']['method'];
        $_contact = $_SESSION['booking_payment']['contact'];
