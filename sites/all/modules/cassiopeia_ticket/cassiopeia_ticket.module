}

function cassiopeia_agent_fee_config_load($user)
{
    try {
        if (!empty($user->uid)) {
            $_user = user_load($user->uid);
            $rank = !empty($_user->field_tx_rank['und'][0]['tid']) ? $_user->field_tx_rank['und'][0]['tid'] : 0;
            $query = db_select("cassiopeia_ticket_agent_fee_config", "cassiopeia_ticket_agent_fee_config");
            $query->fields("cassiopeia_ticket_agent_fee_config");
            $query->condition("uid", $user->uid);
            $query->condition("tid", $rank);
            $config = $query->execute()->fetchObject();
            if (empty($config)) {
                $query = db_select("cassiopeia_ticket_agent_fee_config", "cassiopeia_ticket_agent_fee_config");
                $query->fields("cassiopeia_ticket_agent_fee_config");
                $query->condition("uid", 0);
                $query->condition("tid", $rank);
                $config = $query->execute()->fetchObject();
            }
        } else {
            $query = db_select("cassiopeia_ticket_agent_fee_config", "cassiopeia_ticket_agent_fee_config");
            $query->fields("cassiopeia_ticket_agent_fee_config");
            $query->condition("uid", 0);
            $query->condition("tid", KHACH_THUONG);
            $config = $query->execute()->fetchObject();
        }
        return $config;
    } catch (Exception $e) {
        return null;
    }
}

function cassiopeia_airline_class_load($Airline, $class)
{
    $text = "";
    switch ($Airline) {
        case "VN" :
            switch (strtoupper($class)) {
                case "J" :
                case "C" :
                case "I" :
                    $text = "Thương gia";
                    break;
                default :
                    $text = "Phổ thông";
            }
            break;
        case "QH" :
            switch (strtoupper($class)) {
                case "BUSINESS" :
                    $text = "Thương gia";
                    break;
                default :
                    $text = "Phổ thông";
            }
            break;
        case "VJ" :
            switch (strtoupper($class)) {
                case "ECO" :
                case "DELUXE" :
                    $text = "Phổ thông";
                    break;
                default:
                    $text = "Thương gia";
            }
            break;
        case "VU" :
            $text = "Phổ thông";
            break;
        case "9G" :
            $text = "Phổ thông";
            break;
    }
    return $text;
}

function cassiopeia_customer_load($id)
{
    try {
        $query = db_select("cassiopeia_ticket_customer", "cassiopeia_ticket_customer");
        $query->fields("cassiopeia_ticket_customer");
        $query->condition("id", $id);
        $customer = $query->execute()->fetchObject();
        return $customer;
    } catch (Exception $e) {
        return null;
    }
}

function cassiopeia_customer_save($customer)
{
    global $user;
    try {
        if (!empty($customer->id)) {
            $customer->changed = REQUEST_TIME;
            drupal_write_record("cassiopeia_ticket_customer", $customer, array("id"));
        } else {
            $customer->uid = $user->uid;
            $customer->created = REQUEST_TIME;
            $customer->changed = REQUEST_TIME;
            drupal_write_record("cassiopeia_ticket_customer", $customer);
        }
    } catch (Exception $e) {
        return null;
    }
}

function cassiopeia_node_counter($node)
{
    try {
        $query = db_select("node_counter", "node_counter");
        $query->fields("node_counter");
        $query->condition("nid", $node->nid);
        $result = $query->execute()->fetchObject();
        return $result;
    } catch (Exception $e) {
        return 0;
    }
}

function cassiopeia_partner_change_status_accept()
{
    if (user_has_role(3) || user_has_role(ROLE_SALE)) {
        return true;
    }
    return false;
}

function cassiopeia_ticket_booking_update_form($form, &$form_state)
{
//    $_SESSION['start'] = 0;
    $_SESSION['start'] = !empty($_SESSION['start']) ? $_SESSION['start'] : 0;
    $form = array();
    $form['start'] = array(

        '#type' => 'textfield',

        '#title' => t('Subject'),


        '#default_value' => $_SESSION['start'],
        '#size' => 60,

        '#maxlength' => 128,

        '#required' => TRUE,

    );
    $form['submit'] = array('#type' => 'submit', '#value' => t('update'));
    return $form;
}

function cassiopeia_ticket_booking_update_form_submit($form, &$form_state)
{
    $query = db_select("tbl_booking", "tbl_booking");
    $query->fields("tbl_booking");
    $query->orderBy("created", "DESC");
    $query->range($form_state['values']['start'], 10000);
    $result = $query->execute()->fetchALl();
    foreach ($result as $item) {
        $operations[] = array(
            '_batch_cassiopeia_ticket_booking_update_form_excel',
            array(
                'item' => $item
            ),
        );
    }
    if (!empty($operations)) {
        $batch = array(
            'title' => 'Import trademark conflict',
            'operations' => $operations,
            'progress_message' => t('Import @current of @total.'),
            'error_message' => t('Error!'),
            'finished' => '_batch_cassiopeia_ticket_booking_update_form_excel_finished',
        );
        batch_set($batch);
    }
//    print_r(count($result));
    $item = new stdClass();
    $data = new stdClass();

}

function _batch_cassiopeia_ticket_booking_update_form_excel($item, &$context)
{
    global $user;
    $data = unserialize($item->data);
    if ($item->DO == 1) {
        $fbooking = new stdClass();
        $fbooking->contact_Gender = $data->DepartureFlights->ContactInfo['Gender'];
        $fbooking->contact_FirstName = $data->DepartureFlights->ContactInfo['FirstName'];
        $fbooking->contact_LastName = $data->DepartureFlights->ContactInfo['LastName'];
        $fbooking->contact_Phone = $data->DepartureFlights->ContactInfo['Phone'];
        $fbooking->contact_Email = $data->DepartureFlights->ContactInfo['Email'];
        $fbooking->uid = !empty($item->uid) ? $item->uid : "";
        $fbooking->created = $item->created;
        $fbooking->changed = $item->created;
        $fbooking->booking_code = $item->booking_code;
        $fbooking->pnr_code = $item->pnr_code;
        $fbooking->airline = $item->airline;
        $fbooking->price = $item->price;
        $fbooking->book_price = $item->book_price;
        $fbooking->agent_code = "";
        $fbooking->booking_name = "";
        $fbooking->status = $item->status;
        $fbooking->history = $item->history;
        $fbooking->error_code = $item->error_code;
        $fbooking->error_message = $item->error_message;
        $fbooking->adt = $item->adt;
        $fbooking->chd = $item->chd;
        $fbooking->inf = $item->inf;
        $fbooking->payment_method = $item->payment_method;
        $fbooking->ExpiryDt = $item->ExpiryDt;
        $fbooking->trip_type = $item->trip_type;
        $fbooking->version = 2;
        $fbooking->booking = $item->booking;
        $fbooking->start_point = $item->start_point;
        $fbooking->end_point = $item->end_point;
        $fbooking->departure_date = $item->departure_date;
        $fbooking->return_date = $item->return_date;
        $fbooking->DO = $item->DO;
        $fbooking->additional = "";
        $fbooking->bill_company = "";
        $fbooking->bill_tax_number = "";
        $fbooking->bill_address = "";
        $fbooking->bill_mail = "";
        $fbooking->bank = "";
        $fbooking->customFee = $item->customFee;
        $fbooking->silverFee = $item->silverFee;

        if (!empty($data->DepartureFlights->ListPassengers)) {
            foreach ($data->DepartureFlights->ListPassengers as $Passenger) {
                $passenger = new stdClass();
                $passenger->Email = "";
                $passenger->Phone = "";
                $passenger->passenger_index = $Passenger['Index'];
                $passenger->FirstName = $Passenger['FirstName'];
                $passenger->LastName = $Passenger['LastName'];
                $passenger->Type = $Passenger['Type'];
                $passenger->Gender = $Passenger['Gender'];
                $passenger->Birthday = !empty($Passenger['Birthday']) ? strtotime(str_replace("/", "-", $Passenger['Birthday'])) : 0;
                $passenger->BaggageDeparture = $Passenger['BaggageDeparture'];
                $passenger->BaggageReturn = $Passenger['BaggageReturn'];
                $passenger->uid = $item->uid;
                $passenger->created = $item->created;
                $passenger->changed = $item->created;
                $fbooking->passengers[] = $passenger;
            }
        }
        $sup_query = db_select("tbl_ticket", "tbl_ticket");
        $sup_query->fields("tbl_ticket");
        $sup_query->orderBy("id", "ASC");
        $sup_query->condition("booking_code", $item->booking_code);
        $tickets = $sup_query->execute()->fetchAll();
        foreach ($tickets as $leg => $_ticket) {
            $ticket_detail = unserialize($_ticket->ticket);
            $FlightDetail = cassiopeia_meta_FareOptionSession_load($ticket_detail, $_ticket->FareOptionSession);
            $ticket = new stdClass();
            $ticket->status = "";
            $ticket->TransactionCode = "";
            $ticket->type = $item->DO == 1 ? 0 : 1; // nội địa
            $ticket->StartPoint = $ticket_detail->StartPoint;
            $ticket->EndPoint = $ticket_detail->EndPoint;;
            $ticket->FlightNumber = $ticket_detail->FlightNumber;;
            $ticket->AirlineCode = $ticket_detail->AirlineCode;;
            $ticket->StartDate = strtotime($ticket_detail->StartDate);;
            $ticket->EndDate = strtotime($ticket_detail->EndDate);;
            $ticket->Stops = $ticket_detail->Stops;;
            $ticket->Duration = $ticket_detail->Duration;;
            $ticket->FlightSession = $ticket_detail->FlightSession;;
            $ticket->pnr_code = $_ticket->PNR;;
            $ticket->Itinerary = $leg == 0 ? "DepartureFlights" : "ReturnFlights";
            $ticket->FareOptionSession = $_ticket->FareOptionSession;
            $ticket->Class = $FlightDetail->Class;
            $ticket->PriceAdult = $FlightDetail->PriceAdult;
            $ticket->PriceChild = $FlightDetail->PriceChild;
            $ticket->PriceInfant = $FlightDetail->PriceInfant;
            $ticket->FeeAdult = $FlightDetail->FeeAdult;
            $ticket->FeeChild = $FlightDetail->FeeChild;
            $ticket->FeeInfant = $FlightDetail->FeeInfant;
            $ticket->TaxAdult = $FlightDetail->TaxAdult;
            $ticket->TaxChild = $FlightDetail->TaxChild;
            $ticket->TaxInfant = $FlightDetail->TaxInfant;
            $ticket->TotalPrice = $FlightDetail->TotalPrice;
            $ticket->ServiceFee = $FlightDetail->ServiceFee;
            $ticket->IssueFee = $FlightDetail->IssueFee;
            $ticket->LastTkDate = strtotime($FlightDetail->LastTkDate);
            $ticket->SeatsAvailable = $FlightDetail->SeatsAvailable;
            $ticket->leg = $leg;
            $ticket->uid = $item->uid;
            $ticket->created = $item->created;
            $ticket->changed = $item->created;
            $fbooking->tickets[] = $ticket;
        }

        $saved = cassiopeia_ticket_booking_save($fbooking);
    } else {

        $fbooking = new stdClass();
        $fbooking->contact_Gender = $data->ContactInfo['Gender'];
        $fbooking->contact_FirstName = $data->ContactInfo['FirstName'];
        $fbooking->contact_LastName = $data->ContactInfo['LastName'];
        $fbooking->contact_Phone = $data->ContactInfo['Phone'];
        $fbooking->contact_Email = $data->ContactInfo['Email'];
        $fbooking->uid = !empty($item->uid) ? $item->uid : "";
        $fbooking->created = $item->created;
        $fbooking->changed = $item->created;
        $fbooking->booking_code = $item->booking_code;
        $fbooking->pnr_code = $item->pnr_code;
        $fbooking->airline = $item->airline;
        $fbooking->price = $item->price;
        $fbooking->book_price = $item->book_price;
        $fbooking->agent_code = "";
        $fbooking->booking_name = "";
        $fbooking->status = $item->status;
        $fbooking->history = $item->history;
        $fbooking->error_code = $item->error_code;
        $fbooking->error_message = $item->error_message;
        $fbooking->adt = $item->adt;
        $fbooking->chd = $item->chd;
        $fbooking->inf = $item->inf;
        $fbooking->payment_method = $item->payment_method;
        $fbooking->ExpiryDt = $item->ExpiryDt;
        $fbooking->trip_type = $item->trip_type;
        $fbooking->version = 2;
        $fbooking->booking = $item->booking;
        $fbooking->start_point = $item->start_point;
        $fbooking->end_point = $item->end_point;
        $fbooking->departure_date = $item->departure_date;
        $fbooking->return_date = $item->return_date;
        $fbooking->DO = $item->DO;
        $fbooking->additional = "";
        $fbooking->bill_company = "";
        $fbooking->bill_tax_number = "";
        $fbooking->bill_address = "";
        $fbooking->bill_mail = "";
        $fbooking->bank = "";
        $fbooking->customFee = $item->customFee;
        $fbooking->silverFee = $item->silverFee;

        $sup_query = db_select("tbl_ticket", "tbl_ticket");
        $sup_query->fields("tbl_ticket");
        $sup_query->condition("booking_code", $item->booking_code);
        $tickets = $sup_query->execute()->fetchAll();
        foreach ($tickets as $_ticket) {
            $ticket_detail = unserialize($_ticket->ticket);
            $ticket = new stdClass();
            $ticket->status = "";
            $ticket->TransactionCode = "";
            $ticket->type = $item->DO == 1 ? 0 : 1; // nội địa
            $ticket->StartPoint = $ticket_detail->StartPoint;
            $ticket->EndPoint = $ticket_detail->EndPoint;;
            $ticket->FlightNumber = $ticket_detail->FlightNumber;;
            $ticket->AirlineCode = $ticket_detail->AirlineCode;;
            $ticket->StartDate = strtotime($ticket_detail->StartDate);;
            $ticket->EndDate = strtotime($ticket_detail->EndDate);;
            $ticket->Stops = $ticket_detail->Stops;;
            $ticket->Duration = $ticket_detail->Duration;;
            $ticket->FlightSession = $ticket_detail->FlightSession;;
            $ticket->pnr_code = $ticket_detail->PNR;;
            $ticket->Itinerary = $_ticket->Itinerary;
