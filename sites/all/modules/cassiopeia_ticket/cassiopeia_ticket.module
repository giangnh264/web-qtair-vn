function cassiopeia_ticket_booking_save($booking)
{
    $return = null;
    $db_transaction = db_transaction();
    try {
        $booking_saved = drupal_write_record("cassiopeia_ticket_booking", $booking);
        if (!empty($booking->passengers)) {
            foreach ($booking->passengers as $passenger) {
                $passenger->bid = $booking->id;
                drupal_write_record("cassiopeia_ticket_passenger", $passenger);
            }
        }
        if (!empty($booking->tickets)) {
            foreach ($booking->tickets as $ticket) {
                $ticket->bid = $booking->id;
                drupal_write_record("cassiopeia_ticket_ticket", $ticket);
            }
        }
    } catch (Exception $E) {
        _print_r($E);
        die;
        $db_transaction->rollback();
    }
    return $return;
}

function cassiopeia_ticket_booking_load_by_code($code)
{
    $return = null;
    try {
        $query = db_select("cassiopeia_ticket_booking", "cassiopeia_ticket_booking");
        $query->fields("cassiopeia_ticket_booking");
        $query->condition("booking_code", $code, "=");
        $booking = $query->execute()->fetchObject();
        if (!empty($booking)) {
            $tickets = cassiopeia_ticket_load_by_bid($booking->id);
            $booking->tickets = $tickets;
            $passengers = cassiopeia_passenger_load_by_bid($booking->id);
            $booking->passengers = $passengers;
        }

        $return = $booking;
    } catch (Exception $e) {
        _print_r($e);
    }
    return $return;
}

function cassiopeia_ticket_booking_load_by_PNR($pnr_code)
{
    $return = null;
    try {
        $ticket_query = db_select("cassiopeia_ticket_ticket", "cassiopeia_ticket_ticket");
        $ticket_query->fields("cassiopeia_ticket_ticket", array("bid"));
        $ticket_query->condition("cassiopeia_ticket_ticket.pnr_code", $pnr_code);

        $query = db_select("cassiopeia_ticket_booking", "cassiopeia_ticket_booking");
        $query->fields("cassiopeia_ticket_booking");
        $query->join($ticket_query, "cassiopeia_ticket_ticket", "cassiopeia_ticket_ticket.bid=cassiopeia_ticket_booking.id");

        $booking = $query->execute()->fetchObject();
        if (!empty($booking)) {
            $tickets = cassiopeia_ticket_load_by_bid($booking->id);
            $booking->tickets = $tickets;
            $passengers = cassiopeia_passenger_load_by_bid($booking->id);
            $booking->passengers = $passengers;
        }

        $return = $booking;
    } catch (Exception $e) {
        _print_r($e);
    }
    return $return;
}

function cassiopeia_ticket_load_by_PNR($pnr_code)
{
    $pnr_code = trim($pnr_code);
    $return = null;
    try {
        $ticket_query = db_select("cassiopeia_ticket_ticket", "cassiopeia_ticket_ticket");
        $ticket_query->fields("cassiopeia_ticket_ticket");
        $ticket_query->condition("cassiopeia_ticket_ticket.pnr_code", $pnr_code);

        $tickets = $ticket_query->execute()->fetchAll();
//        _print_r($pnr_code);
//        _print_r($tickets);
        $return = $tickets;
    } catch (Exception $e) {
        _print_r($e);
    }
    return $return;
}

function cassiopeia_ticket_booking_load($id)
{
    $return = null;
    try {
        $query = db_select("cassiopeia_ticket_booking", "cassiopeia_ticket_booking");
        $query->fields("cassiopeia_ticket_booking");
        $query->condition("id", $id, "=");
        $booking = $query->execute()->fetchObject();
        if (!empty($booking)) {
            $tickets = cassiopeia_ticket_load_by_bid($booking->id);
            $booking->tickets = $tickets;
            $passengers = cassiopeia_passenger_load_by_bid($booking->id);
            $booking->passengers = $passengers;
        }

        $return = $booking;
    } catch (Exception $e) {
        _print_r($e);
    }
    return $return;
}

