function cassiopeia_ticket_load_by_bid($bid)
{
    $return = null;
    try {
        $query = db_select("cassiopeia_ticket_ticket", "cassiopeia_ticket_ticket");
        $query->fields("cassiopeia_ticket_ticket");
        $query->condition("bid", $bid, "=");
        $query->orderBy("leg", "ASC");
        $tickets = $query->execute()->fetchAll();
        $return = $tickets;
    } catch (Exception $e) {
        _print_r($e);
    }
    return $return;
}

function cassiopeia_passenger_load_by_bid($bid)
{
    $return = null;
    try {
        $query = db_select("cassiopeia_ticket_passenger", "cassiopeia_ticket_passenger");
        $query->fields("cassiopeia_ticket_passenger");
        $query->condition("bid", $bid, "=");
        $tickets = $query->execute()->fetchAll();
        $return = $tickets;
    } catch (Exception $e) {

    }
    return $return;
}

function cassiopeia_agent_fee_config_save($config)
{
    global $user;
    $return = null;
    try {
        if (!empty($config->id)) {
            $config->changed = REQUEST_TIME;
            $saved = drupal_write_record("cassiopeia_ticket_agent_fee_config", $config, array("id"));
        } else {
            $config->created = REQUEST_TIME;
            $config->changed = REQUEST_TIME;
            $saved = drupal_write_record("cassiopeia_ticket_agent_fee_config", $config);
        }
        $return = $saved;
    } catch (Exception $E) {

    }
    return $return;
}

function cassiopeia_service_fee_config_save($config)
