            'template' => 'cassiopeia_ticket_booking_form',
            'path' => drupal_get_path('module', 'cassiopeia_ticket') . '/templates/forms'
        ),
        'cassiopeia_ticket_payment_after_booking_form' => array(
            'render element' => 'form',
            'template' => 'cassiopeia_ticket_payment_after_booking_form',
            'path' => drupal_get_path('module', 'cassiopeia_ticket') . '/templates/forms'
        ),
    );
}

function cassiopeia_ticket_search_flight_form_ajax_un_choose($form, &$form_state)
{

    $ajax_commands = array();
    $ajax_commands[] = ajax_command_replace('#choose_' . $form_state['#ChoseDepartureFlightSession'], (render($form['DepartureFlight'][$form_state['#ChoseDepartureFlightSession']]['choose'])));
