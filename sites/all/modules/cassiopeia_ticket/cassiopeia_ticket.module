            $ticket->Class = $ticket_detail->ListSegment[0]->ClassAdult;
            $ticket->PriceAdult = $data->FlightData->FlightGroups->PriceAdult;
            $ticket->PriceChild = $data->FlightData->FlightGroups->PriceChild;
            $ticket->PriceInfant = $data->FlightData->FlightGroups->PriceInfant;
            $ticket->FeeAdult = "";
            $ticket->FeeChild = "";
            $ticket->FeeInfant = "";
            $ticket->TaxAdult = "";
            $ticket->TaxChild = "";
            $ticket->TaxInfant = "";
            $ticket->TotalPrice = "";
            $ticket->ServiceFee = "";
            $ticket->IssueFee = "";
            $ticket->LastTkDate = strtotime($ticket_detail->LastTkDate);
            $ticket->SeatsAvailable = "";
            $ticket->leg = $_ticket->Itinerary == "DepartureFlights" ? 0 : 1;
            $ticket->uid = $item->uid;
            $ticket->created = $item->created;
            $ticket->changed = $item->created;
            $fbooking->tickets[] = $ticket;
        }
        if (!empty($data->ListPassengers)) {
            foreach ($data->ListPassengers as $Passenger) {
                $passenger = new stdClass();
                $passenger->Email = "";
                $passenger->Phone = "";
                $passenger->passenger_index = $Passenger['Index'];
                $passenger->FirstName = $Passenger['FirstName'];
                $passenger->LastName = $Passenger['LastName'];
                $passenger->Type = $Passenger['Type'];
                $passenger->Gender = $Passenger['Gender'];
                $passenger->Birthday = !empty($Passenger['Birthday']) ? strtotime(str_replace("/", "-", $Passenger['Birthday'])) : 0;
                $passenger->BaggageDeparture = $Passenger['BaggageDeparture'];
                $passenger->BaggageReturn = $Passenger['BaggageReturn'];
                $passenger->uid = $item->uid;
                $passenger->created = $item->created;
                $passenger->changed = $item->created;
                $fbooking->passengers[] = $passenger;
            }
        }
        $saved = cassiopeia_ticket_booking_save($fbooking);
    }

}

function _batch_cassiopeia_ticket_booking_update_form_excel_finished($success, $results, $operations)
{
    $_SESSION['start'] += 10000;
    drupal_set_message('Import successful.');
}

function cassiopeia_ticket_flight_search_form($form, &$form_state, $data)
{
    $form = array();
    $form['#data'] = $data;
    $form_wrapper = "cassiopeia-ticket-flight-search-form-wrapper";
    $form['#prefix'] = "<div id='" . $form_wrapper . "'>";
    $form['#suffix'] = "</div>";
    $form['#attributes'] = array("class" => array("cassiopeia-ticket-flight-search-form"));
    if (!empty($form_state['#search_result'])) {
        $DataSession = $form_state['#search_result']->Data->DataSession;
        $form['#search_result'] = $form_state['#search_result'];
        $form['#DataSession'] = $form_state['#DataSession'] = $DataSession;
        $form['#DepartureFlights'] = $DepartureFlights = $form_state['#search_result']->Data->DepartureFlights;
        $form['#Adult'] = $form_state['#search_result']->Data->Adult;
        $form['#Children'] = $form_state['#search_result']->Data->Children;
        $form['#Infant'] = $form_state['#search_result']->Data->Infant;
        $form['#ChoseDepartureFlightSession'] = !empty($form_state['#ChoseDepartureFlightSession']) ? $form_state['#ChoseDepartureFlightSession'] : null;
        $form['#ChoseDepartureFareOptionSession'] = !empty($form_state['#ChoseDepartureFareOptionSession']) ? $form_state['#ChoseDepartureFareOptionSession'] : null;
        if (!empty($form['#ChoseDepartureFareOptionSession'])) {
            $form['#ChoseDepatureFlight'] = cassiopeia_meta_FareOptionSession_load($DepartureFlights->{$form['#ChoseDepartureFlightSession']}, $form['#ChoseDepartureFareOptionSession']);;
        }
        foreach ($DepartureFlights as $FlightSession => $Flight) {
            $key = $DataSession . "-" . $FlightSession;
            $form['DepartureFlight'][$key] = array(
                '#type' => 'container',
                '#tree' => true
            );
            $options = array();
            $index = 1;
            $default_value = 0;
            foreach ($Flight->FareOptions as $FareOption) {
                $Price = $FareOption->PriceAdult + $FareOption->FeeAdult + $FareOption->TaxAdult;
                $options[$FareOption->FareOptionSession] = "<div><span class='airline-class'>" . $FareOption->Class . "</span><span class='price'>" . number_format($Price, 0, ",", ".") . "</span></div>";
                $index++;
            }
            $MostCheapFlight = cassiopeia_meta_get_most_cheap_flight($Flight->FareOptions);
            $form['DepartureFlight'][$key]['FareOption'] = array(
                '#type' => 'radios',
                '#title' => t(''),
                '#options' => $options,
                '#default_value' => $MostCheapFlight->FareOptionSession,
                '#ajax' => array(
                    'callback' => 'cassiopeia_ticket_search_flight_form_change_fareoption_ajax_submit',
                    'wrapper' => "test_" . $key,
                    'progress' => array('type' => 'fullscreen'),
                    'method' => 'replace',
                    'effect' => 'fade',
                ),
            );


            if (empty($form['#ChoseDepartureFlightSession'])) {
                $form['DepartureFlight'][$key]['choose'] = array(
                    '#type' => 'submit',
                    '#value' => "chose_" . $key,
                    '#attributes' => array('class' => array('btn-primary btn-choose-flight')),
                    '#ajax' => array(
                        'callback' => 'cassiopeia_ticket_search_flight_form_ajax_choose',
                        'wrapper' => 'RightDet2ail',
                        'progress' => array('type' => 'fullscreen')
                    ),
                    '#submit' => array('cassiopeia_ticket_search_flight_form_departure_choose'),
                    '#prefix' => "<div id='choose_'.$key>",
                    '#suffix' => "</div>"
                );
            } else {
                if ($form['#ChoseDepartureFlightSession'] == $FlightSession) {
                    $form['DepartureFlight'][$key]['un_choose'] = array(
                        '#type' => 'submit',
                        '#value' => "un_choose_" . $key,
                        '#attributes' => array('class' => array('btn-primary btn-un-choose-flight')),
                        '#ajax' => array(
                            'callback' => 'cassiopeia_ticket_search_flight_form_ajax_un_choose',
                            'wrapper' => 'Righ2tDetail',
                            'progress' => array('type' => 'fullscreen')
                        ),
                        '#submit' => array('cassiopeia_ticket_search_flight_form_departure_un_choose'),
                        '#prefix' => "<div id='choose_'.$key>",
                        '#suffix' => "</div>"
                    );
                }
            }

            if (!empty($form_state['values'][$key]['FareOption'])) {
                $form['#FareOption'][$key] = $FareOption = cassiopeia_meta_FareOptionSession_load($Flight, $form_state['values'][$key]['FareOption']);
            } else {
                $form['#FareOption'][$key] = $FareOption = cassiopeia_meta_FareOptionSession_load($Flight, $MostCheapFlight->FareOptionSession);
            }
            $form['DepartureFlight'][$key]['detail'] = array(
                '#markup' => _cassiopeia_render_theme("module", "cassiopeia_ticket", "templates/parts/search-flight-detail.tpl.php", array("Flight" => $Flight, "FareOption" => $FareOption, "PNR" => $form_state['values']['code'], "Adult" => $form['#Adult'], "Children" => $form['#Children'], "Infant" => $form['#Infant'], "custom_fee" => $form['#data']->custom_fee)),
                '#prefix' => "<div id='test_" . $key . "'>",
                '#suffix' => "</div>"

            );
        }
//        if(!empty($form['#ChoseDepartureFareOptionSession'])){
        $form['RightDetail'] = array(
            '#markup' => _cassiopeia_render_theme("module", "cassiopeia_ticket", "templates/parts/right-detail.tpl.php", array("DepartureFlight" => $form['#ChoseDepatureFlight'], "FareOption" => $FareOption, "PNR" => $form_state['values']['code'], "Adult" => $form['#Adult'], "Children" => $form['#Children'], "Infant" => $form['#Infant'], "custom_fee" => $form['#data']->custom_fee)),
            '#prefix' => "<div id='RightDetail'>",
            '#suffix' => "</div>"

        );
//        }
    }


    $form['search'] = array(
        '#type' => 'submit',
        '#value' => t('Thêm mới'),
        '#submit' => array("cassiopeia_ticket_flight_search_form_submit"),
//        '#validate' => array("cassiopeia_admin_payment_report_add_form_validate"),
        '#ajax' => array(
            'callback' => 'cassiopeia_ticket_flight_search_form_ajax_submit',
            'wrapper' => $form_wrapper,
            'method' => 'replace',
            'effect' => 'fade',
        ),
        '#attributes' => array("class" => array("btn-ajax btn-add"))
    );
    $form['#attached']['js'] = array(
        drupal_get_path('module', 'cassiopeia_ticket') . '/js/cassiopeia_ticket_search_flight_form.js'
    );
    return $form;
}

