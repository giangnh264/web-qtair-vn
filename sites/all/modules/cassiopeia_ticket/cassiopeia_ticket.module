        '#type' => 'ajax',
        '#commands' => $ajax_commands,
    );
}

function cassiopeia_ticket_search_flight_form_departure_choose($form, &$form_state)
{
    $key = $form_state['triggering_element']['#parents'][0];
    $splitter = explode("-", $key);
    $FlightSession = $splitter[1];
    $FareOption = $form_state['values'][$key];
    $form_state['#ChoseDepartureFlightSession'] = $FlightSession;
    $form_state['#ChoseDepartureFareOptionSession'] = $FareOption['FareOption'];
    $form_state['rebuild'] = TRUE;
}

function cassiopeia_ticket_search_flight_form_departure_un_choose($form, &$form_state)
{
    $form_state['#ChoseDepartureFlightSession'] = null;
    $form_state['#ChoseDepartureFareOptionSession'] = null;
    $form_state['rebuild'] = TRUE;
}

function cassiopeia_ticket_issue_review($form, &$form_state)
{
    $form_state['#leg_count'] = 0;
    $form_state['#guest_count'] = 0;
    $form_state['#open-pnr-result'] = null;
    $form_state['#TotalPrice'] = 0;
    $values = $form_state['values']['review-group'];
    $_data = new stdClass();
    $_data->PNRCode = strtoupper(trim($values['code']));
    $_data->AirlineCode = strtoupper(trim($values['airline']));
    $result = cassiopeia_meta_api_open_pnr($_data);
    if ($result->Code == 0) {
        if ($form_state['values']['review-group']['airline'] == "VN") {
            $TotalPrice = cassiopeia_meta_api_DOMAirPrice($_data);
            if ($TotalPrice->Code == 0) {
                $form_state['#TotalPrice'] = $TotalPrice->Data->Amount;
            }
            $str = str_replace("\n", "<br>", $result->Data->PNRContent);
            $array1 = explode(strtoupper($_data->PNRCode), $str);
            if (!empty($array1[1])) {
                $array2 = explode("1 VN", $array1[1]);
                $array4 = explode("TKT/TIME LIMIT", $array2[1]);
                $leg_count = (substr_count($array4[0], "VN")) + 1;				
                $newstr = $array2[0];
                $words = preg_replace('/\d+/u', '', $newstr);
                $array3 = explode(".I", $words);
                $str_adult = $array3[0];
                $guestCount = (substr_count($str_adult, "."));
            }
        }
        if ($form_state['values']['review-group']['airline'] == "VJ") {
            if ($result->Code == 0) {
                $DOM = new DOMDocument();
                $DOM->loadHTML('<?xml encoding="utf-8" ?>' . $result->Data->PNRContent);
                $tables = $DOM->getElementsByTagName('table');
                if ($tables->length >= 5) {
                    $length = $tables->length;
                    $guestTables = $tables->item(2);
                    $guestTableTbody = $guestTables->childNodes->item(0);
                    $guestTableTbodyTr = $guestTableTbody->childNodes;
                    $guestCount = count($guestTableTbodyTr) - 1;

                    $itineraryTables = $tables->item($length - 2);
                    $itineraryTableTbody = $itineraryTables->childNodes->item(1);
                    $itineraryTableTbodyTr = $itineraryTableTbody->childNodes;
                    $leg_count = count($itineraryTableTbodyTr);

                    $priceTables = $tables->item($length - 1);
                    $priceTableTbody = $priceTables->childNodes->item(0);
                    $priceTableTbodyTr = $priceTableTbody->childNodes;
                    $priceRow = $priceTableTbodyTr->item($priceTableTbodyTr->length - 1);
                    $priceTds = $priceRow->childNodes;
                    $priceTd = $priceTds->item($priceTds->length - 1);
                    $price = str_replace("VND", "", $priceTd->nodeValue);
                    $price = str_replace(",", "", $price);
                    $removeNode = $tables->item($length - 1);
                    $removeNode->parentNode->removeChild($removeNode);
                    $result->Data->PNRContent = $DOM->saveHTML();
                    $form_state['#TotalPrice'] = $price;
                }
            }
        }
//        _print_r($form_state['values']['review-group']['airline']);
        if ($form_state['values']['review-group']['airline'] == "QH") {
            if ($result->Code == 0) {
                $DOM = new DOMDocument();
                $DOM->loadHTML('<?xml encoding="utf-8" ?>' . $result->Data->PNRContent);
                $tables = $DOM->getElementsByTagName('table');
                if ($tables->length >= 3) {
                  $TotalPrice = 0;
                    $length = $tables->length;
                  $paymentTables = $tables->item($length - 1);
                  $paymentTableTbody = $paymentTables->childNodes->item(1);
                  $paymentTableTbodyTr = $paymentTableTbody->childNodes;
                  foreach ($paymentTableTbodyTr as $item) {
                    $itineraryTableTbodyTrTd = $item->childNodes;
                    $itineraryPriceCell = $itineraryTableTbodyTrTd->item(2);
                    if ($itineraryPriceCell && !empty($itineraryPriceCell->nodeValue)) {
                      $TotalPrice += str_replace("VND", "", str_replace(".", "", $itineraryPriceCell->nodeValue));
                    }
                  }
//                  _print_r($TotalPrice);
                    $guestTables = $tables->item(1);
                    $guestTableTbody = $guestTables->childNodes->item(1);
                    $guestTableTbodyTr = $guestTableTbody->childNodes;
                    $leg_count = 0;
//                    $TotalPrice = 0;
                    $infant = 0;
                    foreach ($guestTableTbodyTr as $item) {
                        foreach ($item->attributes as $attribute) {
                            if ($attribute->name == "class" && $attribute->value == "INFANT") {
                                $infant++;
                            }
                        }
                    }
                    $guestCount = count($guestTableTbodyTr) - $infant;

                    $itineraryTables = $tables->item(0);
                    $itineraryTableTbody = $itineraryTables->childNodes->item(1);
                    $itineraryTableTbodyTr = $itineraryTableTbody->childNodes;
//                _print_r($itineraryTables);
                    foreach ($itineraryTableTbodyTr as $item) {
                        foreach ($item->attributes as $attribute) {
                            if ($attribute->name == "class" && $attribute->value == "flight") {
                                $itineraryTableTbodyTrTd = $item->childNodes;
//                                $TotalPrice += str_replace("VND", "", str_replace(",", "", $itineraryTableTbodyTrTd->item(6)->nodeValue));
//                                $TotalPrice += str_replace("VND", "", str_replace(",", "", $itineraryTableTbodyTrTd->item(7)->nodeValue));
//                                $TotalPrice += str_replace("VND", "", str_replace(",", "", $itineraryTableTbodyTrTd->item(8)->nodeValue));
                                $leg_count++;
                            }
                        }
                    }
                    $form_state['#TotalPrice'] = $TotalPrice;
                }
            }
        }
        if ($form_state['values']['review-group']['airline'] == "VU") {
            if ($result->Code == 0) {
                $DOM = new DOMDocument();
                $DOM->loadHTML('<?xml encoding="utf-8" ?>' . $result->Data->PNRContent);
                $tables = $DOM->getElementsByTagName('table');
                $length = $tables->length;
                $guestTables = $tables->item(0);
                $guestTableTbody = $guestTables->childNodes->item(1);
                $guestTableTbodyTr = $guestTableTbody->childNodes;
                $infant = 0;
                foreach ($guestTableTbodyTr as $item) {
                    foreach ($item->attributes as $attribute) {
                        if ($attribute->name == "class" && $attribute->value == "INF") {
                            $infant++;
                        }
                    }
                }
                $guestCount = $guestTableTbodyTr->length - $infant;

                $itineraryTables = $tables->item(1);
                $itineraryTableTbody = $itineraryTables->childNodes->item(1);
                $itineraryTableTbodyTr = $itineraryTableTbody->childNodes;

                $leg_count = $itineraryTableTbodyTr->length;


                $priceTables = $tables->item(2);
                $priceTableTbody = $priceTables->childNodes->item(1);
                $priceTbodyTr = $priceTableTbody->childNodes;
                $priceTr = $priceTbodyTr->item(count($priceTbodyTr) - 1);
                $priceTds = $priceTr->childNodes;
                $priceTd = $priceTds->item($priceTds->length - 1);
                $price = str_replace("VND", "", str_replace(",", "", $priceTd->nodeValue));
                $form_state['#TotalPrice'] = $price;
            }
        }
    }
//    _print_r($leg_count);
//    _print_r($guestCount);
    $form_state['#leg_count'] = $leg_count;
    $form_state['#guest_count'] = $guestCount;
    $form_state['#open-pnr-result'] = $result;
    $form_state['rebuild'] = TRUE;
}

function cassiopeia_ticket_issue_review_ajax($form, &$form_state)
{
    return $form;
}

function cassiopeia_ticket_issue_form($form, &$form_state){
    $form = array();
    $form_wrapper = "cassiopeia-ticket-issue-form-wrapper";
    $form['#prefix'] = "<div id='" . $form_wrapper . "'>";
    $form['#suffix'] = "</div>";
    $form['#attributes']['class'][] = "cassiopeia-ticket-issue-form";
    $airline_options = array();
    $airline_options['VN'] = "Vietnam Airlines";
    $airline_options['VJ'] = "Vietjet Air";
    $airline_options['QH'] = "Bamboo Airways";
    $airline_options['VU'] = "Vietravel Airlines";
    $form['review-group'] = array(
        '#type' => 'container',
        '#tree' => TRUE,
    );
    $form['review-group']['airline'] = array(
        '#type' => 'select',
        '#title' => t('Hãng'),
        '#options' => $airline_options,
        '#chosen' => false,
    );
    $form['review-group']['code'] = array(
        '#type' => 'textfield',
        '#title' => t('PNR'),
        '#size' => 255,
        '#maxlength' => 255,
    );
    $form['review-group']['review'] = array(
        '#type' => 'submit',
        '#name' => 'review',
        '#value' => "Mở mặt vé",
        '#attributes' => array("class" => array("btn-default btn-ajax btn-open-pnr btn bg-secondary clr-white text ff-bold radius-36")),
        '#ajax' => array(
            'callback' => 'cassiopeia_ticket_issue_review_ajax',
            'wrapper' => $form_wrapper,
        ),
        '#submit' => array('cassiopeia_ticket_issue_review'),
    );
//    _print_r($form_state['#TotalPrice']);
    if (!empty($form_state['#TotalPrice'])) {
        $form['issue-group'] = array(
            '#type' => 'container',
            '#tree' => TRUE,
        );
        if (cassiopeia_issue_report_accept()) {
            $form['issue-group']['agent'] = array(
                '#type' => 'textfield',
                '#title' => t('Đại lý'),
                '#size' => 255,
                '#maxlength' => 255,
                '#attributes' => array("class" => array("hidden")),
                '#ajax' => array(
                    'callback' => 'cassiopeia_ticket_issue_form_ajax_submit',
                    'wrapper' => $form_wrapper,
                    'progress' => 'none',
                ),
            );
            $form['issue-group']['agent']['#process'] = array('form_process_autocomplete', 'ajax_process_form', 'bootstrap_form_process', 'cassiopeia_ticket_issue_form_issue_agent_process');
        }
        $form['issue-group']['code'] = array(
            '#type' => 'textfield',
            '#title' => t('Code'),
            '#size' => 255,
            '#maxlength' => 255,
            '#value' => !empty($form_state['values']['review-group']['code']) ? $form_state['values']['review-group']['code'] : "",
            '#attributes' => array("readonly" => "readonly", "disabled" => "disabled")
        );
        $form['issue-group']['issue'] = array(
            '#type' => 'submit',
            '#name' => 'btn-issue',
            '#value' => t('Xuất vé'),
            '#submit' => array('cassiopeia_ticket_issue_form_submit'),
            '#ajax' => array(
                'callback' => 'cassiopeia_ticket_issue_form_ajax_submit',
                'wrapper' => $form_wrapper,
            ),
            '#attributes' => array("class" => array("btn-ajax btn-red btn-filter btn-issue hidden "))
        );
    }
    $form['#attached']['js'] = array(
        drupal_get_path("module", "cassiopeia_ticket") . "/js/cassiopeia-ticket-issue-form.js"
    );

    $form['#review-result'] = !empty($form_state['#open-pnr-result']) ? $form_state['#open-pnr-result'] : "";
    $form['#TotalPrice'] = !empty($form_state['#TotalPrice']) ? $form_state['#TotalPrice'] : "";
    $form['#leg_count'] = !empty($form_state['#leg_count']) ? $form_state['#leg_count'] : 1;
    $form['#guest_count'] = !empty($form_state['#guest_count']) ? $form_state['#guest_count'] : 1;
    $form['#airline'] = $form_state['#airline'] = !empty($form_state['values']['review-group']['airline']) ? $form_state['values']['review-group']['airline'] : "";
    $form_state['#code'] = !empty($form_state['values']['review-group']['code']) ? $form_state['values']['review-group']['code'] : "";
    return $form;
}

function cassiopeia_ticket_issue_form_issue_agent_process($element, &$form_state, &$form)
{
    $value = !empty($element['#value']) ? $element['#value'] : '';
    $element['#field_prefix'] = '<input placeholder="Nhập mã, tên giao dịch..." name="tagify-issue-agent" class="form-control tagify-issue-agent" id="tagify-issue-agent" value="' . check_plain($value) . '">';
    return $element;
}

function cassiopeia_ticket_issue_form_ajax_submit($form, &$form_state)
{
//    _print_r($form_state['#error_message']);
    if (!empty($form_state['#added'])) {
        ctools_include('ajax');
        $commands[] = ajax_command_invoke("", "cassiopeiaTicketIssueCompleted", array(json_encode(array())));
    } else {
        if ($form_state['#error_message']) {
            ctools_include('ajax');
            $commands[] = ajax_command_invoke("", "cassiopeiaAlert", array(json_encode($form_state['#error_message'])));
        } else {
            drupal_get_messages();
            $commands[] = ajax_command_replace('#cassiopeia-ticket-issue-form-wrapper', drupal_render($form));
        }
    }
    $form_state['rebuild'];
    return array(
        '#type' => 'ajax',
        '#commands' => $commands,
    );
}

function cassiopeia_ticket_issue_form_submit($form, &$form_state)
{
    global $user;
    $flag = true;
    if (!cassiopeia_ticket_issue_accept()) {
        $form_state['#error_message'][] = "Bạn không có quyền sử dụng chức năng này!";
        $flag = false;
    }
    $_log = new stdClass();
    $form_state['#error_message'] = array(); // clear messages
    $form_state['#added'] = 0;
    $TotalPrice = $form_state['#TotalPrice'];
    $Leg = $form_state['#leg_count'];
    $Guest = $form_state['#guest_count'];
    $agent_id = !empty($form_state['values']['issue-group']['agent']) ? json_decode($form_state['values']['issue-group']['agent'])[0]->id : null;
    $Airline = trim($form_state['#airline']);
    $pnr_code = strtoupper(trim($form_state['#code']));
    $booking = cassiopeia_qt_ticket_booking_load_by_PNR($pnr_code);
    $_log->booking_code = "Xuất vé ngoài hệ thống";
    $total_service_fee = 0;
    if (!empty($booking)) {
        $tickets = $booking->tickets;
        $count_ticket = 0;
        $total_agent_fee = 0;
        foreach ($tickets as $ticket) {
            if ($ticket->pnr_code == $pnr_code) {
                $count_ticket++;
                $total_service_fee += $ticket->service_fee * ($booking->adt + $booking->chd);
                $total_service_fee += $ticket->service_infant_fee * $booking->inf;

                $total_agent_fee += $ticket->agent_fee * ($booking->adt + $booking->chd);
                $total_agent_fee += $ticket->agent_infant_fee * $booking->inf;
            }
        }
        $_log->booking_code = $booking->booking_code;
        if (empty($agent_id)) {
            if (cassiopeia_issue_report_accept()) {
                $agent_id = !empty($booking->uid) ? $booking->uid : $user->uid; //
            } else {
                $agent_id = $user->uid;
            }
        }
    } else {
        if (empty($agent_id)) {
            $agent_id = $user->uid;
        }
    }

    if ($flag) {
        $_log->uid = $user->uid;
        $_log->pnr_code = $pnr_code;
        $_log->status = "PENDING";
        $_log->error_code = "";
        $_log->message = "Thực hiện xuất vé";
        $_log->booking_image = "";
        $_log->note = "";
        $_log->issue_type = 1;

        $_agent = !empty($agent_id) ? user_load($agent_id) : user_load($user->uid);
        if (empty($_agent)) {
            $_agent = user_load($user->uid);
        }
        $silver_rank_fee = 0;


        $Partner_Price = $TotalPrice;
        $balance = !empty($_agent->field_account_balance['und'][0]['value']) ? $_agent->field_account_balance['und'][0]['value'] : 0;
        $balance = (float)trim($balance);
        if ($TotalPrice > 0) {
            if ($balance >= $Partner_Price + $total_service_fee || user_has_role(3) || user_has_role(8)) {
                try {
                    $dataResponseFromMeta = "dataResponseFromMeta";
                    $_data = new stdClass();
                    $_data->PNRCode = $pnr_code;
                    $_data->AirlineCode = $Airline;

                    $issue_response = cassiopeia_meta_api_issue($_data);
//                    $issue_response = new stdClass();
//                    $issue_response->Code=0;
                    $dataResponseFromMeta = serialize($issue_response);
                    if ($issue_response->Code == 0 || $issue_response->Code == "0") { // xuất thành công


                        $_agent->field_account_balance['und'][0]['value'] = $balance;
                        if ($_agent->field_account_status['und'][0]['tid'] == 22) { //tiềm năng
                            $_agent->field_account_status['und'][0]['tid'] = 13;
                            $_agent->field_account_updated_date['und'][0]['value'] = REQUEST_TIME;
                        }

                        $insertData = new stdClass();
                        $insertData->partner_price = $Partner_Price + $total_service_fee;
                        $insertData->price = $Partner_Price;
                        $insertData->agent = $_agent->uid;
                        $insertData->tran_kind = 4;
                        $insertData->quantity = $Leg * $Guest;
                        $insertData->PNR = $pnr_code;
                        $insertData->date = REQUEST_TIME;
                        $insertData->airline = $Airline;
                        $insertData->content = "API issue";
                        $insertData->booking = $booking;
                        $flag = true;
                        try {
                            cassiopeia_create_issue_report($insertData);
                            if (!empty($booking)) {
                                $_PNR = $booking->pnr_code;
                                $splitter = explode("-", $_PNR);

                                $query = db_select("tbl_issue_report", "tbl_issue_report");
                                $query->fields("tbl_issue_report");
                                $query->condition("PNR", $splitter, "IN");
                                $query->condition("tran_kind", 4, "=");
                                $checkIssue = $query->execute()->fetchAll();
                                if (count($checkIssue) >= count($booking->tickets)) {
                                    db_update("tbl_booking")->fields(array(
                                        "status" => "TICKETED"
                                    ))->condition("booking_code", $booking->booking_code)->execute();
                                }
                                $attachments = array();
                                module_load_include('inc', 'cassiopeia', 'cassiopeia_agency_ticket_pdf');
                                if (!empty($_agent->mail) && cassiopeia_agency_ticket_pdf_enabled($_agent)) {
                                    try {
                                        $attachments[] = cassiopeia_agency_ticket_pdf_attachment($booking, $Airline, $_agent);
                                    }
                                    catch (Exception $e) {
                                        watchdog(
                                            'cassiopeia',
                                            'Agency ticket PDF generation failed; the original booking email was sent without an attachment.',
                                            array(),
                                            WATCHDOG_WARNING
                                        );
                                        $attachments = array();
                                    }
                                }
                                cassiopeia_send_booking_mail($booking->booking_code, $_agent->mail, $booking->DO, '', $attachments);
                            }
                        } catch (Exception $e) {
                        }

                        $query = db_select("tbl_issue_report", "cassiopeia_report_issue");
                        $query->fields("cassiopeia_report_issue");
                        $query->condition("agent", $_agent->uid);
                        $query->condition("date", strtotime(date("d-m-Y 00:00", strtotime("01-09-2020"))), ">=");
                        $query->addExpression("SUM(partner_price)", "total");
                        $query->groupBy("agent");
                        $result = $query->execute()->fetchObject();

                        $query1 = db_select("tbl_room_booking_report", "cassiopeia_report_room_booking");
                        $query1->fields("cassiopeia_report_room_booking");
                        $query1->condition("agent", $_agent->uid);
                        $query1->addExpression("SUM(partner_price)", "total");
                        $query1->groupBy("agent");
                        $result1 = $query1->execute()->fetchObject();

                        $total = $result->total;
                        if (!empty($result1)) {
                            $total += $result1->total;
                        }

                        $point = round($total / 1000000);
                        $_agent->field_point['und'][0]['value'] = $point;

                        $_agent->field_account_balance['und'][0]['value'] = $balance - $Partner_Price - $total_service_fee;
                        user_save($_agent);

                        $message = "Xuất vé thành công!";
                        if($Airline=="VJ"){
                          $sendMailData = array();
                          $sendMailData['PNRCode'] = $pnr_code;
                          $sendMailData['AirlineCode'] = $Airline;
                          $sendMailData['Language'] = "VN";
                          $sendMailData['Emails'] = $_agent->mail;
                          $sendmail = cassiopeia_qt_meta_SendMail($sendMailData);
                        }
                        $form_state['#added'] = 1;
                    } else { // xuất thất bại
                        $message = "Xuất vé thất bại";
                    }
                    $_log->status = $issue_response->Code;
                    $_log->note = serialize($dataResponseFromMeta);
                } catch (Exception $e) {
                    $message = "Đã có lỗi xảy ra trong quá trình thao tác, vui lòng liên hệ bộ phận booker để dược hỗ trợ!";
                    $_log->status = "FAIL";
                    $_log->note = serialize($e);
                }
            } else {
                $message = "Tài khoản đại lý không đủ số dư để thực hiện thao tác xuất ";
            }
        } else {
            $message = "Phiên làm việc đã hết hạn, vui lòng mở mặt vé rồi thử lại sau!";
        }
        $_log->message = $message;
        $form_state['#error_message'][] = $message;
        cassiopeia_ticket_issue_log_save($_log);
    }
    $form_state['rebuild'] = TRUE;
//    cassiopeia_user_action_log_delete($action);
}

function cassiopeia_ticket_issue_log_save($log)
{
    try {
        $log->created = REQUEST_TIME;
        $log->changed = REQUEST_TIME;
        drupal_write_record("cassiopeia_ticket_issue_log", $log);
    } catch (Exception $e) {

    }
}

function cassiopeia_ticket_alepay_request_payment($booking)
{
    $fields = new stdClass();
//    $fields->allowDomestic = true;
    $fields->amount = $booking->total_pay + $booking->alefee;
    $fields->buyerAddress = $booking->contact_FirstName . " " . $booking->contact_LastName;
    $fields->buyerCity = "Ha noi";
    $fields->buyerCountry = "Viet Nam";
    $fields->buyerEmail = $booking->contact_Email;
    $fields->buyerName = $booking->contact_FirstName . " " . $booking->contact_LastName;
    $fields->buyerPhone = $booking->contact_Phone;
    $fields->cancelUrl = "https://qtair.vn/ticket/alepay/cancel";
//    $fields->checkoutType = 4;
//    $fields->checkoutType = 3;
    $fields->currency = "VND";
    $fields->customMerchantId = "";
    $fields->orderCode = $booking->booking_code;
    $fields->orderDescription = $booking->booking_code;
//    $fields->paymentMethod  = "QRCODE";
    $fields->returnUrl = "https://qtair.vn/ticket/alepay/complete";
    $fields->tokenKey = tokenKey;
    $fields->totalItem = 1;
    $firstValue = null;
    switch ($booking->payment_method) {
        case INTERNATIONAL_CARD :
            $fields->checkoutType = 1;
//            $fields->allowDomestic = true;
//            $fields->paymentMethod  = "ATM_ON";
            break;
        case DOMESTIC_CARD :
            $fields->checkoutType = 4;
            $fields->allowDomestic = true;
            $fields->paymentMethod = "ATM_ON";
            $firstValue = "true";
            break;
        case INTERNET_BANKING :
            $fields->checkoutType = 4;
            $fields->allowDomestic = true;
            $fields->paymentMethod = "VA";
            $firstValue = "true";
            break;
        case QR_PAY :
            $fields->checkoutType = 4;
            $fields->allowDomestic = true;
            $fields->paymentMethod = "VIETQR";
            $firstValue = "true";
            break;
    }
    $fields = (array)$fields;
    ksort($fields);
//    print_r($booking);
//    print_r($fields);
//    die;
    $index = 1;
    $data = "";
    foreach ($fields as $key => $field) {
        if ($index == 1) {
            if (empty($firstValue)) {
                $data .= $key . "=" . $field;
            } else {
                $data .= $key . "=" . $firstValue;
            }
        } else {
            $data .= "&" . $key . "=" . $field;
        }
        $index++;
    }
    $fields['signature'] = hash_hmac('sha256', $data, ChecksumKey);
    $curl = curl_init();

    curl_setopt_array($curl, array(
        CURLOPT_URL => ALEPAY_ENPOINT . '/request-payment',
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_ENCODING => '',
        CURLOPT_MAXREDIRS => 10,
        CURLOPT_TIMEOUT => 0,
        CURLOPT_FOLLOWLOCATION => true,
        CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
        CURLOPT_CUSTOMREQUEST => 'POST',
        CURLOPT_POSTFIELDS => json_encode($fields),
        CURLOPT_HTTPHEADER => array(
            'Content-Type: application/json'
        ),
    ));

    $response = curl_exec($curl);
//    print_r($response);
//    print_r(json_decode($response));
    curl_close($curl);
    return json_decode($response);
}

function cassiopeia_ticket_payment_after_booking_form($form, &$form_state)
{
    global $theme;
    global $user;
    global $viewing_booking_code;
    
    $_user = !empty($user->uid) ? user_load($user->uid) : null;
    $form_wrapper = "cassiopeia-ticket-ticket-payment-after-booking-form-wrapper";
    $form['#prefix'] = "<div id='" . $form_wrapper . "'>";
    $form['#suffix'] = "</div>";
    $form['#attributes']['class'][] = "cassiopeia-ticket-booking-form";
    $balance = $_user->field_account_balance['und'][0]['value'];
    $TotalPrice = $_SESSION['TotalPrice'];
    $TotalServiceFee = $_SESSION['TotalServiceFee'];
    if (!empty($user->uid)) {
        $form_state['#total_pay'] = $TotaPartnerPrice = $TotalPrice - $TotalServiceFee;
    } else {
        $form_state['#total_pay'] = $TotaPartnerPrice = $TotalPrice;
    }
    $form_state['#TotalServiceFee'] = $TotalServiceFee;
    if ($TotaPartnerPrice > $balance) {
        $text = "<span class=\"color-red\">( Số dư tài khoản không đủ, vui lòng <b>nạp tiền</b> để tiếp tục! )</span>";
    } else {
        $text = "<div class=\"color-orange\">( Bấm tiếp tục để thực hiện xuất vé ngay! )</div>";
    }
    $options = array();
//    if (empty(!$user->uid)) {
//        $_options[PAYMENT_HOLD] = "Giữ chỗ";
//        $_options[QT_CREDIT] = "Quang Trang Credit";
//    } else {
//        $_options[PAYMENT_HOLD] = "Giữ chỗ";
        $_options[QR_PAY] = "QR CODE";
        $_options[INTERNET_BANKING] = "Chuyển khoản nhận ngay 24/7";
        $_options[DOMESTIC_CARD] = "Thẻ nội địa";
        $_options[INTERNATIONAL_CARD] = "Thẻ quốc tế";
//    }
//    print_r(123);
    foreach ($_options as $_key => $_option) {
        $alefee = 0;
        $note = "Miễn phí";
        $fee = cassiopeia_qt_alepay_fee_config_load($_key);
        if (!empty($fee)) {
            $alefee = $fee->percent * $TotalPrice / 100 + $fee->amount;
            if (!empty($alefee)) $note = "Thu thêm phụ phí: " . number_format($alefee, 0, ",", ".") . " đ";
        }
        if ($_key == QT_CREDIT) {
            $note = $text;
        }
        $options[$_key] = _cassiopeia_render_theme("module", "cassiopeia_qt", "templates/parts/payment-method-label.tpl.php", array("payment_method" => $_key, "note" => $note, "balance" => $balance));
    }
    $form['payment'] = array(
        '#type' => 'container',
        '#tree' => TRUE,
    );
    $form['payment']['method'] = array(
        '#type' => 'radios',
        '#title' => t(''),
        '#default_value' => QR_PAY,
        '#options' => $options,
        '#ajax' => array(
            'callback' => 'cassiopeia_room_room_booking_form_change_payment_method_ajax_callback',
            'wrapper' => $form_wrapper,
            'method' => 'replace',
            'effect' => 'fade',
        ),
    );
    $form['payment']['method'][QR_PAY]['#prefix'] = "<div class='radio-group-title'>THANH TOÁN</div>";
//    $form['payment']['method'][PAYMENT_HOLD]['#suffix'] = "<div class='radio-group-title'>Xuất vé ngay</div>";
    $alepay_fee = "Miễn phí";
    $form['#alefee'] = $form_state['#alefee'] = $alefee = 0;
    if (!empty($form_state['values']['payment']['method'])) {
        $fee = cassiopeia_qt_alepay_fee_config_load($form_state['values']['payment']['method']);
        if (!empty($fee)) {
            $form['#alefee'] = $form_state['#alefee'] = $alefee = $fee->percent * $TotalPrice / 100 + $fee->amount;
        }
    }
    $banks = (array)cassiopeia_get_items_by_conditions(array(), "bank_info", "node");
    $options = array();
    $default_value = !empty($banks) ? array_values($banks)[0]->nid : null;
    if (!empty($banks)) {
        foreach ($banks as $bank) {
            $options[$bank->nid] = _cassiopeia_render_theme("module", "cassiopeia", "templates/parts/bank-type-1.tpl.php", array("node" => $bank, "image_style" => "original"));
        }
    }
    $form['bank'] = array(
        '#type' => 'radios',
        '#title' => t(''),
        '#options' => $options,
        '#default_value' => $default_value,
    );
    
    $form['booking_code'] = array(
        '#type' => 'hidden',
        '#default_value' => $viewing_booking_code,
    );

    
    $form['submit'] = array(
        '#type' => 'submit',
        '#value' => t('Tiếp tục'),
        '#submit' => array("cassiopeia_ticket_open_payment"),
        '#ajax' => array(
            'callback' => 'cassiopeia_ticket_booking_form_ajax_submit',
        ),
        '#attributes' => array("class" => array("btn bg-secondary clr-white text ff-bold mt-4 btn-ajax"))
    );
    $form['#attached']['js'] = array(
        drupal_get_path("module", "cassiopeia_ticket") . "/js/cassiopeia-ticket-booking-form.js"
    );
    return $form;
}

