}

function cassiopeia_api_booking($data)
{
    global $language;
    global $user;
    $obj = new stdClass();

    $obj->UseAgentContact = true;
    $obj->Remark = "";
    $obj->PaymentMethod = "";
    $obj->Contact = $data->Contact;
    $obj->ListPassenger = $data->ListPassenger;
    $obj->ListFlight = $data->ListFlight;
    try {
//        db_insert("tbl_log")->fields(array(
//            "created" => REQUEST_TIME,
//            "uid" => $user->uid,
//            "request_url" => "http://platform.datacom.vn/flights/book",
//            "postfields" => serialize($obj),
//        ))->execute();
    } catch (Exception $e) {

    }
    $obj->BookType = "book-custom";
    $obj->HeaderUser = HEADERUSER;
    $obj->HeaderPass = HEADERPASS;
    $obj->Language = $language->language;
    $obj->AgentAccount = AGENTACCOUNT;
    $obj->AgentPassword = AGENTPASSWORD;
    $curl = curl_init();
//    print_r(jpo
    curl_setopt_array($curl, array(
        CURLOPT_URL => "http://platform.datacom.vn/flights/book",
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_ENCODING => "",
        CURLOPT_MAXREDIRS => 10,
        CURLOPT_TIMEOUT => 0,
        CURLOPT_FOLLOWLOCATION => true,
        CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
        CURLOPT_CUSTOMREQUEST => "POST",
        CURLOPT_POSTFIELDS => json_encode($obj),
        CURLOPT_HTTPHEADER => array(
            "Content-Type: application/json"
        ),
    ));

    $response = curl_exec($curl);

    curl_close($curl);
    return $response;
}

function cassiopeia_airports_autocomplete($string)
{
    $matches = array();
    try {
        $select_1 = db_select('tbl_airports', 'airport');
        $select_1->fields('airport');
        $select_1->condition('code', '%' . $string . '%', 'LIKE');
        $select_1->orderBy('code', 'ASC');
        $select_1_result = $select_1->execute()->fetchAll();


        $select_2 = db_select('tbl_airports', 'airport');
        $select_2->fields('airport');
        $select_2->condition('name', '%' . $string . '%', 'LIKE');
        $select_2->orderBy('name', 'ASC');
        $select_2_result = $select_2->execute()->fetchAll();


        $select_3 = db_select('tbl_airports', 'airport');
        $select_3->fields('airport');
        $select_3->condition('city', '%' . $string . '%', 'LIKE');
        $select_3->orderBy('city', 'ASC');
        $select_3_result = $select_3->execute()->fetchAll();

        $select_4 = db_select('tbl_airports', 'airport');
        $select_4->fields('airport');
        $select_4->condition('state', '%' . $string . '%', 'LIKE');
        $select_4->orderBy('state', 'ASC');
        $select_4_result = $select_4->execute()->fetchAll();

        $select_5 = db_select('tbl_airports', 'airport');
        $select_5->fields('airport');
        $select_5->condition('country', '%' . $string . '%', 'LIKE');
        $select_5->orderBy('country', 'ASC');
        $select_5_result = $select_5->execute()->fetchAll();

        $result = array();
        foreach ($select_1_result as $select_1_result_key => $select_1_result_value) {
            $result[] = $select_1_result_value;
        }

        foreach ($select_2_result as $select_2_result_key => $select_2_result_value) {
            $check = FALSE;
            foreach ($result as $result_key => $result_value) {
                if ($select_2_result_value->code == $result_value->code) {
                    $check = TRUE;
                }
            }
            if ($check == FALSE) {
                $result[] = $select_2_result_value;
            }

        }

        foreach ($select_3_result as $select_3_result_key => $select_3_result_value) {
            $check = FALSE;
            foreach ($result as $result_key => $result_value) {
                if ($select_3_result_value->code == $result_value->code) {
                    $check = TRUE;
                }
            }

            if ($check == FALSE) {
                $result[] = $select_3_result_value;
            }

        }

        foreach ($select_4_result as $select_4_result_key => $select_4_result_value) {
            $check = FALSE;
            foreach ($result as $result_key => $result_value) {
                if ($select_4_result_value->code == $result_value->code) {
                    $check = TRUE;
                }
            }
            if ($check == FALSE) {
                $result[] = $select_4_result_value;
            }

        }

        foreach ($select_5_result as $select_5_result_key => $select_5_result_value) {
            $check = FALSE;
            foreach ($result as $result_key => $result_value) {
                if ($select_5_result_value->code == $result_value->code) {
                    $check = TRUE;
                }
            }
            if ($check == FALSE) {
                $result[] = $select_5_result_value;
            }

        }
        foreach ($result as $key => $airport) {
            $matches[$airport->code] = '<div class="airport-autocomplete-result-item"><div>' . $airport->name . '( ' . $airport->code . ' )' . '</div> <div>' . $airport->city . ', ' . $airport->country . '</div></div>';
        }
    } catch (Exception $e) {

    }
    drupal_json_output($matches);
}

function cassiopeia_airports_autosuggestflight()
{
    $matches = array();

    if (!empty($_POST['key'])) {
        try {
            $select_1 = db_select('tbl_airports', 'airport');
            $select_1->fields('airport');
            $select_1->condition('code', '%' . $_POST['key'] . '%', 'LIKE');
            $select_1->orderBy('code', 'ASC');
            $select_1_result = $select_1->execute()->fetchAll();


            $select_2 = db_select('tbl_airports', 'airport');
            $select_2->fields('airport');
            $select_2->condition('name', '%' . $_POST['key'] . '%', 'LIKE');
            $select_2->orderBy('name', 'ASC');
            $select_2_result = $select_2->execute()->fetchAll();


            $select_3 = db_select('tbl_airports', 'airport');
            $select_3->fields('airport');
            $select_3->condition('city', '%' . $_POST['key'] . '%', 'LIKE');
            $select_3->orderBy('city', 'ASC');
            $select_3_result = $select_3->execute()->fetchAll();


            $select_6 = db_select('tbl_airports', 'airport');
            $select_6->fields('airport');
            $select_6->condition('city_code', '%' . $_POST['key'] . '%', 'LIKE');
            $select_6->orderBy('city_code', 'ASC');
            $select_6_result = $select_6->execute()->fetchAll();

            //      $select_4 =  db_select('tbl_airports', 'airport');
            //      $select_4->fields('airport');
            //      $select_4->condition('state', '%'.$_POST['key'].'%', 'LIKE');
            //      $select_4->orderBy('state', 'ASC');
            //      $select_4_result = $select_4 ->execute()->fetchAll();

            //      $select_5 =  db_select('tbl_airports', 'airport');
            //      $select_5->fields('airport');
            //      $select_5->condition('country', '%'.$_POST['key'].'%', 'LIKE');
            //      $select_5->orderBy('country', 'ASC');
            //      $select_5_result = $select_5 ->execute()->fetchAll();

            $result = array();
            foreach ($select_1_result as $select_1_result_key => $select_1_result_value) {
                $result[] = $select_1_result_value;
            }

            foreach ($select_2_result as $select_2_result_key => $select_2_result_value) {
                $check = FALSE;
                foreach ($result as $result_key => $result_value) {
                    if ($select_2_result_value->code == $result_value->code) {
                        $check = TRUE;
                    }
                }
                if ($check == FALSE) {
                    $result[] = $select_2_result_value;
                }

            }

            foreach ($select_3_result as $select_3_result_key => $select_3_result_value) {
                $check = FALSE;
                foreach ($result as $result_key => $result_value) {
                    if ($select_3_result_value->code == $result_value->code) {
                        $check = TRUE;
                    }
                }

                if ($check == FALSE) {
                    $result[] = $select_3_result_value;
                }

            }

            //      foreach ($select_4_result as $select_4_result_key => $select_4_result_value ) {
            //        $check = FALSE;
            //        foreach ($result as $result_key => $result_value) {
            //          if ($select_4_result_value->code == $result_value->code) {
            //            $check = TRUE;
            //          }
            //        }
            //        if ($check == FALSE) {
            //          $result[] = $select_4_result_value;
            //        }
            //
            //      }

            //      foreach ($select_5_result as $select_5_result_key => $select_5_result_value ) {
            //        $check = FALSE;
            //        foreach ($result as $result_key => $result_value) {
            //          if ($select_5_result_value->code == $result_value->code) {
            //            $check = TRUE;
            //          }
            //        }
            //        if ($check == FALSE) {
            //          $result[] = $select_5_result_value;
            //        }
            //
            //      }

            foreach ($select_6_result as $select_6_result_key => $select_6_result_value) {
                $check = FALSE;
                foreach ($result as $result_key => $result_value) {
                    if ($select_6_result_value->code == $result_value->code) {
                        $check = TRUE;
                    }
                }
                if ($check == FALSE) {
                    $result[] = $select_6_result_value;
                }

            }

            //  $result = array_slice($result, 0, 10);
            foreach ($result as $key => $airport) {
                $matches[$airport->code] = $airport;
            }
        } catch (Exception $e) {

        }
    }

    return $matches;
}

function cassiopeia_get_airports($options = array())
{
    $airports = null;
    $airports_query = db_select('tbl_airports', 'airport');
    $airports_query->fields('airport');


    if (!empty($options['conditions']['name'])) {
        if (!empty($options['conditions']['name']['operator'])) {
            $airports_query->condition('name', $options['conditions']['name']['value'], $options['conditions']['name']['operator']);
        } else {
            $airports_query->condition('name', $options['conditions']['name']['value']);
        }
    }

    if (!empty($options['conditions']['city'])) {
        if (!empty($options['conditions']['city']['operator'])) {
            $airports_query->condition('city', $options['conditions']['city']['value'], $options['conditions']['city']['operator']);
        } else {
            $airports_query->condition('city', $options['conditions']['city']['value']);
        }

    }

    if (!empty($options['conditions']['state'])) {
        if (!empty($options['conditions']['state']['operator'])) {
            $airports_query->condition('state', $options['conditions']['state']['value'], $options['conditions']['state']['operator']);
        } else {
            $airports_query->condition('state', $options['conditions']['state']['value']);
        }

    }

    if (!empty($options['conditions']['country'])) {
        if (!empty($options['conditions']['country']['operator'])) {
            $airports_query->condition('country', $options['conditions']['country']['value'], $options['conditions']['country']['operator']);
        } else {
            $airports_query->condition('country', $options['conditions']['country']['value']);
        }

    }

    $results = $airports_query->execute()->fetchAll();

    if (!empty($results)) {
        foreach ($results as $key => $value) {
            $airports[] = cassiopeia_get_airport($value->code);
        }
    }
    return $airports;
}

function cassiopeia_get_airport($code)
{
    $airport = null;
    $airport_query = db_select('tbl_airports', 'airport');
    $airport_query->fields('airport');
    $airport_query->condition('code', $code, '=');
    $airport = $airport_query->execute()->fetchObject();
    return $airport;
}

function cassiopeia_get_airlines()
{
    $result = db_select('tbl_airlines', 'a')
        ->fields('a')
        ->execute()
        ->fetchAll();
    return $result;
}

function airline_load($iata)
{
    return cassiopeia_get_airline($iata);
}

function cassiopeia_get_airline($iata)
{
    $result = db_select('tbl_airlines', 'a')
        ->fields('a')
        ->condition('iata', $iata, '=')
        ->execute()
        ->fetchObject();
    return $result;
}

function _cassiopeia_get_day_off_week($timestamp)
{
    $_output = "";
    switch (date('N', $timestamp)) {
        case '1':
            $_output = t('Monday');
            break;
        case '2':
            $_output = t('Tuesday');
            break;
        case '3':
            $_output = t('Wednesday');
            break;
        case '4':
            $_output = t('Thursday');
            break;
        case '5':
            $_output = t('Friday');
            break;
        case '6':
            $_output = t('Saturday');
            break;
        case '7':
            $_output = t('Sunday');
            break;
    }
    return $_output;
}

