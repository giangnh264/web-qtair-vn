function cassiopeia_isue_report_filter_form($form,&$form_state){
    $form = array();
    $form['date_filter'] = array(
        '#type' => 'select',
        '#title' => t('Theo ngày'),
        '#options' => array(
            "all" => "Tất cả",
            "today" => "Trong ngày",
            "yesterday" => "Hôm qua",
            "thismonth" => "Trong tháng",
            "other" => "Theo ngày",
        ),
        '#default_value'    => "today",
//        '#ajax' => array(
//            'callback' => 'cassiopeia_isue_report_filter_form_ajax',
//            'wrapper' => 'txAreaContainer',
//            'method' => 'replace',
//            'effect' => 'fade',
//        )
    );
    if (!empty($cache['date_filter'])) {
        $form['date_filter']['#default_value'] = $cache['date_filter'];
    }
    $form['from_date'] = array(
        '#type' => 'date_popup',
        '#default_value' => !empty($cache['from_date']) ? $cache['from_date'] : date("Y-m-d H:i:s", REQUEST_TIME),
        '#date_type' => DATE_DATETIME,
        '#date_timezone' => date_default_timezone(),
        '#date_format' => 'd-m-Y',
        '#date_increment' => 1,
        '#date_year_range' => '-10:+10',
        '#prefix'           => "<div class='date-filter-group'>",
        '#suffix'           => "</div>"
    );
    $form['to_date'] = array(
        '#type' => 'date_popup',
        '#default_value' => !empty($cache['to_date']) ? $cache['to_date'] : date("Y-m-d H:i:s", REQUEST_TIME),
        '#date_type' => DATE_DATETIME,
        '#date_timezone' => date_default_timezone(),
        '#date_format' => 'd-m-Y',
        '#date_increment' => 1,
        '#date_year_range' => '-10:+10',
        '#prefix'           => "<div class='date-filter-group'>",
        '#suffix'           => "</div>"
    );
    $airlines = cassiopeia_get_airlines();
    $airline_options = array();
    $airline_options['all'] = "Tất cả";
    $airline_options['VN'] = "Vietnam Airlines";
    $airline_options['VJ'] = "VietJet Air";
    $airline_options['BL'] = "Pacific Airlines";
    $airline_options['QH'] = "Bammboo Airways";
    foreach($airlines as $airline){
        $airline_options[$airline->iata] = $airline->iata." - ".$airline->name;
    }
    $form['airline'] = array(
        '#type' => 'select',
        '#title' => t('Hãng hàng không'),
        '#options' => $airline_options,
        '#default_value' => !empty($caches['airline']) ? $caches['airline'] : "",
    );
    $query = db_select("tbl_tran_kind", "tbl_tran_kind");
    $query->fields("tbl_tran_kind");
    $query->condition("kind", "issue");
    $result = $query->execute()->fetchAll();
    $options = array();
    $options['all'] = "Tất cả";
    if (!empty($result)) {
        foreach ($result as $value) {
            $options[$value->id] = $value->name;
        }
    }
    $form['tran_kind'] = array(
        '#type' => 'select',
        '#title' => t('Loại giao dịch'),
        '#options' => $options,
        '#chosen' => TRUE,
    );      
    $form['profit_filter'] = array(
        '#type' => 'select',
        '#title' => t('Lợi nhuận'),
        '#options' => array(
            "all" => "Tất cả",
            "morethanZero" => "Lợi nhuận dương",
            "lessthanZero" => "Lợi nhuận âm",
            "equalZero" => "Không lợi nhuận"
        ),
        '#default_value'    => "all"
    );
    $form['code'] = array(
        '#type'         => 'textfield',
        '#title'        => t('Code'),
        '#size'         => 60,
        '#maxlength'    => 128,
//        '#attributes' => array("onchange" => "this.form.submit()"),
    );
    if(user_has_role(3) || user_has_role(7)|| user_has_role(5)|| user_has_role(8)){
        $query = db_select("users", "tbl_user");
        $query->fields("tbl_user");
        $query->join("users_roles", "tbl_role", "tbl_role.uid = tbl_user.uid");
        $query->condition("tbl_role.rid", array(4));
        $query->join("field_data_field_account_transaction_name", "field_account_transaction_name", "field_account_transaction_name.entity_id=tbl_user.uid");
        $query->join("field_data_field_account_code", "field_account_code", "field_account_code.entity_id=tbl_user.uid");
        $query->addField("field_account_transaction_name", "field_account_transaction_name_value", "agent_transaction_name");
        $query->addField("field_account_code", "field_account_code_value", "agent_code");
        $result = $query->execute()->fetchAll();
        $options = array();
        $options['all'] = "Chọn";
        if (!empty($result)) {
            foreach ($result as $value) {
                $options[$value->uid] = $value->agent_code . " - " . $value->agent_transaction_name;
            }
        }
        $form['agent'] = array(
            '#type' => 'select',
            '#title' => t('Đại lý'),
            '#options' => $options,
            '#chosen' => TRUE,
        );
    }
    $query = db_select("users", "tbl_user");
    $query->fields("tbl_user");
    $query->join("users_roles", "tbl_role", "tbl_role.uid = tbl_user.uid");
    $query->condition("tbl_role.rid", array(3,4,8));
    $query->join("field_data_field_account_transaction_name", "field_account_transaction_name", "field_account_transaction_name.entity_id=tbl_user.uid");
    $query->join("field_data_field_account_code", "field_account_code", "field_account_code.entity_id=tbl_user.uid");
    $query->addField("field_account_transaction_name", "field_account_transaction_name_value", "agent_transaction_name");
    $query->addField("field_account_code", "field_account_code_value", "agent_code");
    $result = $query->execute()->fetchAll();
    $options = array();
    $options['all'] = "Chọn";
    if (!empty($result)) {
        foreach ($result as $value) {
            $options[$value->uid] = $value->agent_code . " - " . $value->agent_transaction_name;
        }
    }
    $form['tran_user'] = array(
        '#type' => 'select',
        '#title' => t('Người xuất'),
        '#options' => $options,
        '#chosen' => TRUE,
    );
    $form['content'] = array(
        '#title' => t('Nội dung'),
        '#type' => 'textfield',
    );
    $form['submit'] = array(
        '#type' => 'submit',
        '#prefix' => "<div class='form-buttons'>",
        '#suffix' => "</div>",
        '#value' => t('Lọc'),
        '#attributes'   => array("class"=>array("btn bg-secondary clr-white ff-semibold radius-4 btn-filter"))
    );
    if(user_has_role(3) || user_has_role(7)|| user_has_role(5)|| user_has_role(8)){
        $form['export'] = array(
            '#type' => 'submit',
            '#prefix' => "<div class='form-buttons'>",
            '#suffix' => "</div>",
            '#value' => t('Xuất Excel'),
            '#attributes'   => array("class"=>array("btn bg-secondary clr-white ff-semibold radius-4 btn-export-1"))
        );
    }
    return $form;
}
