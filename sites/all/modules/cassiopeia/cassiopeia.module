function cassiopeia_ticket_manager_filter_form($form, &$form_state, $caches)
{
    $arg = arg();
    $form = array();
    $query = db_select("tbl_airline_", "tbl_airline_");
    $query->fields("tbl_airline_");
    $_airlines = $query->execute()->fetchAll();
    $option_airlines = array();
    $option_airlines['all'] = "Tất cả";
    if (!empty($_airlines)) {
        foreach ($_airlines as $airline) {
            $option_airlines[$airline->code] = $airline->name;
        }
    }
    if ($arg[2] == "partners") {
        $query = db_select("users", "tbl_user");
        $query->fields("tbl_user");
        $query->join("users_roles", "tbl_role", "tbl_role.uid = tbl_user.uid");
        $or = db_or();
        $or->condition("tbl_role.rid", 4);
        $or->condition("tbl_role.rid", 6);
        $query->leftJoin("field_data_field_account_sale", "tbl_sale", "tbl_sale.entity_id = tbl_user.uid");
        $result = $query->execute()->fetchAll();
        $agent_options = array();
        if (!empty($result)) {
            foreach ($result as $item) {
                $agent_options[$item->uid] = !empty($item->field_account_full_name['und']) ? $item->field_account_full_name['und'][0]['value'] : $item->mail;
            }
        }
        $form['agent'] = array(
            '#type' => 'select',
            '#title' => t('Đại lý'),
            '#options' => $agent_options,
            '#chosen' => TRUE,
            '#default_value' => !empty($caches['airline']) ? $caches['airline'] : "",
        );
    }
    $form['airline'] = array(
        '#type' => 'select',
        '#title' => t('Hãng hàng không'),
        '#options' => $option_airlines,
        '#default_value' => !empty($caches['airline']) ? $caches['airline'] : "",
        '#attributes' => array("onchange" => "this.form.submit()"),
    );
    $query = db_select("tbl_region", "tbl_region");
    $query->fields("tbl_region");
    $_regions = $query->execute()->fetchAll();
    $region_airlines = array();
    $region_airlines['all'] = "Tất cả";
    if (!empty($_regions)) {
        foreach ($_regions as $airline) {
            $region_airlines[$airline->code] = $airline->name;
        }
    }
    $form['region'] = array(
        '#type' => 'select',
        '#title' => t('Khu vực'),
        '#options' => $region_airlines,
        '#default_value' => !empty($caches['region']) ? $caches['region'] : "",
        '#attributes' => array("onchange" => "this.form.submit()"),
    );
    $form['price'] = array(
        '#type' => 'textfield',
        '#title' => t('Phí dịch vụ'),
        '#default_value' => !empty($caches['price']) ? $caches['price'] : "",
    );
    $form['submit'] = array(
        '#type' => 'submit',
        '#value' => 'Lọc',
    );
    return $form;
}

function cassiopeia_ticket_manager_filter_form_submit($form, &$form_state)
{
    $arg = arg();
    $options = array(
        'query' => array(
            'data' => $form_state['values'],
        )
    );
    if ($arg[2] == "partners") {
        $form_state['redirect'] = array('/admin/manager/partners/config', "data" => $options);
    } else {
        $form_state['redirect'] = array('/admin/manager/ticket-price', "data" => $options);
    }
}

