function cassiopeia_add_issue_report_form($form, &$form_state, $_conditions = null)
{
    $form = array();
    $airlines = cassiopeia_get_airlines();
    $airline_options = array();
    $airline_options['VJ'] = "VJ" . " - " . cassiopeia_get_airline("VJ")->name;
    $airline_options['VN'] = "VN" . " - " . cassiopeia_get_airline("VN")->name;
    $airline_options['QH'] = "QH" . " - " . cassiopeia_get_airline("QH")->name;
    $airline_options['JQ'] = "JQ" . " - " . cassiopeia_get_airline("JQ")->name;
    $airline_options['VU'] = "VU" . " - " . cassiopeia_get_airline("VU")->name;
    foreach ($airlines as $airline) {
        if (!array_key_exists($airline->iata, $airline_options)) {
            $airline_options[$airline->iata] = $airline->iata . " - " . $airline->name;
        }
    }
    $form['airline'] = array(
        '#type' => 'select',
        '#title' => t('Hãng'),
        '#options' => $airline_options,
        '#chosen' => TRUE,
    );
    $query = db_select("tbl_tran_kind", "tbl_tran_kind");
    $query->fields("tbl_tran_kind");
    $query->condition("kind", "issue");
    $result = $query->execute()->fetchAll();
    $options = array();
    if (!empty($result)) {
        foreach ($result as $value) {
            if ($value->id == 1) {
                continue;
            }
            $options[$value->id] = $value->name;
        }
    }
    $form['tran_kind'] = array(
        '#type' => 'select',
        '#title' => t('Loại giao dịch'),
        '#options' => $options,
        '#chosen' => TRUE,
        '#resquired' => TRUE,
    );
    $form['id'] = array(
        '#title' => t('PNR'),
        '#type' => 'hidden',
        '#size' => 60,
        '#maxlength' => 128,
//        '#resquired'    => TRUE,
    );
    $form['PNR'] = array(
        '#title' => t('Code'),
        '#type' => 'textfield',
        '#size' => 60,
        '#maxlength' => 128,
        '#resquired' => TRUE,
    );
    $form['quantity'] = array(
        '#title' => t('Số lượng'),
        '#type' => 'textfield',
        '#size' => 60,
        '#maxlength' => 128,
        '#default_value' => 0,
        '#resquired' => TRUE,
    );
    $form['partner_price'] = array(
        '#title' => t('Giá AG'),
        '#type' => 'textfield',
        '#size' => 60,
        '#maxlength' => 128,
        '#resquired' => TRUE,
        '#attributes' => array("class" => array("number_format")),
    );
    $form['price'] = array(
        '#title' => t('Giá vốn'),
        '#type' => 'textfield',
        '#size' => 60,
        '#maxlength' => 128,
        '#resquired' => TRUE,
        '#attributes' => array("class" => array("number_format")),
    );
//    $form['revenue'] = array(
//        '#title'        => t('Doanh thu'),
//        '#type'         => 'textfield',
//        '#size'         => 60,
//        '#maxlength'    => 128,
//        '#resquired'    => TRUE,
//    );
    $query = db_select("users", "tbl_user");
    $query->fields("tbl_user");
    $query->join("users_roles", "tbl_role", "tbl_role.uid = tbl_user.uid");
    $query->condition("tbl_role.rid", 4);
    $query->leftJoin("field_data_field_account_sale", "tbl_sale", "tbl_sale.entity_id = tbl_user.uid");
    $query->join("field_data_field_account_status", "field_account_status", "field_account_status.entity_id=tbl_user.uid");
    $query->condition("field_account_status.field_account_status_tid", array(13, 22), "IN");
    $result = $query->execute()->fetchAll();
    $options = array();
    $options[0] = "Chọn Đại lý";
    if (!empty($result)) {
        foreach ($result as $value) {
            $agent = user_load($value->uid);
            $transaction_name = !empty($agent->field_account_transaction_name['und'][0]['value']) ? $agent->field_account_transaction_name['und'][0]['value'] : "";
            $account_code = !empty($agent->field_account_code['und'][0]['value']) ? $agent->field_account_code['und'][0]['value'] : "";
            $options[$value->uid] = $account_code . " - " . $transaction_name;
        }
    }
    $form['agent'] = array(
        '#type' => 'select',
        '#title' => t('Đại lý'),
        '#options' => $options,
        '#chosen' => TRUE,
    );
    $form['content'] = array(
        '#title' => t('Nội dung'),
        '#type' => 'textfield',
        '#size' => 60,
        '#maxlength' => 128,
        '#resquired' => TRUE,
    );
    $form['submit'] = array(
        '#type' => 'submit',
        '#value' => t('Thêm mới'),
        '#prefix' => '<div class="buttons">',
        '#suffix' => '</div>',
    );
    return $form;
}

function cassiopeia_add_issue_report_form_submit($form, &$form_state)
{
    global $user;
    try {
        $partner_price = !empty($form_state['values']['partner_price']) ? str_replace(".", "", $form_state['values']['partner_price']) : 0;
        $price = !empty($form_state['values']['price']) ? str_replace(".", "", $form_state['values']['price']) : 0;
        $query = db_select("tbl_issue_report", "tbl_issue_report");
        $query->fields("tbl_issue_report");
        $query->range(0, 1);
        $query->orderBy("id", "DESC");
        $last = $query->execute()->fetchAssoc();
        if (!empty($last)) {
            $temp = str_replace("ISSUE", "", $last['tran_code']);
            $tran_code = "ISSUE" . ($temp + 1);
        } else {
            $tran_code = "ISSUE" . date("m", REQUEST_TIME) . "0001";
        }
        $_agent = user_load($form_state['values']['agent']);
        $balance = !empty($_agent->field_account_balance['und'][0]['value']) ? $_agent->field_account_balance['und'][0]['value'] : 0;
        $tran_kind = cassiopeia_get_tran_kind_by_id($form_state['values']['tran_kind']);
        $flag = true;
        $_quantity = !empty($form_state['values']['quantity']) ? $form_state['values']['quantity'] : 0;
        if ($tran_kind['type'] == 1) { //cộng tiền
            $balance += $partner_price;
            $_quantity = 0 - $_quantity;
            $partner_price = 0 - $partner_price;
            $price = 0 - $price;
        } else { //trừ tiền
            $balance -= $partner_price;
        }
        if ($flag == true) {
//            print($form_state['values']['tran_kind']);
//            die;
            if ($form_state['values']['tran_kind'] == 4) { //xuất vé
                db_update("tbl_booking")->fields(array(
                    "status" => "TICKETED",
                ))
                    ->condition("pnr_code", "%" . $form_state['values']['PNR'] . "%", "LIKE")
                    ->execute();
            }
            $_agent->field_account_balance['und'][0]['value'] = $balance;
            if ($_agent->field_account_status['und'][0]['tid'] == 22) { //tiềm năng
                $_agent->field_account_status['und'][0]['tid'] = 13;
            }
            user_save($_agent);
            db_insert("tbl_issue_report")->fields(array(
                "created" => REQUEST_TIME,
                "tran_code" => $tran_code,
                "airline" => !empty($form_state['values']['airline']) ? $form_state['values']['airline'] : "",
                "tran_kind" => !empty($form_state['values']['tran_kind']) ? $form_state['values']['tran_kind'] : "",
                "PNR" => !empty($form_state['values']['PNR']) ? strtoupper($form_state['values']['PNR']) : "",
                "quantity" => $_quantity,
                "partner_price" => $partner_price,
                "price" => $price,
                "revenue" => $partner_price - $price,
                "agent" => !empty($form_state['values']['agent']) ? $form_state['values']['agent'] : "",
                "content" => !empty($form_state['values']['content']) ? $form_state['values']['content'] : "",
                "tran_user" => $user->uid,
                "balance" => $balance,
//            "status"            => 0, // chưa sử dụng
            ))->execute();
            db_insert("tbl_report")->fields(array(
                "created" => REQUEST_TIME,
                "type" => "issue",
                "tran_code" => $tran_code,
            ))->execute();

        }
    } catch (Exception $e) {
        print_r($e);
        die;
    }
}

function cassiopeia_filter_issue_report_form($form, &$form_state, $caches)
{
    global $user;
    $arg = arg();
    $month = date("m", REQUEST_TIME);
    $form = array();
    $month_options = array();
    for ($i = REQUEST_TIME - (12 * 30 * 86400); $i <= REQUEST_TIME; $i += 86400 * 30) {
        $month_options[date("m-Y", $i)] = date("m/Y", $i);
    }
    $form['month'] = array(
        '#type' => 'select',
        '#title' => t('Tháng'),
        '#options' => $month_options,
        '#attributes' => array("class" => array("issue-filter-change")),
//        '#chosen'   => TRUE,
//        '#resquired'    => TRUE,
    );
    if (!empty($caches['month'])) {
        $form['month']['#default_value'] = $caches['month'];
    } else {
        $form['month']['#default_value'] = date("m-Y", REQUEST_TIME);
    }
    $airlines = cassiopeia_get_airlines();
    $airline_options = array();
    $airline_options['all'] = "Tất cả";
    foreach ($airlines as $airline) {
        $airline_options[$airline->iata] = $airline->iata . " - " . $airline->name;
    }
    $form['airline'] = array(
        '#type' => 'select',
        '#title' => t('Hãng'),
        '#options' => $airline_options,
        '#chosen' => TRUE,
        '#attributes' => array("class" => array("issue-filter-change")),
    );
    if (!empty($caches['airline'])) {
        $form['airline']['#default_value'] = $caches['airline'];
    }
    $query = db_select("tbl_tran_kind", "tbl_tran_kind");
    $query->fields("tbl_tran_kind");
    $query->condition("kind", "issue");
    $result = $query->execute()->fetchAll();
    $options = array();
    $options['all'] = "Tất cả";
    if (!empty($result)) {
        foreach ($result as $value) {
            $options[$value->id] = $value->name;
        }
    }
    $form['tran_kind'] = array(
        '#type' => 'select',
        '#title' => t('Loại giao dịch'),
        '#options' => $options,
        '#attributes' => array("class" => array("issue-filter-change")),
        '#chosen' => TRUE,
//        '#required'    => TRUE,
    );
    if (!empty($caches['tran_kind'])) {
        $form['tran_kind']['#default_value'] = $caches['tran_kind'];
    }
    $form['PNR'] = array(
        '#title' => t('PNR'),
        '#type' => 'textfield',
        '#size' => 60,
        '#maxlength' => 128,
        '#attributes' => array("class" => array("issue-filter-change")),
//        '#required'    => TRUE,
    );
    if (!empty($caches['PNR'])) {
        $form['PNR']['#default_value'] = $caches['PNR'];
    }
    $query = db_select("users", "tbl_user");
    $query->fields("tbl_user");
    $query->join("users_roles", "tbl_role", "tbl_role.uid = tbl_user.uid");
    $query->condition("tbl_role.rid", 4);
    $query->leftJoin("field_data_field_account_sale", "tbl_sale", "tbl_sale.entity_id = tbl_user.uid");
    $query->join("field_data_field_account_transaction_name", "field_account_transaction_name", "field_account_transaction_name.entity_id=tbl_user.uid");
    $query->join("field_data_field_account_code", "field_account_code", "field_account_code.entity_id=tbl_user.uid");
    $query->addField("field_account_code", "field_account_code_value", "field_account_code_value");
    $query->addField("field_account_transaction_name", "field_account_transaction_name_value", "field_account_transaction_name_value");
    $result = $query->execute()->fetchAll();
    $agent_options = array();
    $agent_options['all'] = "Chọn Đại lý";
    if (!empty($result)) {
        foreach ($result as $value) {
            $transaction_name = !empty($value->field_account_transaction_name_value) ? $value->field_account_transaction_name_value : "";
            $account_code = !empty($value->field_account_code_value) ? $value->field_account_code_value : "";
            $agent_options[$value->uid] = $account_code . " - " . $transaction_name;
        }
    }
    if (user_has_role(3, $user)) {
        $form['agent'] = array(
            '#type' => 'select',
            '#title' => t('Đại lý'),
            '#options' => $options,
            '#chosen' => TRUE,
            '#attributes' => array("class" => array("issue-filter-change")),
        );
        if (!empty($caches['agent'])) {
            $form['agent']['#default_value'] = $caches['agent'];
        }
    }

    $form['content'] = array(
        '#title' => t('Nội dung'),
        '#type' => 'textfield',
        '#size' => 60,
        '#maxlength' => 128,
        '#attributes' => array("class" => array("issue-filter-change")),
//        '#resquired'    => TRUE,
    );
    if (!empty($caches['content'])) {
        $form['content']['#default_value'] = $caches['content'];
    }
    return $form;
}

function cassiopeia_filter_issue_report_form_submit($form, &$form_state)
{
    $arg = arg();
    $options = array(
        'query' => array(
            'data' => $form_state['values'],
        )
    );
    if ($arg[0] == "user") {
        $form_state['redirect'] = array('/user/manager/dashboard', "data" => $options);
    } else {
        $form_state['redirect'] = array('/admin/manager/bao-cao-xuat-ve', "data" => $options);
    }
}


function cassiopeia_filter_transaction_report_form($form, &$form_state, $caches)
{
    $query = db_select("tbl_tran_kind", "tbl_tran_kind");
    $query->fields("tbl_tran_kind");
    $result = $query->execute()->fetchAll();
    $options = array();
    $options['all'] = "Tất cả";
    if (!empty($result)) {
        foreach ($result as $value) {
            $options[$value->id] = $value->name;
        }
    }
    $form['tran_kind'] = array(
        '#type' => 'select',
        '#title' => t('Loại giao dịch'),
        '#options' => $options,
        '#chosen' => TRUE,
        '#resquired' => TRUE,
    );
    if (!empty($caches['tran_kind'])) {
        $form['tran_kind']['#default_value'] = $caches['tran_kind'];
    }
    $form['PNR'] = array(
        '#title' => t('PNR'),
        '#type' => 'textfield',
        '#size' => 60,
        '#maxlength' => 128,
        '#resquired' => TRUE,
    );
    if (!empty($caches['PNR'])) {
        $form['PNR']['#default_value'] = $caches['PNR'];
    }
    $query = db_select("users", "tbl_user");
    $query->fields("tbl_user");
    $query->join("users_roles", "tbl_role", "tbl_role.uid = tbl_user.uid");
    $query->condition("tbl_role.rid", 4);
    $query->leftJoin("field_data_field_account_sale", "tbl_sale", "tbl_sale.entity_id = tbl_user.uid");
    $result = $query->execute()->fetchAll();
    $options = array();
    $options['all'] = "Chọn Đại lý";
    if (!empty($result)) {
        foreach ($result as $value) {
            $agent = user_load($value->uid);
            $transaction_name = !empty($agent->field_account_transaction_name['und'][0]['value']) ? $agent->field_account_transaction_name['und'][0]['value'] : "";
            $account_code = !empty($agent->field_account_code['und'][0]['value']) ? $agent->field_account_code['und'][0]['value'] : "";
            $options[$value->uid] = $account_code . " - " . $transaction_name;
        }
    }
    $form['agent'] = array(
        '#type' => 'select',
        '#title' => t('Đại lý'),
        '#options' => $options,
        '#chosen' => TRUE,
    );
    if (!empty($caches['agent'])) {
        $form['agent']['#default_value'] = $caches['agent'];
    }
    $form['submit'] = array(
        '#type' => 'submit',
        '#value' => t('Lọc'),
//        '#prefix' => '<div class="buttons">',
//        '#suffix' => '<span class="btn btn-default btn-close-modal">Đóng</span></div>',
    );
    return $form;
}

