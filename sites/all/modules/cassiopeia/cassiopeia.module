function cassiopeia_verify_flight($data)
{
    global $language;
    global $user;
    $obj = new stdClass();
    $obj->ListFareData[] = array(
        "Session" => $data['Session'],
        "FareDataId" => $data['FareDataId'],
        "ListFlight" => $data['ListFlight'],
        "AutoIssue" => false,
    );
    try {
        db_insert("tbl_log")->fields(array(
            "created" => REQUEST_TIME,
            "uid" => $user->uid,
            "request_url" => "http://platform.datacom.vn/flights/verifyflight",
            "postfields" => serialize($obj),
        ))->execute();
    } catch (Exception $e) {

    }
    $obj->HeaderUser = HEADERUSER;
    $obj->HeaderPass = HEADERPASS;
    $obj->Language = $language->language;
    $obj->AgentAccount = AGENTACCOUNT;
    $obj->AgentPassword = AGENTPASSWORD;
//    print_r($obj);
//    die;
    $curl = curl_init();
    curl_setopt_array($curl, array(
        CURLOPT_URL => "http://platform.datacom.vn/flights/verifyflight",
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_ENCODING => "",
        CURLOPT_MAXREDIRS => 10,
        CURLOPT_TIMEOUT => 0,
        CURLOPT_FOLLOWLOCATION => true,
        CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
        CURLOPT_CUSTOMREQUEST => "POST",
        CURLOPT_POSTFIELDS => json_encode($obj),
        CURLOPT_HTTPHEADER => array(
            "Content-Type: application/json"
        ),
    ));
    $response = curl_exec($curl);
    curl_close($curl);
    return $response;
}

function cassiopeia_maybay_void($PNRCode)
{
    $curl = curl_init();

    curl_setopt_array($curl, array(
        CURLOPT_URL => "http://data.webvemaybay.com/AirDataWS.asmx?op=Sab_VoidPNR",
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_ENCODING => "",
        CURLOPT_MAXREDIRS => 10,
        CURLOPT_TIMEOUT => 0,
        CURLOPT_FOLLOWLOCATION => true,
        CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
        CURLOPT_CUSTOMREQUEST => "POST",
        CURLOPT_POSTFIELDS => "
        <x:Envelope xmlns:x=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:tem=\"http://tempuri.org/\">
            <x:Header>
                <tem:Authentication>
                   <tem:HeaderUser>" . HEADERUSER . "</tem:HeaderUser>
                    <tem:HeaderPassword>" . HEADERPASS . "</tem:HeaderPassword>
                </tem:Authentication>
            </x:Header>
            <x:Body>
                <tem:Sab_VoidPNR>
                   <tem:Email>" . AGENTACCOUNT . "</tem:Email>
                    <tem:Password>" . AGENTPASSWORD . "</tem:Password>
                    <tem:PNRCode>" . $PNRCode . "</tem:PNRCode>
                </tem:Sab_VoidPNR>
            </x:Body>
        </x:Envelope>",
        CURLOPT_HTTPHEADER => array(
            "Content-Type: text/xml; charset=utf-8"
        ),
    ));

    $response = curl_exec($curl);

    curl_close($curl);
    return convert_xml_to_array($response)['soapBody']['Sab_VoidPNRResponse']['Sab_VoidPNRResult'];
}

function cassiopeia_maybay_api_GetFareInMonth($data)
{
//    die;
    global $user;
    $curl = curl_init();

    curl_setopt_array($curl, array(
        CURLOPT_URL => "http://data.webvemaybay.com/AirDataWS.asmx?op=DOM_GetFareInMonth",
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_ENCODING => "",
        CURLOPT_MAXREDIRS => 10,
        CURLOPT_TIMEOUT => 0,
        CURLOPT_FOLLOWLOCATION => true,
        CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
        CURLOPT_CUSTOMREQUEST => "POST",
        CURLOPT_POSTFIELDS => "
        <x:Envelope xmlns:x=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:tem=\"http://tempuri.org/\">
            <x:Header>
                <tem:Authentication>
                    <tem:HeaderUser>" . HEADERUSER . "</tem:HeaderUser>
