function vn_to_str($str)
{

    $unicode = array(

        'a' => 'á|à|ả|ã|ạ|ă|ắ|ặ|ằ|ẳ|ẵ|â|ấ|ầ|ẩ|ẫ|ậ',

        'd' => 'đ',

        'e' => 'é|è|ẻ|ẽ|ẹ|ê|ế|ề|ể|ễ|ệ',

        'i' => 'í|ì|ỉ|ĩ|ị',

        'o' => 'ó|ò|ỏ|õ|ọ|ô|ố|ồ|ổ|ỗ|ộ|ơ|ớ|ờ|ở|ỡ|ợ',

        'u' => 'ú|ù|ủ|ũ|ụ|ư|ứ|ừ|ử|ữ|ự',

        'y' => 'ý|ỳ|ỷ|ỹ|ỵ',

        'A' => 'Á|À|Ả|Ã|Ạ|Ă|Ắ|Ặ|Ằ|Ẳ|Ẵ|Â|Ấ|Ầ|Ẩ|Ẫ|Ậ',

        'D' => 'Đ',

        'E' => 'É|È|Ẻ|Ẽ|Ẹ|Ê|Ế|Ề|Ể|Ễ|Ệ',

        'I' => 'Í|Ì|Ỉ|Ĩ|Ị',

        'O' => 'Ó|Ò|Ỏ|Õ|Ọ|Ô|Ố|Ồ|Ổ|Ỗ|Ộ|Ơ|Ớ|Ờ|Ở|Ỡ|Ợ',

        'U' => 'Ú|Ù|Ủ|Ũ|Ụ|Ư|Ứ|Ừ|Ử|Ữ|Ự',

        'Y' => 'Ý|Ỳ|Ỷ|Ỹ|Ỵ',

    );

    foreach ($unicode as $nonUnicode => $uni) {

        $str = preg_replace("/($uni)/i", $nonUnicode, $str);

    }
//    $str = str_replace(' ','_',$str);
    $str = strtoupper($str);
    return $str;

}

function cassiopeia_booking_issue_complete($booking_code, $report_note)
{
    global $user;
    try {
        $query = db_select("tbl_issue_report", "tbl_issue_report");
        $query->fields("tbl_issue_report");
        $query->condition("booking_code", $booking_code);
        $check = $query->execute()->fetchAll();
    } catch (Exception $e) {
        print_r($e);
    }
    if (!empty($check)) {
        drupal_set_message("Đơn hàng đã được xử lý!");
        drupal_goto("/");
    }
    $query = db_select("tbl_booking", "tbl_booking");
    $query->fields("tbl_booking");
    $query->condition("booking_code", $booking_code);
    $result = $query->execute()->fetchObject();
    $books = unserialize($result->booking);
    $flag = true;
    $data = new stdClass();
    $obj = new stdClass();
    $ticket = new stdClass();
    $ticket->Index = 0;
    $ticket->Airline = "VN";
    $ticket->TicketNumber = "ticket1";
    $ticket->IssueDate = strtotime("2019-04-10T09:05:28.571Z");
    $ticket->BookingCode = "MXKFF";
    $ticket->PassengerName = "NGUYEN HUU TRUNG";
    $ticket->BookingFile = "string";
    $ticket->TicketImage = "string";
    $ticket->TotalPrice = 115000;
    $ticket->Status = "OPEN";
    $ticket->ErrorMessage = 0;
    $obj->ListTicket[] = $ticket;
    $obj->BookingImage = "url";
    $obj->Status = true;
    $obj->ErrorCode = "error";
    $obj->Message = "message";
    foreach ($books as $booking) {
        $TotalNetPrice = 0;
        $TotalFullPrice = 0;
        $BookingFee = 0;
        $booking = json_decode($booking)->ListBooking[0];
        _print_r($booking);
        $TotalNetPrice += $booking->FareData->TotalPrice;
        $endpoint = cassiopeia_get_airport($booking->FareData->ListFlight[0]->EndPoint);
        if ($endpoint->country_code == "VN") {
            $region_code = "DO";
        } else {
            $region_code = $endpoint->region_code;
        }
        $BookingFee = cassiopeia_get_fee_by_airline_and_region($booking->Airline, $region_code)['value'];
        $BookingFee = ($booking->FareData->Adt + $booking->FareData->Chd) * $BookingFee;
        $TotalFullPrice = $TotalNetPrice + $BookingFee;
        $data->Airline = $booking->Airline;
        $data->BookingCode = $booking->BookingCode;
//    $issue = cassiopeia_issue_flight($data); // xuất vé
        if ($obj->Status == false) {
            $flag = false;
            drupal_set_message("Vé " . $booking->BookingCode . " xuất lỗi, vui lòng liên hệ với bộ phận Booker để được hỗ trợ!");
        } else { //xuất vé thành công
            $transaction = db_transaction();
            try {
                $query = db_select("tbl_issue_report", "tbl_issue_report");
                $query->fields("tbl_issue_report");
                $query->range(0, 1);
                $query->orderBy("id", "DESC");
                $last = $query->execute()->fetchAssoc();
                if (!empty($last)) {
                    $temp = str_replace("ISSUE_", "", $last['tran_code']);
                    $tran_code = "ISSUE_" . ($temp + 1);
                } else {
                    $tran_code = "ISSUE_" . date("m", REQUEST_TIME) . "0002";
                }


                $query = db_select("tbl_agent_fee", "tbl_agent_fee");
                $query->fields("tbl_agent_fee");
                $query->condition("airline", $booking->Airline);
                $query->condition("region", $region_code);
                $query->condition("agent_id", $user->uid);
                $agent_fee = $query->execute()->fetchObject();
                if (!empty($agent_fee)) {

                } else {
                    $query = db_select("tbl_agent_fee", "tbl_agent_fee");
                    $query->fields("tbl_agent_fee");
                    $query->condition("airline", $booking->Airline);
                    $query->condition("region", $region_code);
                    $agent_fee = $query->execute()->fetchObject();
                }
                if (!empty($agent_fee)) {
                    $rate = $agent_fee->value;
                } else {
                    $rate = 0;
                }
                $_agent = user_load(55);
                $balance = !empty($_agent->field_account_balance['und'][0]['value']) ? $_agent->field_account_balance['und'][0]['value'] : 0;
                $rate = ($booking->FareData->Adt + $booking->FareData->Chd) * $rate;
                db_insert("tbl_issue_report")->fields(array(
                    "booking_code" => $booking_code,
                    "created" => REQUEST_TIME,
                    "tran_code" => $tran_code,
                    "airline" => $booking->Airline,
                    "tran_kind" => 4,
                    "PNR" => $booking->BookingCode,
                    "quantity" => $booking->FareData->Adt + $booking->FareData->Chd + $booking->FareData->Inf,
                    "partner_price" => $TotalFullPrice - $rate,
                    "price" => $TotalNetPrice,
                    "revenue" => $BookingFee - $rate,
                    "agent" => 55,
                    "content" => $report_note,
                    "tran_user" => $user->uid,
                    "balance" => $balance,
                ))
                    ->execute();
                db_insert("tbl_report")->fields(array(
                    "created" => REQUEST_TIME,
                    "type" => "issue",
                    "tran_code" => $tran_code,
                ))
                    ->execute();
                db_insert("tbl_issue")->fields(array(
                    "booking_code" => $booking_code,
                    "pnr_code" => $booking->BookingCode,
                    "status" => 0,
                    "error_code" => $obj->ErrorCode,
                    "message" => $obj->Message,
                    "booking_image" => $obj->BookingImage,
                    "created" => REQUEST_TIME,
                    "booker" => $user->uid,
                ))->execute();
                foreach ($obj->ListTicket as $item) {
                    db_insert("tbl_issue_detail")->fields(array(
                        "pnr_code" => $booking->BookingCode,
                        "_index" => 0,
                        "airline" => $item->Airline,
                        "ticket_number" => $item->TicketNumber,
                        "issue_date" => $item->IssueDate,
                        "passenger_name" => $item->PassengerName,
                        "booking_file" => $item->BookingFile,
                        "ticket_image" => $item->TicketImage,
                        "total_price" => $item->TotalPrice,
                        "status" => $item->Status,
                        "error_message" => $item->ErrorMessage,
                    ))->execute();
                }
            } catch (Exception $e) {
                $transaction->rollback();
            }
        }

    }
    drupal_goto("/booking/view/" . $booking_code);
}

