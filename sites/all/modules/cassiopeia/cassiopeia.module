/**
 * Implements hook_menu_alter().
 */
function cassiopeia_menu_alter(&$items)
{
//  $items['taxonomy/term/%taxonomy_term']['module'] = 'cassiopeia';
    $items['taxonomy/term/%taxonomy_term']['page callback'] = '_cassiopeia_tvi_render_term_view';
    $items['taxonomy/term/%taxonomy_term']['page arguments'] = array(2);
    $items['taxonomy/term/%taxonomy_term/edit']['theme callback'] = '_cassiopeia_switch_theme_';
//    $items['taxonomy/term/%taxonomy_term/edit']['access callback'] = '_cassiopeia_term_edit_access';

    $items['node/%node']['page callback'] = '_cassiopeia_node_render_view';
    $items['node/%node']['page arguments'] = array(1);
    $items['node/%node/edit']['access callback'] = '_cassiopeia_node_access';
    $items['node/%node/edit']['theme callback'] = '_cassiopeia_admin_theme_white';
    $items['node/%node/delete']['access callback'] = '_cassiopeia_node_access';
    $items['node/%node/delete']['theme callback'] = '_cassiopeia_admin_theme_white';

    $items['node/%node/clone/%clone_token']['access callback'] = '_cassiopeia_clone_node_access';
    $items['node/%node/clone/%clone_token']['theme callback'] = '_cassiopeia_admin_theme_white';


    foreach (node_type_get_types() as $type) {
        $type_url_str = str_replace('_', '-', $type->type);
        $items['node/add/' . $type_url_str]['access callback'] = '_cassiopeia_node_access';
        $items['node/add/' . $type_url_str]['theme callback'] = '_cassiopeia_admin_theme_white';
    }
}
function _cassiopeia_admin_theme_white(){
    return "cassiopeia_admin_theme_white";
}
function _cassiopeia_term_edit_access($term, $taxonomy_term = null, $account = NULL) {
    $arg = arg();
    $type = is_object($term) ? $term->vocabulary_machine_name : $term;
    if ($type == 'tx_area') {
        return cassiopeia_check_permission("cassiopeia_user_permission_hotel_tx_area","p_edit");
    }
    if ($type == 'tx_hotel') {
        return cassiopeia_check_permission("cassiopeia_user_permission_tx_hotel","p_edit");
    }
}
function _cassiopeia_clone_node_access($node,$b,$option){
    $access = false;
    $type = is_object($node) ? $node->type : $node;
    if ($type == 'hotel') {
        return cassiopeia_check_permission("cassiopeia_user_permission_hotel","p_edit");
    }
    if ($type == 'room') {
        return cassiopeia_check_permission("cassiopeia_user_permission_room","p_edit");
    }
    return $access;
}
function _cassiopeia_node_access($op, $node = null, $account = NULL) {
    if (empty($account)) {
        $account = $GLOBALS['user'];
    }
    $access = node_access($op, $node, $account);
    $type = is_object($node) ? $node->type : $node;
    if ($type == 'article') {
        switch ($op) {
            case 'create':
                return cassiopeia_user_article_add_access();
                break;
            case 'update':
                return cassiopeia_user_article_edit_access();
                break;
            case 'delete':
                return cassiopeia_user_article_delete_access();
                break;
        }
    }
    return $access;
}
