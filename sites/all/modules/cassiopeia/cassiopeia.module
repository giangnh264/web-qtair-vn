function cassiopeia_baggage_form_submit($form, &$form_state)
{
    if (empty($form_state['values']['id'])) {
        try {
            $check = db_select("tbl_bagage", "tbl_bagage");
            $check->fields("tbl_bagage");
            $check->condition("airline", $form_state['values']['airline']);
            $check->condition("weight", $form_state['values']['weight']);
            $result = $check->execute()->fetchAll();
            if (!empty($result)) {
                drupal_set_message("Dữ liệu đã tồn tại!");
            } else {
                $query = db_insert("tbl_bagage")->fields(array(
                    "created" => REQUEST_TIME,
                    "airline" => $form_state['values']['airline'],
                    "weight" => trim($form_state['values']['weight']),
                    "amount" => $form_state['values']['price'],
                ))->execute();
            }
//          _print_r($query);
        } catch (Exception $E) {
//            _print_r($E);
        }
    } else {
        try {
            db_update("tbl_bagage")->fields(array(
                "airline" => $form_state['values']['airline'],
                "weight" => $form_state['values']['weight'],
                "amount" => $form_state['values']['price'],
            ))->condition("id", $form_state['values']['id'])->execute();
        } catch (Exception $e) {

        }
    }
//    die;
}

function cassiopeia_ticket_price_add_form($form, &$form_state)
{
    $form = array();
    $query = db_select("tbl_airline_", "tbl_airline_");
    $query->fields("tbl_airline_");
    $result_airlines = $query->execute()->fetchAll();
    $airlines = array();
    if (!empty($result_airlines)) {
        foreach ($result_airlines as $item) {
            $airlines[$item->code] = $item->name;
        }
    }
    $query = db_select("tbl_region", "tbl_region");
    $query->fields("tbl_region");
    $result = $query->execute()->fetchAll();
    $regions = array();
    if (!empty($result)) {
        foreach ($result as $item) {
            $regions[$item->code] = $item->name;
        }
    }
    $form['airline'] = array(
        '#type' => 'select',
        '#title' => t('Hãng'),
        '#options' => $airlines,
    );
    $form['region'] = array(
        '#type' => 'select',
        '#title' => t('Khu vực'),
        '#options' => $regions,
    );
    $form['price'] = array(
        '#type' => 'textfield',
        '#title' => t('Phí Dịch Vụ'),
        '#required' => TRUE,
    );
    $form['id'] = array(
        '#type' => 'textfield',
        '#title' => t(''),
        '#attributes' => array("class" => array("hidden")),
    );
    $form['submit'] = array(
        '#type' => 'submit',
        '#value' => 'Tạo',
        '#attributes' => array("class" => array("btn btn-primary")),
    );
    return $form;
}

function cassiopeia_ticket_price_add_form_submit($form, &$form_state)
{
    try {
//        print_r($form_state['values']);
//        die;
        if (!empty($form_state['values']['id'])) {
            db_update("tbl_price_board")->fields(array(
                "airline" => $form_state['values']['airline'],
                "region" => $form_state['values']['region'],
                "value" => $form_state['values']['price'],
                "type" => $form_state['values']['airline'],
            ))->condition("id", $form_state['values']['id'])->execute();
            drupal_set_message("Cập nhật thành công!");
        } else {
            $query = db_select("tbl_price_board", "tbl_price_board");
            $query->fields("tbl_price_board");
            $query->condition("airline", $form_state['values']['airline']);
            $query->condition("region", $form_state['values']['region']);
            $check = $query->execute()->fetchAssoc();
            if ($check) {
                drupal_set_message("Phí cho hành trình này đã được cài đặt!");
            } else {
                db_insert("tbl_price_board")->fields(array(
                    "airline" => $form_state['values']['airline'],
                    "region" => $form_state['values']['region'],
                    "value" => $form_state['values']['price'],
                    "type" => $form_state['values']['airline'],
                ))->execute();
                drupal_set_message("Thêm mới thành công!");
            }
        }
    } catch (Exception $e) {

    }
}

