function _cassiopeia_node_render_view($node)
{
    global $user;
    if (is_object($node)) {
        $nid = $node->nid;
    } else {
        $node = node_load($node);
    }
    if (module_exists('metatag')) {
        metatag_entity_view($node, 'node', 'full', NULL);
    }
    if ($node->type == 'article') {
        return _cassiopeia_render_theme('module', 'cassiopeia', 'templates/nodes/node-article-detail.tpl.php', array('node' => $node));
    }
    if ($node->type == 'ticket_article') {
        return _cassiopeia_render_theme('module', 'cassiopeia', 'templates/pages/page-ticket-article-detail.tpl.php', array('node' => $node));
    }
    if ($node->type == 'autic_family_article') {
        return _cassiopeia_render_theme('module', 'cassiopeia', 'templates/pages/page-promotion-article-detail.tpl.php', array('node' => $node));
    }
    if ($node->type == 'page') {
        return _cassiopeia_render_theme('module', 'cassiopeia', 'templates/nodes/node-page-detail.tpl.php', array('node' => $node));
    }
    if ($node->type == 'handbook') {
        return _cassiopeia_render_theme("module", "cassiopeia", "templates/terms/page-tx-handbook.tpl.php", array("node" => $node));
    }
    if ($node->type == 'autic_family') {
        return _cassiopeia_render_theme("module", "cassiopeia", "templates/pages/page-autic-family.tpl.php", array("node" => $node));
    }
    if ($node->type == 'hotel') {
        return _cassiopeia_render_theme("module", "cassiopeia", "templates/nodes/node-hotel-detail.tpl.php", array("node" => $node));
    }
    if ($node->type == 'agent_profession') {
        return _cassiopeia_render_theme("module", "cassiopeia", "templates/nodes/node-agent-profession-detail.tpl.php", array("node" => $node));
    }
    if ($node->type == 'home_config') {
        drupal_goto("node/2623/edit");
    }
//
    return node_page_view($node);
}


function _cassiopeia_tvi_render_term_view($term, $depth = NULL)
{
//    print_r($term);
    if (is_object($term)) {
        $tid = $term->tid;
    } else {
        $term = taxonomy_term_load($term);
    }
    if (module_exists('metatag')) {
        metatag_entity_view($term, 'taxonomy_term', 'full', NULL);
    }
    if ($term->vocabulary_machine_name == 'tx_article') {
        return _cassiopeia_render_theme('module', 'cassiopeia', 'templates/terms/page-tx-article.tpl.php', array('term' => $term));
    }
    if ($term->vocabulary_machine_name == 'tx_ticket_article') {
        return _cassiopeia_render_theme('module', 'cassiopeia', 'templates/terms/page-tx-ticket-article.tpl.php', array('term' => $term));
    }
    if ($term->vocabulary_machine_name == 'tx_promotion_article') {
        return _cassiopeia_render_theme('module', 'cassiopeia', 'templates/terms/page-tx-promotion-article.tpl.php', array('term' => $term));
    }
    if ($term->vocabulary_machine_name == 'tx_area') {
        return _cassiopeia_render_theme("module","cassiopeia","templates/pages/page-hotel-search.tpl.php",array("term"=>$term));
    }
    if ($term->vocabulary_machine_name == 'tx_autic_family') {
        return _cassiopeia_render_theme("module","cassiopeia","templates/terms/tx_autic_family.tpl.php",array("term"=>$term));
    }
    if ($term->vocabulary_machine_name == 'tx_agent_profession') {
        return _cassiopeia_render_theme("module","cassiopeia","templates/terms/tx-agent-profession.tpl.php",array("term"=>$term));
    }


    module_load_include('inc', 'taxonomy', 'taxonomy.pages');
    return taxonomy_term_page($term);
}


