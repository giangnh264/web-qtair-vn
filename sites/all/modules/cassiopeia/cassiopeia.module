function cassiopeia_room_price_import_validate(&$form, &$form_state)
{
    $validators = array(
        'file_validate_extensions' => array('xls, xlsx'),
    );
    if ($file = file_save_upload('excell_file', $validators, "public://", FILE_EXISTS_REPLACE)) {
        $form_state['values']['excell_file'] = $file;
    } else {
        form_set_error('excell_file', 'Kiểm tra lại file upload, chi chấp nhận file .xls');
    }

}
function cassiopeia_point_report_export_callback(){
    global $user;
    include  drupal_get_path('module','cassiopeia')."/phpspreadsheet.inc";
    $caches = array();
    $arg = arg();
    $caches['sale'] = !empty($arg[3])?$arg[3]:null;
    $caches['status'] = !empty($arg[4])?$arg[4]:'all';
    $caches['date_filter'] = "all";
    if(!empty($_REQUEST['data'])){
        $caches = $_REQUEST['data'];
        if(!empty($caches['uncheck'][1]) && $caches['uncheck'][1]==1){
            $caches = array();
        }
    }
    if(empty($caches['month'])){
        $caches['month'] = date("m",REQUEST_TIME);
    }
    if(empty($caches['year'])){
        $caches['year'] = date("Y",REQUEST_TIME);
    }
    if(!empty($arg[5])){
        $caches['date_filter'] = "other";
        $caches['from_date'] = (date('Y-m-01 00:00',strtotime("01-".$arg[5])));
        $caches['to_date'] = (date("Y-m-t 23:59",strtotime("01-".$arg[5])));
    }
    try{
        $query = db_select("users","tbl_user");
        $query -> fields("tbl_user");
        $query -> orderBy("tbl_user.created","DESC");
        $query -> join("users_roles","tbl_role","tbl_role.uid = tbl_user.uid");
        $query -> condition("tbl_role.rid",4);
        $query -> leftJoin("field_data_field_account_sale","tbl_sale","tbl_sale.entity_id = tbl_user.uid");
        $query -> leftJoin("field_data_field_account_code","field_account_code","field_account_code.entity_id = tbl_user.uid");
        $query -> leftJoin("field_data_field_account_transaction_name","field_account_transaction_name","field_account_transaction_name.entity_id = tbl_user.uid");
        $query -> leftJoin("field_data_field_account_full_name","field_account_full_name","field_account_full_name.entity_id = tbl_user.uid");
        $query -> leftJoin("field_data_field_account_status","field_account_status","field_account_status.entity_id = tbl_user.uid");
        $query -> leftJoin("field_data_field_account_updated_date","field_account_updated_date","field_account_updated_date.entity_id = tbl_user.uid");
        $query -> leftJoin("field_data_field_account_source","field_account_source","field_account_source.entity_id = tbl_user.uid");
        $query->addField("field_account_source","field_account_source_value","field_account_source_value");
        if(!empty($caches['agent'])&&$caches['agent']!="all"){
            $query -> condition("tbl_user.uid",$caches['agent']);
        }
        if($theme=="cassiopeia_theme"){
            $query -> condition("tbl_user.uid",$user->uid);
        }
        $query->orderBy("field_account_updated_date.field_account_updated_date_value","DESC");

        $result  = $query -> execute() -> fetchAll();

        $sub = db_select("users_roles","tbl_role");
        $sub->fields("tbl_role");
        $sub->condition("rid",5);
        $role = $sub->execute()->fetchObject();
        $query = db_select("users","tbl_user");
        $query -> fields("tbl_user");
        $query -> join("users_roles","tbl_role","tbl_role.uid = tbl_user.uid");
        $query -> condition("tbl_role.rid",$role->rid);
        $query -> leftJoin("field_data_field_account_code","field_account_code","field_account_code.entity_id = tbl_user.uid");
        $query -> leftJoin("field_data_field_account_transaction_name","field_account_transaction_name","field_account_transaction_name.entity_id = tbl_user.uid");
        $query->addField("field_account_transaction_name","field_account_transaction_name_value","field_account_transaction_name");
        $sales = $query->execute()->fetchAll();


        $worksheets = array();
        $worksheet = array('title' => 'Báo cáo tích điểm','data'=>array(), 'merge_cells'=> array());
        $worksheet['data'][] = array(
            mb_convert_encoding('Mã đại lý' ,  "UTF-8"),
            mb_convert_encoding('Tên giao dịch' ,  "UTF-8"),
            mb_convert_encoding('Họ tên' ,  "UTF-8"),
            mb_convert_encoding('Ngày tạo' ,  "UTF-8"),
            mb_convert_encoding('Số điện thoại' ,  "UTF-8"),
            mb_convert_encoding('Email' ,  "UTF-8"),
            mb_convert_encoding('Sale' ,  "UTF-8"),
            mb_convert_encoding('Loại đại lý' ,  "UTF-8"),
            mb_convert_encoding('Tích điểm tháng' ,  "UTF-8"),
        );
        if(!empty($result)){
            foreach($result as $item){
                $_partner = user_load($item->uid);
                $field_account_code = !empty($_partner->field_account_code['und'][0]['value'])?($_partner->field_account_code['und'][0]['value']):"";
                $field_account_transaction_name = !empty($_partner->field_account_transaction_name['und'][0]['value'])?($_partner->field_account_transaction_name['und'][0]['value']):"";
                $field_account_full_name = !empty($_partner->field_account_full_name['und'][0]['value'])?($_partner->field_account_full_name['und'][0]['value']):"";
                $sale_field_account_transaction_name = "";
                if(!empty($_partner->field_account_sale['und'])){
                    $sale = user_load($_partner->field_account_sale['und'][0]['target_id']);
                    if(!empty($sale->field_account_transaction_name['und'])) $sale_field_account_transaction_name = ($sale->field_account_transaction_name['und'][0]['value']);
                };
                $tx_rank = !empty($_partner->field_tx_rank['und'][0]['tid'])?taxonomy_term_load($_partner->field_tx_rank['und'][0]['tid']):null;
                $tx_rank_name = !empty($tx_rank)?$tx_rank->name:"";
                try{
                    $query = db_select("tbl_issue_report","tbl_issue_report");
                    $query->fields("tbl_issue_report");
                    $query->condition("agent",$_partner->uid);
                    $query->condition("tbl_issue_report.date", [
                        strtotime(date("01-m-Y 00:00:00", strtotime("01-".$caches['month']."-".$caches['year']))),
                        strtotime(date("t-m-Y 23:59:59", strtotime("01-".$caches['month']."-".$caches['year']))),
                    ], "BETWEEN");
                    $query->addExpression("SUM(tbl_issue_report.partner_price)", "total_price");
                    $ticket_result = $query->execute()->fetchObject();

                    $query = db_select("tbl_room_booking_report","tbl_room_booking_report");
                    $query->fields("tbl_room_booking_report");
                    $query->condition("agent",$_partner->uid);
                    $query->condition("tbl_room_booking_report.created", [
                        strtotime(date("01-m-Y", REQUEST_TIME)),
                        strtotime(date("t-m-Y", REQUEST_TIME)),
                    ], "BETWEEN");
                    $query->addExpression("SUM(tbl_room_booking_report.partner_price)", "total_price");
                    $room_result = $query->execute()->fetchObject();
                    $total_revenue = !empty($ticket_result)?$ticket_result->total_price:0;
                    $total_revenue += !empty($room_result)?$room_result->total_price:0;
                    $Point = floor($total_revenue / 1000000);
//                    echo number_format($Point,0,",",".");
                }catch (Exception $e){

                }
                $worksheet['data'][] = array(
                    mb_convert_encoding($field_account_code ,  "UTF-8"),
                    mb_convert_encoding($field_account_transaction_name ,  "UTF-8"),
                    mb_convert_encoding($field_account_full_name ,  "UTF-8"),
                    mb_convert_encoding(date("d/m/Y",$_partner->created) ,  "UTF-8"),
                    mb_convert_encoding($_partner->name ,  "UTF-8"),
                    mb_convert_encoding(strtolower($_partner->mail) ,  "UTF-8"),
                    mb_convert_encoding($sale_field_account_transaction_name ,  "UTF-8"),
                    mb_convert_encoding($tx_rank_name ,  "UTF-8"),
                    mb_convert_encoding(number_format($Point,0,",",".") ,  "UTF-8"),
                );
            }
            $worksheets[]=$worksheet;
            phpspreadsheet_export($worksheets, 'file_'.date('d_m_Y',REQUEST_TIME));
        }
    }catch (Exception $e){
        print_r($e);
    }
}
function cassiopeia_room_price_import_submit(&$form, &$form_state)
{
    include  drupal_get_path('module','cassiopeia')."/phpspreadsheet.inc";
    $data = phpspreadsheet_import(drupal_realpath($form_state['values']['excell_file']->destination), false, true, false);
//    $EXCEL_COLUMN = unserialize(EXCEL_COLUMN);

    $operations = array();
    if (!empty($data['data'])) {
        $data_import = array_values($data['data']);
        if (!empty($data_import)) {
            try {
                foreach ($data_import as $key => $value) {
                    if ($key == 0) {
                        continue;
                    }
                    if (!empty($value[0])&&is_numeric($value[0])&&!empty($value[3])&&!empty($value[4])&&!empty($value[5])) {
                        $result[] = array(
                            "created" => REQUEST_TIME,
                            "nid" => $value[0],
                            "from_date" => strtotime(str_replace("/", "-", $value[3])),
                            "to_date" => strtotime(str_replace("/", "-", $value[4])),
                            "price" => (int)$value[5],
                            "original_price" => (int)$value[6],
                            "weekend" => (int)$value[7],
                            "extra_bed" => (int)$value[8],
                            "adult" => (int)$value[9],
                            "children" => (int)$value[10],
                            "infant" => (int)$value[11],
                        );
                    }

                }
            } catch (Exception $e) {
                _print_r($e);
                die;
            }
            if(!empty($result)){
                foreach(array_chunk($result,100) as $items){
                    $operations[] = array(
                        '_batch_cassiopeia_room_price_import',
                        array(
                            'items'=> $items
                        ),
                    );
                }
                if (!empty($operations)) {
                    $batch = array(
                        'title' => 'Cập nhật số dư đại lý',
                        'operations' => $operations,
                        'progress_message' => t('Import @current of @total.'),
                        'error_message' => t('Error!'),
                        'finished' => '_batch_cassiopeia_room_price_import_finished',
                    );
                    batch_set($batch);
                }
            }
        }
    }
}
function _batch_cassiopeia_room_price_import($items, &$context){
    global $user;
    try{
        $query = db_insert("cassiopeia_room_room_price")->fields(array("uid","created","changed","nid","from_date","to_date","adult","children","infant","extra_bed","weekend","original_price","price"));
        foreach($items as $item){
            $room_price = new stdClass();
            $room_price->uid = $user->uid;
            $room_price->changed = REQUEST_TIME;
            $room_price->created = REQUEST_TIME;
            $room_price->nid = $item['nid'];
            $room_price->from_date = $item['from_date'];
            $room_price->to_date = $item['to_date'];
            $room_price->adult = !empty($item['adult'])?$item['adult']:0;
            $room_price->children = !empty($item['children'])?$item['children']:0;
            $room_price->infant = !empty($item['adult'])?$item['infant']:0;
            $room_price->extra_bed = !empty($item['extra_bed'])?$item['extra_bed']:0;
            $room_price->weekend = !empty($item['weekend'])?$item['weekend']:0;
            $room_price->price = !empty($item['price'])?$item['price']:0;
            $room_price->original_price = !empty($item['original_price'])?$item['original_price']:$room_price->price;
            $query->values((array)$room_price);
        }
        $query->execute();
    }catch (Exception $e){

    }
}
function _batch_cassiopeia_room_price_import_finished($success, $results, $operations) {
    drupal_set_message('Import successful.');
}
function cassipeia_airport_region_import($form, $form_state)
{
    $form['excell_file'] = array(
        '#title' => 'Excel file',
        '#type' => 'file',
        '#description' => ($max_size = parse_size(ini_get('upload_max_filesize'))) ? t('Due to server restrictions, the <strong>maximum upload file size is !max_size</strong>. Files that exceed this size will be disregarded.', array('!max_size' => format_size($max_size))) : '',
    );

    $form['submit'] = array(
        '#type' => 'submit',
        '#value' => t('Import'),
    );

    return $form;
}

function cassipeia_airport_region_import_validate(&$form, &$form_state)
{
    $validators = array(
        'file_validate_extensions' => array('xls'),
    );
    if ($file = file_save_upload('excell_file', $validators, "public://", FILE_EXISTS_REPLACE)) {
        $form_state['values']['excell_file'] = $file;
    } else {
        form_set_error('excell_file', 'Kiểm tra lại file upload, chi chấp nhận file .xls');
    }

}

function cassipeia_airport_region_import_submit(&$form, &$form_state)
{
//    print_r($form_state);
//    die;
    module_load_include('inc', 'phpexcel');
    $data_import = phpexcel_import($form_state['values']['excell_file']->destination, FALSE);
//    print_r($data_import[0]);
//    die;
    if (!empty($data_import[1])) {
        $transaction = db_transaction();
        try {
            foreach ($data_import[1] as $key => $value) {
                if ($key === 0) {
                    continue;
                }
                $check_query = db_select("tbl_airports", "tbl_airports");
                $check_query->fields("tbl_airports");
                $check_query->condition("code", $value[0]);
                $check_result = $check_query->execute()->fetchAll();
                if (!empty($check_query)) {
                    if (!empty($value[8])) {
                        db_update("tbl_airports")->fields(array(
                            "region_code" => $value[11],
                        ))->condition("country_code", $value[8])->execute();
                    }
                } else {
                    db_insert("tbl_airports")->fields(array(
                        "code" => $value[1],
                        "name" => $value[2],
                        "name_vi" => $value[3],
                        "icao" => $value[1],
                        "city" => $value[4],
                        "city_vi" => $value[5],
                        "city_code" => $value[6],
                        "country" => $value[7],
                        "country_vi" => $value[8],
                        "country_code" => $value[9],
                        "region" => $value[10],
                        "region_vi" => $value[11],
                        "region_code" => $value[12],
                    ))->execute();
                }
            }
        } catch (Exception $e) {
            $transaction->rollback();
        }
    }
}

