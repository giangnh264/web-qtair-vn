                    'effect'        => 'fade',
                ),
            );
            if (!empty($standard_people[$index])) {
                $standard = explode("+", $standard_people[$index]);
                $_standard = array();
                foreach ($standard as $person) {
                    if (strpos($person, "NL") != FALSE) {
                        $_standard['adult'] = (int)str_replace("NL", "", $person);
                    }
                    if (strpos($person, "TE") != FALSE) {
                        $_standard['children'] = (int)str_replace("TE", "", $person);
                    }
                    if (strpos($person, "EB") != FALSE) {
                        $_standard['infant'] = (int)str_replace("EB", "", $person);
                    }
                }
            }
            if (!empty($form_state['values']['roomContainer']['roomGroup_' . $index]['adult_' . $index])) {
                $form['roomContainer']['roomGroup_' . $index]['adult_' . $index]['#default_value'] = $form_state['values']['roomContainer']['roomGroup_' . $index]['adult_' . $index];
            } else {
                $form['roomContainer']['roomGroup_' . $index]['adult_' . $index]['#default_value'] = !empty($data->room[$index]['adult']) ? $data->room[$index]['adult'] : $_standard['adult'];
            }
            $form['roomContainer']['roomGroup_' . $index]['children_' . $index] = array(
                '#type'             => 'select',
                '#title'            => t('Số trẻ em'),
                '#options'          => $children_options,
                '#default_value'    => !empty($data->room[$index]['children']) ? $data->room[$index]['children'] : 0,
                '#ajax' => array(
                    'callback'      => 'cassiopeia_booking_room_reload_by_children',
                    'wrapper'       => 'roomContainer',
                ),
            );

            if (!empty($form_state['values']['roomContainer']['roomGroup_' . $index])) {
                if (!empty($form_state['values']['roomContainer']['roomGroup_' . $index])) {
                    if (($form_state['values']['roomContainer']['roomGroup_' . $index]['children_' . $index]) > 0 || !empty($data->room[$index]['children_age'])) {
                        $form['roomContainer']['roomGroup_' . $index]['roomGroupAge_' . $index] = array(
                            '#type'     => 'container',
                            '#prefix'   => '<div id="roomGroupAge_' . $index . '" class="room-group-age"><label>Tuổi của các bé</label>',
                            '#suffix'   => '</div>',
                        );
                    }
                    for ($i = 0; $i < $form_state['values']['roomContainer']['roomGroup_' . $index]['children_' . $index]; $i++) {
                        $form['roomContainer']['roomGroup_' . $index]['roomGroupAge_' . $index]['roomGroupAgeDetail_' . $i] = array(
                            '#type'             => 'select',
                            '#title'            => t(''),
                            '#options'          => $child_age_options,
                            '#default_value'    => !empty($form_state['values']['roomContainer']['roomGroup_' . $index]['roomGroupAge_' . $index]['roomGroupAgeDetail_' . $i]) ? $form_state['values']['roomContainer']['roomGroup_' . $index]['roomGroupAge_' . $index]['roomGroupAgeDetail_' . $i] : 1,
                            '#ajax' => array(
                                'callback'      => 'cassiopeia_booking_room_change_adult_ajax_callback',
                                'wrapper'       => 'orderInformationContainer',
                                'method'        => 'replace',
                                'effect'        => 'fade',
                            ),
                        );
                    }
                }
            } else {
                if (!empty($data->room[$index]['children_age'])) {
                    $form['roomContainer']['roomGroup_' . $index]['roomGroupAge_' . $index] = array(
                        '#type'         => 'container',
                        '#prefix'       => '<div id="roomGroupAge_' . $index . '" class="room-group-age"><label>Tuổi của các bé</label>',
