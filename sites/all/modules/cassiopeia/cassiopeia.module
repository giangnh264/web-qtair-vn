            break;
    }
}

function cassiopeia_get_booking_status($raw_status)
{
    $status = "";
    switch ($raw_status) {
        case "FAIL" :
            $status = t("FAIL");
            break;
        case "OK" :
            $status = t("Reservation");
            break;
        case "PAID" :
            $status = t("Paid");
            break;
        case "HOLD" :
            $status = t("Waiting for ticket issue");
            break;
        case "TICKETED" :
            $status = t("Ticketed");
            break;
        case "TICKET_FAIL" :
            $status = t("Ticket fail");
            break;
        case "CANCELED" :
            $status = t("Canceled");
            break;
        case "EXPIRED" :
            $status = t("Expired");
            break;
    }
    return $status;
}

function cassiopeia_get_room_booking_detail_by_room_code($room_code){
    $query = db_select("tbl_room_booking", "tbl_booking");
    $query->fields("tbl_booking");
    $query->condition("room_code", $room_code, "=");
    $result = $query->execute()->fetchObject();
    return $result;
}
function cassiopeia_get_room_booking_detail_by_code($code){
    $query = db_select("tbl_room_booking", "tbl_booking");
    $query->fields("tbl_booking");
    $query->condition("code", $code, "=");
    $result = $query->execute()->fetchObject();
    return $result;
}
function cassiopeia_get_booking_detail_by_code($code)
{
    $query = db_select("tbl_booking", "tbl_booking");
    $query->fields("tbl_booking");
    $query->condition("booking_code", $code, "=");
    $result = $query->execute()->fetchAssoc();
    return $result;
}

function cassiopeia_render_airline_logo($idata, $img_width = "")
{
  $airline = cassiopeia_airline_load($idata);
  if (!empty($airline->fid)) {
    $logo = file_load($airline->fid);
    if (!empty($logo)) {
      $node_img = (array) $logo;
      $node_img['style_name'] = "style_width_80";
      $node_img['path'] = $node_img['uri'];
      $node_img['alt'] = !empty($node_img['alt']) ? $node_img['alt'] : variable_get("site_name");
      $node_img['title'] = !empty($node_img['title']) ? $node_img['title'] : variable_get("site_name");
      $node_img = theme('image_style', $node_img);
      echo $node_img;
    }
  }
  else {
    if($idata == "9G"){
        $img_width = "64px";
      }else{
        $img_width = "100px";
      }
      $filename = "sm" . $idata . ".png";
      $image_url = image_style_url("style_width_80", "public://" . $filename);
      print("<img src='" . $image_url . "'style='max-width:".$img_width.";'>");
  }
}

function cassiopeia_get_status($status)
{
    $_status = "Đặt chỗ lỗi";
    switch ($status) {
        case "OK" :
            $_status = "Đặt chỗ";
            break;
        case "FAIL" :
            $_status = "Đặt lỗi";
            break;
        case "PAID" :
            $_status = "Đã thanh toán";
            break;
        case "HOLD" :
            $_status = "Chờ xuất vé";
            break;
        case "TICKETED" :
            $_status = "Xuất vé";
            break;
        case "CANCELED" :
            $_status = "Hủy đặt chỗ";
            break;
        case "PENDING" :
            $_status = "Đang xử lý";
            break;
    }
    return $_status;
}

function cassiopeia_mail($key, &$message, $params)
{
//    print($key);die;
    switch ($key) {
        case 'custom_key':
            $message['subject'] = $params['subject'];
            $message['body'] = $params['body'];
            $message['headers'] = $params['headers'];
            break;
        case 'booking_send_ticket':
            $message['subject'] = $params['subject'];
            $message['body'] = $params['body'];
            $message['headers'] = $params['headers'];
            break;
    }

}


