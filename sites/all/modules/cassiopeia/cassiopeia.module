    return $form;
}

function cassiopeia_delete_notify_form_submit($form, &$form_state)
{
    global $user;
    $transaction = db_transaction();
    try {
        if (user_has_role(3)) {
            db_delete("tbl_notify")->condition("id", $form_state['values']['id'])->execute();
        }
    } catch (Exception $e) {

    }
}

