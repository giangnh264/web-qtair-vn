function cassiopeia_count_hotel_form_area($tid)
{
    $query = db_select("node", "tbl_node");
    $query->fields("tbl_node");
    $query->addExpression("COUNT(tbl_node.nid)", "total_count");
    $query->join("field_data_field_tx_area", "field_tx_area", "field_tx_area.entity_id=tbl_node.nid");
    $query->condition("field_tx_area.field_tx_area_tid", $tid);
    $hotel_count = $query->execute()->fetchObject();
    return !empty($hotel_count) ? $hotel_count->total_count : 0;
}

function getMinPriceByHotelByDate($start_date, $end_date, $hid)
{
    $min = null;
    $rooms = cassiopeia_get_rooms_by_hotel($hid);
    if (!empty($rooms)) {
        $nids = array();
        foreach ($rooms as $room) {
            $nids[] = $room->nid;
        }
        for ($i = strtotime($start_date); $i <= strtotime($end_date) - 86400; $i += 86400) {
            $temp = null;
            $query = db_select("tbl_room_price", "tbl_room_price");
            $query->fields("tbl_room_price");
            $query->condition("from_date", $i, "<=");
            $query->condition("to_date", $i, ">=");
            $query->condition("nid", $nids, "IN");
            $query->orderBy("price", "ASC");
            $query->range(0, 1);
            $temp = $query->execute()->fetchObject();
            $dayofweek = date('w', ($i));
            $dayofweek += 1;
            $temp_weekend = null;
            $query = db_select("tbl_weekend_price", "tbl_weekend_price");
            $query->fields("tbl_weekend_price");
            $query->condition("from_date", $i, "<=");
            $query->condition("to_date", $i, ">=");
            $query->condition("hotel", $hid, "=");
            $query->condition("choose", "%" . $dayofweek . "%", "LIKE");
            $temp_weekend = $query->execute()->fetchObject();
            if (!empty($temp_weekend)) {
                $temp->is_weekend = true;
            }
            $result[] = $temp;
        }
        // _print_r(node_load($hid)->title);
        //_print_r($result);

        if (!empty($result)) {
            $min = array_values($result)[0];           
            $value = 0;
            foreach ($result as $item) {
                if ($min->price > $item->price) {
                    $min = $item;
                }
                $value += $item->price;
                if($item->is_weekend){
                    $value += $item->weekend;
                }
            }
            $value = $value/count($result);
            $min->price = $value;
            if (!empty($min)) {
                $room = node_load($min->nid);
                $people = $room->field_people['und'][0]['value'];
                $people = str_replace("NL","",$people);
                $q = db_select("tbl_room_booking_fee", "tbl_room_booking_fee");
                $q->fields("tbl_room_booking_fee");
                $q->condition("tbl_room_booking_fee.people",$people, "<=");
//                $q->condition("tbl_room_booking_fee.to_price", $result->price, ">=");
                $q->orderBy("people", "DESC");
                $q->range(0, 1);
                $fee = $q->execute()->fetchObject();
                if (!empty($fee)) {
                    $min->price += $fee->value;
                }

            }
        }

    }
    return $min;

}

function getMinPriceByHotel($hid)
{
    $result = null;
    try {
        $rooms = cassiopeia_get_rooms_by_hotel($hid);
        if (!empty($rooms)) {
            $nids = array();
            foreach ($rooms as $room) {
                $nids[] = $room->nid;
            }
            $query = db_select("tbl_room_price", "tbl_room_price");
            $query->fields("tbl_room_price");
            $query->condition("nid", $nids, "IN");
            $query->condition("from_date", REQUEST_TIME, ">=");
            $query->orderBy("price", "ASC");
            $query->range(0, 1);
            $result = $query->execute()->fetchObject();


            if (!empty($result)) {
                $room = node_load($result->nid);
                $people = $room->field_people['und'][0]['value'];
                $people = str_replace("NL","",$people);
                $q = db_select("tbl_room_booking_fee", "tbl_room_booking_fee");
                $q->fields("tbl_room_booking_fee");
                $q->condition("tbl_room_booking_fee.people",$people, "<=");
//                $q->condition("tbl_room_booking_fee.to_price", $result->price, ">=");
                $q->orderBy("people", "DESC");
                $q->range(0, 1);
                $fee = $q->execute()->fetchObject();
                if (!empty($fee)) {
                    $result->price += $fee->value;
                }
            }
        }
    } catch (Exception $E) {
        _print_r($E);
    }
    return $result;
}

function getMinPriceByHotelRoomByDate($start_date, $end_date, $nid,$hid)
{
    $min = null;
    $room = node_load($nid);
    $hotel = node_load($hid);
    for ($i = strtotime($start_date); $i <= strtotime($end_date) - 86400; $i += 86400) {
        $temp = null;
        $query = db_select("cassiopeia_room_room_price", "cassiopeia_room_room_price");
        $query->fields("cassiopeia_room_room_price");
        $query->condition("from_date", $i, "<=");
        $query->condition("to_date", $i, ">=");
        $query->condition("nid", $nid, "=");
        $query->condition("price", 0, ">");
        $temp = $query->execute()->fetchObject();

        $dayofweek = date('w', ($i));
        $dayofweek += 1;
        $temp_weekend = null;
        $query = db_select("tbl_weekend_price", "tbl_weekend_price");
        $query->fields("tbl_weekend_price");
        $query->condition("from_date", $i, "<=");
        $query->condition("to_date", $i, ">=");
        $query->condition("hotel", $hid, "=");
        $query->condition("choose", "%" . $dayofweek . "%", "LIKE");
        $temp_weekend = $query->execute()->fetchObject();
        if (!empty($temp)) {
            $temp->netPrice = $temp->price;
            $booking_fee = cassiopeia_room_room_booking_fee_load_by_hotel($hotel,$temp->price);
            $_booking_fee = cassiopeia_room_room_booking_fee_load_by_hotel($hotel,$temp->original_price);
            if (!empty($booking_fee)) {
                $temp->price += $booking_fee;
                $temp->original_price += $_booking_fee;
            }
            if (!empty($temp_weekend)) {
                $temp->is_weekend = true;
            }
            $result[] = $temp;
        }

    }
//    _print_r($result);
    if (!empty($result)) {
        $min = array_values($result)[0];
        $netPrice = 0;
        $price = 0;
        $original_price = 0;
        foreach ($result as $item) {
            if ($min->price > $item->price) {
                $min = $item;
            }
            $netPrice += $item->netPrice;
            $price += $item->price;
            $original_price += $item->original_price;
            if(!empty($item->is_weekend)){
                $netPrice += $item->weekend;
                $price += $item->weekend;
                $original_price += $item->weekend;
            }
        }
        $total_price = $price;
        $totalNetPrice = $netPrice;
        $price = $price/count($result);
        $original_price = $original_price/count($result);
        if($min->price != 0){
            $min->price = $price;
            $min->original_price = $original_price;
            $min->total_price = $total_price;
            $min->totalNetPrice = $totalNetPrice;
        }
    }
    return $min;
}

function getMinPriceByHotelRoom($nid)
{
    $result = null;
    try {
        $query = db_select("tbl_room_price", "tbl_room_price");
        $query->fields("tbl_room_price");
        $query->condition("nid", $nid, "=");
        $query->orderBy("price", "ASC");
        $query->range(0, 1);
        $result = $query->execute()->fetchObject();
        if (!empty($result)) {
            $q = db_select("tbl_room_booking_fee", "tbl_room_booking_fee");
            $q->fields("tbl_room_booking_fee");
            $q->condition("tbl_room_booking_fee.from_price", $result->price, "<=");
            $q->condition("tbl_room_booking_fee.to_price", $result->price, ">=");
            $fee = $q->execute()->fetchObject();
            if (!empty($fee)) {
                $result->price += $fee->value;
            }
        }
    } catch (Exception $E) {
        _print_r($E);
    }
    return $result;
}

function cassiopeia_get_room_price_by_date($start_date, $end_date, $room_id){
    $result = array();
    $room = node_load($room_id);
    $hotel_id = $room->field_hotel['und'][0]['nid'];
//    $hotel = node_load($hotel_id);
//    _print_r($hotel);
    $people = $room->field_people['und'][0]['value'];
    $people = str_replace("NL","",$people);
    for ($i = strtotime($start_date); $i <= strtotime($end_date) - 86400; $i += 86400) {
        $temp = null;
        $query = db_select("tbl_room_price", "tbl_room_price");
        $query->fields("tbl_room_price");
        $query->condition("from_date", $i, "<=");
        $query->condition("to_date", $i, ">=");
        $query->condition("nid", $room_id, "=");
        $temp = $query->execute()->fetchObject();

        $dayofweek = date('w', ($i));
        $dayofweek += 1;
        $temp_weekend = null;
        $query = db_select("tbl_weekend_price", "tbl_weekend_price");
        $query->fields("tbl_weekend_price");
        $query->condition("from_date", $i, "<=");
        $query->condition("to_date", $i, ">=");
        $query->condition("hotel", $hotel_id, "=");
        $query->condition("choose", "%" . $dayofweek . "%", "LIKE");
        $temp_weekend = $query->execute()->fetchObject();

        if (!empty($temp)) {
            $q = db_select("tbl_room_booking_fee", "tbl_room_booking_fee");
            $q->fields("tbl_room_booking_fee");
            $q->condition("tbl_room_booking_fee.people", $people, "<=");
            $q->orderBy("people", "DESC");
            $q->range(0, 1);
            $fee = $q->execute()->fetchObject();
            if (!empty($fee)) {
                $temp->booking_fee = $fee->value;
            }
            if (!empty($temp_weekend)) {
                $temp->is_weekend = $temp->weekend;
            }
        }

        $result[$i] = $temp;
    }
//    _print_r($result);
    return $result;
}


