function convert_xml_to_array($xml_string)
{
//    print($xml_string);
    $xml = preg_replace("/(<\/?)(\w+):([^>]*>)/", '$1$2$3', $xml_string);
    $xml = simplexml_load_string($xml);
    $json = json_encode($xml);
    $responseArray = json_decode($json, true);
//    _print_r($responseArray);
    return $responseArray;
}

function cassiopeia_get_flight_time_limit($airline, $StartDate, $class, $selectValue = "", $StartPoint = "", $endPoint = "")
{
    switch ($airline) {
        case "VJ" :
            $timestamp = strtotime($StartDate);
            $hour = 3600;
            $minute = 60;
            if (strtotime($StartDate) - REQUEST_TIME <= 24 * $hour) {
                $Expired_Date = 0;
            } else if((strtotime($StartDate) - REQUEST_TIME >= 24 * $hour) && (strtotime($StartDate) - REQUEST_TIME <= 30 * $hour)){
                $Expired_Date = $timestamp - 24 * $hour; // trong khoảng từ 24h - 28h trước giờ khởi hành -> giữ chỗ đến trước giờ bay 24h
            }else{
                $Expired_Date = REQUEST_TIME + 3 * $hour; //Giữ 3 tiếng
            }
            break;
        case "QH" :
            $timestamp = strtotime($StartDate);
            $hour = 3600;
            $minute = 60;
            if (strtotime($StartDate) - REQUEST_TIME <= 24 * 3600) {
                $Expired_Date = REQUEST_TIME + 1800; // dưới 24h thì chỉ giữ được 30 phút
            } else if((strtotime($StartDate) - REQUEST_TIME >= 24 * 3600) && (strtotime($StartDate) - REQUEST_TIME <= 27 * 3600)){
                $Expired_Date = $timestamp - 24 * $hour; // trong khoảng từ 24h - 28h trước giờ khởi hành -> giữ chỗ đến trước giờ bay 24h
            }else{
                if($class=="ECONOMYSAVERMAX"){
                    $Expired_Date = REQUEST_TIME + 1800; // ECONOMYSAVERMAX thì chỉ giữ được 30 phút
                }else{
                    $Expired_Date = REQUEST_TIME + 3 * 3600; //Giữ 3 tiếng
                }
            }

            break;
        case "BL" :
            if (strtotime($StartDate) - REQUEST_TIME <= 36 * 3600) {
                if (strtotime($StartDate) - REQUEST_TIME <= 24 * 3600) {
                    $Expired_Date = "";
                } else {
                    $Expired_Date = strtotime($StartDate) - 86400;
                    $Expired_Date -= 30 * 60;
                }
            } else {
                $Expired_Date = REQUEST_TIME + 12 * 3600;
                $Expired_Date -= 30 * 60;
            }
            break;
        case "VU" :
            $timestamp = strtotime($StartDate);
            $hour = 3600;
            $minute = 60;
            if ($timestamp - REQUEST_TIME <= 24 * $hour) {
                $Expired_Date = 0;
            } else if(($timestamp - REQUEST_TIME > 24 * $hour) && (strtotime($StartDate) - REQUEST_TIME <= 36 * $hour)){
                $Expired_Date = $timestamp - 24 * $hour; // trong khoảng từ 24h - 28h trước giờ khởi hành -> giữ chỗ đến trước giờ bay 24h
            }else{
                $Expired_Date = REQUEST_TIME + 12 * $hour; // Vé đặt trước 28h giữ được 3 tiếng
            }
            break;
        case "VN" :
            $timestamp = strtotime($StartDate);
            $hour = 3600;
            $minute = 60;
            if ($timestamp - REQUEST_TIME <= 24 * $hour) {
                $Expired_Date = REQUEST_TIME + 30*$minute; // dưới 24h thì chỉ giữ được 30 phút
            } else if(($timestamp - REQUEST_TIME > 24 * $hour) && (strtotime($StartDate) - REQUEST_TIME <= 28 * $hour)){
                $Expired_Date = $timestamp - 24 * $hour; // trong khoảng từ 24h - 28h trước giờ khởi hành -> giữ chỗ đến trước giờ bay 24h
            }else{
                $Expired_Date = REQUEST_TIME + 3 * $hour; // Vé đặt trước 28h giữ được 3 tiếng
            }
            break;
        case "9G" :
            $timestamp = strtotime($StartDate);
            $hour = 3600;
            $minute = 60;
            if ($timestamp - REQUEST_TIME <= 24 * $hour) {
                $Expired_Date = REQUEST_TIME + 30*$minute; // dưới 24h thì chỉ giữ được 30 phút
            } else if(($timestamp - REQUEST_TIME > 24 * $hour) && (strtotime($StartDate) - REQUEST_TIME <= 28 * $hour)){
                $Expired_Date = $timestamp - 24 * $hour; // trong khoảng từ 24h - 28h trước giờ khởi hành -> giữ chỗ đến trước giờ bay 24h
            }else{
                $Expired_Date = REQUEST_TIME + 3 * $hour; // Vé đặt trước 28h giữ được 3 tiếng
            }
            break;
    }
    return $Expired_Date;
}

function cassiopeia_get_most_cheap_flight($ListFlights)
{
    $Flight = $ListFlights[0];
    foreach ($ListFlights as $flight) {
        if ($Flight['TotalPrice'] > $flight['TotalPrice']) {
            $Flight = $flight;
        }
    }
    return $Flight;
}

function cassiopeia_open_pnr_form($form, &$form_state, $caches = null)
{
    $form = array();
    $form['#attributes']['class'][] = "mb-24";
    $txtBtnSubmit = "Xem vé trước khi xuất";
    if($caches['isReview']){
        $txtBtnSubmit = "Mở lại vé";
    }
    $form_state['#cache'] = $caches;
    //$airlines = cassiopeia_get_airlines();
    $airline_options = array();
//    $airline_options['all'] = "Tất cả";
    $airline_options['VN'] = "Vietnam Airlines";
    $airline_options['VJ'] = "Vietjet Air";
    $airline_options['QH'] = "Bamboo Airways";
    $airline_options['VU'] = "Vietravel Airlines";
//    $airline_options['BL'] = "";

//    foreach($airlines as $airline){
//        $airline_options[$airline->iata] = $airline->iata." - ".$airline->name;
//    }
    $form['airline'] = array(
        '#type' => 'select',
        '#title' => t('Hãng'),
        '#options' => $airline_options,
        '#chosen' => false,
        '#required' => TRUE,
        '#attributes' => array("class" => array("issue-filter-change")),
    );
    if (!empty($caches['airline'])) {
        $form['airline']['#default_value'] = $caches['airline'];
    }
    $form['code'] = array(
        '#type' => 'textfield',
        '#title' => t('PNR'),
        '#required' => TRUE,
    );
    if (!empty($caches['code'])) {
        $form['code']['#default_value'] = $caches['code'];
    }
    $form['submit'] = array(
        '#type' => 'submit',
        '#value' =>  $txtBtnSubmit,
        '#prefix'   => "<div class='form-actions'>",
        '#suffix' => "</div>",
        '#attributes' => array("class" => array("btn-default")),
    );
    if (!empty($caches['isReview'])) {
        $form['preview_pdf'] = array(
            '#type' => 'submit',
            '#value' => t('Xem mặt vé'),
            '#prefix' => "<div class='form-actions'>",
            '#suffix' => "</div>",
            '#attributes' => array('class' => array('btn-default', 'btn-preview-ticket-pdf')),
            '#submit' => array('cassiopeia_open_pnr_form_preview_pdf_submit'),
        );
    }
    return $form;
}

