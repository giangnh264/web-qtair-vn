    </table>
    <?php
}

function cassiopeia_manger_agents_balance_report_export(){
    global $user;
    $data = json_decode($_REQUEST['data']);
    $caches = (array)$data;
    $filename = "Bao-cao-so-du-" . date("d.m.Y",REQUEST_TIME);
    drupal_add_http_header('Content-Type', 'application/vnd.ms-excel; charset=utf-8');
    drupal_add_http_header('Content-Disposition', 'attachment; filename=' . $filename . '.xls');
    try{
        $issue_query = db_select("tbl_issue_report","tbl_issue_report");
        $issue_query->fields("tbl_issue_report",array("created","partner_price","agent"));
    
        $room_query = db_select("tbl_room_booking_report","tbl_room_booking_report");
        $room_query->fields("tbl_room_booking_report",array("created"));
        $room_query->addField("tbl_room_booking_report","partner_price","partner_price");
        $room_query->addField("tbl_room_booking_report","agent","agent");
    
        $quer1y = Database::getConnection()
            ->select($issue_query->union($room_query))
            ->fields(NULL, array("created","partner_price","agent"))
            ->orderBy("created","DESC");
        $quer1y->condition("created",array(strtotime(date("01-01-Y",REQUEST_TIME)),strtotime(date("31-12-Y",REQUEST_TIME))),"BETWEEN");
        $quer1y->addExpression("SUM(partner_price)","total_price");
        $quer1y->groupBy("agent");
    
    
        $total_query = db_select("users","tbl_user");
        $total_query -> fields("tbl_user");
        $total_query -> join("users_roles","tbl_role","tbl_role.uid = tbl_user.uid");
        $total_query -> condition("tbl_role.rid",4);
        $total_query -> join("field_data_field_account_balance","tbl_balance","tbl_balance.entity_id = tbl_user.uid");
        $total_query -> addExpression("SUM(tbl_balance.field_account_balance_value)","total_balance");
        $result_total_query = $total_query->execute()->fetchObject();
    
        $total = 0;
        $query = db_select("users","tbl_user");
        $query -> fields("tbl_user");
        $query -> join("users_roles","tbl_role","tbl_role.uid = tbl_user.uid");
        $query -> condition("tbl_role.rid",4);
    //    $query->condition("tbl_user.uid",130);
        $query -> leftJoin("field_data_field_account_sale","tbl_sale","tbl_sale.entity_id = tbl_user.uid");
        $query -> join("field_data_field_account_balance","tbl_balance","tbl_balance.entity_id = tbl_user.uid");
        $query->addField("tbl_balance","field_account_balance_value","balance");
        $query -> leftJoin("field_data_field_point","tbl_point","tbl_point.entity_id = tbl_user.uid");
        $query->addField("tbl_point","field_point_value","total_point");
        $query -> leftJoin("field_data_field_used_point","tbl_used_point","tbl_used_point.entity_id = tbl_user.uid");
        $query->addField("tbl_used_point","field_used_point_value","total_used_point");
        $query -> addExpression("CASE WHEN tbl_used_point.field_used_point_value>0 THEN (tbl_point.field_point_value-tbl_used_point.field_used_point_value) ELSE tbl_point.field_point_value END ","availablePoint");
    
        $query->leftJoin($quer1y,"tbl_rank","tbl_rank.agent=tbl_user.uid");
        $query->addField("tbl_rank","total_price","total_price");
        $query->addExpression("FLOOR(tbl_rank.total_price/1000000)","total_rank_point");
        if(!empty($caches['rank']) && $caches['rank']!="all"){
            switch ($caches['rank']){
                case 500 :
                    $query->where('FLOOR(tbl_rank.total_price/1000000)<:rank', array(':rank' => $caches['rank']));
                    break;
                case 1000 :
                    $query->where('FLOOR(tbl_rank.total_price/1000000)>=:rank1', array(':rank1' => 500));
                    $query->where('FLOOR(tbl_rank.total_price/1000000)<:rank2', array(':rank2' => 1000));
                    break;
                case 2000 :
                    $query->where('FLOOR(tbl_rank.total_price/1000000)<:rank1', array(':rank1' => 2000));
                    $query->where('FLOOR(tbl_rank.total_price/1000000)>=:rank2', array(':rank2' => 1000));
                    break;
                default:
                    $query->where('FLOOR(tbl_rank.total_price/1000000)>=:rank', array(':rank' => 2000));
                    break;
            }
        }
        $query->join("field_data_field_account_code","field_account_code","field_account_code.entity_id=tbl_user.uid");
        $query->addField("field_account_code","field_account_code_value","account_code");
        $query->join("field_data_field_account_transaction_name","field_account_transaction_name","field_account_transaction_name.entity_id=tbl_user.uid");
        $query->addField("field_account_transaction_name","field_account_transaction_name_value","account_transaction_name");
        if(!empty($caches['order_by']) && $caches['order_by']!="none"){
            if($caches['order_by']=='balance'){
                $query->orderBy("tbl_balance.field_account_balance_value",$caches['direction']);
            }elseif($caches['order_by']=="point"){
                $query->orderBy("CAST(availablePoint AS SIGNED)",$caches['direction']);
            }elseif($caches['order_by']=='agent_code'){
    //            $query->orderBy("field_account_code.field_account_code_value",$caches['direction']);
            }
        }
    
        if(!empty($caches['code']) && $caches['code']!="all"){
            $query->condition("field_account_code.field_account_code_value","%".$caches['code']."%","LIKE");
        }
        if(!empty($caches['name']) && $caches['name']!="all"){
            $query->condition("field_account_transaction_name.field_account_transaction_name_value","%".$caches['name']."%","LIKE");
        }
        if(!empty($caches['tel']) && $caches['tel']!="all"){
            $query->condition("tbl_user.name","%".$caches['tel']."%","LIKE");
        }
        if(!empty($caches['mail']) && $caches['mail']!="all"){
            $query->condition("tbl_user.mail","%".$caches['mail']."%","LIKE");
        }
        if(isset($caches['status'])&& $caches['status']!="all"){
            $query->condition("tbl_user.status",$caches['status'],"=");
        }
        if(!empty($caches['sale'])&& $caches['sale']!="all"){
            $query->condition("tbl_sale.field_account_sale_target_id",$caches['sale'],"=");
        }
        if(!empty($caches['profit_filter']) && $caches['profit_filter']!="all"){
            switch ($caches['profit_filter']){
                case "morethanZero":
                    $query->condition("tbl_balance.field_account_balance_value",0,">");
                    break;
                case "lessthanZero":
                    $query->condition("tbl_balance.field_account_balance_value",0,"<");
                    break;
                case "equalZero":
                    $query->condition("tbl_balance.field_account_balance_value",0,"=");
                    break;
            }
        }
        $result  = $query -> execute() -> fetchAll();
        $query->addExpression("SUM(tbl_balance.field_account_balance_value)","total_balance");
        $query->addExpression("SUM(CASE WHEN tbl_used_point.field_used_point_value>0 THEN (tbl_point.field_point_value-tbl_used_point.field_used_point_value) ELSE tbl_point.field_point_value END)","total_availablePoint");
        $result2 = $query->execute()->fetchObject();
        $limit = $num_per_page;
        $page = pager_default_initialize(count($result), $limit, 0);
        $offset = $limit * $page;
        if(!empty($result)){
            $result = array_slice($result, $offset, $limit);
        }else{
            $result=array();
        }
    }catch (Exception $e){
        _print_r($e);
    }
    ?>
    <div class="total-block">
        <label for="">Tổng số dư:</label> <span class="color-red"><?php print(number_format($result_total_query->total_balance,0,",",".")); ?> đ</span>
    </div>
    <!--    --><?php //endif; ?>
    <div class="table-responsive">
        <table class="table  table-hover table-bordered">
            <thead class="thead-dark">
            <tr>
                <th class="hidden"></th>
                <th class="<?php if($caches['order_by']=="agent_code") print($caches['direction']); ?>" data-sort="agent_code">Mã</th>
                <th>Tên Đại Lý</th>
                <th class="">Điện thoại</th>
                <th class="">Email</th>
                <th class="">Hoạt động</th>
                <th class="<?php if($caches['order_by']=="balance") print($caches['direction']); ?>" data-sort="balance">Số dư</th>
                <th class="<?php if($caches['order_by']=="point") print($caches['direction']); ?> " data-sort="point">Tích điểm</th>
                <th class="">Hạng</th>
            </tr>
            </thead>
            <tbody>
            <?php if(!empty($result)): ?> 
                <?php foreach($result as $value): ?>
                    <tr data-key="<?php print($value->uid);?>" class="desktop-detail-row">
                        <td class="hidden"><span class="fa fa-plus"></span></td>
                        <td><?php echo $value->account_code; ?></td>
                        <td><?php echo $value->account_transaction_name; ?></td>
                        <td class=""><?php echo(strval($value->name)); ?></td>
                        <td class=""><?php echo($value->mail); ?></td>
                        <td class="">
                            <?php
                            if($value->status==0){
                                print("Đã khóa");
                            }else{
                                print("Hoạt động");
                            }
                            ?>
                        </td>
                        <td><?php print(number_format($value->balance,0,".",",")); ?></td>
                        <td class=""  ><?php
                            echo($value->total_point - $value->total_used_point);
                            ?></td>
                        <td class="">
                            <?php
                            $rank = "Thành viên";
                            if ($value->total_rank_point < 500) {

                            } else if ($value->total_rank_point < 1000) {
                                $rank = "Bạc";
                            } else if ($value->total_rank_point < 2000) {
                                $rank = "Vàng";
                            } else {
                                $rank = "Kim cương";
                            }
                            echo $rank;
                            ?>
                        </td>
                    </tr>
                    <?php $total+= $agent->field_account_balance['und'][0]['value']; ?>
                <?php endforeach; ?>
            <?php endif; ?>
            </tbody>
        </table>
    </div>
    <?php
}



function cassiopeia_form_hotel_node_form_alter_submit(&$form, &$form_state)
{
    $form_state['values']['weekendPriceCount'] = count($form_state['weekendPriceList']);
}

function cassiopeia_node_insert($node)
{
    if ($node->type == "hotel") {
        db_delete("tbl_weekend_price")->condition("hotel", $node->nid)->execute();
        $db_transaction = db_transaction();
        try {
            if (!empty($node->weekendPriceCount)) {
                for ($i = 0; $i < $node->weekendPriceCount; $i++) {
                    $_from_date = "weekendPriceFromDate_" . $i;
                    $_to_date = "weekendPriceToDate_" . $i;
//                    $_value = "weekendPriceValue_".$i;
                    $_choose = "weekendPriceChoose_" . $i;
                    $l_choose = "";
                    if (!empty($node->$_choose)) {
                        foreach ($node->$_choose as $item) {
                            $l_choose .= "," . $item;
                        }
                    }
                    db_insert("tbl_weekend_price")->fields(array(
                        "created" => REQUEST_TIME,
                        "hotel" => $node->nid,
                        "from_date" => strtotime($node->$_from_date),
                        "to_date" => strtotime($node->$_to_date),
//                        "value" => $node->$_value,
                        "choose" => $l_choose
                    ))->execute();
                }
            }
        } catch (Exception $e) {
            _print_r($e);
            die;
            $db_transaction->rollback();
        }
    }
}

function cassiopeia_node_presave($node){
    if ($node->type == "hotel") {
        if (empty($node->is_new)) {
            db_delete("tbl_weekend_price")->condition("hotel", $node->nid)->execute();
            $db_transaction = db_transaction();
            try {
                if (!empty($node->weekendPriceCount)) {
                    for ($i = 0; $i < $node->weekendPriceCount; $i++) {
                        $_from_date = "weekendPriceFromDate_" . $i;
                        $_to_date = "weekendPriceToDate_" . $i;
//                        $_value = "weekendPriceValue_".$i;
                        $_choose = "weekendPriceChoose_" . $i;
                        $l_choose = "";
                        if (!empty($node->$_choose)) {
                            foreach ($node->$_choose as $item) {
                                $l_choose .= "," . $item;
                            }
                        }
                        db_insert("tbl_weekend_price")->fields(array(
                            "created" => REQUEST_TIME,
                            "hotel" => $node->nid,
                            "from_date" => strtotime($node->$_from_date),
                            "to_date" => strtotime($node->$_to_date),
//                            "value" => $node->$_value,
                            "choose" => $l_choose
                        ))->execute();
                    }
                }
            } catch (Exception $e) {
                _print_r($e);
                die;
                $db_transaction->rollback();
            }
        }
    }
}




function cassiopeia_get_hotels_by_tx_area($tid = null)
{
    $conditions = array();
    $conditions['status'] = array(
        "type" => "propertyCondition",
        "value" => 1,
        "condition" => "=",
    );
    $conditions['created'] = array(
        "type" => "propertyOrderBy",
        "direction" => "DESC"
    );
    if (!empty($tid)) {
        $conditions['field_tx_area'] = array(
            "type" => "fieldCondition",
            "key" => "tid",
            "value" => $tid,
            "condition" => "=",
        );
    }
    $hotels = cassiopeia_get_items_by_conditions($conditions, "hotel", "node");
    return $hotels;
}

function cassiopeia_get_rooms_by_hotel($nid = null)
{
    $conditions = array();
    $conditions['status'] = array(
        "type" => "propertyCondition",
        "value" => 1,
        "condition" => "=",
    );
//    $conditions['field_weight']  = array(
//        "type"      => "fieldOrderBy",
//        "column" => "value",
//        "direction" => "ASC",
//    );
    if (!empty($nid)) {
        $conditions['field_hotel'] = array(
            "type" => "fieldCondition",
            "key" => "nid",
            "value" => $nid,
            "condition" => "=",
        );
    }
    $rooms = cassiopeia_get_items_by_conditions($conditions, "room", "node");
    return $rooms;
}

function cassiopeia_admin_room_booking_form($form, &$form_state, $_conditions = null)
{
    $form = array();
    $form["field_ajax_container"] = array(
        '#type' => 'container',
        '#prefix' => '<div id="txAreaContainer">',
        '#suffix' => '</div>',
    );
    $vocal_area = taxonomy_vocabulary_machine_name_load("tx_area");
    $tx_ares = taxonomy_get_tree($vocal_area->vid, 0, 1);
    $tx_ares_options = array();
    $tx_ares_options['all'] = "Tất cả";
    if (!empty($tx_ares)) {
        foreach ($tx_ares as $tx_are) {
            $tx_ares_options[$tx_are->tid] = $tx_are->name;
        }
    }
    $form['field_ajax_container']['tx_area'] = array(
        '#type' => 'select',
        '#title' => t('Khu vực'),
        '#options' => $tx_ares_options,
        '#chosen' => TRUE,
        '#ajax' => array(
            'callback' => 'cassiopeia_admin_room_booking_form_tx_area',
            'wrapper' => 'txAreaContainer',
            'method' => 'replace',
            'effect' => 'fade',
        )
    );
//        print_r($form_state);
//        if(!empty($form_state['values'])){
//            print_r($form_state['values']);
//        }
    $tid = !empty($form_state['values']['tx_area']) ? $form_state['values']['tx_area'] : null;
    $hotels = cassiopeia_get_hotels_by_tx_area($tid);
    $hotel_options = array();
    $hotel_options['all'] = "Tất cả";
    if (!empty($hotels)) {
        foreach ($hotels as $hotel) {
            $hotel_options[$hotel->nid] = $hotel->title;
        }
    }
    $form['field_ajax_container']['hotel'] = array(
        '#type' => 'select',
        '#title' => t('Khách sạn'),
        '#options' => $hotel_options,
        '#chosen' => TRUE,
    );
    $nid = null;
    $rooms = cassiopeia_get_rooms_by_hotel($nid);
    $room_options = array();
    $room_options['all'] = "Tất cả";
    if (!empty($rooms)) {
        foreach ($rooms as $room) {
            $room_options[$room->nid] = $room->title;
        }
    }
    $form['field_ajax_container']['room'] = array(
        '#type' => 'select',
        '#title' => t('Phòng'),
        '#options' => $room_options,
        '#chosen' => TRUE,
    );
    return $form;
}

function cassiopeia_admin_room_booking_form_tx_area($form, &$form_state)
{
//        print(123);
//        die;
    return $form['field_ajax_container'];
}

function cassiopeia_form_hotel_node_form_alter(&$form, &$form_state)
{
    $form['weekendPrice'] = array(
        '#type' => 'container',
        '#prefix' => '<div id="weekendPriceContainer"><label for="">Cuối tuần</label>',
        '#suffix' => '</div>',
    );
    $form['field_hotel_ranking']['und'][0]['value']['#options'] = array(
        1 => "1 sao",
        2 => "2 sao",
        3 => "3 sao",
        4 => "4 sao",
        5 => "5 sao",
    );

    unset($form['field_hotel_ranking']['und'][0]['value']['#size']);
    $form['field_hotel_ranking']['und'][0]['value']['#type'] = "select";

    if (!empty($form['nid']['#value'])) {
        $query = db_select("tbl_weekend_price", "tbl_weekend_price");
        $query->fields("tbl_weekend_price");
        $query->condition("hotel", $form['nid']['#value']);
        $result = $query->execute()->fetchAll();
        if (empty($result)) {
            $result = array(0 => array());
        }
        $form_state['weekendPriceList'] = !empty($form_state['weekendPriceList']) ? $form_state['weekendPriceList'] : $result;
    } else {
        $form_state['weekendPriceList'] = !empty($form_state['weekendPriceList']) ? $form_state['weekendPriceList'] : array(0 => array());
    }
    foreach ($form_state['weekendPriceList'] as $key => $value) {
        $form['weekendPrice']['weekendPriceGroup_' . $key] = array(
            '#type' => 'container',
            '#prefix' => '<div id="weekendPriceGroup" class="room-price-group">',
            '#suffix' => '</div>',
        );
        $form['weekendPrice']['weekendPriceGroup_' . $key]['weekendPriceFromDate_' . $key] = array(
            '#type' => 'date_popup',
            '#date_type' => DATE_DATETIME,
            '#date_timezone' => date_default_timezone(),
            '#date_format' => 'm/d/Y',
            '#date_increment' => 1,
            '#date_year_range' => '-3:+3',
            '#required' => FALSE,
            '#attributes' => array("class" => array("fromDate")),
            '#default_value' => !empty($value) ? date("Y-m-d H:i:s", $value->from_date) : date("Y-m-d H:i:s", REQUEST_TIME),
        );
        $form['weekendPrice']['weekendPriceGroup_' . $key]['weekendPriceToDate_' . $key] = array(
            '#type' => 'date_popup',
            '#date_type' => DATE_DATETIME,
            '#date_timezone' => date_default_timezone(),
            '#date_format' => 'm/d/Y',
            '#date_increment' => 1,
            '#date_year_range' => '-3:+3',
            '#required' => FALSE,
            '#attributes' => array("class" => array("toDate")),
            '#default_value' => !empty($value) ? date("Y-m-d H:i:s", $value->to_date) : date("Y-m-d H:i:s", REQUEST_TIME),
        );
//        $form['weekendPrice']['weekendPriceGroup_'.$key]['weekendPriceValue_'.$key] = array(
//            '#type'             => 'textfield',
//            '#title'            => t('Phụ thu'),
//            '#required'         => FALSE,
//            '#default_value'    => !empty($value)?$value->value:0,
//        );
        $form['weekendPrice']['weekendPriceGroup_' . $key]['weekendPriceChoose_' . $key] = array(
            '#type' => 'select',
            '#title' => t('Chọn thứ'),
            '#options' => array(
                5 => t('Thứ 5'),
                6 => t('Thứ 6'),
                7 => t('Thứ 7'),
                8 => t('Chủ nhật'),
            ),
            '#multiple' => TRUE,
            '#chosen' => TRUE,
        );
        if (!empty($value->choose)) {
            $_choose = explode(",", $value->choose);
            $choose_array = array();
            foreach ($_choose as $item) {
                if (!empty($item)) {
                    $choose_array[$item] = $item;
                }
            }
            $form['weekendPrice']['weekendPriceGroup_' . $key]['weekendPriceChoose_' . $key]['#default_value'] = $choose_array;
        }
        $form['weekendPrice']['weekendPriceGroup_' . $key]['roomPriceGroupRemove_' . $key] = array(
            '#type' => 'submit',
            '#submit' => array('cassiopeia_remove_weekend_price_remove_one'),
            '#text' => '<span class="icon glyphicon glyphicon-trash" aria-hidden="true"></span>',
            '#value' => 'roomPriceGroupRemove_' . $key,
            '#attributes' => array(
                'class' => array('close teaRoomPriceItemRemove'), // insert space before attribute name :)
            ),
            '#ajax' => array(
                'callback' => 'cassiopeia_remove_weekend_price_ajax_callback',
                'wrapper' => 'weekendPriceContainer',
                'method' => 'replace',
                'effect' => 'fade',
            ),
        );
    }

    $form['weekendPrice']['price_addMore'] = array(
        '#type' => 'submit',
        '#submit' => array('cassiopeia_add_weekend_price_add_one'),
        '#value' => 'Thêm giai đoạn',
        '#text' => '<span class="icon glyphicon glyphicon-plus" ></span> ',
        '#attributes' => array(
            'class' => array('btn close teaTimeAddMore'),
            'type' => 'button',
        ),
        '#ajax' => array(
            'callback' => 'cassiopeia_add_weekend_price_ajax_callback',
            'wrapper' => 'weekendPriceContainer',
            'method' => 'replace',
            'effect' => 'fade',
        ),
    );
    $form['weekendPriceCount'] = array(
        '#type' => 'hidden',
        '#title' => t('Giá trẻ em'),
        '#default_value' => "0",
        '#required' => FALSE,
    );
    $form['#theme'][] = "cassiopeia_form_hotel_node_form_alter_theme";
    $form['#submit'][] = "cassiopeia_form_hotel_node_form_alter_submit";
}

