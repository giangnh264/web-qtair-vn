function cassiopeia_add_notify_form_submit($form, &$form_state)
{
    try {
        db_insert("tbl_notify")->fields(array(
            "title" => $form_state['values']['title'],
            "content" => !empty($form_state['values']['content']) ? $form_state['values']['content'] : "",
            "url" => !empty($form_state['values']['url']) ? $form_state['values']['url'] : "",
            "created" => REQUEST_TIME,
        ))->execute();
    } catch (Exception $e) {

    }
}

function cassiopeia_get_notify_by_id($id)
{
    $query = db_select("tbl_notify", "tbl_notify");
    $query->fields("tbl_notify");
    $query->condition("id", $id);
    $result = $query->execute()->fetchObject();
    return $result;
}

function cassiopeia_delete_notify_form($form, &$form_state)
{
    $form = array();
    $form['id'] = array(
        '#type' => 'hidden',
