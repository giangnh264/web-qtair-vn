function cassiopeia_detail_report_tab_6_filter_form($form, &$form_state, $caches)
{
    $month_options = array();
    for ($i = REQUEST_TIME - (12 * 30 * 86400); $i <= REQUEST_TIME; $i += 86400 * 30) {
        $month_options[date("m-Y", $i)] = date("m/Y", $i);
    }
    $form['month'] = array(
        '#type' => 'select',
        '#title' => t('Tháng'),
        '#options' => $month_options,
        '#attributes' => array("onchange" => "this.form.submit()"),
//        '#resquired'    => TRUE,
    );
    if (!empty($caches['month'])) {
        $form['month']['#default_value'] = $caches['month'];
    } else {
        $form['month']['#default_value'] = date("m-Y", REQUEST_TIME);
    }
    $form['submit'] = array(
        '#type' => 'submit',
        '#value' => t('Lọc'),
        '#attributes' => array("class" => array("hidden")),
    );
    return $form;
}

