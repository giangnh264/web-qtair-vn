function cassiopeia_flight_search($data)
{
    global $language;
    $obj = new stdClass();
    $obj->Adt = $data->Adt;
    $obj->Chd = $data->Chd;
    $obj->Inf = $data->Inf;
    $obj->ViewMode = $data->ViewMode;
    foreach ($data->lightFlight as $item) {
        $obj->ListFlight[] = array(
            "StartPoint" => $item->StartPoint,
            "EndPoint" => $item->EndPoint,
            "DepartDate" => $item->DepartDate,
            "Airline" => $item->Airline,
        );
    }

    $obj->HeaderUser = HEADERUSER;
    $obj->HeaderPass = HEADERPASS;
    $obj->Language = $language->language;
    $obj->AgentAccount = AGENTACCOUNT;
    $obj->AgentPassword = AGENTPASSWORD;
//    print_r(json_encode($obj));die;
    $curl = curl_init();
    curl_setopt_array($curl, array(
        CURLOPT_URL => "http://platform.datacom.vn/flights/search",
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_ENCODING => "",
        CURLOPT_MAXREDIRS => 10,
        CURLOPT_TIMEOUT => 0,
        CURLOPT_FOLLOWLOCATION => true,
        CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
        CURLOPT_CUSTOMREQUEST => "POST",
        CURLOPT_POSTFIELDS => json_encode($obj),
        CURLOPT_HTTPHEADER => array(
            "Content-Type: application/json"
        ),
    ));
    $response = curl_exec($curl);
    curl_close($curl);
    return $response;
}

