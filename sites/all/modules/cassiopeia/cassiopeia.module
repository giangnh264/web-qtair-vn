            $form['agent']['#default_value'] = $cache['agent'];
        }
    }
    $form['checkin'] = array(
        '#type' => 'date_popup',
//        '#default_value' => !empty($cache['checkin']) ? $cache['checkin'] : date("Y-m-d H:i:s", REQUEST_TIME),
        '#date_type' => DATE_DATETIME,
