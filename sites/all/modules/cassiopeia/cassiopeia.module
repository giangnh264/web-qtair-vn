function cassiopeia_filter_payment_report_form($form, &$form_state, $caches)
{
    drupal_add_js(drupal_get_path('module', 'cassiopeia') . '/js/payment-report-js.js', ['weight' => 1000]);
    global $user;
    $form = array();
    $query = db_select("tbl_tran_kind", "tbl_tran_kind");
    $query->fields("tbl_tran_kind");
//    $query -> condition("kind","payment");
    $result = $query->execute()->fetchAll();
    $options = array();
    $options['all'] = "Tất cả";
    if (!empty($result)) {
        foreach ($result as $value) {
            $options[$value->id] = $value->name;
        }
    }
    $form['tran_kind'] = array(
        '#type' => 'select',
        '#title' => t('Loại giao dịch'),
        '#options' => $options,
        '#chosen' => TRUE,
        '#resquired' => TRUE,
        '#attributes' => array("onchange" => "this.form.submit();"),
    );
    if (!empty($caches['tran_kind'])) {
        $form['tran_kind']['#default_value'] = $caches['tran_kind'];
    }
    $form['PNR'] = array(
        '#title' => t('PNR'),
        '#type' => 'textfield',
        '#size' => 60,
        '#maxlength' => 128,
        '#resquired' => TRUE,
        '#attributes' => array("onchange" => "this.form.submit();"),
    );
    if (!empty($caches['PNR'])) {
        $form['PNR']['#default_value'] = $caches['PNR'];
    }
    if (user_has_role(3) || user_has_role(5)) {
        $query = db_select("users", "tbl_user");
        $query->fields("tbl_user");
        $query->join("users_roles", "tbl_role", "tbl_role.uid = tbl_user.uid");
        $query->condition("tbl_role.rid", 4);
        $query->leftJoin("field_data_field_account_sale", "tbl_sale", "tbl_sale.entity_id = tbl_user.uid");
        $result = $query->execute()->fetchAll();
        $options = array();
        $options['all'] = "Chọn Đại lý";
        if (!empty($result)) {
            foreach ($result as $value) {
                $agent = user_load($value->uid);
                $transaction_name = !empty($agent->field_account_transaction_name['und'][0]['value']) ? $agent->field_account_transaction_name['und'][0]['value'] : "";
                $account_code = !empty($agent->field_account_code['und'][0]['value']) ? $agent->field_account_code['und'][0]['value'] : "";
                $options[$value->uid] = $account_code . " - " . $transaction_name;
            }
        }
        $form['agent'] = array(
            '#type' => 'select',
            '#title' => t('Đại lý'),
            '#options' => $options,
            '#chosen' => TRUE,
            '#attributes' => array("onchange" => "this.form.submit();"),
        );
        if (!empty($caches['agent'])) {
            $form['agent']['#default_value'] = $caches['agent'];
        }
    }
    $form['content'] = array(
        '#title' => t('Nội dung'),
        '#type' => 'textfield',
        '#size' => 60,
        '#maxlength' => 128,
        '#resquired' => TRUE,
        '#attributes' => array("onchange" => "this.form.submit();"),
    );
    if (!empty($caches['content'])) {
        $form['content']['#default_value'] = $caches['content'];
    }
    $form['date_filter'] = array(
        '#type' => 'select',
        '#title' => t('Theo ngày'),
        '#options' => array(
            "all" => "Tất cả",
            "today" => "Trong ngày",
            "yesterday" => "Hôm qua",
            "thismonth" => "Trong tháng",
            "other" => "Theo ngày",
        ),
        '#attributes' => array("onchange" => "this.form.submit();"),
    );
    if (!empty($caches['date_filter'])) {
        $form['date_filter']['#default_value'] = $caches['date_filter'];
    }
    $form['payment_report_from_date'] = array(
        '#type' => 'date_popup',
        '#default_value' => !empty($caches['payment_report_from_date']) ? $caches['payment_report_from_date'] : date("Y-m-d H:i:s", REQUEST_TIME),
        '#date_type' => DATE_DATETIME,
        '#date_timezone' => date_default_timezone(),
        '#date_format' => 'd-m-Y',
        '#date_increment' => 1,
        '#date_year_range' => '-10:+10',
        '#attributes' => array("onchange" => "this.form.submit();"),
    );
    $form['payment_report_to_date'] = array(
        '#type' => 'date_popup',
        '#default_value' => !empty($caches['payment_report_to_date']) ? $caches['payment_report_to_date'] : date("Y-m-d H:i:s", REQUEST_TIME),
        '#date_type' => DATE_DATETIME,
        '#date_timezone' => date_default_timezone(),
        '#date_format' => 'd-m-Y',
        '#date_increment' => 1,
        '#date_year_range' => '-10:+10',
        '#attributes' => array("onchange" => "this.form.submit();"),
    );

    $form['submit'] = array(
        '#type' => 'submit',
        '#value' => t('Lọc'),
//        '#prefix' => '<div class="buttons">',
//        '#suffix' => '<span class="btn btn-default btn-close-modal">Đóng</span></div>',
    );
    return $form;
}

