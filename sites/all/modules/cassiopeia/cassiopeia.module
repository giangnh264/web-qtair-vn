function cassiopeia_get_infant_rule(){
    global $user;
    if(!empty($user->uid)){
        $_user = user_load($user->uid);
        $rank = !empty($_user->field_tx_rank['und'][0]['tid'])?$_user->field_tx_rank['und'][0]['tid']:0;
        $_query = db_select("tbl_infant_price","tbl_infant_price");
        $_query->fields("tbl_infant_price");
        $_query->condition("uid",$_user->uid);
        $_query->condition("tid",$rank);
        $_query->condition("type",1);
        $infant = $_query->execute()->fetchObject();
        if(empty($infant)){
            $_query = db_select("tbl_infant_price","tbl_infant_price");
            $_query->fields("tbl_infant_price");
            $_query->condition("uid",0);
            $_query->condition("tid",$rank);
            $_query->condition("type",1);
            $infant = $_query->execute()->fetchObject();
        }
    }else{
        $_query = db_select("tbl_infant_price","tbl_infant_price");
        $_query->fields("tbl_infant_price");
        $_query->condition("uid",0);
        $_query->condition("tid",18);
        $_query->condition("type",1);
        $infant = $_query->execute()->fetchObject();
    }
    return $infant;
}
function cassiopeia_get_agent_fee($Airline,$_Class){
    global $user;
    $Price = 0;
    if(!empty($user->uid)){
        $_user = user_load($user->uid);
        $Price = 0;
        $rank = !empty($_user->field_tx_rank['und'][0]['tid'])?$_user->field_tx_rank['und'][0]['tid']:0;
        $query = db_select("tbl_agent_fee","tbl_agent_fee");
        $query->fields("tbl_agent_fee");
        $query->condition("uid",$user->uid);
        $query->condition("tid",$rank);
        $config = $query->execute()->fetchObject();
        if(empty($config)){
            $query = db_select("tbl_agent_fee","tbl_agent_fee");
            $query->fields("tbl_agent_fee");
            $query->condition("uid",0);
            $query->condition("tid",$rank);
            $config = $query->execute()->fetchObject();
        }
    }
    if(empty($config)){
        $query = db_select("tbl_agent_fee","tbl_agent_fee");
        $query->fields("tbl_agent_fee");
        $query->condition("uid",0);
        $query->condition("tid",18);
        $config = $query->execute()->fetchObject();
    }
    if(!empty($config)){
        switch ($Airline){
            case "VN" :
                switch (strtoupper($_Class)){
                    case "J" :
                    case "C" :
                    case "I" :
                    case "D" :
                        $Price=$config->VN_OTHER;
                        break;
                    default :
                        $Price=$config->VN_ECO;;
                }
                break;
            case "QH" :
                switch (strtoupper($_Class)){
                    case "BUSINESSSMART" :
                    case "BUSINESSFLEX" :
                        $Price=$config->QH_OTHER;
                        break;
                    default :
                        $Price=$config->QH_ECO;;
                }
                break;
            case "VJ" :
                switch (strtoupper($_Class)){
                    case "ECO" :
                    case "DELUXE" :
                        $Price=$config->VJ_ECO;
                        break;
                    default : $Price=$config->VJ_OTHER;;
                }
                break;
            case "VU" :
                $Price=$config->VT_ECO;
                break;
            case "9G" :
                switch (strtoupper($_Class)){
                    case "J" :
                    case "C" :
                    case "I" :
                        $Price=$config->SPA_OTHER;
                        break;
                    default :
                        $Price=$config->SPA_ECO;
                        break;
                }
                break;
        }
    }
    return $Price;
//    print_r("222");
}
function cassiopeia_image_load($image,$image_style="original"){
    if (!empty($image)) {
        $node_img = (array) $image;
        $node_img['alt'] = !empty($node_img['alt'])?$node_img['alt']:variable_get("site_name");
        $node_img['title'] = !empty($node_img['title'])?$node_img['title']:variable_get("site_name");
        $node_img['style_name'] = $image_style;
        $node_img['path'] = $node_img['uri'];
        $node_img = theme('image_style', $node_img);
        return $node_img;
    }
    return null;
}
function cassiopeia_cancel_booking_form($form, &$form_state, $caches = null){
    $form = array();
    $airline_options = array();
    $airline_options['VN'] = "Vietnam Airlines";
    $form['airline'] = array(
        '#type' => 'select',
        '#title' => t('Hãng'),
        '#options' => $airline_options,
        '#chosen' => false,
        '#attributes' => array("class" => array("issue-filter-change")),
    );
    $form['code'] = array(
        '#type' => 'textfield',
        '#title' => t('PNR'),
        '#required' => TRUE,
    );
    $form['submit'] = array(
        '#type' => 'submit',
        '#value' =>  "Xác nhận",
        '#prefix'   => "<div class='form-actions'>",
        '#attributes' => array("class" => array("btn-default")),
    );
    return $form;
}
function cassiopeia_cancel_booking_form_submit($form, &$form_state){
    $data = array();
    $data['AirlineCode'] = $form_state['values']['airline'];
    $data['PNRCode'] = $form_state['values']['code'];
    $result = cassiopeia_qt_meta_CancelBooking($data);
    if($result->code==0){
        drupal_set_message("Hủy hành trình thành công!");
    }
}

function cassiopeia_airline_load($iata){
  try{
    $query = db_select("tbl_airlines","tbl_airlines");
    $query->fields("tbl_airlines");
    $query->condition("iata",$iata);
    $result = $query->execute()->fetchObject();
    return $result;
  }catch (Exception $e){
    return null;
  }
}
