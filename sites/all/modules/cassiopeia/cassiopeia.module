function cassiopeia_room_booking_form($form, &$form_state, $data=array(),$admin=false){
    $arg = arg();
    $InputKey = REQUEST_TIME;
//    _print_r($data);
    if(!empty($data->status) && $data->status==3){
        $InputKey = "Done";
    }
    $form['#InputKey'] = $InputKey;
    $edit = false; // admin sửa
    $done = false; // Đã chốt
    $hotels = cassiopeia_get_nodes_by_category("hotel",null,null,true);
    $hotel_options = array();
    if (!empty($hotels)) {
        foreach ($hotels as $hotel) {
            if ($index = 1) {
                $_hotel = $hotel;
            }
            $hotel_options[$hotel->nid] = $hotel->title;
        }
    }
    if (!empty($data->booking_code)) {
        $edit = true;
        $form['#bookingCode'] = $data->booking_code;
    }
    $form['#attributes'] = array(
        "class" => array("cassiopeia-room-booking-form")
    );

    $form['hotel'] = array(
        '#type'     => 'select',
        '#title'    => t('Hotel'),
        '#options'  => $hotel_options,
        '#chosen'   => TRUE,
        '#ajax' => array(
            'callback'  => 'cassiopeia_booking_room_reload_by_hotel',
            'wrapper'   => 'roomContainer',
        ),
    );
    if (!empty($data->hotel)) {
        $_hotel = node_load($data->hotel);
        $form['hotel']['#default_value'] = $data->hotel;
    }
    if($arg[0]!="admin"){
        $form['hotel']['#attributes'] = array("class"=>array("hidden"));
    }
    $hotel = !empty($form_state['values']['hotel']) ? node_load($form_state['values']['hotel']) : $_hotel;
    $rooms = cassiopeia_get_rooms_by_hotel($hotel->nid);
    $room_options = array();
    $room_options[0] = "Chọn phòng";
    if (!empty($rooms)) {
        foreach ($rooms as $room) {
            $room_options[$room->nid] = $room->title;
        }
    }
    $listOfRoom = array();
    if (!empty($data->room)) {
        foreach ($data->room as $index => $value) {
            $listOfRoom[] = array(
                "nid" => $value['nid'],
                "quantity" => $value['quantity'],
            );
        }
    }
    if(!empty($data) && !empty($data->status) && $data->status==3){
        $done = true;
    }
    $form_state['roomList'] = !empty($form_state['roomList']) ? $form_state['roomList'] : $listOfRoom;
    $quantity_options = array();
    for ($i = 1; $i <= 50; $i++) {
        $quantity_options[$i] = $i . " phòng";
    }
    $adult_options = array();
    for ($i = 1; $i <= 50; $i++) {
        $adult_options[$i] = $i . " người";
    }
    $children_options = array();
    for ($i = 0; $i <= 50; $i++) {
        $children_options[$i] = $i;
    }
    $child_age_options = array();
    for ($i = 1; $i <= 17; $i++) {
        $child_age_options[$i] = $i;
    }
    $hasExtraBed = 2;
    $hasVAT = false;
    $validFlag = true;
    $price = 0;
    $Netprice = 0;
    $TotalAGPrice = 0;
    $extraBed = 0;
    $TotalExtraBed = 0;
    $tempExtrabed = 0;
    $roomExtrabed = array();
    $roomValid = array();
    $standard_people = array();
    if (!empty($form_state['values']['roomContainer'])) {
        foreach ($form_state['roomList'] as $_index => $_value) {
            $big_flag = false;
            $extraBed = 0;
            $weekend = 0;
            $children = 0;
            $infant = 0;
            $roomGroup = $form_state['values']['roomContainer']['roomGroup_' . $_index];
            $_room = node_load($roomGroup['room_' . $_index]);
            $children_age = !empty($_room->field_children_max_age['und'][0]['value']) ? $_room->field_children_max_age['und'][0]['value'] : 11;
            $infant_age = !empty($_room->field_infant_max_age['und'][0]['value']) ? $_room->field_infant_max_age['und'][0]['value'] : 5;
            $adult = $roomGroup['adult_' . $_index];
            $total_children = $roomGroup['children_' . $_index];
            $start_date = $form_state['values']['roomContainer']['roomGroup_' . $_index]['from_date_' . $_index];
            $end_date = $form_state['values']['roomContainer']['roomGroup_' . $_index]['to_date_' . $_index];
            $date1 = date_create($form_state['values']['roomContainer']['roomGroup_' . $_index]['from_date_' . $_index]);
            $date2 = date_create($form_state['values']['roomContainer']['roomGroup_' . $_index]['to_date_' . $_index]);
            $diff = date_diff($date1, $date2);
            $_price = cassiopeia_get_room_price_by_date(($start_date), ($end_date), $_room->nid);
            $valid_people = !empty($_room->field_people['und'][0]['value']) ? $_room->field_people['und'][0]['value'] : "1A+1C";
            $valid_max_people = !empty($_room->field_max_people['und'][0]['value']) ? $_room->field_max_people['und'][0]['value'] : "1A+1C";
            $_valid_people = explode("/", $valid_people);
            $_valid_max_people = explode("/", $valid_max_people);
            $_people_valid = array();
            $_max_valid = array();
            if (!empty($_valid_max_people)) {
                foreach ($_valid_max_people as $key => $max_person) {
                    $max_person = explode("+", $max_person);
                    foreach ($max_person as $person) {
                        if (strpos($person, "NL") != FALSE) {
                            $_max_valid[$key]['adult'] = (int)str_replace("NL", "", $person) * $roomGroup['quantity_' . $_index];
                        }
                        if (strpos($person, "TE") != FALSE) {
                            $_max_valid[$key]['children'] = (int)str_replace("TE", "", $person) * $roomGroup['quantity_' . $_index];
                        }
                        if (strpos($person, "EB") != FALSE) {
                            $_max_valid[$key]['infant'] = (int)str_replace("EB", "", $person) * $roomGroup['quantity_' . $_index];
                        }
                    }
                }
            }
            if (!empty($_valid_people)) {
                foreach ($_valid_people as $key => $max_person) {
                    $max_person = explode("+", $max_person);
                    foreach ($max_person as $person) {
                        if (strpos($person, "NL") != FALSE) {
                            $_people_valid[$key]['adult'] = (int)str_replace("NL", "", $person) * $roomGroup['quantity_' . $_index];
                        }
                        if (strpos($person, "TE") != FALSE) {
                            $_people_valid[$key]['children'] = (int)str_replace("TE", "", $person) * $roomGroup['quantity_' . $_index];
                        }
                        if (strpos($person, "EB") != FALSE) {
                            $_people_valid[$key]['infant'] = (int)str_replace("EB", "", $person) * $roomGroup['quantity_' . $_index];
                        }
                    }
                }
            }
            $standard_people[$_index] = $_valid_people[0];
            $stt = 1;
            if (!empty($roomGroup['roomGroupAge_' . $_index])) {
                foreach ($roomGroup['roomGroupAge_' . $_index] as $key => $age) {
                    if ($age <= $infant_age) {
                        $infant++;
                    } elseif ($age <= $children_age) {
                        $children++;
                    } else {
                        $adult++;
                    }
                    if ($stt >= $total_children) {
                        break;
                    }
                    $stt++;
                }

                $infant = $total_children - $children;
            } else {
                $infant = $total_children;
            }

            if (!empty($_max_valid)) {
                foreach ($_max_valid as $item) {
                    $flag = true;
                    if ($adult > $item['adult']) {
                        $flag = false;
                    } elseif ($children > $item['children']) {
                        if ($children - $item['children'] > $item['adult'] - $adult) {
                            $flag = false;
                        } else {
                            if ($infant > $item['infant']) {
                                if ($infant - $item['infant'] > ($item['adult'] - $adult) + ($item['children'] - $children)) {
                                    $flag = false;
                                }
                            }
                        }
                    } elseif ($infant > $item['infant']) {
                        if ($infant - $item['infant'] > ($item['adult'] - $adult) + ($item['children'] - $children)) {
                            $flag = false;
                        }
                    }
                    if ($flag != false) {
                        $big_flag = true;
                        break;
                    } else {
                        $big_flag = false;
                    }
                }
            }
            $plus_price = array();
            if (!empty($_people_valid)) {
                foreach ($_people_valid as $key => $item) {
                    $plus_adult = $adult - $item['adult'] > 0 ? $adult - $item['adult'] : 0;
                    $plus_children = $children - $item['children'] > 0 ? $children - $item['children'] : 0;
                    $plus_infant = $infant - $item['infant'] > 0 ? $infant - $item['infant'] : 0;
                    if (!empty($_price)) {
                        foreach ($_price as $priceKey => $priceValue) {
                            if (!empty($priceValue)) {
                                $plus_price[$key]['adult'] += $priceValue->adult * $plus_adult;
                                $plus_price[$key]['children'] += $priceValue->children * $plus_children;
                                $plus_price[$key]['infant'] += $priceValue->infant * $plus_infant;
                            }
                        }
                    }
                }
            }

            if (!empty($_price)) {
                foreach ($_price as $priceKey => $priceValue) {
                    if (!empty($priceValue)) {
                        $Netprice += $priceValue->price * $roomGroup['quantity_' . $_index];
                        $price += ($priceValue->price+$priceValue->booking_fee) * $roomGroup['quantity_' . $_index];
                        if (!empty($priceValue->is_weekend)) {
                            $weekend += $priceValue->is_weekend * $value['quantity'];
                        }
                        $extraBed = !empty($priceValue->extra_bed) ? $priceValue->extra_bed * $roomGroup['quantity_' . $_index]*$diff->format("%a") : 0;
                    }
                }
            }
            if ($big_flag == false) {
                $validFlag = false;
                $i = 1;
                $_message = "";
                $roomValid[$_index]['invalid'] = 1;
                $text = "Số người tối đa: ";
                foreach ($_max_valid as $item) {
                    $_text = "";
                    if (!empty($item['adult'])) {
                        $_text .= $item['adult'] . " người lớn";
                    }
                    if (!empty($item['children'])) {
                        $_text .= ", " . $item['children'] . " trẻ em";
                    }
                    if (!empty($item['infant'])) {
                        $_text .= ", " . $item['infant'] . " em bé";
                    }
                    if ($i == 1) {
                        $_message .= $_text;
                    } else {
                        $_message .= " hoặc " . $_text;
                    }
                    $i++;
                }
                $_message = $text . $_message;
                $roomValid[$_index]['message'] = $_message;
            } else {
                if (!empty($plus_price)) {
                    $plus_min_price = $plus_price[0];
                    foreach ($plus_price as $item) {
                        if ($item['adult'] + $item['children'] + $item['infant'] < $plus_min_price['adult'] + $plus_min_price['children'] + $plus_min_price['infant']) {
                            $plus_min_price = $item;
                        }
                    }
                }
                $form_state['roomList'][$_index]['invalid'] = 0;
            }
            if (!empty($form_state['values']['roomContainer']['roomGroup_' . $_index]['roomExtraBedLabel_' . $_index])) {
                $roomExtrabed[$_index] = $extraBed;
                $tempExtrabed += $extraBed;
            }
        }
        $adult_price = !empty($plus_min_price) ? $plus_min_price['adult'] : 0;
        $children_price = !empty($plus_min_price) ? $plus_min_price['children'] : 0;
        if (!empty($plus_min_price['infant'])) {
            $children_price += $plus_min_price['infant'];
        }
        $total_price = $price + $adult_price;
        $total_price += $weekend;

        $total_net_price = $Netprice + $adult_price;
        $total_net_price += $weekend;
        $total_net_price += $children_price;
        $total_net_price += $tempExtrabed;

        $total_price += $children_price;
        $TotalAGPrice = $total_price;
        $TotalAGPrice += $tempExtrabed;
    } else {
        $big_flag = true;
        $weekend = 0;
        if (!empty($data->room)) {
            foreach ($data->room as $index => $value) {
                $_room = node_load($value['nid']);
                $_price = cassiopeia_get_room_price_by_date($value['from_date'], $value['to_date'], $_room->nid);
                $valid_people = !empty($_room->field_people['und'][0]['value']) ? $_room->field_people['und'][0]['value'] : "2NL";
                $_valid_people = explode("/", $valid_people);
                $standard_people[$index] = $_valid_people[0];
                foreach ($_price as $priceKey => $priceValue) {
                    if (!empty($priceValue)) {
                        $Netprice += ($priceValue->price) * $value['quantity'];
                        $price += ($priceValue->price+$priceValue->booking_fee) * $value['quantity'];
                        if (!empty($priceValue->is_weekend)) {
                            $weekend += $priceValue->is_weekend * $value['quantity'];
                        }
                        $extraBed += !empty($priceValue->extra_bed) ? $priceValue->extra_bed * $value['quantity'] : 0;
                    }
                }
                $roomExtrabed[$index] = $value['extraBed'];
//                $TotalExtraBed += $value['extraBed'];
            }
        }
        $adult_price = !empty($data->surcharge_adult) ? $data->surcharge_adult : 0;
        $children_price = !empty($data->surcharge_children) ? $data->surcharge_children : 0;
        if (isset($data->extraBed)) {
            $hasExtraBed = 1;
        }
        if (!empty($data->VAT)) {
            $hasVAT = true;
        }
        $weekend = isset($data->surcharge_weekend) ? $data->surcharge_weekend : $weekend;
        $total_net_price = $Netprice + $adult_price + $weekend + $children_price;
        $total_price = $price + $adult_price + $weekend + $children_price;
        $total_net_price = !empty($data->net_price)?$data->net_price:0;
        $TotalAGPrice = !empty($data->partner_price)?$data->partner_price:0;
    }
    $form['roomContainer'] = array(
        '#type' => 'container',
        '#prefix' => '<div id="roomContainer">',
        '#suffix' => '</div>',
        '#tree' => TRUE,
    );
    if (!empty($form_state['roomList'])) {
        foreach ($form_state['roomList'] as $index => $item) {
            $form['roomContainer']['roomGroup_' . $index] = array(
                '#type'     => 'container',
                '#prefix'   => '<div id="roomGroup" class="room-group"><label class="roomGroupTitle">Hạng phòng</label>',
                '#suffix'   => '</div>',

            );
            $form['roomContainer']['roomGroup_' . $index]['room_' . $index] = array(
                '#type'             => 'select',
                '#title'            => t('Hạng phòng'),
                '#options'          => $room_options,
                '#chosen'           => TRUE,
                '#default_value'    => $item['nid'],
                '#ajax' => array(
                    'callback'      => 'cassiopeia_booking_room_change_room_ajax_callback',
                    'wrapper'       => 'orderInformationContainer',
                    'method'        => 'replace',
                    'effect'        => 'fade',
                ),
                '#element_validate' => array('cassiopeia_room_booking_form_room_validate'),
            );
            $form['roomContainer']['roomGroup_' . $index]['quantity_' . $index] = array(
                '#type'             => 'select',
                '#title'            => t('Số phòng'),
                '#options'          => $quantity_options,
                '#default_value'    => $item['quantity'],
                '#ajax' => array(
                    'callback'      => 'cassiopeia_booking_room_change_room_ajax_callback',
                    'wrapper'       => 'orderInformationContainer',
                    'method'        => 'replace',
                    'effect'        => 'fade',
                ),
            );
//            _print_r($_SESSION['booking_room']['start_date']);
            $form['roomContainer']['roomGroup_' . $index]['from_date_' . $index] = array(
                '#type'             => 'date_popup',
                '#default_value'    => !empty($data->room[$index]['from_date']) ? date("Y-m-d H:i:s", strtotime($data->room[$index]['from_date'])) : date("Y-m-d H:i:s", strtotime($_SESSION['booking_room']['start_date'])),
                '#date_type'        => DATE_DATETIME,
                '#date_timezone'    => date_default_timezone(),
                '#date_format'      => 'd-m-Y',
                '#date_increment'   => 1,
                '#date_year_range'  => '-10:+2',
                '#attributes'       => array("class" => array("roomBookingFromDate"), "readonly" => "readonly"),
                '#ajax' => array(
                    'callback'      => 'cassiopeia_booking_room_reload_by_children',
                    'wrapper'       => 'roomContainer',
                ),
            );
//            _print_r($data->room[$index]['to_date']);
//            _print_r($_SESSION['booking_room']['end_date']);
            $form['roomContainer']['roomGroup_' . $index]['to_date_' . $index] = array(
                '#type'             => 'date_popup',
                '#default_value'    => !empty($data->room[$index]['to_date']) ? date("Y-m-d H:i:s", strtotime($data->room[$index]['to_date'])) : date("Y-m-d H:i:s", strtotime($_SESSION['booking_room']['end_date'])),
                '#date_type'        => DATE_DATETIME,
                '#date_timezone'    => date_default_timezone(),
                '#date_format'      => 'd-m-Y',
                '#date_increment'   => 1,
                '#attributes'       => array("class" => array("roomBookingToDate"), "readonly" => "readonly"),
                '#date_year_range'  => '-10:+2',
                '#ajax' => array(
                    'callback'      => 'cassiopeia_booking_room_reload_by_children',
                    'wrapper'       => 'roomContainer',
                ),
            );
            if (!empty($form_state['values']['roomContainer']['roomGroup_' . $index]['to_date_' . $index])) {
                $date1 = date_create($form_state['values']['roomContainer']['roomGroup_' . $index]['from_date_' . $index]);
                $date2 = date_create($form_state['values']['roomContainer']['roomGroup_' . $index]['to_date_' . $index]);
                $diff = date_diff($date1, $date2);
            } else {
                $date1 = date_create( $data->room[$index]['from_date']);
                $date2 = date_create( $data->room[$index]['to_date']);
                $diff = date_diff($date1, $date2);
            }
//            $roomExtrabed[$index] = $roomExtrabed[$index]*($diff->format("%a"));
            $form['roomContainer']['roomGroup_' . $index]['number_of_night_' . $index] = array(
                '#type'         => 'textfield',
                '#title'        => t('Số đêm'),
                '#value'        => !empty($diff) ? $diff->format("%a") : 1,
                '#prefix'       => "<div id='numberOfNight_" . $index . "' class='numberOfNight'>",
                '#suffix'       => "</div>",
                '#attributes'   => array("disabled" => "disabled", "readonly" => "readonly"),
            );
            $form['roomContainer']['roomGroup_' . $index]['adult_' . $index] = array(
                '#type'             => 'select',
                '#title'            => t('Số người lớn'),
                '#options'          => $adult_options,
                '#default_value'    => !empty($data->room[$index]['adult']) ? $data->room[$index]['adult'] : 1,
                '#chosen'           => false,
                '#ajax' => array(
                    'callback'      => 'cassiopeia_booking_room_change_adult_ajax_callback',
                    'wrapper'       => 'orderInformationContainer',
