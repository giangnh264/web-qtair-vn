function cassiopeia_meta_get_most_cheap_flight($ListFlights)
{
    $Flight = $ListFlights[0];
    foreach ($ListFlights as $flight) {
        if ($Flight->TotalPrice > $flight->TotalPrice) {
            $Flight = $flight;
        }
    }
    return $Flight;
}
function cassiopeia_meta_FareOptionSession_load($Flight,$FareOptionSession)
{
    $result = new stdClass();
    foreach($Flight->FareOptions as $fareOption){
        if($fareOption->FareOptionSession==$FareOptionSession){
            $result = $fareOption;
            break;
        }
    }
    return $result;
}
