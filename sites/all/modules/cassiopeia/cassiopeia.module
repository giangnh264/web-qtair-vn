function _cassiopeia_get_day_of_week($timestamp)
{
    $return = array();
    $index = 1;
    $_output = "";
    switch (date('N', $timestamp)) {
        case '1':
            $_output = t('Monday');
            $index = 1;
            break;
        case '2':
            $_output = t('Tuesday');
            $index = 2;
            break;
        case '3':
            $_output = t('Wednesday');
            $index = 3;
            break;
        case '4':
            $_output = t('Thursday');
            $index = 4;
            break;
        case '5':
            $_output = t('Friday');
            $index = 5;
            break;
        case '6':
            $_output = t('Saturday');
            $index = 6;
            break;
        case '7':
            $_output = t('Sunday');
            $index = 0;
            break;
    }
    $return = array(
        "name" => $_output,
        "index" => $index,
    );
    return $return;
}

function cassiopeia_render_airport_name($point)
{
    global $language;
    if ($language == "vi") {
        if (!empty($point->name_vi)) {
            $name = $point->name_vi;
        } else {
            $name = $point->name;
        }
    } else {
        $name = $point->name;
    }
    print($name);
}

function cassiopeia_render_flight_duration($flight)
{
    $duration = 0;
    foreach ($flight->ListSegment as $segment) {
        $duration += $segment->Duration;
    }
    print(floor($duration / 60) . "h " . ($duration % 60) . "p");
}

function cassiopeia_maybay_get_baggage($data)
{

    $curl = curl_init();

    curl_setopt_array($curl, array(
        CURLOPT_URL => "http://data.webvemaybay.com/AirDataWS.asmx?op=Lcc_GetBaggages",
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_ENCODING => "",
        CURLOPT_MAXREDIRS => 10,
        CURLOPT_TIMEOUT => 0,
        CURLOPT_FOLLOWLOCATION => true,
        CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
        CURLOPT_CUSTOMREQUEST => "POST",
        CURLOPT_POSTFIELDS =>
            "<x:Envelope xmlns:x=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:tem=\"http://tempuri.org/\">   
                <x:Header>       
                    <tem:Authentication>           
                        <tem:HeaderUser>maybay</tem:HeaderUser>           
                        <tem:HeaderPassword>MayBay@6868api#</tem:HeaderPassword>       
                    </tem:Authentication>   
                </x:Header>   
                <x:Body>       
                    <tem:Lcc_GetBaggages>           
                        <tem:Email>" . AGENTACCOUNT . "</tem:Email>           
                        <tem:Password>" . AGENTPASSWORD . "</tem:Password>           
                        <tem:AirlineCode>" . $data->AirlineCode . "</tem:AirlineCode>           
                        <tem:ItineraryType>" . $data->ItineraryType . "</tem:ItineraryType>           
                        <tem:DepartureSelectValue>" . $data->DepartureSelectValue . "</tem:DepartureSelectValue>           
                        <tem:ReturnSelectValue>" . $data->ReturnSelectValue . "</tem:ReturnSelectValue>           
                        <tem:SessionAll>" . $data->SessionAll . "</tem:SessionAll>           
                        <tem:isDomestic>" . $data->isDomestic . "</tem:isDomestic>           
                        <tem:NumberOfAvailFlightsDepart>" . $data->NumberOfAvailFlightsDepart . "</tem:NumberOfAvailFlightsDepart>           
                        <tem:NumberOfAvailFlightsReturn>" . $data->NumberOfAvailFlightsReturn . "</tem:NumberOfAvailFlightsReturn>       
                    </tem:Lcc_GetBaggages>   
                </x:Body>\r\n
            </x:Envelope>",
        CURLOPT_HTTPHEADER => array(
            "Content-Type: text/xml; charset=utf-8"
        ),
    ));

    $response = curl_exec($curl);

    curl_close($curl);
    $result = convert_xml_to_array($response);
    $bagages = null;
    if (!empty($result['soapBody']['Lcc_GetBaggagesResponse']['Lcc_GetBaggagesResult']['BaggageDepart']['Baggage'])) {
        $bagages = $result['soapBody']['Lcc_GetBaggagesResponse']['Lcc_GetBaggagesResult']['BaggageDepart']['Baggage'];
    }
    return $bagages;
}

function cassiopeia_get_baggage($data)
{
    global $language;
    global $user;
    $baggages = null;
    $obj = new stdClass();
    $obj->ListFareData[] = array(
        "Session" => $data['Session'],
        "FareDataId" => $data['FareDataId'],
        "ListFlight" => $data['ListFlight'],
    );
    try {
        db_insert("tbl_log")->fields(array(
            "created" => REQUEST_TIME,
            "uid" => $user->uid,
            "request_url" => "http://platform.datacom.vn/flights/getbaggage",
            "postfields" => serialize($obj),
        ))->execute();
    } catch (Exception $e) {

    }
    $obj->HeaderUser = HEADERUSER;
    $obj->HeaderPass = HEADERPASS;
    $obj->Language = $language->language;
    $obj->AgentAccount = AGENTACCOUNT;
    $obj->AgentPassword = AGENTPASSWORD;
//    print_r(($obj));
//    die;
    $curl = curl_init();
    curl_setopt_array($curl, array(
        CURLOPT_URL => "http://platform.datacom.vn/flights/getbaggage",
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_ENCODING => "",
        CURLOPT_MAXREDIRS => 10,
        CURLOPT_TIMEOUT => 0,
        CURLOPT_FOLLOWLOCATION => true,
        CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
        CURLOPT_CUSTOMREQUEST => "POST",
        CURLOPT_POSTFIELDS => json_encode($obj),
        CURLOPT_HTTPHEADER => array(
            "Content-Type: application/json"
        ),
    ));

    $baggages = curl_exec($curl);

    curl_close($curl);
    return $baggages;
}

function _print_r($data)
{
    global $user;
    if (isset($_SESSION['lastUid'])) {
        print("---Admin----");
        print("<pre>");
        print_r($data);
        print("</pre>");
    }
}

