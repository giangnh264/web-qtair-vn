function cleanAmount($text){
    $amount = str_replace(",","",$text);
    $amount = str_replace("VND","",$amount);
    $amount = trim($amount);
    return $amount;
}
function cassiopeia_create_issue_report($data){
    global $user;
    try {
        $partner_price = $data->partner_price;
        $price = $data->price;
        $last = cassiopeia_get_last_row("tbl_issue_report");
        if (!empty($last)) {
            $temp = str_replace("ISSUE_", "", $last['tran_code']);
            $tran_code = "ISSUE_" . ($temp + 1);
        } else {
            $tran_code = "ISSUE_" . date("m", REQUEST_TIME) . "0002";
        }
        $_agent = user_load($data->agent);
        $balance = !empty($_agent->field_account_balance['und'][0]['value']) ? $_agent->field_account_balance['und'][0]['value'] : 0;
        $tran_kind = cassiopeia_get_tran_kind_by_id($data->tran_kind);
        $flag = true;
        $_quantity = !empty($data->quantity) ? $data->quantity : 0;
        if ($tran_kind['type'] == 1) { //cộng tiền
            $balance += $partner_price;
            $_quantity = 0 - $_quantity;
            $partner_price = 0 - $partner_price;
            $price = 0 - $price;
        } else { //trừ tiền
            $balance -= $partner_price;
        }
        if ($flag == true) {
            $db_transaction = db_transaction();
            try {
                if ($data->tran_kind == 4) { //xuất vé
                    db_update("tbl_booking")->fields(array(
                        "status" => "TICKETED",
                    ))
                        ->condition("pnr_code", "%" . $data->PNR . "%", "LIKE")
                        ->execute();
                }

                db_insert("tbl_issue_report")->fields(array(
                    "created"       => REQUEST_TIME,
                    "date"          => !empty($data->date) ? $data->date : REQUEST_TIME,
                    "tran_code"     => $tran_code,
                    "booking_code"       => !empty($data->booking_code) ? $data->booking_code : "",
                    "airline"       => !empty($data->airline) ? $data->airline : "",
                    "tran_kind"     => !empty($data->tran_kind) ? $data->tran_kind : "",
                    "PNR"           => !empty($data->PNR) ? strtoupper($data->PNR) : "",
                    "quantity"      => $_quantity,
                    "partner_price" => $partner_price,
                    "price"         => $price,
                    "revenue"       => $partner_price - $price,
                    "agent"         => !empty($data->agent) ? $data->agent : 0,
                    "content"       => !empty($data->content) ? $data->content : "",
                    "tran_user"     => $user->uid,
                    "balance"       => !empty($_agent->uid)?$balance:0,
                    "category"      => "issue",
                ))->execute();
                db_insert("tbl_report")->fields(array(
                    "created"       => REQUEST_TIME,
                    "type"          => "issue",
                    "tran_code"     => $tran_code,
                ))->execute();
                db_insert("tbl_log")->fields(array(
                    "created"       => REQUEST_TIME,
                    "uid"           => $user->uid,
                    "value"         => "Thêm báo cáo",
                    "booking_code"  => $tran_code,
                ))->execute();
                if(!empty($_agent->uid)){
                    $query = db_select("tbl_issue_report", "tbl_issue_report");
                    $query->fields("tbl_issue_report");
                    $query->condition("agent", $_agent->uid);
                    $query->condition("date", strtotime(date("d-m-Y 00:00", strtotime("01-09-2020"))), ">=");
                    $query->addExpression("SUM(partner_price)", "total");
                    $query->groupBy("agent");
                    $result = $query->execute()->fetchObject();
                    $query1 = db_select("tbl_room_booking_report", "tbl_room_booking_report");
                    $query1->fields("tbl_room_booking_report");
                    $query1->condition("agent", $_agent->uid);
                    $query1->addExpression("SUM(partner_price)", "total");
                    $query1->groupBy("agent");
                    $result1 = $query1->execute()->fetchObject();
                    $total = $result->total;
                    if (!empty($result1)) {
                        $total += $result1->total;
                    }
                    $point = round($total / 1000000);
                    $_agent->field_point['und'][0]['value'] = $point;
                    $_agent->field_account_balance['und'][0]['value'] = $balance;

                    user_save($_agent);
                }
            } catch (Exception $e) {
                print_r($e);
            }
        }
    }catch (Exception $e){
        _print_r($e);
    }
}
function cassiopeia_get_last_row($table){
    $query = db_select($table, "tbl");
    $query->fields("tbl");
    $query->range(0, 1);
    $query->orderBy("id", "DESC");
    $last = $query->execute()->fetchAssoc();
    return $last;
}

