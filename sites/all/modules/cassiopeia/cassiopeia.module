        $options[$tx_area->tid] = $tx_area->name;
    }
    $form['tx_area'] = array(
        '#type' => 'select',
        '#title' => t('Tỉnh / TP'),
        '#options' => $options,
        '#chosen' => TRUE,
        '#attributes' => array("onchange" => "this.form.submit();"),
    );
    if (!empty($cache['tx_area'])) {
        $form['tx_area']['#default_value'] = $cache['tx_area'];
    }
    $form['hotel'] = array(
        '#type'         => 'textfield',
        '#title'        => t('Tên khách sạn'),
        '#size'         => 60,
        '#maxlength'    => 128,
    );
    if (!empty($cache['hotel'])) {
        $form['hotel']['#default_value'] = $cache['hotel'];
    }
    $form['status'] = array(
        '#type' => 'select',
        '#title' => t('Tình trạng'),
        '#options' => array(
            "all"   => "Tất cả",
            1       => "Đặt chỗ",
            2       => "Báo giá",
            3       => "Đã chốt",
            4       => "Thất bại",
            5       => "Sắp đi",
            6       => "Đã đi",
        ),
        '#chosen' => TRUE,
//        '#attributes' => array("onchange" => "this.form.submit();"),
    );
    if (!empty($cache['status'])) {
        $form['status']['#default_value'] = $cache['status'];
    }

    return $form;
}
