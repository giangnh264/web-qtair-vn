}

function cassiopeia_agent_report_filter_form($form, &$form_state, $caches = null)
{
    $form = array();
    $form['code'] = array(
        '#type' => 'textfield',
        '#title' => t('Mã'),
        '#attributes' => array("placeholder" => "Mã đại lý"),
        '#default_value' => !empty($caches['code']) ? $caches['code'] : "",
    );
    $form['name'] = array(
        '#type' => 'textfield',
        '#title' => t('Tên Đại lý'),
        '#attributes' => array("placeholder" => "Tên đại lý"),
        '#default_value' => !empty($caches['name']) ? $caches['name'] : "",
    );
    $form['tel'] = array(
        '#type' => 'textfield',
        '#title' => t('Số điện thoại'),
        '#attributes' => array("placeholder" => "Số điện thoại"),
        '#default_value' => !empty($caches['tel']) ? $caches['tel'] : "",
    );
    $form['mail'] = array(
        '#type' => 'textfield',
        '#title' => t('Email'),
        '#attributes' => array("placeholder" => "Email"),
        '#default_value' => !empty($caches['mail']) ? $caches['mail'] : "",
    );
    $query = db_select("users", "tbl_user");
    $query->fields("tbl_user");
    $query->join("users_roles", "tbl_role", "tbl_role.uid = tbl_user.uid");
    $query->condition("tbl_role.rid", 5);
    $result = $query->execute()->fetchAll();
    $sale_options = array();
    $sale_options['all'] = "Tất cả";
    if (!empty($result)) {
        foreach ($result as $value) {
            $sale = user_load($value->uid);
            $sale_code = !empty($sale->cassiopeia_manager_partners_filter_form['und'][0]['value']) ? $sale->cassiopeia_manager_partners_filter_form['und'][0]['value'] : "";
            $sale_transaction_name = !empty($sale->field_account_transaction_name['und'][0]['value']) ? $sale->field_account_transaction_name['und'][0]['value'] : "";
            $sale_options[$value->uid] = $sale_code . "-" . $sale_transaction_name;
        }
    }
    $form['sale'] = array(
        '#type' => 'select',
        '#title' => t('Sale'),
        '#options' => $sale_options,
        '#default_value' => !empty($caches['sale']) ? $caches['sale'] : "",
    );
    $form['rank'] = array(
        '#type' => 'select',
        '#title' => t('Hạng'),
        '#options' => array(
            "all" => "Tất cả",
            500 => "Thành viên",
            1000 => "Bạc",
            2000 => "Vàng",
            1000000 => "Kim cương",
        ),
        '#default_value' => !empty($caches['rank']) ? $caches['rank'] : "",
    );
    $form['num_per_page'] = array(
        '#type' => 'select',
        '#title' => t('Hiển thị'),
        '#options' => array(
            50 => "50",
            100=> "100",
            200 => "200",
        ),
        '#attributes' => array("onchange" => "this.form.submit();"),
        '#resquired' => TRUE,
        '#default_value' => isset($caches['num_per_page']) ? $caches['num_per_page'] : 50,
    );
    $form['status'] = array(
        '#type' => 'select',
        '#title' => t('Hoạt động'),
        '#options' => array(
            "all" => "Tất cả",
            1 => "Có",
            0 => "Không",
        ),
        '#default_value' => isset($caches['status']) ? $caches['status'] : "status",
    );    
    $profit_options = array();
    $profit_options['all'] = "Tất cả";
    $profit_options['morethanZero'] = "Số dư dương";
    $profit_options['lessthanZero'] = "Số dư âm";
    $profit_options['equalZero'] = "Số dư không";
    $form['profit_filter'] = array(
        '#type' => 'select',
        '#title' => t('Số dư'),
        '#options' => $profit_options,
        '#default_value' => !empty($caches['profit_filter']) ? $caches['profit_filter'] : "all",
    );
    $form['order_by'] = array(
        '#type' => 'select',
        '#title' => t(''),
        '#options' => array(
            "agent_code" => "Tên giao dịch",
            "balance" => "Tên giao dịch",
            "point" => "Tên giao dịch",
        ),
        '#class' => "hidden",
        '#resquired' => TRUE,
        '#attributes' => array("class" => array("hidden")),
    );
    if (!empty($caches['order_by'])) {
        $form['order_by']['#default_value'] = $caches['order_by'];
    }
    $form['direction'] = array(
        '#type' => 'select',
        '#title' => t(''),
        '#options' => array(
            "none" => "Không",
            "ASC" => "Tăng dần",
            "DESC" => "Giảm dần",
        ),
        '#class' => "hidden",
        '#resquired' => TRUE,
        '#attributes' => array("class" => array("hidden")),
    );
    if (!empty($caches['direction'])) {
        $form['direction']['#default_value'] = $caches['direction'];
    }
    $form['submit'] = array(
        '#type' => 'submit',
        '#value' => t('Lọc'),
    );
    return $form;
}

