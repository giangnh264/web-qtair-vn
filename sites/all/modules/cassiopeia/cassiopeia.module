function cassiopeia_add_refund_report_form_submit($form, &$form_state)
{
    global $user;
    try {
        $query = db_select("tbl_refund_report", "tbl_refund_report");
        $query->fields("tbl_refund_report");
        $query->range(0, 1);
        $query->orderBy("id", "DESC");
        $last = $query->execute()->fetchAssoc();
        if (!empty($last)) {
            $temp = str_replace("REF", "", $last['tran_code']);
            $tran_code = "REF" . date("m", REQUEST_TIME) . ($temp + 1);
        } else {
            $tran_code = "REF" . date("m", REQUEST_TIME) . "0001";
        }
        db_insert("tbl_refund_report")->fields(array(
            "created" => REQUEST_TIME,
            "tran_code" => $tran_code,
            "amount" => !empty($form_state['values']['amount']) ? $form_state['values']['amount'] : "",
            "refund" => !empty($form_state['values']['refund']) ? $form_state['values']['refund'] : "",
            "PNR" => !empty($form_state['values']['pnr']) ? $form_state['values']['pnr'] : "",
            "airline_created" => strtotime($form_state['values']['airline_date']),
            "partner" => !empty($form_state['values']['partner']) ? $form_state['values']['partner'] : 0,
            "tran_kind" => 2,
            "tran_user" => $user->uid,
            "status" => 0, // chưa sử dụng
        ))->execute();
        db_insert("tbl_report")->fields(array(
            "created" => REQUEST_TIME,
            "type" => "refund",
            "tran_code" => $tran_code,
        ))->execute();
    } catch (Exception $e) {
        print_r($e);
        die;
    }
}

function cassiopeia_add_payment_report_form($form, &$form_state, $_conditions = null)
{
    $form = array();
    try {
        $query = db_select("users", "tbl_user");
        $query->fields("tbl_user");
        $query->join("users_roles", "tbl_role", "tbl_role.uid = tbl_user.uid");
        $query->condition("tbl_role.rid", 4);
        $query->leftJoin("field_data_field_account_sale", "tbl_sale", "tbl_sale.entity_id = tbl_user.uid");
        $query->join("field_data_field_account_status", "field_account_status", "field_account_status.entity_id=tbl_user.uid");
        $query->condition("field_account_status.field_account_status_tid", array(13, 22), "IN");
        $result = $query->execute()->fetchAll();
    } catch (Exception $e) {
        print_r($e);
    }
    $options = array();
    $options[0] = "Chọn Đại lý";
    if (!empty($result)) {
        foreach ($result as $value) {
            $agent = user_load($value->uid);
            $field_account_transaction_name = !empty($agent->field_account_transaction_name['und'][0]['value']) ? $agent->field_account_transaction_name['und'][0]['value'] : "";
            $account_code = !empty($agent->field_account_code['und'][0]['value']) ? $agent->field_account_code['und'][0]['value'] : "";
            $options[$value->uid] = $account_code . " - " . $field_account_transaction_name;
        }
    }
    $form['agent'] = array(
        '#type' => 'select',
        '#title' => t('Đại lý'),
        '#options' => $options,
        '#chosen' => TRUE,
    );
    $form['value'] = array(
        '#title' => t('Số tiền'),
        '#type' => 'textfield',
        '#size' => 60,
        '#maxlength' => 128,
        '#attributes' => array("class" => array("number_format")),
        '#required' => TRUE,
    );

    $query = db_select("tbl_tran_kind", "tbl_tran_kind");
    $query->fields("tbl_tran_kind");
    $query->condition("kind", "payment");
    $result = $query->execute()->fetchAll();
    $options = array();
    if (!empty($result)) {
        foreach ($result as $value) {
            $options[$value->id] = $value->name;
        }
    }
    $form['tran_kind'] = array(
        '#type' => 'select',
        '#title' => t('Loại giao dịch'),
        '#options' => $options,
        '#chosen' => TRUE,
        '#required' => TRUE,
        '#default_value' => 1,
    );

    $form['content'] = array(
        '#title' => t('Nội dung'),
        '#type' => 'textfield',
    );
    $form['submit'] = array(
        '#type' => 'submit',
        '#value' => t('Thêm mới'),
//        '#prefix' => '<div class="buttons">',
//        '#suffix' => '<span class="btn btn-default btn-close-modal">Đóng</span></div>',
    );
    return $form;
}

