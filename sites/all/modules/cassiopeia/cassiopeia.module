function cassiopeia_void_List_Ticket_Number($data){
    global $user;
    $voided = false;
    $void = cassiopeia_maybay_api_void($form_state['values']['code']);
    if (strpos($void,"VOIDED") !== false) {
        $voided = true;
    }
    try{
        db_insert("tbl_ticket_void")->fields(array(
            "uid"       => $user->uid,
            "created"   => REQUEST_TIME,
            "pnr_code"       => $form_state['values']['code'],
            "status"    => $voided===true?"OK":"FAIL",
            "message"    => $void,
        ))->execute();
    }catch (Exception $e){
        print_r($e);
        die;
    }
    if($voided){
        drupal_set_message("Void vé thành công!");
        $form_state['redirect'] = array(
            'admin/manager/ticketIssue',
            array(
                'query' => array(
                    'data' => array(
                        "code"      => $form_state['values']['code'],
                        "airline"   => "VN",
                    ),
                )
            ),
        );
    }else{
        drupal_set_message("Void vé thất bại!");
    }
}
function cassiopeia_maybay_api_void($PNR){
    $curl = curl_init();

    curl_setopt_array($curl, array(
        CURLOPT_URL => 'http://data.webvemaybay.com/airdataws.asmx?op=Sab_VoidPNR',
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_ENCODING => '',
        CURLOPT_MAXREDIRS => 10,
        CURLOPT_TIMEOUT => 0,
        CURLOPT_FOLLOWLOCATION => true,
        CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
        CURLOPT_CUSTOMREQUEST => 'POST',
        CURLOPT_POSTFIELDS => "
        <x:Envelope xmlns:x=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:tem=\"http://tempuri.org/\">
             <x:Header>
                <tem:Authentication>
                    <tem:HeaderUser>" . HEADERUSER . "</tem:HeaderUser>
                    <tem:HeaderPassword>" . HEADERPASS . "</tem:HeaderPassword>
                </tem:Authentication>
            </x:Header>
            <x:Body>
                <tem:Sab_VoidPNR>
                    <tem:Email>" . AGENTACCOUNT . "</tem:Email>
                     <tem:Password>" . AGENTPASSWORD . "</tem:Password>
                    <tem:PNRCode>" . $PNR . "</tem:PNRCode>
                </tem:Sab_VoidPNR>
            </x:Body>
        </x:Envelope>",
        CURLOPT_HTTPHEADER => array(
            'Content-Type: text/xml; charset=utf-8'
        ),
    ));
//echo "
//        <x:Envelope xmlns:x=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:tem=\"http://tempuri.org/\">
//             <x:Header>
//                <tem:Authentication>
//                    <tem:HeaderUser>" . HEADERUSER . "</tem:HeaderUser>
//                    <tem:HeaderPassword>" . HEADERPASS . "</tem:HeaderPassword>
//                </tem:Authentication>
//            </x:Header>
//            <x:Body>
//                <tem:openPnr>
//                    <tem:Email>" . AGENTACCOUNT . "</tem:Email>
//                     <tem:Password>" . AGENTPASSWORD . "</tem:Password>
//                    <tem:PNRCode>" . $PNR . "</tem:PNRCode>
//                </tem:openPnr>
//            </x:Body>
//        </x:Envelope>";
//die;
    $response = curl_exec($curl);

    curl_close($curl);
    return convert_xml_to_array($response)['soapBody']['Sab_VoidPNRResponse']['Sab_VoidPNRResult'];

}

function cassiopeia_update_booking_price($booking){
    $booking_detail = unserialize($booking->data);
    if($booking->DO==0){
        $Passengers = $booking_detail->ListPassengers;
    }else{
        $Passengers = $booking_detail->DepartureFlights->ListPassengers;
    }
    $total_price = 0;
    $query = db_select("tbl_ticket","tbl_ticket");
    $query -> fields("tbl_ticket");
    $query -> condition("booking_code",$booking->booking_code,"=");
    $query->orderBy("StartDate","ASC");
    $tickets = $query -> execute() -> fetchAll();
    if(!empty($tickets)){
        $_fee = 0;
        $adult_fee = 0;
        $child_fee = 0;
        $infant_fee = 0;
        $index=0;
        $__airlines = array();
        foreach($tickets as $ticket){
            $Flight = unserialize($ticket->ticket);
            $endpoint = cassiopeia_get_airport($Flight['EndPoint']);
            if($endpoint->country_code=="VN"){
                $region_code = "DO";
            }else{
                $region_code = $endpoint->region_code;
            }
            $region_fee = cassiopeia_get_fee_by_airline_and_region($ticket->airline,$region_code);
            if(!empty($region_fee)){
                $_fee =$region_fee['value'];
            }
            $adult_fee += $_fee+ $Flight['PriceAdult']+ $Flight['FeeAdult']+ $Flight['TaxAdult'];
            $child_fee += $_fee+ $Flight['PriceChild']+ $Flight['FeeChild']+ $Flight['TaxChild'];
            $infant_fee += $Flight['PriceInfant']+ $Flight['FeeInfant']+ $Flight['TaxInfant'];
        }
        foreach((array)$Passengers as $passenger){
            switch($passenger['Type']){
                case "ADT": $price = $adult_fee; break;
                case "CHD": $price = $child_fee; break;
                case "INF": $price = $infant_fee; break;
            }
            $total_price+=$price;
        }
        if(!empty($booking_detail->ReturnFlights->ListPassengers[0]['BaggageReturn']) || !empty($booking_detail->DepartureFlights->ListPassengers[0]['BaggageDeparture'])){
            if(!empty($booking_detail->DepartureFlights->ListPassengers)){
                foreach($booking_detail->DepartureFlights->ListPassengers as $Passenger){
                    $baggage = cassiopeia_get_baggage_by_weight_and_airline($Passenger['BaggageDeparture'],$booking_detail->DepartureFlights->AirlineCode);
                    $total_price+=$baggage->amount;
                }
            }
            if(!empty($booking_detail->ReturnFlights->ListPassengers)){
                foreach($booking_detail->ReturnFlights->ListPassengers as $Passenger){
                    $baggage = cassiopeia_get_baggage_by_weight_and_airline($Passenger['BaggageReturn'],$booking_detail->ReturnFlights->AirlineCode);
                    $total_price+=$baggage->amount;
                }
            }
        }
    }
    $query = db_update("tbl_booking");
    $query->condition("booking_code", $booking->booking_code, "=");
    $query->fields(array(
        "price"=>$total_price
    ))->execute();
}
function cassiopeia_form_home_setting_node_form_alter(&$form,&$form_state){
    unset($form['title']);
    unset($form['actions']['delete']);
    unset($form['actions']['preview']);
}
function cassiopeia_get_flight_by_select_value($ListFlights,$SelectValue)
{
    $Flight = null;
    if(!empty($ListFlights)){
        foreach($ListFlights as $Flight_Item){
            if($Flight_Item['SelectValue'] == $SelectValue){
                $Flight = $Flight_Item;
                break;
            }
        }
    }
    return $Flight;
}
function cassiopeia_issue_report_add_form($form,&$form_state){
    drupal_add_js(drupal_get_path("theme","cassiopeia_admin_theme_white")."/javascripts/select2-4.0.13/dist/js/select2.full.min.js");

    $airlines = cassiopeia_get_airlines();
    $airline_options = array();
    $airline_options['all'] = "Tất cả";
    $airline_options['VN'] = "Vietnam Airlines";
    $airline_options['VJ'] = "VietJet Air";
    $airline_options['BL'] = "Pacific Airlines";
    $airline_options['QH'] = "Bammboo Airways";
    foreach($airlines as $airline){
        $airline_options[$airline->iata] = $airline->iata." - ".$airline->name;
    }
    $form['airline'] = array(
        '#type' => 'select',
        '#title' => t('Hãng hàng không'),
        '#options' => $airline_options,
        '#default_value' => !empty($caches['airline']) ? $caches['airline'] : "",
    );
    $query = db_select("tbl_tran_kind", "tbl_tran_kind");
    $query->fields("tbl_tran_kind");
    $query->condition("kind", "issue");
