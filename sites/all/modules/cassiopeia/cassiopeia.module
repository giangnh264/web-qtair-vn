function cassiopeia_airport_add_form_submit($form, &$form_state)
{
    $transaction = db_transaction();
    try {
        $airport = cassiopeia_get_airport($form_state['values']['code']);
        if (!empty($airport)) {
            $query = db_select("tbl_region", "tbl_region");
            $query->fields("tbl_region");
            $query->condition("id", $form_state['values']['region']);
            $region = $query->execute()->fetchAssoc();
            db_update("tbl_airports")
                ->fields(array(
//                    "code"          =>  $form_state['values']['code'],
                    "name" => $form_state['values']['name'],
                    "name_vi" => $form_state['values']['name_vi'],
                    "city" => $form_state['values']['city'],
                    "city_vi" => $form_state['values']['city_vi'],
                    "city_code" => $form_state['values']['city_code'],
                    "country" => $form_state['values']['country'],
                    "country_vi" => $form_state['values']['country_vi'],
                    "country_code" => $form_state['values']['country_code'],
                    "region" => !empty($region['name']) ? $region['name'] : "",
                    "region_vi" => !empty($region['name_vi']) ? $region['name_vi'] : "",
                    "region_code" => !empty($region['code']) ? $region['code'] : "",
                    "created" => REQUEST_TIME,
                ))->condition("code", $form_state['values']['code'])->execute();
        } else {
            $query = db_select("tbl_region", "tbl_region");
            $query->fields("tbl_region");
            $query->condition("id", $form_state['values']['region']);
            $region = $query->execute()->fetchAssoc();
            db_insert("tbl_airports")
                ->fields(array(
                    "code" => $form_state['values']['code'],
                    "name" => $form_state['values']['name'],
                    "name_vi" => $form_state['values']['name_vi'],
                    "city" => $form_state['values']['city'],
                    "city_vi" => $form_state['values']['city_vi'],
                    "city_code" => $form_state['values']['city_code'],
                    "country" => $form_state['values']['country'],
                    "country_vi" => $form_state['values']['country_vi'],
                    "country_code" => $form_state['values']['country_code'],
                    "region" => !empty($region['name']) ? $region['name'] : "",
                    "region_vi" => !empty($region['name_vi']) ? $region['name_vi'] : "",
                    "region_code" => !empty($region['code']) ? $region['code'] : "",
                    "created" => REQUEST_TIME,

                ))->execute();
        }

    } catch (Exception $e) {
        $transaction->rollback();
    }
}

