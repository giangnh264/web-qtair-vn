    );

//    $form['orderInformationContainer']['roomPriceGroup']['roomPriceValue'] = array(
//        '#type' => 'textfield',
//        '#title' => t(''),
//        '#value'        => $_adult_price,
//        '#size' => 60,
//        '#maxlength' => 128,
