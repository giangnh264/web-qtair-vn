function cassiopeia_send_booking_mail($booking_code, $_mail, $DO = 0, $custom_subject = "", $attachments = array())
{
    $booking = cassiopeia_qt_ticket_booking_load_by_code($booking_code);
//    print_r($booking_code);
//    die;
    try{
        $site_mail = "";
        $subject_mail = "Booking ".ucfirst(SITE_DOMAIN)." cho mã đặt chỗ ".$booking->pnr_code;
        
        if (trim($custom_subject) !== '') {
            $subject_mail = $custom_subject;
        }
        
        if($booking->DO==0){
            $body[] = _cassiopeia_render_theme("module", "cassiopeia", "templates/mail/booking-mail-international.tpl.php", array("booking_code" => $booking_code));
        }else{
            //$body[] = _cassiopeia_render_theme("module", "cassiopeia", "templates/mail/booking-mail-ver-2.tpl.php", array("booking_code" => $booking_code));booking-mail-ver-4-replace-ver-2.tpl.php
			$body[] = _cassiopeia_render_theme("module", "cassiopeia", "templates/mail/booking-mail-ver-4-replace-ver-2.tpl.php", array("booking_code" => $booking_code));
        }
//        $body[] = _cassiopeia_render_theme("module", "cassiopeia", "templates/mail/booking-mail-ver-2.tpl.php", array("booking_code" => $booking_code));
        $headers['From'] = $headers['Sender'] = $headers['Return-Path'] = "";
        $headers['MIME-Version'] = '1.0';
        $headers['Content-Type'] = 'text/html; charset=UTF-8; format=flowed; delsp=yes';
        $params = array(
            'body' => $body,
            'subject' => $subject_mail,
            'headers' => $headers,
        );
        if (!empty($attachments)) {
            $params['attachments'] = $attachments;
        }
//        _print_r($body);
//        _print_r($_mail);
//        die;
        if (drupal_mail('cassiopeia', 'custom_key', $_mail, language_default(), $params)) {
        };
    }catch(Exception $e){}
}

function cassiopeia_send_account_to_agent($account, $pass)
{
    $site_mail = variable_get("sites_mail");
    $cassiopeia_config_mail_template_send_account = variable_get('cassiopeia_config_mail_template_send_account', array(
        'value' => '',
        'format' => 'full_html'
    ));
    $field_account_transaction_name = !empty($account->field_account_transaction_name['und'][0]['value'])?$account->field_account_transaction_name['und'][0]['value']:$account->name;
    $_content = $cassiopeia_config_mail_template_send_account['value'];
    $_content = str_replace("#code", $account->field_account_code['und'][0]['value'], $_content);
    $_content = str_replace("#tel", $account->name, $_content);
    $_content = str_replace("#name", $field_account_transaction_name, $_content);
    $_content = str_replace("#pass", $pass, $_content);
//    $body1 = array();
    $body1[] = $_content;
//    _print_r($account);
//    die;
    $headers['From'] = $headers['Sender'] = $headers['Return-Path'] = "";
    $headers['MIME-Version'] = '1.0';
    $headers['Content-Type'] = 'text/html; charset=UTF-8; format=flowed; delsp=yes';
    $params1 = array(
        'body' => $body1,
        'subject' => ucfirst(SITE_DOMAIN)." gửi bạn tài khoản đại lý",
        'headers' => $headers,
    );
    drupal_mail('cassiopeia', 'custom_key', $account->mail, language_default(), $params1);
//    drupal_mail('cassiopeia', 'custom_key','huutrungdc@gmail.com', language_default(), $params1);
}
function cassiopeia_topup_form($form, &$form_state)
{
    $agents = array();
    try {
        $query = db_select("users", "tbl_user");
        $query->fields("tbl_user");
        $query->join("users_roles", "tbl_role", "tbl_role.uid = tbl_user.uid");
//        $query->condition("tbl_role.rid", 4);
        $query->leftJoin("field_data_field_account_sale", "tbl_sale", "tbl_sale.entity_id = tbl_user.uid");
        $result = $query->execute()->fetchAll();
        $options = array();
        if (!empty($result)) {
            foreach ($result as $item) {
                $_agent = user_load($item->uid);
                if(!empty($_agent->field_account_code['und'][0]['value'])){
                    $options[$_agent->uid] = $_agent->field_account_code['und'][0]['value'] . " - ";
                }else{
                    $options[$_agent->uid] = $item->name." - ";
                }
                $options[$_agent->uid] .= !empty($_agent->field_account_full_name['und']) ? $_agent->field_account_full_name['und'][0]['value'] : "";
            }
        }
    } catch (Exception $e) {
        print_r($e);
    }
//    $form['code'] = array(
//        '#type' => 'textfield',
//        '#title' => t('Mã yêu cầu'),
//        '#size' => 60,
//        '#maxlength' => 128,
//        '#required' => FALSE,
//        '#attributes'   => array("readonly"=>true)
//    );
    $form['agent'] = array(
        '#type' => 'select',
        '#title' => t('Đại lý'),
        '#options' => $options,
        '#chosen'   => TRUE,
        '#required'   => TRUE,
    );
    $form['value'] = array(
        '#type' => 'textfield',
        '#title' => t('Số tiền'),
        '#size' => 60,
        '#maxlength' => 128,
        '#required' => TRUE,
//        '#attributes'   => array("placeholder"=>array("Email *")),
    );
    $form['note'] = array(
        '#title' => t('Ghi chú'),
        '#type' => 'textarea',
    );
    $form['submit'] = array(
        '#type' => 'submit',
        '#value' => t('Chấp nhận')
    );
    return $form;
}
function cassiopeia_topup_form_submit($form, &$form_state)
{
    global $user;
    $amount = str_replace(",","",$form_state['values']['value']);
    $amount = str_replace(".","",$amount);
    $amount = abs($amount);
    $transaction = db_transaction();
    try {
        $_agent = user_load($form_state['values']['agent']);
        if(!empty($_agent)){
            $_agent->field_account_balance['und'][0]['value'] = $_agent->field_account_balance['und'][0]['value']+ $amount;
            user_save($_agent);
            db_insert("tbl_topup")->fields(array(
                "user" => $user->uid,
                "agent" => $_agent->uid,
                "value" => $amount,
                "created" => REQUEST_TIME,
                "note" => !empty($form_state['values']['note']) ? $form_state['values']['note'] : "",
            ))->execute();

            if(!empty($form_state['values']['code'])){
                db_update("tbl_top_up_request")->fields(array(
                    "tran_user"    => $user->uid,
                    "status"    => 1
                ))->condition("code",$form_state['values']['code'])->execute();
            }
            $report = new stdClass();
            $report->created = REQUEST_TIME;
            $report->date = REQUEST_TIME;
            $report->amount = $amount;
            $report->content = !empty($form_state['values']['note']) ? $form_state['values']['note'] : "";
            $report->agent = $_agent->uid;
            $report->tran_kind = 1;
            $report->uid = $user->uid;
            $report->balance = $_agent->field_account_balance['und'][0]['value'];
            cassiopeia_qt_payment_report_save($report);
            drupal_set_message("Cập nhật thành công!");
        }else{
            drupal_set_message("Tài khoản không tồn tại!");
        }
    } catch (Exception $e) {
        $transaction->rollback();
        drupal_set_message("Đã xảy ra lỗi, vui lòng liên hệ với người quản trị!");
    }
}
function cassiopeia_ticket_issue($form, &$form_state)
{
    $form = array();
    $form['pnr'] = array(
        '#title' => t(''),
        '#type' => 'textfield',
        '#size' => 60,
        '#maxlength' => 128,
        '#required' => TRUE,
        '#attributes' => array("placeholder" => "Mã đặt chỗ ( PNR )"),
    );

    $query = db_select("users", "tbl_user");
    $query->fields("tbl_user");
    $query->join("users_roles", "tbl_role", "tbl_role.uid = tbl_user.uid");
    $query->condition("tbl_role.rid", 4);
    $query->leftJoin("field_data_field_account_sale", "tbl_sale", "tbl_sale.entity_id = tbl_user.uid");
    $query->join("field_data_field_account_transaction_name", "field_account_transaction_name", "field_account_transaction_name.entity_id=tbl_user.uid");
    $query->join("field_data_field_account_code", "field_account_code", "field_account_code.entity_id=tbl_user.uid");
    $query->addField("field_account_code", "field_account_code_value", "field_account_code_value");
    $query->addField("field_account_transaction_name", "field_account_transaction_name_value", "field_account_transaction_name_value");
    $result = $query->execute()->fetchAll();
    $agent_options = array();
    $agent_options['all'] = "Chọn Đại lý";
    if (!empty($result)) {
        foreach ($result as $value) {
            $transaction_name = !empty($value->field_account_transaction_name_value) ? $value->field_account_transaction_name_value : "";
            $account_code = !empty($value->field_account_code_value) ? $value->field_account_code_value : "";
            $agent_options[$value->uid] = $account_code . " - " . $transaction_name;
        }
    }
    $form['agent'] = array(
        '#type' => 'select',
        '#title' => t('Đại lý'),
        '#options' => $agent_options,
        '#chosen' => TRUE,
    );
    $form['submit'] = array(
        '#type' => 'submit',
        '#value' => t('Xuất vé')
    );
    return $form;
}

function cassiopeia_ticket_issue_submit($form, &$form_state)
{
    global $user;
    $_pnr = $form_state['values']['pnr'];
    $check = db_select("tbl_issue", "tbl_issue");
    $check->fields("tbl_issue");
    $check->condition("pnr_code", $_pnr);
    $issue = $check->execute()->fetchAssoc();
    if (!empty($issue)) {
        drupal_set_message("Vé này đã được xuất rồi, vui lòng kiểm tra lại!");
    } else {
        try {
            $query = db_select("tbl_booking", "tbl_booking");
            $query->fields("tbl_booking");
//        $query -> condition("uid",$user->uid);
            $query->condition("pnr_code", "%" . $_pnr . "%", "LIKE");
            $result = $query->execute()->fetchAssoc();
//        print_r($result);
//        die;
        } catch (Exception $e) {
            print_r($e);
        }
        if (!empty($result)) {
            $obj = new stdClass();
            $ticket = new stdClass();
            $ticket->Index = 0;
            $ticket->Airline = "VN";
            $ticket->TicketNumber = "ticket1";
            $ticket->IssueDate = strtotime("2019-04-10T09:05:28.571Z");
            $ticket->BookingCode = "MXKFF";
            $ticket->PassengerName = "NGUYEN HUU TRUNG";
            $ticket->BookingFile = "string";
            $ticket->TicketImage = "string";
            $ticket->TotalPrice = 115000;
            $ticket->Status = TRUE;
            $ticket->ErrorMessage = 0;
            $obj->ListTicket[] = $ticket;
            $obj->BookingImage = "url";
            $obj->Status = "OPEN";
            $obj->ErrorCode = "error";
            $obj->Message = "message";
            $transaction = db_transaction();
            try {
                db_insert("tbl_issue")->fields(array(
                    "booking_code" => $result['booking_code'],
                    "pnr_code" => $_pnr,
                    "status" => $obj->Status,
                    "error_code" => $obj->ErrorCode,
                    "message" => $obj->Message,
                    "booking_image" => $obj->BookingImage,
                    "created" => REQUEST_TIME,
                    "booker" => $user->uid,
                ))->execute();
                foreach ($obj->ListTicket as $item) {
                    db_insert("tbl_issue_detail")->fields(array(
                        "pnr_code" => $_pnr,
                        "_index" => 0,
                        "airline" => $item->Airline,
                        "ticket_number" => $item->TicketNumber,
                        "issue_date" => $item->IssueDate,
                        "passenger_name" => $item->PassengerName,
                        "booking_file" => $item->BookingFile,
                        "ticket_image" => $item->TicketImage,
                        "total_price" => $item->TotalPrice,
                        "status" => $item->Status,
                        "error_message" => $item->ErrorMessage,
                    ))->execute();
                }
                drupal_set_message("Xuất vé thành công!");
            } catch (Exception $e) {
                $transaction->rollback();
                print_r($e);
                die;

            }
        } else {
//        $form_state['redirect'] = "user/manager/issue";
            drupal_set_message("Mã PNR không đúng hoặc không thuộc quyền quản lý của bạn!");
        }
    }
}


function cassiopeia_agent_price_add_form($form, &$form_state)
{
//    $agent = user_load($agent_id);
    $form = array();
    $query = db_select("tbl_airline_", "tbl_airline_");
    $query->fields("tbl_airline_");
    $result_airlines = $query->execute()->fetchAll();
    $airlines = array();
    if (!empty($result_airlines)) {
        foreach ($result_airlines as $item) {
            $airlines[$item->code] = $item->name;
        }
    }
    $query = db_select("tbl_region", "tbl_region");
    $query->fields("tbl_region");
    $result = $query->execute()->fetchAll();
    $regions = array();
    if (!empty($result)) {
        foreach ($result as $item) {
            $regions[$item->code] = $item->name;
        }
    }

    $query = db_select("users", "tbl_user");
    $query->fields("tbl_user");
    $query->join("users_roles", "tbl_role", "tbl_role.uid = tbl_user.uid");
    $query->condition("tbl_role.rid", 4);
    $query->leftJoin("field_data_field_account_sale", "tbl_sale", "tbl_sale.entity_id = tbl_user.uid");
    $query->join("field_data_field_account_transaction_name", "field_account_transaction_name", "field_account_transaction_name.entity_id=tbl_user.uid");
    $query->join("field_data_field_account_code", "field_account_code", "field_account_code.entity_id=tbl_user.uid");
    $query->addField("field_account_code", "field_account_code_value", "field_account_code_value");
    $query->addField("field_account_transaction_name", "field_account_transaction_name_value", "field_account_transaction_name_value");
    $result = $query->execute()->fetchAll();
    $agent_options = array();
    $agent_options['all'] = "Chọn Đại lý";
    if (!empty($result)) {
        foreach ($result as $value) {
            $transaction_name = !empty($value->field_account_transaction_name_value) ? $value->field_account_transaction_name_value : "";
            $account_code = !empty($value->field_account_code_value) ? $value->field_account_code_value : "";
            $agent_options[$value->uid] = $account_code . " - " . $transaction_name;
        }
    }
    $form['agent'] = array(
        '#type' => 'select',
        '#title' => t('Đại lý'),
        '#options' => $agent_options,
        '#chosen' => TRUE,
    );
    $form['airline'] = array(
        '#type' => 'select',
        '#title' => t('Hãng hàng không'),
        '#options' => $airlines,
    );
    $form['region'] = array(
        '#type' => 'select',
        '#title' => t('Khu vực'),
        '#options' => $regions,
    );
    $form['price'] = array(
        '#type' => 'textfield',
        '#title' => t('Phí Dịch Vụ'),
        '#required' => TRUE,
    );
    $form['id'] = array(
        '#type' => 'textfield',
        '#title' => t(''),
        '#attributes' => array("class" => array("hidden")),
    );
    $form['submit'] = array(
        '#type' => 'submit',
        '#value' => 'Tạo',
        '#attributes' => array("class" => array("btn btn-primary")),
    );
    return $form;
}

function cassiopeia_agent_price_add_form_submit($form, &$form_state)
{
    try {
        if (!empty($form_state['values']['id'])) {
            db_update("tbl_agent_fee")->fields(array(
                "agent_id" => $form_state['values']['agent'],
                "airline" => $form_state['values']['airline'],
                "region" => $form_state['values']['region'],
                "value" => $form_state['values']['price'],
            ))->condition("id", $form_state['values']['id'])->execute();
        } else {
            try {
                if (!empty($form_state['values']['agent'])) {
                    db_insert("tbl_agent_fee")->fields(array(
                        "agent_id" => $form_state['values']['agent'],
                        "airline" => $form_state['values']['airline'],
                        "region" => $form_state['values']['region'],
                        "value" => $form_state['values']['price'],
                    ))->execute();
                } else {
                    db_insert("tbl_agent_fee")->fields(array(
//                        "agent_id"       => $form_state['values']['agent'],
                        "airline" => $form_state['values']['airline'],
                        "region" => $form_state['values']['region'],
                        "value" => $form_state['values']['price'],
                    ))->execute();
                }
            } catch (Exception $e) {
                _print_r($e);
                die;
            }
        }
        drupal_set_message("Thêm mới thành công");
    } catch (Exception $e) {
        drupal_set_message("Đã xảy ra lỗi");
    }
}

