function cassiopeia_ticket_pdf_download_access($booking, $account) {
    if (empty($booking) || empty($account->uid)) {
        return FALSE;
    }
    if (!empty($account->roles[4])) {
        return !empty($booking->uid) && (int) $booking->uid === (int) $account->uid;
    }
    return user_has_role(3, $account) || user_has_role(8, $account) || user_has_role(10, $account);
}

function cassiopeia_ticket_pdf_download_booking_load($pnr_code, $airline_code, $account) {
    $query = db_select('tbl_booking', 'b');
    $query->fields('b');
    $query->join('tbl_ticket', 't', 't.bid = b.id');
    $query->condition('t.pnr_code', $pnr_code);
    $query->condition('t.AirlineCode', $airline_code);
    if (!empty($account->roles[4])) {
        $query->condition('b.uid', $account->uid);
    }
    $query->orderBy('b.id', 'DESC');
    $query->range(0, 1);
    $booking = $query->execute()->fetchObject();
    if (!empty($booking)) {
        $booking->tickets = cassiopeia_qt_ticket_load_by_bid($booking->id);
        $booking->passengers = cassiopeia_qt_passenger_load_by_bid($booking->id);
    }
    return $booking;
}

function cassiopeia_open_pnr_form_preview_pdf_submit($form, &$form_state) {
    global $user;

    $pnr_code = strtoupper(trim($form_state['values']['code']));
    $airline_code = strtoupper(trim($form_state['values']['airline']));
    $booking = cassiopeia_ticket_pdf_download_booking_load($pnr_code, $airline_code, $user);
    if (empty($booking)) {
        form_set_error('code', t('Không tìm thấy dữ liệu đặt chỗ để tạo mặt vé.'));
        return;
    }
    if (!cassiopeia_ticket_pdf_download_access($booking, $user)) {
        form_set_error('code', t('Bạn không có quyền tải mặt vé của mã đặt chỗ này.'));
        return;
    }

    $form_state['redirect'] = array(
        'user/manager/ticketReview',
        array('query' => array('pdf' => array('airline' => $airline_code, 'code' => $pnr_code))),
    );
}

function cassiopeia_ticket_pdf_response($airline_code, $pnr_code) {
    global $user;

    $airline_code = strtoupper(trim($airline_code));
    $pnr_code = strtoupper(trim($pnr_code));
    $booking = cassiopeia_ticket_pdf_download_booking_load($pnr_code, $airline_code, $user);
    if (empty($booking) || !cassiopeia_ticket_pdf_download_access($booking, $user)) {
        drupal_access_denied();
        drupal_exit();
    }

    $agent = !empty($booking->uid) ? user_load($booking->uid) : user_load($user->uid);
    if (empty($agent)) {
        drupal_not_found();
        drupal_exit();
    }

    module_load_include('inc', 'cassiopeia', 'cassiopeia_agency_ticket_pdf');
    try {
        $attachment = cassiopeia_agency_ticket_pdf_attachment($booking, $airline_code, $agent);
    }
    catch (Exception $e) {
        drupal_add_http_header('Status', '500 Internal Server Error');
        print t('Không thể tạo mặt vé lúc này, vui lòng thử lại sau.');
        drupal_exit();
    }

    while (ob_get_level() > 0) {
        ob_end_clean();
    }
    drupal_add_http_header('Content-Type', $attachment['filemime']);
    $disposition = !empty($_GET['download']) ? 'attachment' : 'inline';
    drupal_add_http_header('Content-Disposition', $disposition . '; filename="' . $attachment['filename'] . '"');
    drupal_add_http_header('Content-Length', strlen($attachment['filecontent']));
    drupal_add_http_header('Cache-Control', 'private, no-store');
    drupal_add_http_header('X-Content-Type-Options', 'nosniff');
    print $attachment['filecontent'];
    drupal_exit();
}

function cassiopeia_get_booking_by_pnr($PNR)
{
    $query = db_select("tbl_booking", "tbl_booking");
     $query->fields("tbl_booking");
    // $query->condition("pnr_code", "%" . $PNR . "%", "LIKE");
    //if PNR first
    $IsFirtPNR = db_and()
                    ->condition("pnr_code", $PNR . "%", "LIKE")
                    ->condition("airline", $airline . "%", "LIKE");
    $IsLastPNR = db_and()
                    ->condition("pnr_code", "%" . $PNR, "LIKE")
                    ->condition("airline", "%" . $airline, "LIKE");
    $db_or = db_or()
        ->condition($IsFirtPNR)
        ->condition($IsLastPNR);
    $query->condition($db_or);
    $result = $query->execute()->fetchObject();
    return $result;
}

function cassiopeia_get_baggage_by_airline($airline)
{
    $query = db_select("tbl_bagage", "tbl_bagage");
    $query->fields("tbl_bagage");
    $query->condition("airline", $airline);
    $result = $query->execute()->fetchAll();
    return $result;
}

function cassiopeia_get_baggage_by_id($id)
{
    $query = db_select("tbl_bagage", "tbl_bagage");
    $query->fields("tbl_bagage");
    $query->condition("id", $id);
    $result = $query->execute()->fetchObject();
    return $result;
}

function cassiopeia_delete_report($tran_code, $table)
{
    global $user;
    try {
        db_delete($table)->condition("tran_code", $tran_code)->execute();
        db_delete("tbl_report")->condition("tran_code", $tran_code)->execute();
        db_insert("tbl_log")->fields(array(
            "created" => REQUEST_TIME,
            "uid" => $user->uid,
            "value" => "Xóa báo cáo",
            "booking_code" => $tran_code,
        ))->execute();
        return true;
    } catch (Exception $e) {
        return false;
    }
}

function cassiopeia_fix_report($data)
{
    try {
//       foreach($_SESSION['users'] as $ff){
//           $data->agent = $ff;
//           $data->startTime = 1580490000;
        $room_query = db_select("tbl_room_booking_report", "tbl_room_booking_report");
        $room_query->fields("tbl_room_booking_report", array("tran_code"));
        $room_query->addField("tbl_room_booking_report", "created", "created");
        $room_query->addField("tbl_room_booking_report", "created", "airline");
        $room_query->addField("tbl_room_booking_report", "tran_kind", "tran_kind");
        $room_query->addField("tbl_room_booking_report", "created", "PNR");
        $room_query->addField("tbl_room_booking_report", "created", "quantity");
        $room_query->addField("tbl_room_booking_report", "partner_price", "partner_price");
        $room_query->addField("tbl_room_booking_report", "agent", "agent");
        $room_query->addField("tbl_room_booking_report", "tran_user", "tran_user");
        $room_query->addField("tbl_room_booking_report", "created", "content");
        $room_query->addField("tbl_room_booking_report", "balance", "balance");
        $room_query->addField("tbl_room_booking_report", "created", "date");
        $room_query->addField("tbl_room_booking_report", "category", "category");

        $issue_query = db_select("tbl_issue_report", "tbl_issue_report");
        $issue_query->fields("tbl_issue_report", array("tran_code", "created", "airline", "tran_kind", "PNR", "quantity", "partner_price", "agent", "tran_user", "content", "balance", "date", "category"));
        $payment_query = db_select("tbl_payment_report", "tbl_payment_report");
        $payment_query->fields("tbl_payment_report", array("tran_code"));
        $payment_query->addField("tbl_payment_report", "created", "created");
        $payment_query->addField("tbl_payment_report", "created", "airline");
        $payment_query->addField("tbl_payment_report", "tran_kind", "tran_kind");
        $payment_query->addField("tbl_payment_report", "created", "PNR");
        $payment_query->addField("tbl_payment_report", "created", "quantity");
        $payment_query->addField("tbl_payment_report", "amount", "partner_price");
        $payment_query->addField("tbl_payment_report", "agent", "agent");
        $payment_query->addField("tbl_payment_report", "tran_user", "tran_user");
        $payment_query->addField("tbl_payment_report", "content", "content");
        $payment_query->addField("tbl_payment_report", "balance", "balance");
        $payment_query->addField("tbl_payment_report", "date", "date");
        $payment_query->addField("tbl_payment_report", "category", "category");
        $query = Database::getConnection()
            ->select($issue_query->union($payment_query))
            ->fields(NULL, array("tran_code","created", "airline", "tran_kind", "PNR", "quantity", "partner_price", "agent", "tran_user", "content", "balance", "date", "category"));
        $query = Database::getConnection()
            ->select($query->union($room_query))
            ->fields(NULL, array("tran_code","created","airline","tran_kind","PNR","quantity","partner_price","agent","tran_user","content","balance","date","category"))
            ->orderBy("created", "DESC");
        $query->join("tbl_tran_kind", "tbl_tran_kind", "tbl_tran_kind.id=tran_kind");
        $query->addField("tbl_tran_kind", "type", "tran_type");
        $query->condition("created", ($data->startTime), ">=");
        $query->condition("agent", $data->agent);
        $query->orderBy("created", "ASC");
        $result = $query->execute()->fetchAll();
//           if($data->agent <= 1827){
//               print_r($result);
//               break;
//           die;
        $index = 1;
        $start = 0;
        foreach ($result as $key => $item) {
            if (!empty($data->startTime)) {
                if ($index == 1) {
                    $start = $item->balance;
                } else {
                    if ($item->tran_type == 1) {
                        $start = $start + abs($item->partner_price);
                    } else {
                        $start = $start - abs($item->partner_price);
                    }
//                    print_r($start);
                    if ($item->category == "issue") {
                        db_update("tbl_issue_report")->fields(array(
                            "balance" => $start
                        ))->condition("tran_code", $item->tran_code)->execute();
                    } elseif ($item->category == "room_booking") {
                        db_update("tbl_room_booking_report")->fields(array(
                            "balance" => $start
                        ))->condition("tran_code", $item->tran_code)->execute();
                    } else {
                        db_update("tbl_payment_report")->fields(array(
                            "balance" => $start
                        ))->condition("tran_code", $item->tran_code)->execute();
                    }
                }
            } else {
                if ($item->tran_type == 1) {
                    $start = $start + abs($item->partner_price);
                } else {
                    $start = $start - abs($item->partner_price);
                }
                if ($item->category == "issue") {
                    db_update("tbl_issue_report")->fields(array(
                        "balance" => $start
                    ))->condition("tran_code", $item->tran_code)->execute();
                } elseif ($item->category == "room_booking") {
                    db_update("tbl_room_booking_report")->fields(array(
                        "balance" => $start
                    ))->condition("tran_code", $item->tran_code)->execute();
                } else {
                    db_update("tbl_payment_report")->fields(array(
                        "balance" => $start
                    ))->condition("tran_code", $item->tran_code)->execute();
                }
            }
            $index++;
        }
        $_agent = user_load($data->agent);
        $_agent->field_account_balance['und'][0]['value'] = $start;
        user_save($_agent);
//       }
    } catch (Exception $E) {
        _print_r($E);
    }
}

function cassiopeia_test_issue($_agent){
    global $user;
    $flag = false;
    $balance = !empty($_agent->field_account_balance['und'][0]['value']) ? $_agent->field_account_balance['und'][0]['value'] : 0;
    $TotalPrice = $_SESSION['total_price'];
    $Airline = $_SESSION['Airline'];
    $PNR = $_SESSION['PNR'];
    $TotalLeg = $_SESSION['count_leg'];
    $TotalAdult = $_SESSION['count_adult'];
    if($balance >= $TotalPrice || (user_has_role(3) || user_has_role(8))){
        try {
            $issue_response = cassiopeia_maybay_api_issue($PNR,$Airline);
//            if (true) {
            if ($issue_response->status==1) {
                $transaction = db_transaction();
                try {
                    $query = db_select("tbl_issue_report", "tbl_issue_report");
                    $query->fields("tbl_issue_report");
                    $query->range(0, 1);
                    $query->orderBy("id", "DESC");
                    $last = $query->execute()->fetchAssoc();
                    if (!empty($last)) {
                        $temp = str_replace("ISSUE_", "", $last['tran_code']);
                        $tran_code = "ISSUE_" . ($temp + 1);
                    } else {
                        $tran_code = "ISSUE_" . date("m", REQUEST_TIME) . "0001";
                    }

                    $balance -= $TotalPrice;

                    db_insert("tbl_issue_report")->fields(array(
                        "booking_code" => "",
                        "created" => REQUEST_TIME,
                        "date" => REQUEST_TIME,
                        "tran_code" => $tran_code,
                        "airline" => $Airline,
                        "tran_kind" => 4,
                        "PNR" => $PNR,
                        "quantity" => $TotalLeg*$TotalAdult,
                        "partner_price" => $TotalPrice,
                        "price" => $TotalPrice ,
                        "revenue" => 0,
                        "agent" => $_agent->uid,
                        "content" => "API issue",
                        "tran_user" => $user->uid,
                        "balance" => $balance,
                        "category" => "issue",
                    ))
                        ->execute();
                    db_insert("tbl_report")->fields(array(
                        "created" => REQUEST_TIME,
                        "date" => REQUEST_TIME,
                        "type" => "issue",
                        "tran_code" => $tran_code,
                    ))
                        ->execute();
                    $query = db_select("tbl_issue_report","tbl_issue_report");
                    $query->fields("tbl_issue_report");
                    $query->condition("agent",$_agent->uid);
                    $query->condition("date",strtotime(date("d-m-Y 00:00",strtotime("01-09-2020"))),">=");
                    $query->addExpression("SUM(partner_price)","total");
                    $query->groupBy("agent");
                    $result = $query->execute()->fetchObject();
                    $query1 = db_select("tbl_room_booking_report","tbl_room_booking_report");
                    $query1->fields("tbl_room_booking_report");
                    $query1->condition("agent",$_agent->uid);
                    $query1->addExpression("SUM(partner_price)","total");
                    $query1->groupBy("agent");
                    $result1 = $query1->execute()->fetchObject();
                    $total = $result->total;
                    if(!empty($result1)){
                        $total+=$result1->total;
                    }
                    $point = floor($total/1000000);
                    $_agent->field_point['und'][0]['value'] = $point;
                    if($_agent->field_account_status['und'][0]['tid']==22){ //tiềm năng
                        $_agent->field_account_status['und'][0]['tid'] = 13;
                        $_agent->field_account_updated_date['und'][0]['value'] = REQUEST_TIME;
                    }
                    $_agent->field_account_balance['und'][0]['value'] = $balance;

                    user_save($_agent);

                    $flag = true;
                    $message = "Xuất vé thành công!";
                } catch (Exception $e) {
                    $message = "Xuất vé thành công, tuy nhiên đã xảy ra lỗi trong quá trình tạo báo cáo, vui lòng liên hệ bộ phận booker để dược hỗ trợ!";
                }
            }else{
                $flag = false;
                $message = $issue_response->ermsg;
            }
            try{
                db_insert("tbl_issue")->fields(array(
                    "booking_code" => "",
                    "pnr_code" => $PNR,
                    "status" => $issue_response->status,
                    "error_code" => $issue_response->ercode,
                    "message" => $message,
                    "booking_image" => "",
                    "created" => REQUEST_TIME,
                    "booker" => $user->uid,
                    "issue_type" => 1, // xuất thường
                ))->execute();
            }catch (Exception $e){

            }
        }catch (Exception $e){
            $message = "Đã có lỗi xảy ra trong quá trình thao tác, vui lòng liên hệ bộ phận booker để dược hỗ trợ!";
            $flag = false;
        }
    }else{
        $message = "Tài khoản đại lý không đủ số dư để thực hiện thao tác xuất ";
        $flag = false;
    }
    return array(
        "flag"  => $flag,
        "message"  => $message,
    );
}
function cassiopeia_issue($pnr_code, $agent){
    global $user;
    $flag = false;
    if ($agent > 0) {
        $aid = $agent;
    }
    $pnr_code = strtoupper(trim($pnr_code));
    $booking = cassiopeia_qt_ticket_booking_load_by_PNR($pnr_code);
    if(!empty($booking)){
        $booking->uid = !empty($booking->uid)?$booking->uid:$user->uid;
        $tickets = $booking->tickets;
        if ($agent == 0) {
            $aid = $booking->uid;
        }
        if($user->uid == $booking->uid){
            $_agent = user_load($booking->uid);
        }else{
            if(cassiopeia_issue_report_accept()){
                $_agent = user_load($aid);
            }else{
                $_agent = user_load($user->uid);
            }
        }
        $count_ticket = 0;
        $total_service_fee = 0;
        $total_agent_fee = 0;
        foreach ($tickets as $ticket) {
            if($ticket->pnr_code==$pnr_code){
                $count_ticket++;
                $total_service_fee+=$ticket->service_fee*($booking->adt+$booking->chd);
                $total_service_fee+=$ticket->service_infant_fee*$booking->inf;

                $total_agent_fee+=$ticket->agent_fee*($booking->adt+$booking->chd);
                $total_agent_fee+=$ticket->agent_infant_fee*$booking->inf;
            }
        }
        $Airline = $_SESSION[$pnr_code.'-Airline'];
		$TotalPrice = $_SESSION[$pnr_code.'-total_price'];
        $balance = !empty($_agent->field_account_balance['und'][0]['value']) ? $_agent->field_account_balance['und'][0]['value'] : 0;
        $Partner_Price = $TotalPrice;
        $issue_log = new stdClass();
        $issue_log->uid = $user->uid;
        $issue_log->created = REQUEST_TIME;
        $issue_log->bid = $booking->id;
        $issue_log->booking_code = $booking->booking_code;
        $issue_log->pnr_code = $pnr_code;
        $issue_log->issue_type = 1;
        $issue_log->status = 10;
        drupal_write_record("tbl_issue",$issue_log);
        if($TotalPrice > 0){
			if(!empty($booking)){
				if($balance >= $Partner_Price || (user_has_role(3) || user_has_role(8))){
					$transaction = db_transaction();
					$dataResponseFromMeta = "dataResponseFromMeta";
					try {
						$_data = new stdClass();
						$_data->PNRCode = $pnr_code;
						$_data->AirlineCode = $Airline;
						$issue_response = cassiopeia_meta_api_issue($_data);
//                        $issue_response = new stdClass();
						$dataResponseFromMeta = $issue_response;
//                        $issue_response->Code=0;
						if ($issue_response->Code==0 || $issue_response->Code== "0") { // xuất thành công
							try {
								$insertData = new stdClass();
								$insertData->partner_price = $booking->price-$total_agent_fee;
								$insertData->price = $booking->price - $total_service_fee - $total_agent_fee;
								$insertData->agent = $_agent->uid;
								$insertData->tran_kind = 4;
								$insertData->quantity = $count_ticket*($booking->adt + $booking->chd);
								$insertData->PNR = $pnr_code;
								$insertData->date = REQUEST_TIME;
								$insertData->airline = $Airline;
								$insertData->content = "API issue";
								$insertData->booking = $booking;
								$flag = true;
								$message = "Xuất vé thành công!";
                                try{                                    
                                    cassiopeia_create_issue_report($insertData);
                                    $_PNR = $booking->pnr_code;
                                    $splitter = explode("-",$_PNR);

                                    $query = db_select("tbl_issue_report","tbl_issue_report");
                                    $query->fields("tbl_issue_report");
                                    $query->condition("PNR",$splitter,"IN");
                                    $query->condition("tran_kind",4,"=");
                                    $checkIssue = $query->execute()->fetchAll();
                                    if(count($checkIssue)>=count($booking->tickets)){
                                        db_update("tbl_booking")->fields(array(
                                            "status" => "TICKETED"
                                        ))->condition("booking_code",$booking->booking_code)->execute();
                                    }  
                                    cassiopeia_send_booking_mail($booking->booking_code,$_agent->mail, $booking->DO);
                                }catch(Exception $e){}
							} catch (Exception $e) {
                                $issue_log = new stdClass();
                                $issue_log->uid = $user->uid;
                                $issue_log->created = REQUEST_TIME;
                                $issue_log->bid = $booking->id;
                                $issue_log->booking_code = $booking->booking_code;
                                $issue_log->pnr_code = $pnr_code;
                                $issue_log->issue_type = 1;
								$message = "Xuất vé thành công, tuy nhiên đã xảy ra lỗi trong quá trình tạo báo cáo, vui lòng liên hệ bộ phận booker để dược hỗ trợ!";
                                $issue_log->status = $issue_response->Code;
                                $issue_log->message = $message;
                                $issue_log->note = serialize($dataResponseFromMeta);
                                drupal_write_record("tbl_issue",$issue_log);
							}
						}else{
                            $issue_log = new stdClass();
                            $issue_log->uid = $user->uid;
                            $issue_log->created = REQUEST_TIME;
                            $issue_log->bid = $booking->id;
                            $issue_log->booking_code = $booking->booking_code;
                            $issue_log->pnr_code = $pnr_code;
                            $issue_log->issue_type = 1;
                            $issue_log->status = 10;
							$flag = false;
							$message = serialize($issue_response);
                            $issue_log->status = $issue_response->Code;
                            $issue_log->message = $message;
                            $issue_log->note = serialize($dataResponseFromMeta);
                            drupal_write_record("tbl_issue",$issue_log);
                            $message = "Xuất vé thất bại, vui lòng liên hệ với bộ phận kỹ thuật để được hỗ trợ!";
                            $flag = false;
						}
					}catch (Exception $e){
                        $issue_log = new stdClass();
                        $issue_log->uid = $user->uid;
                        $issue_log->created = REQUEST_TIME;
                        $issue_log->bid = $booking->id;
                        $issue_log->booking_code = $booking->booking_code;
                        $issue_log->pnr_code = $pnr_code;
                        $issue_log->issue_type = 1;
                        $issue_log->status = 11;
						$message = "Đã có lỗi xảy ra trong quá trình thao tác, vui lòng liên hệ bộ phận booker để dược hỗ trợ!";
						$flag = false;
                        $issue_log->message = $message;
                        $issue_log->note = serialize($dataResponseFromMeta);
                        drupal_write_record("tbl_issue",$issue_log);
					}
				}else{
					$message = "Tài khoản đại lý không đủ số dư để thực hiện thao tác xuất ";
					$flag = false;
				}
			}else{
				$message = "Không tìm thấy booking!";
				$flag = false;
			}
		}else{
            $message = "Phiên làm việc đã hết hạn, vui lòng mở mặt vé rồi thử lại sau!";
            $flag = false;
        }

    }
    elseif($_SESSION['Airline']=="VN____"){
        $message = "Vui lòng liên hệ bộ phận Booker để được hỗ trợ!";
        $flag = false;
    }
    else{
        if(cassiopeia_issue_report_accept()){
            $_agent = user_load($aid);
        }else{
            $_agent = user_load($user->uid);
        }
        $issue_log = new stdClass();
        $issue_log->booking_image = "Vé đặt hệ thống khác";
        $issue_log->uid = $user->uid;
        $issue_log->created = REQUEST_TIME;
        $issue_log->bid = $booking->id;
        $issue_log->booking_code = $booking->booking_code;
        $issue_log->pnr_code = $pnr_code;
        $issue_log->issue_type = 1;
        $issue_log->status = 10;
        drupal_write_record("tbl_issue",$issue_log);
        $flag = false;
        $balance = !empty($_agent->field_account_balance['und'][0]['value']) ? $_agent->field_account_balance['und'][0]['value'] : 0;
        $TotalPrice = $_SESSION[$pnr_code.'-total_price'];
        if($TotalPrice>0){
            $Airline = $_SESSION[$pnr_code.'-Airline'];
            $PNR = $_SESSION[$pnr_code.'-PNR'];
            $TotalLeg = $_SESSION[$pnr_code.'-count_leg'];
            $TotalAdult = $_SESSION[$pnr_code.'-count_adult'];
            if(($balance >= ($TotalPrice)) || (user_has_role(3) || user_has_role(8))){
                $transaction = db_transaction();
				$dataResponseFromMeta = "dataResponseFromMeta";
                try {

                    $_data = new stdClass();
                    $_data->PNRCode = $PNR;
                    $_data->AirlineCode = $Airline;
                    $issue_response = cassiopeia_meta_api_issue($_data);
					$dataResponseFromMeta = $issue_response;
                    if ($issue_response->Code==0 || $issue_response->Code== "0") {

                        try {
                            $insertData = new stdClass();
                            $insertData->partner_price = $TotalPrice;
                            $insertData->price = $TotalPrice;
                            $insertData->agent = $_agent->uid;
                            $insertData->tran_kind = 4;
                            $insertData->quantity = $TotalLeg*$TotalAdult;
                            $insertData->PNR = $PNR;
                            $insertData->date = REQUEST_TIME;
                            $insertData->airline = $Airline;
                            $insertData->content = "API issue.";
                            cassiopeia_create_issue_report($insertData);
                            $flag = true;
                            $message = "Xuất vé thành công!";
                        } catch (Exception $e) {
                            $message = "Xuất vé thành công, tuy nhiên đã xảy ra lỗi trong quá trình tạo báo cáo, vui lòng liên hệ bộ phận booker để dược hỗ trợ!";
                            $issue_log->status = $issue_response->Code;
                            $issue_log->message = $message;
                            $issue_log->note = serialize($dataResponseFromMeta);
                            drupal_write_record("tbl_issue",$issue_log);
                        }
                    }else{
                        $issue_log = new stdClass();
                        $issue_log->booking_image = "Vé đặt hệ thống khác";
                        $issue_log->uid = $user->uid;
                        $issue_log->created = REQUEST_TIME;
                        $issue_log->bid = $booking->id;
                        $issue_log->booking_code = $booking->booking_code;
                        $issue_log->pnr_code = $pnr_code;
                        $issue_log->issue_type = 1;
                        $issue_log->status = 10;
                        $flag = false;
                        $message = $issue_response;
                        $issue_log->status = $issue_response->Code;
                        $issue_log->message = $message;
                        $issue_log->note = serialize($dataResponseFromMeta);
                        drupal_write_record("tbl_issue",$issue_log);
                        $message = "Xuất vé thất bại, vui lòng liên hệ với bộ phận kỹ thuật để được hỗ trợ!";
                        $flag = false;
                    }
                }catch (Exception $e){
                    $issue_log = new stdClass();
                    $issue_log->booking_image = "Vé đặt hệ thống khác";
                    $issue_log->uid = $user->uid;
                    $issue_log->created = REQUEST_TIME;
                    $issue_log->bid = $booking->id;
                    $issue_log->booking_code = $booking->booking_code;
                    $issue_log->pnr_code = $pnr_code;
                    $issue_log->issue_type = 1;
                    $issue_log->status = 11;
                    $message = "Đã có lỗi xảy ra trong quá trình thao tác, vui lòng liên hệ bộ phận booker để dược hỗ trợ!";
                    $flag = false;
                    $issue_log->message = $message;
                    $issue_log->note = serialize($dataResponseFromMeta);
                    drupal_write_record("tbl_issue",$issue_log);
                }
            }else{
                $message = "Tài khoản đại lý không đủ số dư để thực hiện thao tác xuất ";
                $flag = false;
            }
        }else{
            $message = "Phiên làm việc đã hết hạn, vui lòng mở mặt vé rồi thử lại sau!";
            $flag = false;
        }
    }
//    die;
    return array(
        "flag"  => $flag,
        "message"  => $message,
    );
}

function cassiopeia_get_baggage_by_weight_and_airline($weight, $airline)
{
    $query = db_select("tbl_bagage", "tbl_bagage");
    $query->fields("tbl_bagage");
    $query->condition("weight", $weight);
    $query->condition("airline", $airline);
    $result = $query->execute()->fetchObject();
    return $result;
}

function cassiopeia_get_agent_rank($user)
{
    $query = db_select("tbl_issue_report","tbl_issue_report");
    $query -> fields("tbl_issue_report");
    $query->condition("agent",$user->uid);
    $query->condition("tbl_issue_report.date",array(strtotime(date("01-01-Y",REQUEST_TIME)),strtotime(date("31-12-Y",REQUEST_TIME))),"BETWEEN");
    $query->groupBy("agent");
    $query->addExpression("SUM(partner_price)","total_price");
    $query->addExpression("SUM(quantity)","total_quantity");
    $query->addExpression("SUM(revenue)","total_revenue");
    $query->orderBy("created","DESC");
    $resultTotal = $query -> execute() -> fetchObject();
//_print_r($resultTotal);
//
    $query = db_select("tbl_room_booking_report","tbl_room_booking_report");
    $query -> fields("tbl_room_booking_report");
    $query->condition("agent",$user->uid);
    $query->groupBy("agent");
    $query->addExpression("SUM(partner_price)","total_price");
    $query->condition("tbl_room_booking_report.created",array(strtotime(date("01-01-Y",REQUEST_TIME)),strtotime(date("31-12-Y",REQUEST_TIME))),"BETWEEN");
    $query->addExpression("SUM(revenue)","total_revenue");
    $query->orderBy("created","DESC");
    $resultBookingTotal = $query -> execute() -> fetchObject();
    $Total = !empty($resultTotal)?$resultTotal->total_price:0;
    $Total += !empty($resultBookingTotal)?$resultBookingTotal->total_price:0;
    $Point = floor($Total/1000000);
    _print_r($Point);
    $rank = "Thành viên";
    if ($Point < 500) {

    } else if ($Point < 1000) {
        $rank = "Bạc";
    } else if ($Point < 2000) {
        $rank = "Vàng";
    } else {
        $rank = "Kim cương";
    }
    return $rank;
}

function cassiopeia_manger_room_price_export()
{
    include  drupal_get_path('module','cassiopeia')."/phpspreadsheet.inc";

    $worksheets = array();
    $worksheet = array('title' => 'Trademark Conflict','data'=>array(), 'merge_cells'=> array());
    $worksheet['data'][] = array(
        mb_convert_encoding('ID' ,  "UTF-8"),
        mb_convert_encoding('Khách sạn' ,  "UTF-8"),
        mb_convert_encoding('Tên phòng' ,  "UTF-8"),
        mb_convert_encoding('Từ ngày' ,  "UTF-8"),
        mb_convert_encoding('Đến ngày' ,  "UTF-8"),
        mb_convert_encoding('Giá bán' ,  "UTF-8"),
        mb_convert_encoding('Giá gốc' ,  "UTF-8"),
        mb_convert_encoding('Phụ thu cuối tuần' ,  "UTF-8"),
        mb_convert_encoding('Kê giường phụ' ,  "UTF-8"),
        mb_convert_encoding('Phụ thu người lớn' ,  "UTF-8"),
        mb_convert_encoding('Phụ thu trẻ em' ,  "UTF-8"),
        mb_convert_encoding('Phụ thu em bé' ,  "UTF-8"),
    );

    $rooms = cassiopeia_get_nodes_by_category("room");
    if(!empty($rooms)){
        foreach($rooms as $room){
            $hotel = !empty($room->field_hotel['und'][0]['nid'])?node_load($room->field_hotel['und'][0]['nid']):null;
            $worksheet['data'][] = array(
              mb_convert_encoding($room->nid ,  "UTF-8"),
              mb_convert_encoding(!empty($hotel)?$hotel->title:"",  "UTF-8"),
              mb_convert_encoding($room->title ,  "UTF-8"),
            );
        }
        $worksheets[]=$worksheet;
        phpspreadsheet_export($worksheets, 'file_'.date('d_m_Y',REQUEST_TIME));
    }
}

function cassiopeia_manger_payment_export()
{
    global $user;
    $data = json_decode($_REQUEST['data']);
    $caches = (array)$data;
    $filename = "Bao-cao-thanh-toan-" . REQUEST_TIME;
    drupal_add_http_header('Content-Type', 'application/vnd.ms-excel; charset=utf-8');
    drupal_add_http_header('Content-Disposition', 'attachment; filename=' . $filename . '.xls');
    $issue_query = db_select("tbl_issue_report", "tbl_issue_report");
    $issue_query->fields("tbl_issue_report", array("created", "airline", "tran_kind", "PNR", "quantity", "partner_price", "agent", "tran_user", "content", "balance", "date", "tran_code"));
    $payment_query = db_select("tbl_payment_report", "tbl_payment_report");
    $payment_query->fields("tbl_payment_report", array("created"));
    $payment_query->addField("tbl_payment_report", "created", "airline");
    $payment_query->addField("tbl_payment_report", "tran_kind", "tran_kind");
    $payment_query->addField("tbl_payment_report", "created", "PNR");
    $payment_query->addField("tbl_payment_report", "created", "quantity");
    $payment_query->addField("tbl_payment_report", "amount", "partner_price");
    $payment_query->addField("tbl_payment_report", "agent", "agent");
    $payment_query->addField("tbl_payment_report", "tran_user", "tran_user");
    $payment_query->addField("tbl_payment_report", "content", "content");
    $payment_query->addField("tbl_payment_report", "balance", "balance");
    $payment_query->addField("tbl_payment_report", "date", "date");
    $payment_query->addField("tbl_payment_report", "tran_code", "tran_code");
    $query = Database::getConnection()
        ->select($issue_query->union($payment_query))
        ->fields(NULL, array("created", "airline", "tran_kind", "PNR", "quantity", "partner_price", "agent", "tran_user", "content", "balance", "date", "tran_code"))
        ->orderBy("created", "DESC");
    $query->join("tbl_tran_kind", "tbl_tran_kind", "tbl_tran_kind.id=tran_kind");
    if (!empty($caches['date_filter']) && $caches['date_filter'] != "all") {
        switch ($caches['date_filter']) {
            case "today" :
                $query->condition("date", array(strtotime(date("d-m-Y 00:00", REQUEST_TIME)), strtotime(date("d-m-Y 23:59", REQUEST_TIME))), "BETWEEN");
                break;
            case "yesterday" :
                $query->condition("date", array(strtotime(date("d-m-Y 00:00", REQUEST_TIME - 86400)), strtotime(date("d-m-Y 23:59", REQUEST_TIME - 86400))), "BETWEEN");
                break;
            case "thismonth" :
                $query->condition("date", array(strtotime(date("01-m-Y 00:00", REQUEST_TIME)), strtotime(date("t-m-Y 23:59", REQUEST_TIME))), "BETWEEN");
                break;
            case "other":
                if (!empty($caches['from_date'])) {
                    $query->condition("date", strtotime($caches['from_date']), ">");
                }
                if ($caches['to_date']) {
                    $query->condition("date", strtotime($caches['to_date']), "<");
                }
                break;
        }
    } elseif ($caches['date_filter'] == "other") {
        if (!empty($caches['payment_report_from_date']) && $caches['payment_report_from_date'] != "") {
            $query->condition("date", strtotime(date("d-m-Y 00:00", strtotime($caches['payment_report_from_date']))), ">=");
        }
        if (!empty($caches['payment_report_to_date']) && $caches['payment_report_to_date'] != "") {
            $query->condition("date", strtotime(date("d-m-Y 23:59", strtotime($caches['payment_report_to_date']))), "<=");
        }
    }
    if (!empty($caches['tran_kind']) && $caches['tran_kind'] != "all") {
        $query->condition("tran_kind", $caches['tran_kind']);
    }
    if (!empty($caches['PNR']) && $caches['PNR'] != "all") {
        $query->condition("PNR", $caches['PNR']);

    }
    if (!empty($caches['content']) && $caches['content'] != "") {
        $query->condition("content", "%" . $caches['content'] . "%", "LIKE");
    }
    if (!empty($caches['tran_user']) && $caches['tran_user'] != "all") {
        $query->condition("tran_user", $caches['tran_user']);

    }
    if (cassiopeia_payment_report_accept()) {
        if (!empty($caches['agent'])) {
            if ($caches['agent'] == "offline") {
            } else if ($caches['agent'] != "all") {
                $query->condition("agent", $caches['agent']);
            }
        }
    } else {
        $query->condition("agent", $user->uid);
    }
    $result = $query->execute()->fetchAll();
//    print(count($result));
    ?>
    <table border="1" class="table table-responsive report-items">
        <thead>
        <tr>
            <?php if (user_has_role(3)): ?>
                <td>Mã GD</td>
            <?php endif; ?>
            <th class="hidden-xs">STT</th>
            <th class="hidden-xs">Ngày tạo</th>
            <th class="hidden-xs">Ngày thực hiện</th>
            <th>Loại GD</th>
            <th>Mã GD</th>
            <th>Thanh toán</th>
            <th>Đại lý</th>
            <th class="hidden-xs">Người xuất</th>
            <th class="hidden-xs">Nội dung</th>
            <?php if (user_has_role(3) || user_has_role(8)): ?>
                <td>Số dư</td>
                <td></td>
            <?php endif; ?>
        </tr>
        </thead>
        <tbody>
        <?php if (!empty($result)): $stt = 1; ?>
            <?php foreach ($result as $value): ?>
                <!--            --><?php //$total_amount = $value->total_amount; ?>
                <tr>
                    <?php if (user_has_role(3)): ?>
                        <td class="hidden-xs"><?php print($value->tran_code); ?></td>
                    <?php endif; ?>
                    <td class="hidden-xs"><?php print($stt); ?></td>
                    <td class="hidden-xs"><?php print(date("d/m/Y H:i", $value->created)); ?></td>
                    <td class="hidden-xs"><?php print(date("d/m/Y H:i", $value->date)); ?></td>
                    <td class="hidden-xs">
                        <?php
                        $tran_kind = cassiopeia_get_tran_kind_by_id($value->tran_kind);
                        print($tran_kind['name']);
                        ?>
                    </td>
                    <td class="hidden-xs">
                        <?php print($value->PNR != $value->created ? $value->PNR : ""); ?>
                    </td>
                    <td class="<?php print($tran_kind['type'] == 1 ? "plus" : "minus"); ?> text-right hidden-xs">
                        <?php if ($tran_kind['type'] == 1): ?>
                            <?php print(abs($value->partner_price)); ?>
                        <?php else: ?>
                            <?php print(-abs($value->partner_price)); ?>
                        <?php endif; ?>
                    </td>
                    <td class="hidden-xs">
                        <?php
                        $agent = user_load($value->agent);
                        if (!empty($agent)) {
                            print($agent->field_account_code['und'][0]['value']);
                            if (!empty($agent->field_account_transaction_name['und'][0]['value'])) {
                                print(" - ");
                                print($agent->field_account_transaction_name['und'][0]['value']);
                            }
                        }
                        //                        ?>
                    </td>
                    <td class="hidden-xs">
                        <?php
                        $tran_user = user_load($value->tran_user);
                        if (!empty($tran_user)) {
                            print(!empty($tran_user->field_account_transaction_name['und'][0]['value']) ? $tran_user->field_account_transaction_name['und'][0]['value'] : $tran_user->name);
                        }
                        //                        ?>
                    </td>
                    <td class="hidden-xs"><?php print($value->content); ?></td>
                    <?php if (user_has_role(3) || user_has_role(7)): ?>
                        <td><?php print($value->balance); ?></td>
                    <?php endif; ?>
                    <?php if (user_has_role(3)): ?>
                        <td><span data-tran-code="<?php print($value->tran_code); ?>"
                                  class="btn btn-danger fa fa-trash btn-delete-report"></span></td>
                    <?php endif; ?>
                </tr>
                <?php $stt++; ?>
            <?php endforeach; ?>
        <?php endif; ?>
        <!--    <tr class="total-row">-->
        <!--        <td><b>Tổng</b></td>-->
        <!--        <td></td>-->
        <!--        <td></td>-->
        <!--        <td>Có <span class="color-red">--><?php //print(number_format($total_items,0,",","."));
        ?><!--</span> giao dịch</td>-->
        <!--        <td></td>-->
        <!--        <td class="text-right plus">--><?php //print(number_format($result2->total_amount,0,",","."));
        ?><!--</td>-->
        <!--        <td></td>-->
        <!--        <td></td>-->
        <!--        <td></td>-->
        <!--    </tr>-->
        </tbody>
    </table>
    <?php
}

