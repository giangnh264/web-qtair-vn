    );
    $_ex_bed = $hasExtraBed == 1 ? $extraBed : 0;
//    print($hasExtraBed);;
    if (!empty($TotalExtraBed)) {
        $form['orderInformationContainer']['roomExtraBedGroup']['roomTotalExtraBedLabel'] = array(
            '#type' => 'checkbox',
            '#title' => t('Tôi muốn kê thêm giường phụ'),
