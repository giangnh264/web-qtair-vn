function cassiopeia_flight_search_filter_form($form, &$form_state, $data = array())
{
    $form = array();
    $form['airline'] = array(
        '#type' => 'select',
        '#title' => t(''),
        '#options' => !empty($data['airlines']) ? $data['airlines'] : array(),
    );
    $form['groupClass'] = array(
        '#type' => 'select',
        '#title' => t(''),
        '#options' => !empty($data['groupClass']) ? $data['groupClass'] : array(),
    );
    return $form;
}

