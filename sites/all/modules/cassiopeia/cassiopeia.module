    $form['orderInformationContainer']['roomPriceGroup'] = array(
        '#type' => 'container',
        '#prefix' => '<div id="roomPriceGroup" class="orderInformationGroup">',
        '#suffix' => '</div>',
    );
    $form['orderInformationContainer']['roomPriceGroup']['roomPriceLabel'] = array(
        '#type' => 'checkbox',
        '#title' => t('Giá phòng'),
        '#value' => 1,
        '#attributes' => array("readonly" => "readonly", "disabled" => "disabled"),
        '#prefix' => '<div id="" class="">',
