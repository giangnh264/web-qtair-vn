    $form = array();
    $month_options = array();
    for ($i = REQUEST_TIME - (12 * 30 * 86400); $i <= REQUEST_TIME; $i += 86400 * 30) {
        $month_options[date("m-Y", $i)] = date("m/Y", $i);
    }
    $form['cassiopeia_detail_report_tab_2_filter_form_date_filter'] = array(
