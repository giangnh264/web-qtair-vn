            '#attributes' => array("readonly" => "readonly", "disabled" => "disabled"),
            '#prefix' => '<div id="" class="roomExtraBed">',
            '#suffix' => '<span>' . number_format($TotalExtraBed, 0, ",", ".") . 'đ</span></div>',
            '#ajax' => array(
                'callback' => 'cassiopeia_booking_room_change_adult_ajax_callback',
                'wrapper' => 'orderInformationContainer',
                'method' => 'replace',
                'effect' => 'fade',
            ),
        );
    }
    $form['orderInformationContainer']['roomVATGroup'] = array(
        '#type' => 'container',
        '#prefix' => '<div id="roomVATGroup" class="orderInformationGroup">',
        '#suffix' => '</div>',
    );
    if ($hasExtraBed == 1) {
        $form['orderInformationContainer']['roomExtraBedGroup']['roomExtraBedLabel']['#default_value'] = 1;
    }
//    $_VAT = ($total_price/10);
//    if(empty($form_state['values']['roomVATLabel'])){
//        $total_price+=$_VAT;
//    }else{
//        $_VAT = 0;
//    }
    $form['orderInformationContainer']['roomVATGroup']['roomVATLabel'] = array(
        '#type' => 'checkbox',
        '#title' => t('Tôi muốn lấy hóa đơn VAT'),
        '#prefix' => '<div id="" class="">',
        '#suffix' => '</div>',
//        '#ajax' => array(
//            'callback' => 'cassiopeia_booking_room_change_adult_ajax_callback',
//            'wrapper' => 'orderInformationContainer',
//            'method' => 'replace',
//            'effect' => 'fade',
//        ),
    );
    if ($hasVAT) {
        $form['orderInformationContainer']['roomVATGroup']['roomVATLabel']['#default_value'] = 1;
    }
    $total_price+=$TotalExtraBed;
//    $total_net_price+=$TotalExtraBed;
    if($edit){
        $form['orderInformationContainer']['roomTotalPrice'] = array(
            '#type' => 'container',
            '#prefix' => '<div id="roomTotalPriceGroup" class="orderInformationGroup">',
            '#suffix' => '</div>',
        );
        $form['orderInformationContainer']['roomTotalPrice']['room_code'] = array(
            '#type'             => 'textfield',
            '#title'            => t('Code đặt phòng'),
        );
//        _print_r($data);
        if(!empty($data->room_code)){
            $form['orderInformationContainer']['roomTotalPrice']['room_code']['#default_value'] = $data->room_code;
        }
        $form['orderInformationContainer']['roomTotalPrice']['roomTotalPriceValue'.$InputKey] = array(
            '#type' => 'textfield',
            '#title' => t('Tổng giá'),
//            '#attributes' => array("class" => array("hidden")),
//            '#prefix' => '<div id="" class="">',
//            '#suffix' => '<span>' . number_format($total_price, 0, ",", ".") . 'đ</span></div>',
        );
        $form['orderInformationContainer']['roomTotalPrice']['roomTotalPriceValue'.$InputKey]['#attributes'] = array(
            "class"  => array("disabled"),
        );
//        if(!empty($data) && $data->status==3){
//            $form['orderInformationContainer']['roomTotalPrice']['roomTotalPriceValue']['#attributes'] = array(
//                "readonly"  => "readonly",
//                "disabled"  => "disabled",
//            );
//        }
        if(!empty($total_price)){
            $form['orderInformationContainer']['roomTotalPrice']['roomTotalPriceValue'.$InputKey]['#default_value'] = number_format($total_price, 0, ",", ".") ;
        }
//        unset($form['orderInformationContainer']['roomTotalPrice']['roomTotalAGPriceValue']);
        $form['orderInformationContainer']['roomTotalPrice']['roomTotalAGPriceValue'.$InputKey] = array(
            '#type'             => 'textfield',
            '#title'            => t('Tổng giá AG'),
            '#attributes'       => array("class" => array("partnerPrice")),
        );
        if(!empty($data->status) && $data->status==3){
            $form['orderInformationContainer']['roomTotalPrice']['roomTotalAGPriceValue'.$InputKey]['#attributes'] = array(
                "class"  => array("disabled"),
            );
        }
        if(!empty($TotalAGPrice)){
            $form['orderInformationContainer']['roomTotalPrice']['roomTotalAGPriceValue'.$InputKey]['#default_value'] = number_format($TotalAGPrice, 0, ",", ".") ;
        }
        $form['orderInformationContainer']['roomTotalPrice']['roomTotalNetPriceValue'.$InputKey] = array(
            '#type'             => 'textfield',
            '#title'            => t('Tổng giá NET'),
            '#default_value'    => number_format($total_net_price, 0, ",", "."),
        );
        if(!empty($data->status) && $data->status==3){
            $form['orderInformationContainer']['roomTotalPrice']['roomTotalNetPriceValue'.$InputKey]['#attributes'] = array(
                "class"  => array("disabled"),
            );
        }
        if(!empty($total_net_price)){
            $form['orderInformationContainer']['roomTotalPrice']['roomTotalNetPriceValue'.$InputKey]['#default_value'] = number_format($total_net_price, 0, ",", ".") ;
        }
    }else{
        $form['orderInformationContainer']['roomTotalPrice'] = array(
            '#type' => 'container',
            '#prefix' => '<div id="roomTotalPriceGroup" class="orderInformationGroup">',
            '#suffix' => '</div>',
        );
        $form['orderInformationContainer']['roomTotalPrice']['roomTotalPriceValue'] = array(
            '#type' => 'checkbox',
            '#title' => t(''),
            '#attributes' => array("class" => array("hidden")),
            '#prefix' => '<div id="" class="">',
            '#suffix' => '<span> <img src="/sites/all/themes/cassiopeia_theme/img/hotel/icon-sum.png" alt="">' . number_format($total_price, 0, ",", ".") . 'đ</span></div>',
        );
    }

    $form['note'] = array(
        '#title' => t('Yêu cầu của bạn'),
        '#type' => 'textarea',
    );
    if(!empty($data->note )){
        $form['note']['#default_value'] = $data->note ;
    }
    $form['formButtons'] = array(
        '#type' => 'container',
        '#prefix' => '<div id="formButtons" class="formButtons"><div><div><h2>' . $hotel->title . '</h2></div></div>',
        '#suffix' => '</div>',
    );
    if($edit){
        $options = array(
            0 => t('Tất cả'),
            1 => t('Đặt chỗ'),
            2 => t('Báo giá'),
            3 => t('Đã chốt'),
            4 => t('Thất bại'),
        );
        if(!empty($data->status)&&$data->status==3){ // đã chốt
            $options = array(
                3 => t('Đã chốt'),
            );
        }
        $form['formButtons']['booking_status'] = array(
            '#type' => 'select',
            '#title' => t('Tình trạng'),
            '#options' => $options,
        );
        if(!empty($data->status)&&$data->status==3){
            $form['formButtons']['booking_status']['#attributes'] = array(
                "readonly"  => "readonly",
                "disabled"  => "disabled",
            );
        }
        if(!empty($data->status)){
            $form['formButtons']['booking_status']['#default_value'] = $data->status;
        }
        if(!empty($data->booking_code)){
            $query = db_select("tbl_room_booking_report","tbl_room_booking_report");
            $query->fields("tbl_room_booking_report");
            $query->orderBy("created","DESC");
            $query->condition("booking_code",$data->booking_code);
            $reports = $query->execute()->fetchAll();
            $html = "<ul>";
            if(!empty($reports)){
                foreach($reports as $report){
                    $tran_kind = cassiopeia_get_tran_kind_by_id($report->tran_kind);
                    $html.= "<li>".date("d-m-Y H:i",$report->created)." - ".$tran_kind['name']." - Giá AG: ".number_format($report->partner_price,0,",",".")."đ - Giá Net: ".number_format($report->price,0,",",".")."đ - ".$report->note."</li>";
                }
            }
            $html .= "</ul>";
            $form['formButtons']["report_note"] = array(
                '#type' => 'container',
                '#prefix'   => "<div>".$html,
                '#suffix'   => "</div>",
            );
        }
    }
//    _print_r($big_flag);
//    _print_r($validFlag);
    if ($big_flag == true && $validFlag) {

        $form['formButtons']['submit'] = array(
            '#type' => 'submit',
            '#value' => t('Gửi yêu cầu')
        );
    } else {
        $form['formButtons']['submit'] = array(
            '#type' => 'submit',
            '#value' => t('Gửi yêu cầu'),
            '#attributes' => array("disabled" => "disabled")
        );
    }
    $form['#data'] = $data;
    return $form;
}
function cassiopeia_booking_room_change_agent_ajax_callback(&$form,&$form_state){
    if(!empty($form_state['values']['orderContactFullName'])){
        $str = $form_state['values']['orderContactFullName'];
        $array = explode("-",$str);
        $_code = trim($array[0]);
        $_name = trim($array[1]);
        $query = db_select("users","tbl_user");
        $query -> fields("tbl_user");
        $query->join("field_data_field_account_code","field_account_code","field_account_code.entity_id=tbl_user.uid");
//            $query->join("field_data_field_account_transaction_name","field_account_transaction_name","field_account_transaction_name.entity_id=tbl_user.uid");
        $query->condition("field_account_code.field_account_code_value",$_code,"=");
        $_agent = $query->execute()->fetchObject();
//            _print_r($_agent);
    }
    $form['orderContact']['orderContactTel']['#value'] = !empty($_agent)?$_agent->name:"";
    $form['orderContact']['orderContactEmail']['#value'] = !empty($_agent)?$_agent->mail:"";
    $ajax_commands = array();
    $ajax_commands[] = ajax_command_replace('#customerInformation', (render($form['orderContact'])));

    // Return our commands in JSON.
    $form_state['rebuild'] = TRUE;
    return array(
        '#type' => 'ajax',
        '#commands' => $ajax_commands,
    );
}
