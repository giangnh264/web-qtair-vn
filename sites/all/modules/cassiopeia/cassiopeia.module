{
//    _print_r($element);
//    die;
//    $allowed = array('blue', 'yellow', 'pink', 'purple');
    if ($element['#value'] == 0) {
        form_error($element, t('Bạn chưa chọn loại phòng'));
    }
//    if (!in_array($form_state['values']['colour'], $allowed)) {
//        form_error($element, t('You mus enter a valid colour.'));
//    }
}

function cassiopeia_room_booking_form_submit($form, &$form_state){
//    _print_r($form_state['values']);
    $arg = arg();
    global $user;
    $mail_data = array();
    $weekend = 0;
    $db_transaction = db_transaction();
//    $start_date = $_SESSION['booking_room']['start_date'];
//    $end_date = $_SESSION['booking_room']['end_date'];
    $price = 0;
    $_adult_price = 0;
    $roomExtraBed = array();
    $TotalExtraBed = 0;
    $Netprice = 0;
    $TotalNetprice = 0;
    $children_price = 0;
    $room_price = array();
    $quantity = 0;
    try {
//        $query = db_select("tbl_room_booking", "tbl_room_booking");
////        $query->fields("tbl_room_booking");
////
////        $result = $query->execute();
        $TotalGuest = 0;
        foreach ($form_state['roomList'] as $_index => $_value) {

            $children = 0;
            $extraBed = 0;
            $infant = 0;
            $roomGroup = $form_state['values']['roomContainer']['roomGroup_' . $_index];
            $quantity+=$roomGroup['number_of_night_' . $_index]*$roomGroup['quantity_' . $_index];
            $total_children = $roomGroup['children_' . $_index];
            $adult = $roomGroup['adult_' . $_index];
            $_room = node_load($roomGroup['room_' . $_index]);
            $children_age = !empty($_room->field_children_max_age['und'][0]['value']) ? $_room->field_children_max_age['und'][0]['value'] : 11;
            $infant_age = !empty($_room->field_infant_max_age['und'][0]['value']) ? $_room->field_infant_max_age['und'][0]['value'] : 5;
            $start_date = $form_state['values']['roomContainer']['roomGroup_' . $_index]['from_date_' . $_index];
            $end_date = $form_state['values']['roomContainer']['roomGroup_' . $_index]['to_date_' . $_index];

            $valid_people = !empty($_room->field_people['und'][0]['value']) ? $_room->field_people['und'][0]['value'] : "1A+1C";
            $_valid_people = explode("/", $valid_people);
            $_people_valid = array();
            $_max_valid = array();
//            _print_r($_valid_people);
            if (!empty($_valid_people)) {
                foreach ($_valid_people as $key => $max_person) {
                    $max_person = explode("+", $max_person);
                    foreach ($max_person as $person) {
                        if (strpos($person, "NL") != FALSE) {
                            $_people_valid[$key]['adult'] = (int)str_replace("NL", "", $person) * $roomGroup['quantity_' . $_index];
                        }
                        if (strpos($person, "TE") != FALSE) {
                            $_people_valid[$key]['children'] = (int)str_replace("TE", "", $person) * $roomGroup['quantity_' . $_index];
                        }
                        if (strpos($person, "EB") != FALSE) {
                            $_people_valid[$key]['infant'] = (int)str_replace("EB", "", $person) * $roomGroup['quantity_' . $_index];
                        }
                    }
                }
            }
//            _print_r($_people_valid);
            $stt = 1;
            if (!empty($roomGroup['roomGroupAge_' . $_index])) {
                foreach ($roomGroup['roomGroupAge_' . $_index] as $key => $age) {
                    if ($age <= $infant_age) {
                        $infant++;
                    } elseif ($age <= $children_age) {
                        $children++;
                    } else {
                        $adult++;
                    }
                    if ($stt >= $total_children) {
                        break;
                    }
                    $stt++;
                }

                $infant = $total_children - $children;
            }
            $TotalGuest+=$adult;
            $_price = cassiopeia_get_room_price_by_date(($start_date), ($end_date), $_room->nid);
            $room_price[$_index] = $_price;
            $plus_price = array();
            if (!empty($_people_valid)) {
                foreach ($_people_valid as $key => $item) {
                    $plus_price[$key] = array();
                    $plus_price[$key]['adult'] = 0;
                    $plus_price[$key]['children'] = 0;
                    $plus_price[$key]['infant'] = 0;
                    $plus_children = 0;
                    $plus_infant = 0;
                    $plus_adult = $adult - $item['adult'] > 0 ? $adult - $item['adult'] : 0;
                    $item['children'] = !empty($item['children']) ? $item['children'] : 0;
                    $plus_children = $children - $item['children'] > 0 ? $children - $item['children'] : 0;
                    $item['infant'] = !empty($item['infant']) ? $item['infant'] : 0;
                    $plus_infant = $infant - $item['infant'] > 0 ? $infant - $item['infant'] : 0;
                    if (!empty($_price)) {
                        foreach ($_price as $priceKey => $priceValue) {
                            if (!empty($priceValue)) {
                                $plus_price[$key]['adult'] += $priceValue->adult * $plus_adult * $roomGroup['quantity_' . $_index];
                                $plus_price[$key]['children'] += $priceValue->children * $plus_children * $roomGroup['quantity_' . $_index];
                                $plus_price[$key]['infant'] += $priceValue->infant * $plus_infant * $roomGroup['quantity_' . $_index];
                            }
                        }
                    }
                }
            }
            if (!empty($plus_price)) {
                $plus_min_price = $plus_price[0];
                foreach ($plus_price as $item) {
                    if ($item['adult'] + $item['children'] + $item['infant'] < $plus_min_price['adult'] + $plus_min_price['children'] + $plus_min_price['infant']) {
                        $plus_min_price = $item;
                    }
                }
            }

            if (!empty($_price)) {
                foreach ($_price as $priceKey => $priceValue) {
                    if (!empty($priceValue)) {
                        $Netprice += ($priceValue->price) * $roomGroup['quantity_' . $_index];
                        $price += ($priceValue->price+$priceValue->booking_fee) * $roomGroup['quantity_' . $_index];
                        if (!empty($priceValue->is_weekend)) {
                            $weekend += $priceValue->is_weekend * $roomGroup['quantity_' . $_index];
                        }
                        $extraBed += !empty($priceValue->extra_bed) ? $priceValue->extra_bed * $roomGroup['quantity_' . $_index] : 0;
                    }
                }
            }
            if (!empty($form_state['values']['roomContainer']['roomGroup_' . $_index]['roomExtraBedLabel_' . $_index])) {
                $roomExtraBed[$_index] = $extraBed;
                $TotalExtraBed += $extraBed;
            }
        }
        $total_price = $price;
        $TotalNetprice = $Netprice;
        if (!empty($plus_min_price['adult'])) {
            $total_price += $plus_min_price['adult'];
            $TotalNetprice += $plus_min_price['adult'];
        }
        if (!empty($plus_min_price['children'])) {
            $total_price += $plus_min_price['children'];
            $TotalNetprice += $plus_min_price['children'];
        }
        if (!empty($form_state['values']['roomExtraBedLabel'])) {
//            $total_price += $extraBed;
//            $TotalNetprice += $extraBed;
        }
        $TotalNetprice += $weekend;
        $TotalNetprice += $TotalExtraBed;

        $total_price += $weekend;
        $total_price += $TotalExtraBed;

        if (!empty($form['#bookingCode'])) {
            $booking = $_booking = cassiopeia_get_room_booking_by_code($form['#bookingCode']);
            if($user->uid==1){
//                _print_r($booking);
//                die;
            }
            $_name = $form_state['values']['orderContactFullName'];

            db_update("tbl_room_booking")->fields(array(
                "updated"           => REQUEST_TIME,
                "status"            => 1,
                "contactName"       => $form_state['values']['orderContactFullName'],
                "contactTel"        => $form_state['values']['orderContactTel'],
                "contactEmail"      => $form_state['values']['orderContactEmail'],
                "room_price"        => $price,
                "surcharge_adult"   => !empty($plus_min_price['adult']) ? $plus_min_price['adult'] : 0,
                "surcharge_children"=> !empty($plus_min_price['children']) ? $plus_min_price['children'] : 0,
                "extraBed"          => $TotalExtraBed,
                "surcharge_weekend" => $weekend,
                "hotel"             => $_booking->hotel,
                "from_date"         => strtotime($start_date),
                "to_date"           => strtotime($end_date),
                "uid"               => $_booking->uid,
                "VAT"               => !empty($form_state['values']['roomVATLabel']) ? 1 : 0,
                "note"              => !empty($form_state['values']['note']) ? $form_state['values']['note'] : "",
                "total_price"       => $total_price,
                "partner_price"     => !empty($form_state['values']['roomTotalAGPriceValue'.$form['#InputKey']])?str_replace(".","",$form_state['values']['roomTotalAGPriceValue'.$form['#InputKey']]):$total_price,
                "net_price"         => !empty($form_state['values']['roomTotalNetPriceValue'.$form['#InputKey']])?str_replace(".","",$form_state['values']['roomTotalNetPriceValue'.$form['#InputKey']]):$total_price,
                "room_code"         => !empty($form_state['values']['room_code'])?str_replace(".","",$form_state['values']['room_code']):"",
                "customer_name"     => !empty($form_state['values']['orderCustomerFullName'])?str_replace(".","",$form_state['values']['orderCustomerFullName']):"",
            ))->condition("code", $form['#bookingCode'])->execute();
            db_update("tbl_room_booking")->fields(array(
                "status"=>$form_state['values']['booking_status'],
                "tran_user"=>$user->uid,
            ))->condition("code",$_booking->code)->execute();
            $code = $form['#bookingCode'];
            if($form_state['values']['booking_status']!=$_booking->status){
                $_history = $booking->history;
                switch ($form_state['values']['booking_status']){
                    case 1:
                        $_statusText="Đặt chỗ";
                        $_statusCode="DATCHO";
                        break;
                    case 2:
                        $_statusText="Báo giá";
                        $_statusCode="BAOGIA";
                        break;
                    case 3:
                        $_statusText="Đã chốt";
                        $_statusCode="DACHOT";
                        break;
                    case 4:
                        $_statusText="Thất bại";
                        $_statusCode="THATBAI";
                        break;
                }
                $_history .= "Status : ".$_statusText." - ".date("d/m/Y H:i")." Updated by ".$user->name."<br>";
                db_update("tbl_room_booking")->fields(array(
                    "history"        => $_history,
                ))->condition("code",$_booking->code,"=")->execute();
            }
            if($form_state['values']['booking_status']!=$_booking->status && $form_state['values']['booking_status']==3){
                $partner_price = !empty($form_state['values']['roomTotalAGPriceValue'.$form['#InputKey']])?str_replace(".","",$form_state['values']['roomTotalAGPriceValue'.$form['#InputKey']]):$total_price;
                $NetPrice = !empty($form_state['values']['roomTotalNetPriceValue'.$form['#InputKey']])?str_replace(".","",$form_state['values']['roomTotalNetPriceValue'.$form['#InputKey']]):$total_price;
                $db_transaction = db_transaction();
                $_agent = user_load($_booking->uid);
                $balance = !empty($_agent->field_account_balance['und'][0]['value'])?$_agent->field_account_balance['und'][0]['value']:0;
                $balance-=$partner_price;
                $tran_code = "KS".REQUEST_TIME;
                $date1=date_create(date("Y-m-d",strtotime($start_date)));
                $date2=date_create(date("Y-m-d",strtotime($end_date)));
                $diff=date_diff($date1,$date2);
                try{
                    $sub_query = db_select("tbl_room_booking","tbl_room_booking");
                    $sub_query->fields("tbl_room_booking");
                    $sub_query->join("tbl_room_booking_detail","tbl_room_booking_detail","tbl_room_booking_detail.code=tbl_room_booking.code");
                    $sub_query->addExpression("tbl_room_booking_detail.number_of_room","number_of_quantity");
                    $sub_query->addExpression("tbl_room_booking_detail.number_of_night","number_of_night");
                    $sub_query->addExpression("tbl_room_booking_detail.number_of_night*tbl_room_booking_detail.number_of_room","quantity_night");
                    $sub_query->condition("tbl_room_booking.code",$_booking->code);
                    $query = db_select($sub_query,"tbl_query");
                    $query->fields("tbl_query");
                    $query->groupBy("tbl_query.code");
                    $query->orderBy("tbl_query.created","DESC");
                    $query->addExpression("SUM(tbl_query.number_of_quantity)","quantity");
                    $query->addExpression("SUM(tbl_query.number_of_night)","night");
                    $query->addExpression("SUM(tbl_query.quantity_night)","total_quantity_night");
                    $booking = $query->execute()->fetchObject();
                    if($user->uid==1){
//                        _print_r($_booking);
//                        _print_r($booking);
//                        die;
                    }
                    db_insert("tbl_room_booking_report")->fields(array(
                        "created"           => REQUEST_TIME,
                        "booking_code"      => $_booking->code,
                        "hotel"             => $booking->hotel,
                        "guest"             => $TotalGuest,
                        "night"             => $diff->format("%a"),
                        "price"             => $NetPrice,
                        "partner_price"     => $partner_price,
                        "revenue"           => $partner_price-$NetPrice,
                        "agent"             => $_booking->uid,
                        "tran_user"         => $user->uid,
                        "tran_kind"         => 15,
                        "tran_code"         => $tran_code,
                        "balance"           => $balance,
                        "quantity"           => $quantity,
                        "quantity_night"    => $booking->total_quantity_night,
                        "room_code"         => !empty($form_state['values']['room_code'])?str_replace(".","",$form_state['values']['room_code']):"",
                        "category"          => "room_booking",
                    ))->execute();
                    db_insert("tbl_report")->fields(array(
                        "created"           => REQUEST_TIME,
                        "tran_code"         => $tran_code,
                        "type"         => "room_booking",
                    ))->execute();
                    $query = db_select("tbl_issue_report","tbl_issue_report");
                    $query->fields("tbl_issue_report");
                    $query->condition("agent",$booking->uid);
                    $query->condition("date",strtotime(date("d-m-Y 00:00",strtotime("01-09-2020"))),">=");
                    $query->addExpression("SUM(partner_price)","total");
                    $query->groupBy("agent");
                    $result = $query->execute()->fetchObject();
                    $query1 = db_select("tbl_room_booking_report","tbl_room_booking_report");
                    $query1->fields("tbl_room_booking_report");
                    $query1->condition("agent",$booking->uid);
                    $query1->addExpression("SUM(partner_price)","total");
                    $query1->groupBy("agent");
                    $result1 = $query1->execute()->fetchObject();
                    $total = !empty($result)?$result->total:0;
                    if(!empty($result1)){
                        $total+=$result1->total;
                    }
                    $point = ceil($total/1000000);
                    $_agent->field_point['und'][0]['value'] = $point;
                    $_agent->field_account_balance['und'][0]['value'] = $balance;
                    if(!empty($_agent->field_account_status['und']) && $_agent->field_account_status['und'][0]['tid']==22){ //tiềm năng
                        $_agent->field_account_status['und'][0]['tid'] = 13;
                        $_agent->field_account_updated_date['und'][0]['value'] = REQUEST_TIME;
                    }
                    user_save($_agent);
//                    db_update("tbl_room_booking")->fields(array(
//                        "status"=>$_REQUEST['status'],
//                        "tran_user"=>$user->uid,
//                    ))->condition("code",$_booking->code)->execute();
                    $mail_content = _cassiopeia_render_theme("module","cassiopeia","templates/mail/room-booking-mail-2.tpl.php",array("booking_code"=>$booking->code));
                    $site_mail = variable_get("site_mail");
                    $body[] = $mail_content;
                    $headers['From'] = $headers['Sender'] = $headers['Return-Path'] = "";
                    $headers['MIME-Version'] = '1.0';
                    $headers['Content-Type'] = 'text/html; charset=UTF-8; format=flowed; delsp=yes';
                    $params = array(
                        'body' => $body,
                        'subject' => "Booking Autic.vn",
                        'headers' => $headers,
                    );
                    if (drupal_mail('cassiopeia', 'custom_key', $booking->contactEmail, language_default(), $params)) {

                    };
                }catch (Exception $e){
//                    _print_r($e);
//                    $db_transaction->rollback();
                }
            }elseif($form_state['values']['booking_status']!=$_booking->status && $form_state['values']['booking_status']==2){
                $mail_content = _cassiopeia_render_theme("module","cassiopeia","templates/mail/room-booking-mail-2.tpl.php",array("booking_code"=>$booking->code));
                $site_mail = variable_get("site_mail");
                $body[] = $mail_content;
                $headers['From'] = $headers['Sender'] = $headers['Return-Path'] = "";
                $headers['MIME-Version'] = '1.0';
                $headers['Content-Type'] = 'text/html; charset=UTF-8; format=flowed; delsp=yes';
                $params = array(
                    'body' => $body,
                    'subject' => "Booking Autic.vn",
                    'headers' => $headers,
                );
                if (drupal_mail('cassiopeia', 'custom_key', $booking->contactEmail, language_default(), $params)) {

                };

            }
            db_delete("tbl_room_booking_detail")->condition("code", $form['#bookingCode'])->execute();
        } else {
            $code = "KS" . REQUEST_TIME;
            if($arg[0]=="hotel"){
                $_agent = user_load($user->uid);
                $_name = $form_state['values']['orderContactFullName'];
            }else{
                $str = $form_state['values']['orderContactFullName'];
                $array = explode("-",$str);
                $_code = trim($array[0]);
                $_name = trim($array[1]);
                $query = db_select("users","tbl_user");
                $query -> fields("tbl_user");
                $query->join("field_data_field_account_code","field_account_code","field_account_code.entity_id=tbl_user.uid");
                $query->condition("field_account_code.field_account_code_value",$_code,"=");
                $_agent = $query->execute()->fetchObject();
            }

//            $agent_id = str_replace("A","",$_code);
//            $agent_id = str_replace("0","",$agent_id);
//            _print_r($agent_id);
//            die;
            db_insert("tbl_room_booking")->fields(array(
                "created" => REQUEST_TIME,
                "status" => 1,
                "code" => $code,
                "contactName" => $_name,
                "contactTel" => $form_state['values']['orderContactTel'],
                "contactEmail" => $form_state['values']['orderContactEmail'],
                "note" => !empty($form_state['values']['note']) ? $form_state['values']['note'] : "",
                "room_price" => $price,
                "surcharge_adult" => !empty($plus_min_price['adult']) ? $plus_min_price['adult'] : 0,
                "surcharge_children" => !empty($plus_min_price['children']) ? $plus_min_price['children'] : 0,
                "extraBed" => $TotalExtraBed,
                "surcharge_weekend" => $weekend,
                "hotel" => $form_state['values']['hotel'],
                "from_date" => strtotime($start_date),
                "to_date" => strtotime($end_date),
                "uid" => $_agent->uid,
                "VAT" => !empty($form_state['values']['roomVATLabel']) ? 1 : 0,
                "total_price"   => $total_price,
                "partner_price"     => !empty($form_state['values']['roomTotalAGPriceValue'.$form['#InputKey']])?str_replace(".","",$form_state['values']['roomTotalAGPriceValue'.$form['#InputKey']]):$total_price,
                "net_price"         => !empty($form_state['values']['roomTotalNetPriceValue'.$form['#InputKey']])?str_replace(".","",$form_state['values']['roomTotalNetPriceValue'.$form['#InputKey']]):$TotalNetprice,
                "room_code"         => !empty($form_state['values']['room_code'])?str_replace(".","",$form_state['values']['room_code']):"",
                "customer_name"     => !empty($form_state['values']['orderCustomerFullName'])?str_replace(".","",$form_state['values']['orderCustomerFullName']):"",
//                "partner_price"   => $total_price,
//                "net_price"   => $TotalNetprice,
//                "customer_name"   => !empty($form_state['values']['orderCustomerFullName'])?str_replace(".","",$form_state['values']['orderCustomerFullName']):$total_price,
            ))->execute();

        }
        $mail_data['contact'] = array(
            "contactName"   => $_name,
            "contactTel"   => $form_state['values']['orderContactTel'],
            "contactEmail"   => $form_state['values']['orderContactEmail'],
        );
        $mail_data['total'] = array(
            "room_price"            => $price,
            "surcharge_adult"       => !empty($plus_min_price['adult']) ? $plus_min_price['adult'] : 0,
            "surcharge_children"    => !empty($plus_min_price['children']) ? $plus_min_price['children'] : 0,
            "extraBed"              => $TotalExtraBed,
            "VAT"                   => !empty($form_state['values']['roomVATLabel']) ? 1 : 0,
            "note"                  => !empty($form_state['values']['note']) ? $form_state['values']['note'] : "",
        );
        foreach ($form_state['roomList'] as $_index => $_value) {

            $roomGroup = $form_state['values']['roomContainer']['roomGroup_' . $_index];
            $_room = node_load($roomGroup['room_' . $_index]);
            $_roomExtraBed = !empty($roomExtraBed[$_index]) ? $roomExtraBed[$_index] : 0;
            $children_age = "";
            if (!empty($roomGroup['roomGroupAge_' . $_index])) {
                foreach ($roomGroup['roomGroupAge_' . $_index] as $_age) {
                    $children_age .= "," . $_age;
                }
            }
            $mail_data['rooms'][$_index]['room-type'] = $_room->title;
            $mail_data['rooms'][$_index]['room-count'] = $roomGroup['quantity_' . $_index];
            $mail_data['rooms'][$_index]['from-date'] = strtotime($roomGroup['from_date_' . $_index]);
            $mail_data['rooms'][$_index]['to-date'] = strtotime($roomGroup['to_date_' . $_index]);
            $mail_data['rooms'][$_index]['night'] = $roomGroup['number_of_night_' . $_index];
            $mail_data['rooms'][$_index]['adult'] = $roomGroup['adult_' . $_index];
            $mail_data['rooms'][$_index]['children'] = $roomGroup['children_' . $_index];
            $mail_data['rooms'][$_index]['children_age'] = $children_age;
            $mail_data['rooms'][$_index]['extraBed'] = $_roomExtraBed;

            db_insert("tbl_room_booking_detail")->fields(array(
                "code" => $code,
                "room" => $roomGroup['room_' . $_index],
                "number_of_room" => $roomGroup['quantity_' . $_index],
                "from_date" => strtotime($roomGroup['from_date_' . $_index]),
                "to_date" => strtotime($roomGroup['to_date_' . $_index]),
                "number_of_night" => $roomGroup['number_of_night_' . $_index],
                "adult" => $roomGroup['adult_' . $_index],
                "children" => $roomGroup['children_' . $_index],
                "children_age" => $children_age,
                "extraBed" => $_roomExtraBed,
                "room_price" => serialize($room_price[$_index]),
            ))->execute();
        }
        if (!empty($form['#bookingCode'])) {
            drupal_set_message("Cập nhật đặt phòng thành công");
            drupal_goto("/admin/manager/room/booking");
        } else {

            drupal_set_message("Chúng tôi đã nhận được yêu cầu của bạn, chúng tôi sẽ liên hệ lại trong thời gian sớm nhất");
            $arg = arg();
            if($arg[0]=="admin"){
                drupal_goto("/admin/manager/room/booking");
            }else{
                drupal_goto("/hotel/room/booking/complete");
            }

        }
    } catch (Exception $e) {
        _print_r($e);
        die;
        $db_transaction->rollback();
    }
}

function cassiopeia_get_room_booking_by_code($code)
{
    $query = db_select("tbl_room_booking", "tbl_room_booking");
    $query->fields("tbl_room_booking");
    $query->condition("code", $code);
    $result = $query->execute()->fetchObject();
    return !empty($result) ? $result : null;
}



