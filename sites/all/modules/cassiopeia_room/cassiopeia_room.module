function cassiopeia_room_booking_load($id) {
	$return = NULL;
	try {
		$query = db_select("cassiopeia_room_booking", "cassiopeia_room_booking");
		$query->fields("cassiopeia_room_booking");
		$query->condition("id", $id, "=");
		$booking = $query->execute()->fetchObject();
		if (!empty($booking)) {
			$details = cassiopeia_room_detail_load($booking->id);
			$booking->details = $details;
		}

		$return = $booking;
	}
	catch (Exception $e) {
		_print_r($e);
	}
	return $return;
}

function cassiopeia_room_booking_delete($booking) {
	return [];
}

function cassiopeia_room_detail_load($bid) {
	$return = NULL;
	try {
		$query = db_select("cassiopeia_room_booking_detail", "cassiopeia_room_booking_detail");
		$query->fields("cassiopeia_room_booking_detail");
		$query->condition("bid", $bid, "=");
		$query->orderBy("created", "ASC");
		$rooms = $query->execute()->fetchAll();
		$return = $rooms;
	}
	catch (Exception $e) {
		_print_r($e);
	}
	return $return;
}

function cassiopeia_room_room_booking_form($form, &$form_state, $data = []) {
	global $theme;
	global $user;
	$_user = !empty($user->uid) ? user_load($user->uid) : NULL;
	$form['#room'] = $form_state['#room'] = !empty($data['room']) ? $data['room'] : NULL;
	$form['#hotel'] = $form_state['#hotel'] = !empty($data['hotel']) ? $data['hotel'] : NULL;
	$form['#tx_area'] = $form_state['#tx_area'] = !empty($data['tx_area']) ? $data['tx_area'] : NULL;
	$form['#data'] = $form_state['#data'] = !empty($data['data']) ? $data['data'] : NULL;
	$form_wrapper = "cassiopeia-room-room-booking-form-wrapper";
	$form['#attributes']['class'][] = "cassiopeia-room-room-booking-form";
	$form['#prefix'] = "<div id='" . $form_wrapper . "'>";
	$form['#suffix'] = "</div>";
	$form['customer'] = [
		'#type' => 'container',
		'#tree' => TRUE,
	];
	$form['customer']['full_name'] = [
		'#type' => 'textfield',
		'#title' => t(''),
		'#attributes' => ["placeholder" => "Họ tên"],
	];
	$form['customer']['tel'] = [
		'#type' => 'textfield',
		'#title' => t(''),
		'#attributes' => ["placeholder" => "Số điện thoại"],
	];
	$form['customer']['mail'] = [
		'#type' => 'textfield',
		'#title' => '',
		'#attributes' => ["placeholder" => "Email"],
	];
	$provinces = cassiopeia_address_province_load_all();
	$options = [];
	$options['_none'] = "Chọn Tỉnh/TP";
	foreach ($provinces as $province) {
		$options[$province->id] = $province->name;
	}
	$form['customer']['province'] = [
		'#type' => 'select',
		'#title' => t(''),
		'#options' => $options,
		'#attributes' => ["placeholder" => "Thành phố"],
	];
	$form['customer']['address'] = [
		'#type' => 'textfield',
		'#title' => t(''),
		'#attributes' => ["placeholder" => "Địa chỉ"],
	];
	$form['customer']['note'] = [
		'#title' => t(''),
		'#type' => 'textarea',
		'#attributes' => ["placeholder" => "Nội dung yêu cầu đặc biệt"],
	];
	if (!empty($_user->uid)) {
		$form['contact'] = [
			'#type' => 'container',
			'#tree' => TRUE,
		];
		$form['contact']['full_name'] = [
			'#type' => 'textfield',
			'#title' => t(''),
			'#attributes' => ["placeholder" => "Họ tên đại lý"],
			'#default_value' => !empty($_user->field_account_full_name['und'][0]['value']) ? $_user->field_account_full_name['und'][0]['value'] : "",
		];
		$form['contact']['tel'] = [
			'#type' => 'textfield',
			'#title' => t(''),
			'#attributes' => ["placeholder" => "Số điện thoại"],
			'#default_value' => $_user->name,
		];
		$form['contact']['mail'] = [
			'#type' => 'textfield',
			'#title' => '',
			'#attributes' => ["placeholder" => "Email"],
			'#default_value' => $_user->mail,
		];
	}
	$form['payment'] = [
		'#type' => 'container',
		'#tree' => TRUE,
	];
	$form['#room_price'] = $form_state['#room_price'] = $room_price = getMinPriceByHotelRoomByDate(str_replace("/", "-", $form['#data']['check-in']), str_replace("/", "-", $form['#data']['check-out']), $form['#room']->nid, $form['#hotel']->nid);

	$total_price = $form['#data']['quantity'] * $room_price->total_price;
	$form['#total_price'] = $form_state['#total_price'] = $total_price;
	$balance = $_user->field_account_balance['und'][0]['value'];
	if ($room_price->total_price > $balance) {
		$text = "<span>Số dư tài khoản không đủ, vui lòng nạp tiền để tiếp tục</span>";
	}
	$options = [];
	if (!empty($user->uid)) {
		$_options[QT_CREDIT] = "Quang Trang Credit";
		//        $_options[PAYMENT_HOLD] = "Giữ chỗ";
	}
	else {
		$_options[QR_PAY] = "QR CODE";
		$_options[INTERNET_BANKING] = "Chuyển khoản nhận ngay 24/7";
		$_options[DOMESTIC_CARD] = "Thẻ nội địa";
		$_options[INTERNATIONAL_CARD] = "Thẻ quốc tế";
		//        $_options[PAYMENT_HOLD] = "Giữ chỗ";
	}
	foreach ($_options as $_key => $_option) {
		$alefee = 0;
		$note = "Miễn phí";
		$fee = cassiopeia_qt_alepay_fee_config_load($_key);
		if (!empty($fee)) {
			$alefee = $fee->percent * $total_price / 100 + $fee->amount;
			if (!empty($alefee)) {
				$note = "Thu thêm phụ phí: " . number_format($alefee, 0, ",", ".") . "đ";
			}
		}
		if ($_key == QT_CREDIT) {
			$note = $text;
		}
		$options[$_key] = _cassiopeia_render_theme("module", "cassiopeia_qt", "templates/parts/payment-method-label.tpl.php", [
			"payment_method" => $_key,
			"note" => $note,
			"balance" => $balance,
		]);
	}
	$form['payment']['method'] = [
		'#type' => 'radios',
		'#title' => t(''),
		'#default_value' => PAYMENT_HOLD,
		'#options' => $options,
		'#ajax' => [
			'callback' => 'cassiopeia_room_room_booking_form_change_payment_method_ajax_callback',
			'wrapper' => $form_wrapper,
			'method' => 'replace',
			'effect' => 'fade',
		],
	];
	$alepay_fee = "Miễn phí";
	$form['#alefee'] = $form_state['#alefee'] = $alefee = 0;
	if (!empty($form_state['values']['payment']['method'])) {
		$fee = cassiopeia_qt_alepay_fee_config_load($form_state['values']['payment']['method']);
		if (!empty($fee)) {
			$form['#alefee'] = $form_state['#alefee'] = $alefee = $fee->percent * $total_price / 100 + $fee->amount;
		}
	}

	//    $cassiopeia_admin_room_payment_config_form_content = variable_get('cassiopeia_admin_room_payment_config_form_content', array(
	//        'value' => '',
	//        'format' => 'full_html'
	//    ));
	//    $cassiopeia_admin_room_payment_config_form_content_value = !empty($cassiopeia_admin_room_payment_config_form_content['value'])?$cassiopeia_admin_room_payment_config_form_content['value']:"";
	//    $form['payment']['method'][HOLD]['#prefix'] = "<div class=\"box-form-payments bg-form-booking pd-2 mb-4\">
	//                        <label for=\"edit-payment-method-3\">";
	//    $form['payment']['method'][HOLD]['#suffix'] = "
	//                            <div class=\"icon-payments ml-2\">
	//                                <img src=\"/sites/all/themes/cassiopeia_theme/img/icons/option-pay-3.png\" alt=\"\">
	//                            </div>
	//                            <span>Thanh toán bằng chuyển khoản ngân hàng </span>
	//                        </label>
	//                        <div class=\"node-payments-op-3 mt-1\">
	//                                ".$cassiopeia_admin_room_payment_config_form_content_value."
	//                        </div>
	//                    </div>
	//                        ";
	$banks = (array) cassiopeia_get_items_by_conditions([], "bank_info", "node");
	$options = [];
	$default_value = !empty($banks) ? array_values($banks)[0]->nid : NULL;
	if (!empty($banks)) {
		foreach ($banks as $bank) {
			$options[$bank->nid] = _cassiopeia_render_theme("module", "cassiopeia", "templates/parts/bank-type-1.tpl.php", [
				"node" => $bank,
				"image_style" => "original",
			]);
		}
	}
	$form['bank'] = [
		'#type' => 'radios',
		'#title' => t(''),
		'#options' => $options,
		'#default_value' => $default_value,
	];

	$form['topup'] = [
		'#type' => 'submit',
		'#name' => 'topup',
		'#value' => t('Nạp tiền'),
		'#attributes' => ["class" => ["btn bg-secondary clr-white text ff-bold radius-36 mt-4"]],
		'#submit' => ['cassiopeia_room_room_booking_form_topup_submit_callback'],
		'#ajax' => [
			'callback' => 'cassiopeia_room_room_booking_form_topup_submit_ajax_callback',
		],
	];
	$form['submit'] = [
		'#type' => 'submit',
		'#value' => t('Hoàn tất thanh toán'),
		'#validate' => ["cassiopeia_room_room_booking_form_submit_validate"],
		'#attributes' => ["class" => ["btn-ajax"]],
		'#submit' => ["cassiopeia_room_room_booking_form_submit"],
		//        '#ajax' => array(
		//            'callback' => 'cassiopeia_room_room_booking_form_submit',
		//        ),
	];
	$form['#attached']['js'] = [
		drupal_get_path("module", "cassiopeia_room") . "/js/cassiopeia-room-room-booking-form.js",
	];
	return $form;
}

function cassiopeia_room_room_booking_form_change_payment_method_ajax_callback($form, &$form_state) {
	return $form;
}

function cassiopeia_room_room_booking_form_topup_submit_callback($form, &$form_state) {
	global $user;
	try {
		$query = db_select("tbl_top_up_request", "tbl_top_up_request");
		$query->fields("tbl_top_up_request");
		$query->range(0, 1);
		$query->orderBy("created", "DESC");
		$last = $query->execute()->fetchObject();
		if (!empty($last)) {
			$code_number = str_replace("T", "", $last->code);
			$code_number++;
		}
		else {
			$code_number = "100000";
		}
		$code = "T" . $code_number;
		$s = new stdClass();
		$s->uid = $user->uid;
		$s->created = REQUEST_TIME;
		$s->bank = $form_state['values']['bank'];
		$s->code = $code;
		$s->payment = 1;
		$s->amount = $form_state['#total_price'];
		$s->status = 0;
		drupal_write_record("tbl_top_up_request", $s);

		$data['message'] = ucfirst(SITE_DOMAIN) . " đã tiếp nhận thông tin, chúng tôi sẽ phản hồi trong thời gian sớm nhất!";
	}
	catch (Exception $e) {
		print_r($e);
		$data['message'] = "Đã xảy ra lỗi, vui lòng thử lại sau!";
	}
}

function cassiopeia_room_room_booking_form_topup_submit_ajax_callback($form, &$form_state) {
	ctools_include('ajax');
	$commands[] = ajax_command_invoke("", "cassiopeiaAlert", [json_encode(["Chúng tôi đã nhận được yêu cầu của bạn, chúng tôi sẽ xử lý trong thời gian sớm nhất!"])]);
	return [
		'#type' => 'ajax',
		'#commands' => $commands,
	];
}

function cassiopeia_room_room_booking_form_submit_validate($form, &$form_state) {
	global $user;
	$_user = user_load($user->uid);
	if ($form_state['values']['payment']['method'] == 1) {
		if ($_user->field_account_balance['und'][0]['value'] < $form_state['#total_price']) {
			form_error($form['submit'], "Tài khoản không đủ số dư, vui lòng nạp thêm tiền để tiếp tục!");
		}
	}
	if (empty($form_state['values']['customer']['full_name'])) {
		form_error($form['customer']['full_name'], "Bạn chưa nhập Họ tên khách hàng!");
	}
	if (empty($form_state['values']['customer']['tel'])) {
		form_error($form['customer']['tel'], "Bạn chưa nhập Số điện thoại khách hàng!");
	}
	if (empty($form_state['values']['customer']['province']) || $form_state['values']['customer']['province'] == "_none") {
		form_error($form['customer']['province'], "Bạn chưa chọn Tỉnh/TP!");
	}
	if (empty($form_state['values']['customer']['address'])) {
		form_error($form['customer']['address'], "Bạn chưa nhập địa chỉ!");
	}
}

function cassiopeia_room_room_booking_form_submit($form, &$form_state) {
	global $user;
	if (!empty($user->uid)) {
		$_agent = user_load($user->uid);
	}
	$contact = $form_state['values']['contact'];
	$customer = $form_state['values']['customer'];
	//    print_r($form_state['values']);
	//    die;
	$db_transaction = db_transaction();

	try {
		$code = "KS" . REQUEST_TIME;
		$booking = new stdClass();
		$booking->contactName = !empty($contact['full_name']) ? $contact['full_name'] : "";
		$booking->contactTel = !empty($contact['tel']) ? $contact['tel'] : "";
		$booking->contactEmail = !empty($contact['mail']) ? $contact['mail'] : "";
		$booking->room_price = $form_state['#data']['customer'];
		$booking->surcharge_adult = 0;
		$booking->surcharge_children = 0;
		$booking->extraBed = 0;
		$booking->surcharge_weekend = 0;
		$booking->from_date = strtotime(str_replace("/", "-", $form_state['#data']['check-in']));
		$booking->to_date = strtotime(str_replace("/", "-", $form_state['#data']['check-out']));
		$booking->VAT = 0;
		$booking->note = "";
		$booking->voucher = "";
		$booking->total_price = $form_state['#total_price'];

		$booking->partner_price = $form_state['#total_price'];
		$booking->net_price = $form_state['#room_price']->totalNetPrice;
		$booking->room_code = "";
		$booking->customer_name = !empty($customer['full_name']) ? $customer['full_name'] : "";
		$booking->customer_tel = !empty($customer['tel']) ? $customer['tel'] : "";
		$booking->customer_mail = !empty($customer['mail']) ? $customer['mail'] : "";
		$booking->customer_province = !empty($customer['province']) ? $customer['province'] : 0;
		$booking->customer_address = !empty($customer['address']) ? $customer['address'] : "";
		$booking->customer_note = !empty($customer['note']) ? $customer['note'] : "";
		$booking->history = "";
		$room = $form_state['#room'];
		$booking->details = [];
		$detail = new stdClass();
		$detail->room = $room->nid;
		$detail->number_of_room = $form_state['#data']['quantity'];
		$detail->from_date = strtotime(str_replace("/", "-", $form_state['#data']['check-in']));
		$detail->to_date = strtotime(str_replace("/", "-", $form_state['#data']['check-out']));
		$detail->number_of_night = $form_state['#data']['number_of_night'];
		$detail->adult = $form_state['#data']['adult'];
		$detail->children = $form_state['#data']['children'];
		$detail->children_age = 0;
		$detail->extraBed = 0;
		$detail->room_price = $form_state['#room_price']->total_price;
		$booking->details[] = $detail;

		$booking->hotel = $form_state['#hotel']->nid;
		$booking->status = 1;
		$booking->code = $code;
		$booking->uid = !empty($user->uid) ? $user->uid : 0;
		$booking->tran_user = 0;
		$booking->payment_method = $form_state['values']['payment']['method'];

		if ($form_state['values']['payment']['method'] == 1 && !empty($_agent)) {
			$balance = $_agent->field_account_balance['und'][0]['value'];
			$balance -= $booking->partner_price;
			db_insert("tbl_room_booking_report")->fields([
				"created" => REQUEST_TIME,
				"booking_code" => $booking->code,
				"hotel" => $booking->hotel,
				"guest" => $booking->guest,
				"night" => $detail->number_of_night,
				"price" => $booking->net_price,
				"partner_price" => $booking->partner_price,
				"revenue" => $booking->partner_price - $booking->net_price,
				"agent" => $booking->uid,
				"tran_user" => $user->uid,
				"tran_kind" => 15,
				"tran_code" => REQUEST_TIME,
				"balance" => $balance,
				"quantity_night" => $detail->number_of_room * $detail->number_of_night,
				"category" => "room_booking",
			])->execute();
			db_insert("tbl_report")->fields([
				"created" => REQUEST_TIME,
				"tran_code" => REQUEST_TIME,
				"type" => "room_booking",
			])->execute();
			$query = db_select("tbl_issue_report", "tbl_issue_report");
			$query->fields("tbl_issue_report");
			$query->condition("agent", $booking->uid);
			$query->condition("date", strtotime(date("d-m-Y 00:00", strtotime("01-09-2020"))), ">=");
			$query->addExpression("SUM(partner_price)", "total");
			$query->groupBy("agent");
			$result = $query->execute()->fetchObject();
			$query1 = db_select("tbl_room_booking_report", "tbl_room_booking_report");
			$query1->fields("tbl_room_booking_report");
			$query1->condition("agent", $booking->uid);
			$query1->addExpression("SUM(partner_price)", "total");
			$query1->groupBy("agent");
			$result1 = $query1->execute()->fetchObject();
			$total = $result->total;
			if (!empty($result1)) {
				$total += $result1->total;
			}
			$point = ceil($total / 1000000);
			$_agent->field_point['und'][0]['value'] = $point;
			$_agent->field_account_balance['und'][0]['value'] = $balance;
			if ($_agent->field_account_status['und'][0]['tid'] == 22) { //tiềm năng
				$_agent->field_account_status['und'][0]['tid'] = 13;
				$_agent->field_account_updated_date['und'][0]['value'] = REQUEST_TIME;
			}
			user_save($_agent);
			$booking->status = 3;
		}
		if (in_array($form_state['values']['payment']['method'], [
			DOMESTIC_CARD,
			INTERNATIONAL_CARD,
			INTERNET_BANKING,
			QR_PAY,
		])) {
			$booking->alefee = !empty($form_state['#alefee']) ? $form_state['#alefee'] : 0;
			$return = cassiopeia_room_alepay_request_payment($booking);
			$booking->transactionCode = $return->transactionCode;
			//            print_r($booking);
			//            die;

			if ($return->code == "000") {
				$form_state['redirect'] = $return->checkoutUrl;
			}
			else {
				drupal_set_message("Đã xảy ra lỗi!");
			}
		}
		else {
			$form_state['redirect'] = "dat-phong/hoan-tat/" . $code;
		}
		cassiopeia_room_booking_save($booking);
	}
	catch (Exception $e) {
		_print_r($e);
		$db_transaction->rollback();
	}
}

function cassiopeia_room_alepay_request_payment($booking) {
	$province = cassiopeia_address_province_load($booking->customer_province);
	$fields = new stdClass();
	$fields->amount = $booking->total_price + $booking->alefee;
	$fields->buyerAddress = $booking->customer_address;
	$fields->buyerCity = $province->name;
	$fields->buyerCountry = "Viet Nam";

	$fields->buyerEmail = $booking->customer_mail;
	$fields->buyerName = $booking->customer_name;
	$fields->buyerPhone = $booking->customer_tel;
	$fields->cancelUrl = "https://qtair.vn/dat-phong/alepay/cancel";

	$fields->currency = "VND";
	$fields->customMerchantId = "";
	$fields->orderCode = $booking->code;
	$fields->orderDescription = $booking->code;

	$fields->returnUrl = "https://qtair.vn/dat-phong/alepay/complete";
	$fields->tokenKey = tokenKey;
	$fields->totalItem = 1;
	$firstValue = NULL;
	switch ($booking->payment_method) {
		case INTERNATIONAL_CARD :
			$fields->checkoutType = 1;
			//            $fields->allowDomestic = true;
			//            $fields->paymentMethod  = "ATM_ON";
			break;
		case DOMESTIC_CARD :
			$fields->checkoutType = 4;
			$fields->allowDomestic = TRUE;
			$fields->paymentMethod = "ATM_ON";
			$firstValue = "true";
			break;
		case INTERNET_BANKING :
			$fields->checkoutType = 4;
			$fields->allowDomestic = TRUE;
			$fields->paymentMethod = "VA";
			$firstValue = "true";
			break;
		case QR_PAY :
			$fields->checkoutType = 4;
			$fields->allowDomestic = TRUE;
			$fields->paymentMethod = "VIETQR";
			$firstValue = "true";
			break;
	}
	$fields = (array) $fields;
	ksort($fields);
	//    print_r($fields);
	//    die;
	$index = 1;
	$data = "";
	foreach ($fields as $key => $field) {
		if ($index == 1) {
			if (empty($firstValue)) {
				$data .= $key . "=" . $field;
			}
			else {
				$data .= $key . "=" . $firstValue;
			}
		}
		else {
			$data .= "&" . $key . "=" . $field;
		}
		$index++;
	}
	$fields['signature'] = hash_hmac('sha256', $data, ChecksumKey);
	$curl = curl_init();

	curl_setopt_array($curl, [
		CURLOPT_URL => ALEPAY_ENPOINT . '/request-payment',
		CURLOPT_RETURNTRANSFER => TRUE,
		CURLOPT_ENCODING => '',
		CURLOPT_MAXREDIRS => 10,
		CURLOPT_TIMEOUT => 0,
		CURLOPT_FOLLOWLOCATION => TRUE,
		CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
		CURLOPT_CUSTOMREQUEST => 'POST',
		CURLOPT_POSTFIELDS => json_encode($fields),
		CURLOPT_HTTPHEADER => [
			'Content-Type: application/json',
		],
	]);

	$response = curl_exec($curl);

	curl_close($curl);
	return json_decode($response);
}

function cassiopeia_room_booking_report_save($report) {
	$report->tran_code = !empty($report->tran_code) ? $report->tran_code : "KS" . REQUEST_TIME;
	$_agent = user_load($report->agent);
	if (empty($report->balance)) {
		$report->balance = !empty($_agent->field_account_balance['und'][0]['value']) ? $_agent->field_account_balance['und'][0]['value'] : 0;
		$report->balance -= (float) $report->partner_price;
	}
	try {
		db_insert("tbl_room_booking_report")->fields([
			"created" => REQUEST_TIME,
			"booking_code" => $report->booking_code,
			"hotel" => $report->hotel,
			"price" => $report->price,
			"partner_price" => $report->partner_price,
			"revenue" => $report->revenue,
			"agent" => $report->agent,
			"room_code" => $report->room_code,
			"tran_user" => $report->uid,
			"tran_kind" => $report->tran_kind,
			"note" => $report->note,
			"tran_code" => $report->tran_code,
			"balance" => $report->balance,
			"quantity_night" => !empty($report->quantity_night) ? $report->quantity_night : 0,
			"category" => "room_booking",
		])->execute();
		db_insert("tbl_report")->fields([
			"created" => REQUEST_TIME,
			"tran_code" => $report->tran_code,
			"type" => "room_booking",
		])->execute();
	}
	catch (Exception $e) {
		_print_r($e);
		die;
	}
	$query = db_select("tbl_issue_report", "tbl_issue_report");
	$query->fields("tbl_issue_report");
	$query->condition("agent", $_agent->uid);
	$query->condition("date", strtotime(date("d-m-Y 00:00", strtotime("01-09-2020"))), ">=");
	$query->addExpression("SUM(partner_price)", "total");
	$query->groupBy("agent");
	$result = $query->execute()->fetchObject();
	$query1 = db_select("tbl_room_booking_report", "tbl_room_booking_report");
	$query1->fields("tbl_room_booking_report");
	$query1->condition("agent", $_agent->uid);
	$query1->addExpression("SUM(partner_price)", "total");
	$query1->groupBy("agent");
	$result1 = $query1->execute()->fetchObject();
	$total = $result->total;
	if (!empty($result1)) {
		$total += $result1->total;
	}
	$point = floor($total / 1000000);
	$_agent->field_point['und'][0]['value'] = $point;
	$_agent->field_account_balance['und'][0]['value'] = $report->balance;
	if ($_agent->field_account_status['und'][0]['tid'] == 22) { //tiềm năng
		$_agent->field_account_status['und'][0]['tid'] = 13;
		$_agent->field_account_updated_date['und'][0]['value'] = REQUEST_TIME;
	}
	user_save($_agent);
	$agent_status = new stdClass();
	$agent_status->uid = $_agent->uid;
	if (!empty($result)) {
		$agent_status->status[2] = 2;
		$agent_status->status[3] = 3;
	}
	if (!empty($result1)) {
		$agent_status->status[2] = 2;
		$agent_status->status[4] = 4;
	}
	cassiopeia_user_agent_status_save($agent_status);
}

