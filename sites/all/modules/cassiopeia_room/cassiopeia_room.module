function cassiopeia_room_booking_save($booking) {
	$return = NULL;
	$db_transaction = db_transaction();
	try {
		if (!empty($booking->id)) {
			$booking->changed = REQUEST_TIME;
			$booking_saved = drupal_write_record("cassiopeia_room_booking", $booking, ["id"]);
		}
		else {
			$booking->created = REQUEST_TIME;
			$booking->changed = REQUEST_TIME;
			$booking_saved = drupal_write_record("cassiopeia_room_booking", $booking);
		}
		if (!empty($booking->voucher)) {
			db_delete("cassiopeia_voucher_transaction")
				->condition("bid", $booking->id)
				->execute();
			$transaction = new stdClass();
			$transaction->uid = $booking->uid;
			$transaction->bid = $booking->id;
			$transaction->vid = $booking->voucher;
			$transaction->amount = $booking->discount_value;
			$transaction->status = 0;
			$transaction->product_type = 1;
			cassiopeia_voucher_transaction_save($transaction);
		}
		db_delete("cassiopeia_room_booking_detail")
			->condition("bid", $booking->id)
			->execute();
		if (!empty($booking->details)) {
			foreach ($booking->details as $detail) {
				$detail->bid = $booking->id;
				$detail->code = $booking->code;
				drupal_write_record("cassiopeia_room_booking_detail", $detail);
			}
		}
		$return = $booking;
	}
	catch (Exception $E) {
		$return = NULL;
		$db_transaction->rollback();
	}
	return $return;
}

function cassiopeia_room_room_booking_code_load($code) {
	$return = NULL;
	try {
		$query = db_select("cassiopeia_room_booking", "cassiopeia_room_booking");
		$query->fields("cassiopeia_room_booking");
		$query->condition("code", $code, "=");
		$booking = $query->execute()->fetchObject();
		if (!empty($booking)) {
			$details = cassiopeia_room_detail_load($booking->id);
			if (!empty($details)) {
				$booking->details = $details;
				$total_room = 0;
				$total_night = 0;
				$total_quantity_night = 0;
				$total_guest = 0;
				$from_date = 0;
				foreach ($details as $detail) {
					if (empty($from_date)) {
						$from_date = $detail->from_date;
					}
					else {
						if ($from_date > $detail->from_date) {
							$from_date = $detail->from_date;
						}
					}
					$total_guest += $detail->adult;
					$total_room += $detail->number_of_room;
					$total_night += $detail->number_of_night;
					$total_quantity_night += $detail->number_of_night * $detail->number_of_room;
				}
				$booking->total_room = $total_room;
				$booking->total_night = $total_night;
				$booking->total_guest = $total_guest;
				$booking->total_quantity_night = $total_quantity_night;
				$booking->from_date = $from_date;
			}
		}

		$return = $booking;
	}
	catch (Exception $e) {
		_print_r($e);
	}
	return $return;
}

