function cassiopeia_admin_get_icon() {
  $sql = "SELECT icon FROM cassiopeia_admin_items WHERE link = :link";
  $result = db_query($sql, array(':link' => $_GET['q']))->fetchAll();
  if (!empty($result[0])) {
    return 'c3s-icon c3s-icon-' . $result[0]->icon;
  }
  elseif (arg(0) == 'user') {
    return 'c3s-icon c3s-icon-nguoidung2';
  }
  return FALSE;
}

function cassiopeia_admin_get_items_all() {
  $sql = "SELECT b.id, b.name as name, b.position, b.icon, i.id as item_id, i.name as item_name, i.link, i.icon as item_icon, i.position as item_position 
  FROM {cassiopeia_admin_block} b JOIN {cassiopeia_admin_items} i ON b.id = i.bid ORDER BY b.position, i.position";
  $result = db_query($sql)->fetchAll();
  return $result;
}

function cassiopeia_admin_get_menu_left($theme = '') {
  //if(!user_access('cassiopeia admin content')) return '';
  $result = cassiopeia_admin_get_items_all();
  //todo
  $list = array();
  foreach ($result as $item) {
    if (empty($list[$item->id])) {
      $list[$item->id] = array(
        '#title' => theme('cassiopeia_admin_administrator_icon', array('icon' => $item->icon)) . '<span>' . $item->name . '</span>',
        '#href' => $_GET['q'],
        '#attributes' => array(),
        '#localized_options' => array('html' => TRUE, 'fragment' => 'top'),
      );
    }
    if (!empty($list[$item->id])) {
      $argument = explode('?', $item->link);
      if (drupal_valid_path($argument[0])) {
        $args = array();
        if (count($argument) == 2) {
          $ex = explode('&', $argument[1]);
          foreach ($ex as $part) {
            $ex1 = explode('=', $part);
            if (count($ex1) == 2) {
              $args[$ex1[0]] = $ex1[1];
            }
          }
        }
        $list[$item->id]['#below'][$item->item_id] = array(
          '#title' => theme('cassiopeia_admin_administrator_icon', array('icon' => $item->item_icon)) . '<span>' . $item->item_name . '</span>',
          '#href' => $argument[0],
          '#attributes' => array(),
          '#localized_options' => array('html' => TRUE, 'query' => $args),
        );
      }
    }
  }
  drupal_alter('cassiopeia_admin_get_menu_left', $list);
  if ($theme) {
    return theme($theme, array('items' => $list));
  }
  return theme('cassiopeia_admin_get_menu_left', array('items' => $list));
}

function cassiopeia_admin_page_build(&$page) {
  global $user, $theme_key;
  //todo
  if ((user_access('cassiopeia admin content') || user_access('c3s quantri access theme')) && $theme_key == 'my_theme') {
    $page['page_bottom']['cassiopeia_admin_menu'] = array(
      '#markup' => '<div style="position: fixed; top: 40%; left: 10px; background: #ccc; border-radius: 5px; padding: 5px; z-index: 999;">' . l('Quản trị', user_access('cassiopeia admin content') ? 'administrator' : 'manager') . '</div>'
    );
  }
}

function cassiopeia_admin_taxonomy_menu_insert(&$item) {
  $item = _cassiopeia_admin_taxonomy_menu_item($item);
}

function cassiopeia_admin_taxonomy_menu_update(&$item) {
  $item = _cassiopeia_admin_taxonomy_menu_item($item);
}

function _cassiopeia_admin_taxonomy_menu_item($item) {
  $mlid = _taxonomy_menu_get_mlid($item['tid'], $item['vid']);
  if ($link = menu_link_load($mlid)) {
    if ($link['depth'] == 1) {
      $item['weight'] = $link['weight'];
    }
  }
  return $item;
}


function cassiopeia_admin_get_function() {
  $args = func_get_args();
  $func = $args[0];
  if (!function_exists($func)) {
    return FALSE;
  }
  unset($args[0]);
  return call_user_func_array($func, $args);
}

function cassiopeia_room_filter_form($form, &$form_state, $data = array()){
    $form = array();
    $hotels = cassiopeia_get_nodes_by_category("hotel");
    $options = array();
    $options['_none'] = "Chọn khách sạn";
    foreach($hotels as $hotel){
        $options[$hotel->nid] = $hotel->title;
    }
    $form['hotel'] = array(
        '#type' => 'select',
        '#title' => t('Khách sạn'),
        '#options' => $options,
    );
    if(isset($data['hotel'])){
        $form['hotel']['#default_value'] = $data['hotel'];
    }
    $form['submit'] = array(
        '#type' => 'submit',
        '#value' => 'Lọc',
    );
    return $form;
}
function cassiopeia_room_filter_form_submit($form, &$form_state)
{
    $arg = arg();
    $options = array(
        'query' => array(
            'data' => $form_state['values'],
        )
    );
    $form_state['redirect'] = array('/admin/manager/room', "data" => $options);
}
function cassiopeia_general_report_filter_form($form, &$form_state, $caches){
    $form = array();
    $form['#redirect'] = $caches['redirect'];
    $form = array();
    $form['#redirect'] = $caches['redirect'];
    $month_options = array();
    for ($i = 11; $i >= 0; $i--) {
        $check_point = strtotime(date("01-m-Y", REQUEST_TIME));
        $month_options[date("m-Y", strtotime(date("d-m-Y", $check_point) . " - " . $i . " months"))] = date("m/Y", strtotime(date("d-m-Y", $check_point) . " - " . $i . " months"));
    }
    $form['date_filter'] = array(
        '#type' => 'select',
        '#title' => t('Chọn tháng'),
        '#options' => $month_options,
        '#attributes' => array("onchange" => "this.form.submit();"),
        '#default_value' => !empty($caches['date_filter']) ? $caches['date_filter'] : date("m-Y", REQUEST_TIME),
    );
    if($form['#redirect'] =="admin/manager/report/room/hotel"){
        $areas = cassiopeia_get_items_by_conditions($conditions,"tx_area","taxonomy_term");
        $areas_option = array();
        $areas_option['all'] = "Tất cả";
        if (!empty($areas)) {
            foreach ($areas as $value) {
                $areas_option[$value->tid] = $value->name;
            }
        }
        $form['areas_filter'] = array(
            '#type' => 'select',
            '#title' => t('Chọn khu vực'),
            '#options' => $areas_option,
            '#attributes' => array("onchange" => "this.form.submit();"),
            '#default_value' => !empty($caches['areas_filter']) ? $caches['areas_filter'] : "all",
        );
    }
    $form['submit'] = array(
        '#type' => 'submit',
        '#value' => 'Lọc',
        '#attributes' => array("class" => array("hidden")),
    );
    return $form;
}

function cassiopeia_general_report_filter_form_submit($form, &$form_state)
{
    $options = array(
        'query' => array(
            'data' => $form_state['values'],
        )
    );
    $form_state['redirect'] = array($form['#redirect'], "data" => $options);
}
function cassiopeia_general_revenue_report_filter_form($form, &$form_state, $caches){
    $form = array();
