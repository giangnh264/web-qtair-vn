<?php


/**
 * Implements hook_permission().
 */
function cassiopeia_admin_permission() {
  return  array (
    'cassiopeia admin content' => array(
      'title' => t('Administrator content manager'),
      'description' => t('Cassiopeia admin content'),
    ),
    'cassiopeia admin block manager' => array(
      'title' => t('Administrator block Manager'),
      'description' => t('Cassiopeia admin block manager'),
    ),
  );
}


