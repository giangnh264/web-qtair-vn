    return true;
    if(user_has_role(3)||user_has_role(12)){
    }
}
function cassiopeia_admin_tx_area_delete_form($form,&$form_state,$term=null){
    $form = array();
    $title = "";
    _print_r($_REQUEST);
    switch ($term->vocabulary_machine_name){
        case "tx_hotel": $title = "Xóa Loại lưu trú"; break;
        case "tx_area": $title = "Xóa khu vực"; break;
    }
    drupal_set_title($title);
    $form['#term'] = $term;
    $form['delete'] = array(
        '#type' => 'container',
        '#prefix'   => "<div class=''>",
        '#suffix'   => "<label for=''>Bạn có muốn mục này?</label></div>",
    );
    $form['submit'] = array(
        '#type'     => 'submit',
        '#prefix'   => "<div class='form-buttons'>",
        '#suffix'   => "<a href='/".$_REQUEST['destination']."' class='btn btn-default'>Hủy</a></div>",
        '#value'    => t('Xóa')
    );
    return $form;
}
function cassiopeia_admin_tx_area_delete_form_submit(&$form,&$form_state){
    try{
        $term = taxonomy_term_load($form['#term']->tid);
		db_delete('taxonomy_term_data')
			->condition('tid', $form['#term']->tid)
			->execute();
	    drupal_set_message('Đã xóa ' . $form['#term']->name);
    }catch (Exception $e){
		drupal_set_message('Đã gặp lỗi trong quá trình xóa, vui lòng liên hệ kỹ thuật!');
    }
    $form_state['redirect'] = "/admin/manager/hotel-tx-area";
}
function cassiopeia_alepay_fee_config_form($form, &$form_state){
    $query = db_select("cassiopeia_qt_alepay_fee_config", "cassiopeia_qt_alepay_fee_config");
    $query->fields("cassiopeia_qt_alepay_fee_config");
    $result = $query->execute()->fetchAll();
    $default_values = array();
    if(!empty($result)){
        foreach($result as $item){
            $default_values[$item->type] = $item;
        }
    }

    $form_wrapper = "cassiopeia-alepay-fee-config-form-wrapper";
    $form['#prefix'] = "<div id='".$form_wrapper."'>";
    $form['#suffix'] = "</div>";
    $form['#attributes']['class'][] = "cassiopeia-alepay-fee-config-form";
    $form['feeContainer'] = array(
        '#type' => 'container',
        '#prefix' => '<div id="feeContainer">',
        '#suffix' => '</div>',
        '#tree' => TRUE
    );
    $form['feeContainer'][INTERNATIONAL_CARD]['percent'] = array(
        '#type' => 'textfield',
        '#title' => t('<i class="fa fa-percent"></i>'),
        '#size' => 60,
        '#maxlength' => 128,
        '#default_value' => !empty($default_values[INTERNATIONAL_CARD])?$default_values[INTERNATIONAL_CARD]->percent:0,
    );
    $form['feeContainer'][INTERNATIONAL_CARD]['amount'] = array(
        '#type' => 'textfield',
        '#title' => t(''),
        '#size' => 60,
        '#maxlength' => 128,
        '#default_value' => !empty($default_values[INTERNATIONAL_CARD])?$default_values[INTERNATIONAL_CARD]->amount:0,
    );
    $form['feeContainer'][DOMESTIC_CARD]['percent'] = array(
        '#type' => 'textfield',
        '#title' => t('<i class="fa fa-percent"></i>'),
        '#size' => 60,
        '#maxlength' => 128,
        '#default_value' => !empty($default_values[DOMESTIC_CARD])?$default_values[DOMESTIC_CARD]->percent:0,
