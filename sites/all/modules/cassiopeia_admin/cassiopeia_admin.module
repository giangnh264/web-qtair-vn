function cassiopeia_admin_topup_edit_form($form,&$form_state,$id){
    $query = db_select("tbl_user_topup","tbl_user_topup");
    $query->fields("tbl_user_topup");
    $query->condition("id",$id);
    $query->join("users","tbl_user","tbl_user.uid=tbl_user_topup.uid");
    $query->join("field_data_field_account_transaction_name", "field_account_transaction_name", "field_account_transaction_name.entity_id=tbl_user.uid");
    $query->join("field_data_field_account_code", "field_account_code", "field_account_code.entity_id=tbl_user.uid");
    $query->addField("field_account_transaction_name", "field_account_transaction_name_value", "agent_transaction_name");
    $query->addField("field_account_code", "field_account_code_value", "agent_code");
    $query->join("node","tbl_bank","tbl_bank.nid=tbl_user_topup.bank");
    $query->addField("tbl_bank","title","bank_title");
    $query->join("field_data_field_code","field_code","field_code.entity_id=tbl_bank.nid");
    $query->addField("field_code","field_code_value","bank_code");
    $result = $query->execute()->fetchObject();
    $form = array();
    $form['#action'] = "/admin/manager/topup/".$result->id."/edit";
    $form['#topup'] = $result;
    $form['created'] = array(
        '#type'         => 'textfield',
        '#title'        => t('Ngày tạo'),
        '#value'        => date("d/m/Y H:i",$result->created),
        '#attributes'   => array("readonly"=>TRUE)
    );
    $form['title'] = array(
        '#type'         => 'textfield',
        '#title'        => t('Đại  lý'),
        '#value'        => $result->agent_code." - ".$result->agent_transaction_name,
        '#attributes'   => array("readonly"=>TRUE)
    );
    $form['amount'] = array(
        '#type'         => 'textfield',
        '#title'        => t('Số tiền'),
        '#value'        => number_format($result->amount,0,",","."),
        '#attributes'   => array("readonly"=>TRUE)
    );
    $form['bank'] = array(
        '#type'         => 'textfield',
        '#title'        => t('Ngân hàng'),
        '#value'        => $result->bank_title,
        '#attributes'   => array("readonly"=>TRUE)
    );
    $form['note'] = array(
        '#title'        => t('Ghi chú của Đại lý'),
        '#type'         => 'textarea',
        '#value'        => $result->note,
        '#attributes'   => array("readonly"=>TRUE)
    );
     $form['tran_user_note'] = array(
        '#title'        => t('Ghi chú'),
        '#type'         => 'textarea',
        '#default_value'=> !empty($result->tran_user_note)?$result->tran_user_note:"",
    );
//    $form['status'] = array(
//        '#type' => 'select',
//        '#title' => t('Tình trạng'),
//        '#options' => array(
//            0 => t('Đề nghị'),
//            1 => t('Duyệt'),
//            2 => t('Từ chối'),
//        ),
//        '#default_value' => $result->status,
//    );
    $form['submit'] = array(
        '#type'     => 'submit',
        '#value'    => t('Từ chối yêu cầu'),
        '#attributes'   => array("class"=>array("btn btn-danger")),
        '#prefix'   => "<div class='form-buttons'>",
        '#suffix'   => "</div>"
    );
    return $form;
}
function cassiopeia_admin_topup_edit_form_submit($form,&$form_state){
    global $user;
    try{
        db_update("tbl_user_topup")->fields(array(
            "tran_user"         => $user->uid,
            "tran_user_note"    => !empty($form_state['values']['tran_user_note']),
            "status"            => 2
        ))->condition("id",$form['#topup']->id)->execute();
        drupal_set_message("Cập nhật thành công!");
        $form_state['redirect'] = "admin/manager/topup";
    }catch (Exception $e){
        drupal_set_message("Đã xảy ra lỗi!","error");
    }
}
function cassiopeia_admin_topup_filter_form($form, &$form_state, $cache = array()){
    $form = array();
    $form['#redirect'] = $cache['redirect'];
    $form['date_filter'] = array(
        '#type' => 'select',
        '#title' => t('Theo ngày'),
        '#options' => array(
            "all" => "Tất cả",
            "today" => "Trong ngày",
            "yesterday" => "Hôm qua",
            "thismonth" => "Trong tháng",
            "other" => "Theo ngày",
        ),
    );
    if (!empty($cache['date_filter'])) {
        $form['date_filter']['#default_value'] = $cache['date_filter'];
    }
    $form['from_date'] = array(
        '#type' => 'date_popup',
        '#default_value' => !empty($cache['from_date']) ? $cache['from_date'] : date("Y-m-d H:i:s", REQUEST_TIME),
        '#date_type' => DATE_DATETIME,
        '#date_timezone' => date_default_timezone(),
        '#date_format' => 'd-m-Y',
        '#date_increment' => 1,
        '#date_year_range' => '-10:+10',
        '#attributes' => array( "class" => array("form_date")),
        '#prefix'           => "<div class='date-filter-group'>",
        '#suffix'           => "</div>"
    );
    $form['to_date'] = array(
        '#type' => 'date_popup',
        '#default_value' => !empty($cache['to_date']) ? $cache['to_date'] : date("Y-m-d H:i:s", REQUEST_TIME),
        '#date_type' => DATE_DATETIME,
        '#date_timezone' => date_default_timezone(),
        '#date_format' => 'd-m-Y',
        '#date_increment' => 1,
        '#date_year_range' => '-10:+10',
        '#attributes' => array("class" => array("to_date")),
        '#prefix'           => "<div class='date-filter-group'>",
        '#suffix'           => "</div>"
    );
    if(isset($cache['admin'])&&$cache['admin']){
        $query = db_select("users", "tbl_user");
        $query->fields("tbl_user");
        $query->join("users_roles", "tbl_role", "tbl_role.uid = tbl_user.uid");
        $query->condition("tbl_role.rid", 4);
        $query->join("field_data_field_account_transaction_name", "field_account_transaction_name", "field_account_transaction_name.entity_id=tbl_user.uid");
        $query->join("field_data_field_account_code", "field_account_code", "field_account_code.entity_id=tbl_user.uid");
        $query->addField("field_account_transaction_name", "field_account_transaction_name_value", "agent_transaction_name");
        $query->addField("field_account_code", "field_account_code_value", "agent_code");
        $result = $query->execute()->fetchAll();
        $options = array();
        $options['all'] = "Chọn Đại lý";
        if (!empty($result)) {
            foreach ($result as $value) {
                $options[$value->uid] = $value->agent_code . " - " . $value->agent_transaction_name;
            }
        }
        $form['agent'] = array(
            '#type' => 'select',
            '#title' => t('Đại lý'),
            '#options' => $options,
            '#chosen' => TRUE,
            '#attributes' => array("onchange" => "this.form.submit();"),
        );
        if (!empty($cache['agent'])) {
            $form['agent']['#default_value'] = $cache['agent'];
        }
    }
    $conditions = array();
    $conditions['status'] = array(
        "type" => "propertyCondition",
        "value" => 1,
        "condition" => "=",
    );
    $conditions['field_weight'] = array(
        "type"      => "fieldOrderBy",
        "column"    => "value",
        "direction" => "ASC",
    );
    $banks = cassiopeia_get_items_by_conditions($conditions,"bank","node");
    $options = array();
    $options['all'] = "Tất cả";
    foreach($banks as $bank){
        $options[$bank->nid] = $bank->field_code['und'][0]['value'];
    }
    $form['bank'] = array(
        '#type' => 'select',
        '#title' => t('Ngân hàng'),
        '#options' => $options,
    );
    if (!empty($cache['bank'])) {
        $form['bank']['#default_value'] = $cache['bank'];
    }
    $query = db_select("users", "tbl_user");
    $query->fields("tbl_user");
    $query->join("users_roles", "tbl_role", "tbl_role.uid = tbl_user.uid");
    $query->condition("tbl_role.rid", array(3,8));
    $query->join("field_data_field_account_transaction_name", "field_account_transaction_name", "field_account_transaction_name.entity_id=tbl_user.uid");
    $query->join("field_data_field_account_code", "field_account_code", "field_account_code.entity_id=tbl_user.uid");
    $query->addField("field_account_transaction_name", "field_account_transaction_name_value", "agent_transaction_name");
    $query->addField("field_account_code", "field_account_code_value", "agent_code");
    $result = $query->execute()->fetchAll();
    $options = array();
    $options['all'] = "Tất cả";
    if (!empty($result)) {
        foreach ($result as $value) {
            $options[$value->uid] = $value->agent_code . " - " . $value->agent_transaction_name;
        }
    }
    $form['tran_user'] = array(
        '#type' => 'select',
        '#title' => t('Người duyệt'),
        '#options' => $options,
        '#chosen' => TRUE,
    );
    if (!empty($cache['tran_user'])) {
        $form['tran_user']['#default_value'] = $cache['tran_user'];
    }
    $form['statuscondition'] = array(
        '#type' => 'select',
        '#title' => t('Tình trạng'),
        '#options' => array(
            'all'       => "Tất cả",
            0           => "Đề nghị",
            1           => "Đã duyệt",
            2           => "Từ chối",
        ),
    );
    if (isset($cache['statuscondition'])) {
        $form['statuscondition']['#default_value'] = $cache['statuscondition'];
    }

    $form['submit'] = array(
        '#type' => 'submit',
        '#value' => 'Lọc',
    );
    return $form;
}
function cassiopeia_admin_topup_filter_form_submit($form, &$form_state)
{
    $arg = arg();
    $options = array(
        'query' => array(
            'data' => $form_state['values'],
        )
    );
    $form_state['redirect'] = array($form['#redirect'], "data" => $options);
}
function cassiopeia_admin_report_ajax_form($form,&$form_state,$cache){
    global $user;
    $sort_options = $cache['sort_options'];
    $form['#cache'] = $cache;
    $form['#prefix'] = "<div id='formContainer'>";
    $form['#suffix'] = "</div>";
    $form['sort_by'] = array(
        '#type' => 'radios',
        '#title' => t(''),
        '#options' => $sort_options,
        '#ajax' => array(
            'callback' => 'cassiopeia_ajax_form_callback',
            'wrapper' => 'formContainer',
            'method' => 'replace',
            'effect' => 'fade',
        ),
//        '#attributes'   => array("class"=>array("hidden"))
    );
    if($user->uid!=1){
        $form['sort_by']['#attributes'] = array("class"=>array("hidden"));
    }
    if(!empty($cache['sort_by'])){
        $form['sort_by']['#default_value'] = $cache['sort_by'];
    }
    $form['sort_direction'] = array(
        '#type' => 'radios',
        '#title' => t(''),
        '#options' => array(
            'ASC'   => "ASC",
            'DESC'  => "DESC",
        ),
        '#default_value'    => "ASC",
        '#ajax' => array(
            'callback' => 'cassiopeia_ajax_form_callback',
            'wrapper' => 'formContainer',
            'method' => 'replace',
            'effect' => 'fade',
        ),
        '#attributes'   => array("class"=>array("hidden"))
    );
    if(!empty($cache['direction'])){
        $form['sort_direction']['#default_value'] = $cache['direction'];
    }
    if(!empty($form_state['values'])){
        $form['#form_state'] = $form_state['values'];
        $form['#cache']['form_state'] = $form_state['values'];
    }else{
        $form['#cache']['form_state'] = array(
            "sort_by"  =>  !empty($cache['sort_by'])?$cache['sort_by']:"",
            "sort_direction"  =>  !empty($cache['direction'])?$cache['direction']:"",
        );
    }
    $form['page'] = array(
        '#type' => 'textfield',
        '#title' => t(''),
        '#size' => 60,
        '#maxlength' => 128,
        '#required' => TRUE,
        '#ajax' => array(
            'callback' => 'cassiopeia_ajax_form_callback',
            'wrapper' => 'formContainer',
            'method' => 'replace',
            'effect' => 'fade',
        ),
        '#attributes'   => array("class"=>array("hidden")),
        '#default_value' => 1
    );
    $form['#theme'][] = "cassiopeia_admin_report_ajax_form_theme";
    return $form;
}
