function cassiopeia_admin_manager_accountant_email_form($form,&$form_state){
    $form['value'] = array(
        '#type'             => 'textfield',
        '#title'            => t('Email Kế toán viên'),
        '#size'             => 60,
        '#maxlength'        => 128,
        '#required'         => TRUE,
        '#default_value'    => variable_get("mod_accountant_email")
    );
    $form['submit'] = array(
        '#type'         => 'submit',
        '#value'        => t('Xác nhận'),
        '#attributes'   => array("class" => array("btn btn-primary"))
    );
    return $form;
}

function cassiopeia_admin_manager_accountant_email_form_submit($form,&$form_state){
    variable_set("mod_accountant_email",$form_state['values']['value']);
}



function cassiopeia_admin_report_accept(){
    if(user_has_role(3)){
        return true;
    }
}
function topup_load($id){
    return $id;
}
function cassiopeia_admin_block_items_load($id_items) {
  $sql = "SELECT id, name, link, icon, position FROM cassiopeia_admin_items WHERE id = :id";
  $result = db_query($sql, array(":id" => $id_items))->fetchAll();
  if (!empty($result[0])) {
    return $result[0];
  }
  return FALSE;
}

function cassiopeia_admin_block_load($id) {
  $sql = "SELECT id, name, icon, position FROM cassiopeia_admin_block WHERE id = :id";
  $result = db_query($sql, array(":id" => $id))->fetchAll();
  if (!empty($result[0])) {
    return $result[0];
  }
  return FALSE;
}

