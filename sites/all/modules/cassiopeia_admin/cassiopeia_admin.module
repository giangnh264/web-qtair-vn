}
function cassiopeia_alepay_fee_config_form_submit($form, &$form_state){
    global $user;
    $db_transaction = db_transaction();

    try {
        db_delete("cassiopeia_qt_alepay_fee_config")->execute();
        $query = db_insert("cassiopeia_qt_alepay_fee_config")->fields(array("uid","created","changed","type","amount","percent"));
        foreach($form_state['values']['feeContainer'] as $key => $_value){
            $query->values(array($user->uid,REQUEST_TIME,REQUEST_TIME,$key,$_value['amount'],$_value['percent']));
        }
        $query->execute();
    } catch (Exception $e) {
        _print_r($e);
        die;
        $db_transaction->rollback();
    }

}
function cassiopeia_room_booking_fee_form($form, &$form_state){
    $query = db_select("cassiopeia_room_room_booking_fee", "cassiopeia_room_room_booking_fee");
    $query->fields("cassiopeia_room_room_booking_fee");
    $result = $query->execute()->fetchAll();
    $default_values = array();
    if(!empty($result)){
        foreach($result as $item){
            $default_values[$item->star] = $item;
        }
    }
    $form_wrapper = "cassiopeia-room-booking-fee-form-wrapper";
    $form['#prefix'] = "<div id='".$form_wrapper."'>";
    $form['#suffix'] = "</div>";
    $form['#attributes']['class'][] = "cassiopeia-room-booking-fee-form";
    $form['feeContainer'] = array(
        '#type' => 'container',
        '#prefix' => '<div id="feeContainer">',
        '#suffix' => '</div>',
        '#tree' => TRUE
    );
    $form['feeContainer'][0]['percent'] = array(
        '#type' => 'textfield',
        '#title' => t('<i class="fa fa-percent"></i>'),
        '#size' => 60,
        '#maxlength' => 128,
        '#default_value' => !empty($default_values[0])?$default_values[0]->percent:0,
    );
    $form['feeContainer'][0]['amount'] = array(
        '#type' => 'textfield',
        '#title' => t(''),
        '#size' => 60,
        '#maxlength' => 128,
        '#default_value' => !empty($default_values[0])?$default_values[0]->amount:0,
    );
    $form['by_star'] = array(
        '#type' =>'checkbox',
        '#title' => t('Thiết lập riêng'),
        '#ajax' => array(
            'callback' => 'cassiopeia_ajax_form_callback',
            'wrapper' => $form_wrapper,
            'method' => 'replace',
            'effect' => 'fade',
        ),
        '#default_value' => !empty(variable_get("room_booking_fee_by_start"))?variable_get("room_booking_fee_by_start"):0,
    );
    $by_star = !empty(variable_get("room_booking_fee_by_start"))?variable_get("room_booking_fee_by_start"):0;
    $form['#by_star'] = $form_stare['#by_star'] = $by_star = isset($form_state['values']['by_star'])?$form_state['values']['by_star']:$by_star;

    for($i=1;$i<=5;$i++){
        $form['feeContainer'][$i]['percent'] = array(
            '#type' => 'textfield',
            '#title' => t('<i class="fa fa-percent"></i>'),
            '#size' => 60,
            '#maxlength' => 128,
            '#default_value' => !empty($default_values[$i])?$default_values[$i]->percent:0,
        );
        $form['feeContainer'][$i]['amount'] = array(
            '#type' => 'textfield',
            '#title' => t(''),
            '#size' => 60,
            '#maxlength' => 128,
            '#default_value' => !empty($default_values[$i])?$default_values[$i]->amount:0,
        );
    }

    $form['submit'] = array(
        '#type' => 'submit',
        '#prefix' => "<div class='form-buttons'>",
        '#suffix' => "</div>",
        '#value' => t('Lưu')
    );
    return $form;
}

function cassiopeia_room_booking_fee_form_submit($form, &$form_state){
    global $user;
    $db_transaction = db_transaction();
    variable_set("room_booking_fee_by_start",0);
    if(!empty($form_state['values']['by_star'])){
        variable_set("room_booking_fee_by_start",1);
    }
    try {
        db_delete("cassiopeia_room_room_booking_fee")->execute();
        $query = db_insert("cassiopeia_room_room_booking_fee")->fields(array("uid","created","changed","star","amount","percent","agent_rank","agent"));
        for($i=0;$i<=5;$i++){
            $_value = $form_state['values']['feeContainer'][$i];
            $query->values(array($user->uid,REQUEST_TIME,REQUEST_TIME,$i,$_value['amount'],$_value['percent'],0,0));
        }
        $query->execute();
    } catch (Exception $e) {
        _print_r($e);
        die;
        $db_transaction->rollback();
    }

}
function cassiopeia_admin_ticket_booking_manager_form($form, &$form_state, $cache = null){
    $form = array();
    $form['#prefix'] = "<div id='formContainer'>";
    $form['#suffix'] = "</div>";
    $data_filter = !empty($cache['date_filter'])?$cache['date_filter']:"today";
    $data_filter = !empty($form_state['values']['date_filter'])?$form_state['values']['date_filter']:$data_filter;
    $cache['date_filter'] = $data_filter;
    $form['#cache'] = $cache;
    $form['date_filter'] = array(
        '#type' => 'select',
        '#title' => t('Theo ngày'),
        '#options' => array(
//            "all" => "Tất cả",
            "today" => "Trong ngày",
            "yesterday" => "Hôm qua",
            "thismonth" => "Trong tháng",
            "other" => "Theo ngày",
        ),
        '#ajax' => array(
            'callback' => 'cassiopeia_admin_ticket_booking_manager_form_callback',
            'wrapper' => 'formContainer',
            'method' => 'replace',
            'effect' => 'fade',
        ),
    );
    if (!empty($cache['date_filter'])) {
        $form['date_filter']['#default_value'] = $cache['date_filter'];
    }
    if($data_filter=="other"){
        $form['from_date'] = array(
            '#type' => 'date_popup',
            '#default_value' => !empty($cache['from_date']) ? $cache['from_date'] : date("Y-m-d H:i:s", REQUEST_TIME),
            '#date_type' => DATE_DATETIME,
            '#date_timezone' => date_default_timezone(),
            '#date_format' => 'd-m-Y',
            '#date_increment' => 1,
            '#date_year_range' => '-10:+10',
            '#attributes' => array( "class" => array("form_date")),
            '#prefix'           => "<div class='date-filter-group'>",
            '#suffix'           => "</div>",
            '#ajax' => array(
                'callback' => 'cassiopeia_admin_ticket_booking_manager_form_callback',
                'wrapper' => 'formContainer',
                'method' => 'replace',
                'effect' => 'fade',
            ),
        );
        $form['to_date'] = array(
            '#type' => 'date_popup',
            '#default_value' => !empty($cache['to_date']) ? $cache['to_date'] : date("Y-m-d H:i:s", REQUEST_TIME),
            '#date_type' => DATE_DATETIME,
            '#date_timezone' => date_default_timezone(),
            '#date_format' => 'd-m-Y',
            '#date_increment' => 1,
            '#date_year_range' => '-10:+10',
            '#attributes' => array("class" => array("to_date")),
            '#prefix'           => "<div class='date-filter-group'>",
            '#suffix'           => "</div>",
            '#ajax' => array(
                'callback' => 'cassiopeia_admin_ticket_booking_manager_form_callback',
                'wrapper' => 'formContainer',
                'method' => 'replace',
                'effect' => 'fade',
            ),
        );
    }
    $form['booking_code'] = array(
        '#type' => 'textfield',
        '#title' => t('Mã giao dịch'),
        '#attributes' => array("placeholder" => "Mã giao dịch"),
        '#default_value' => !empty($cache['booking_code']) ? $cache['booking_code'] : "",
    );
    $form['pnr_code'] = array(
        '#type' => 'textfield',
        '#title' => t('Mã đặt chỗ'),
        '#attributes' => array("placeholder" => "Mã đặt chỗ"),
        '#default_value' => !empty($cache['pnr_code']) ? $cache['pnr_code'] : "",
    );

    $form['status'] = array(
        '#type' => 'select',
        '#title' => t('Tình trạng'),
        '#options' => array(
            'all' => t('Tất cả'),
            'OK' => t('Đặt chỗ'),
            'FAIL' => t('Đặt lỗi'),
            'EXPIRED' => t('Hết hạn'),
//            'HOLD'          => t("Chờ xuất vé"),
            'TICKETED' => t('Xuất vé'),
//            'CANCELED'      => t('Hủy đặt chỗ'),
        ),
        '#attributes' => array("onchange" => "this.form.submit()"),
        '#default_value' => !empty($cache['status']) ? $cache['status'] : "",
    );
    if(cassiopeia_booking_manager_accept()){
        $role_query = db_select("role","tbl_role");
        $role_query->fields("tbl_role");
        $role_query->condition("rid",4);
        $role_query->addExpression("GROUP_CONCAT(rid SEPARATOR ',')","rids");
        $roles = $role_query->execute()->fetchObject();

        $query = db_select("users", "tbl_user");
        $query->fields("tbl_user");
        $query->join("users_roles", "tbl_role", "tbl_role.uid = tbl_user.uid");
        $query->condition("tbl_role.rid", explode(",",$roles->rids));
        $query->join("field_data_field_account_transaction_name", "field_account_transaction_name", "field_account_transaction_name.entity_id=tbl_user.uid");
        $query->join("field_data_field_account_code", "field_account_code", "field_account_code.entity_id=tbl_user.uid");
        $query->addField("field_account_transaction_name", "field_account_transaction_name_value", "agent_transaction_name");
        $query->addField("field_account_code", "field_account_code_value", "agent_code");
        $result = $query->execute()->fetchAll();
        $options = array();
        $options['all'] = "Chọn Đại lý";
        if (!empty($result)) {
            foreach ($result as $value) {
                $options[$value->uid] = $value->agent_code . " - " . $value->agent_transaction_name;
            }
        }
        $form['agent'] = array(
            '#type' => 'select',
            '#title' => t('Đại lý'),
            '#options' => $options,
            '#chosen' => TRUE,
            '#attributes' => array("onchange" => "this.form.submit();"),
        );
        if (!empty($cache['agent'])) {
            $form['agent']['#default_value'] = $cache['agent'];
        }
    }

    $form['airline'] = array(
        '#type' => 'textfield',
        '#title' => t('Hãng hàng không'),
        '#attributes' => array("placeholder" => "Hãng hàng không"),
        '#default_value' => !empty($cache['airline']) ? $cache['airline'] : "",
    );
    $form['full_name'] = array(
        '#type' => 'textfield',
        '#title' => t('Tên khách hàng'),
        '#attributes' => array("placeholder" => "Tên khách hàng"),
        '#default_value' => !empty($cache['full_name']) ? $cache['full_name'] : "",
    );
    $form['email'] = array(
        '#type' => 'textfield',
        '#title' => t('Email'),
        '#attributes' => array("placeholder" => "Email"),
        '#default_value' => !empty($cache['email']) ? $cache['email'] : "",
    );
    $form['tel'] = array(
        '#type' => 'textfield',
        '#title' => t('Điện thoại'),
        '#attributes' => array("placeholder" => "Điện thoại"),
        '#default_value' => !empty($cache['tel']) ? $cache['tel'] : "",
    );
    $form['item_per_page'] = array(
        '#type' => 'select',
        '#title' => t('Hiển thị'),
        '#options' => array(
            '50' => t('50'),
            '100' => t('100'),
            '200' => t('200'),
        ),
        '#attributes' => array("onchange" => "this.form.submit()"),
        '#default_value' => !empty($cache['item_per_page']) ? $cache['item_per_page'] : "",
    );

    $form['submit'] = array(
        '#type' => 'submit',
        '#value' => 'Lọc',
        '#attributes' => array("class" => array("hidden")),
    );
    $form['page'] = array(
        '#type' => 'textfield',
        '#title' => t(''),
        '#size' => 60,
        '#maxlength' => 128,
        '#required' => TRUE,
        '#ajax' => array(
            'callback' => 'cassiopeia_admin_ticket_booking_manager_form_callback',
            'wrapper' => 'formContainer',
            'method' => 'replace',
            'effect' => 'fade',
        ),
        '#attributes'   => array("class"=>array("hidden")),
        '#default_value' => 1
    );
    $form['#theme'][] = "cassiopeia_admin_ticket_booking_manager_form_theme";
    return $form;
}
function cassiopeia_admin_ticket_booking_manager_form_callback($form,&$form_state){
    return $form;
}
function cassiopeia_admin_ticket_booking_manager_form_submit($form, &$form_state)
{
    $arg = arg();
    $options = array(
        'query' => array(
            'data' => $form_state['values'],
        )
    );
    $form_state['redirect'] = array('/admin/manager/booking', "data" => $options);
}
function cassiopeia_contact_delete_form ($form, &$form_state,$contact) {
    $form_state['#contact'] = $contact;
    $form = confirm_form($form,
        t('Bạn có chắc chắn muốn xóa liên hệ này?'),
        'admin/manager/contact',
        '<p>' . t('This action cannot be undone.') .'</p>',
        t('Delete'),
        t('Cancel'),
        'confirm'
    );
    $form['actions']['cancel']['#attributes'] = array('class'=>array('btn btn-icon-before btn-open-search bg-primary c-white'), 'style'=>array('display: inline-block;'));
    $form['actions']['cancel']['#options']['html']  = true;
//  $form['actions']['cancel']['#options']['text']  = '<i class="fal fa-magnifying-glass fa-fw" aria-hidden="true"></i> Cancel';
    $form['actions']['cancel']['#title']  = '<i class="fal fa-ban fa-fw" aria-hidden="true"></i> '. t('Cancel');
    $form['actions']['submit']['#icon'] ='<span class="fal fa-trash fa-fw"></span>';
//    $form['#theme'] = 'kenfox_trademark_trademark_registration_debit_note_description_delete_form';
    $form['#submit'][] = 'cassiopeia_contact_delete_form_submit';

    return $form;
}
function cassiopeia_contact_delete_form_submit ($form, &$form_state) {
    $contact = $form_state['#contact'];
    try{
        db_delete("tbl_contact")->condition("contact_id",$contact->contact_id)->execute();
        drupal_set_message(t('Đã xóa thành công!'));
    }catch (Exception $e){
        drupal_set_message(t('Xóa thất bại!'));
    }
}
