        '#title' => t('<i class="fa fa-percent"></i>'),
        '#size' => 60,
        '#maxlength' => 128,
        '#default_value' => !empty($default_values[INTERNET_BANKING])?$default_values[INTERNET_BANKING]->percent:0,
    );
    $form['feeContainer'][INTERNET_BANKING]['amount'] = array(
        '#type' => 'textfield',
        '#title' => t(''),
        '#size' => 60,
        '#maxlength' => 128,
        '#default_value' => !empty($default_values[INTERNET_BANKING])?$default_values[INTERNET_BANKING]->amount:0,
    );
    $form['feeContainer'][QR_PAY]['percent'] = array(
        '#type' => 'textfield',
        '#title' => t('<i class="fa fa-percent"></i>'),
        '#size' => 60,
        '#maxlength' => 128,
        '#default_value' => !empty($default_values[QR_PAY])?$default_values[QR_PAY]->percent:0,
    );
    $form['feeContainer'][QR_PAY]['amount'] = array(
        '#type' => 'textfield',
        '#title' => t(''),
        '#size' => 60,
        '#maxlength' => 128,
