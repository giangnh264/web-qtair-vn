}
function cassiopeia_issue_report_export_call_back(){
    $datas = $_REQUEST;
    if(!empty($datas)){
        $caches['content'] = $datas['content'];
        $caches['date_filter'] = $datas['date_filter'];
        $caches['from_date'] = $datas['from_date']['date'];
        $caches['to_date'] = $datas['to_date']['date'];
        $caches['airline'] = $datas['airline'];
        $caches['tran_kind'] = $datas['tran_kind'];
        $caches['profit_filter'] = $datas['profit_filter'];
        $caches['PNR'] = $datas['code'];
        $caches['agent'] = !empty($datas['agent'])?$datas['agent']:null;
        $caches['tran_user'] = $datas['tran_user'];
    }
    try{
        $query = db_select("tbl_issue_report","tbl_issue_report");
        $query -> fields("tbl_issue_report");
        $query->join("tbl_tran_kind","tbl_tran_kind","tbl_tran_kind.id=tbl_issue_report.tran_kind");
        $query2 = db_select("tbl_issue_report","tbl_issue_report");
        $query2 -> fields("tbl_issue_report");
        $query2->join("tbl_tran_kind","tbl_tran_kind","tbl_tran_kind.id=tbl_issue_report.tran_kind");
        $query2 -> addExpression("SUM(partner_price)","total_partner_price");
        $query2 -> addExpression("SUM(quantity)","total_quantity");
        $query2 -> addExpression("SUM(price)","total_price");
        $query2 -> addExpression("SUM(partner_price-price)","total_revenue");
        $query2 -> addExpression("COUNT(partner_price)","total_items");
        if(!empty($caches)){
//        _print_r($datas);
            if(!empty($caches['date_filter']&& $caches['date_filter']!="all")){
                switch ($caches['date_filter']){
                    case "today" :
                        $query2->condition("date",array(strtotime(date("d-m-Y 00:00",REQUEST_TIME)),strtotime(date("d-m-Y 23:59",REQUEST_TIME))),"BETWEEN");
                        $query->condition("date",array(strtotime(date("d-m-Y 00:00",REQUEST_TIME)),strtotime(date("d-m-Y 23:59",REQUEST_TIME))),"BETWEEN");
                        break;
                    case "yesterday" :
                        $query2->condition("date",array(strtotime(date("d-m-Y 00:00",REQUEST_TIME-86400)),strtotime(date("d-m-Y 23:59",REQUEST_TIME-86400))),"BETWEEN");
                        $query->condition("date",array(strtotime(date("d-m-Y 00:00",REQUEST_TIME-86400)),strtotime(date("d-m-Y 23:59",REQUEST_TIME-86400))),"BETWEEN");
                        break;
                    case "thismonth" :
                        $query2->condition("date",array(strtotime(date("01-m-Y 00:00",REQUEST_TIME)),strtotime(date("t-m-Y 23:59",REQUEST_TIME))),"BETWEEN");
                        $query->condition("date",array(strtotime(date("01-m-Y 00:00",REQUEST_TIME)),strtotime(date("t-m-Y 23:59",REQUEST_TIME))),"BETWEEN");
                        break;
                    case "other":
                        if(!empty($caches['from_date'])){
                            $query2->condition("date",strtotime(date("d-m-Y 00:00",strtotime($caches['from_date']))),">=");
                            $query->condition("date",strtotime(date("d-m-Y 00:00",strtotime($caches['from_date']))),">=");
                        }
                        if($caches['to_date']){
                            $query2->condition("date",strtotime(date("d-m-Y 23:59",strtotime($caches['to_date']))),"<=");
                            $query->condition("date",strtotime(date("d-m-Y 23:59",strtotime($caches['to_date']))),"<=");
                        }
                        break;
                }
            }
            if(!empty($caches['airline'] && $caches['airline']!="all")){
                $query->condition("airline",$caches['airline']);
                $query2->condition("airline",$caches['airline']);
            }
            if(!empty($caches['tran_kind']&& $caches['tran_kind']!="all")){
                $query->condition("tran_kind",$caches['tran_kind']);
                $query2->condition("tran_kind",$caches['tran_kind']);
            }
            if(!empty($caches['profit_filter']&& $caches['profit_filter']!="all")){
                switch ($datas['profit_filter']){
                    case "morethanZero":
                        $query->condition("revenue",0,">");
                        $query2->condition("revenue",0,">");
                        break;
                    case "lessthanZero":
                        $query->condition("revenue",0,"<");
                        $query2->condition("revenue",0,"<");
                        break;
                    case "equalZero":
                        $query->condition("revenue",0,"=");
                        $query2->condition("revenue",0,"=");
                        break;
                }
            }
            if(!empty($caches['PNR'])){
                $query->condition("PNR",$caches['PNR']);
                $query2->condition("PNR",$caches['PNR']);
            }
            if(!empty($caches['content']&& $caches['content']!="all")){
                $query->condition("content","%".$caches['content']."%","LIKE");
                $query2->condition("content","%".$caches['content']."%","LIKE");
            }
            if(!empty($caches['agent']) && $caches['agent']!="all"){
                $query->condition("agent",$caches['agent']);
                $query2->condition("agent",$caches['agent']);
            }
            if(!empty($caches['tran_user']) && $caches['tran_user']!="all"){
                $query->condition("tran_user",$caches['tran_user']);
                $query2->condition("tran_user",$caches['tran_user']);
            }
        }

        $query->orderBy("created","DESC");
        $result = $query -> execute() -> fetchAll();
    }catch (Exception $e){
        _print_r($e);
    }
    include  drupal_get_path('module','cassiopeia')."/phpspreadsheet.inc";

    $worksheets = array();
    $worksheet = array('title' => 'Báo cáo xuất vé','data'=>array(), 'merge_cells'=> array());
    $worksheet['data'][] = array(
        mb_convert_encoding('Ngày thực hiện' ,  "UTF-8"),
        mb_convert_encoding('Hãng' ,  "UTF-8"),
        mb_convert_encoding('Loại giao dịch' ,  "UTF-8"),
        mb_convert_encoding('Code' ,  "UTF-8"),
        mb_convert_encoding('Số lượng' ,  "UTF-8"),
        mb_convert_encoding('Doanh thu' ,  "UTF-8"),
        mb_convert_encoding('Giá vốn' ,  "UTF-8"),
        mb_convert_encoding('lợi nhuận' ,  "UTF-8"),
        mb_convert_encoding('Đại lý' ,  "UTF-8"),
        mb_convert_encoding('Sale' ,  "UTF-8"),
        mb_convert_encoding('Người xuất' ,  "UTF-8"),
        mb_convert_encoding('Khách bay' ,  "UTF-8"),
        mb_convert_encoding('Nội dung' ,  "UTF-8"),
    );
//    _print_r($result);
//    die;
    if(!empty($result)){
        foreach($result as $value){
            $booking = cassiopeia_qt_ticket_booking_load_by_PNR($value->PNR,$value->airline);
            $airline = cassiopeia_get_airline($value->airline);
            $tran_kind = cassiopeia_get_tran_kind_by_id($value->tran_kind);
            $agent = user_load($value->agent);
            $agent_name = $agent->field_account_code['und'][0]['value'];
            if(!empty($agent->field_account_transaction_name['und'][0]['value'])){
                $agent_name.=" - ".$agent->field_account_transaction_name['und'][0]['value'];
            }
            $sale = !empty($agent->field_account_sale['und'][0]['target_id'])?user_load($agent->field_account_sale['und'][0]['target_id']):null;
            $tran_user = user_load($value->tran_user);
            $worksheet['data'][] = array(
                mb_convert_encoding(date("d/m/Y H:i",$value->date) ,  "UTF-8"),
                mb_convert_encoding(!empty($airline)?$airline->iata:"" ,  "UTF-8"),
                mb_convert_encoding(!empty($tran_kind)?$tran_kind['name']:"" ,  "UTF-8"),
                mb_convert_encoding($value->PNR ,  "UTF-8"),
                mb_convert_encoding($value->quantity ,  "UTF-8"),
                mb_convert_encoding($value->partner_price ,  "UTF-8"),
                mb_convert_encoding($value->price ,  "UTF-8"),
                mb_convert_encoding($value->revenue ,  "UTF-8"),
                mb_convert_encoding($agent_name,  "UTF-8"),
                mb_convert_encoding(!empty($sale->field_account_transaction_name['und'][0]['value'])?$sale->field_account_transaction_name['und'][0]['value']:"",  "UTF-8"),
                mb_convert_encoding(!empty($tran_user->field_account_transaction_name['und'][0]['value'])?$tran_user->field_account_transaction_name['und'][0]['value']:$tran_user->name,  "UTF-8"),
                mb_convert_encoding(!empty($booking)?$booking->passengers[0]->FirstName." ".$booking->passengers[0]->LastName:"",  "UTF-8"),
                mb_convert_encoding($value->content,  "UTF-8"),
            );
        }
        $worksheets[]=$worksheet;
        phpspreadsheet_export($worksheets, 'file_'.date('d_m_Y',REQUEST_TIME));
    }else{
        drupal_set_message("Không có dữ liệu phù hợp!");
        drupal_goto("admin/manager/bao-cao-xuat-ve");
    }
}
function cassiopeia_admin_point_report_filter_form($form,&$form_state,$data){
    $form_state['#redirect'] = $data['redirect']; 
    $query = db_select("users", "tbl_user");
    $query->fields("tbl_user");
    $query->join("users_roles", "tbl_role", "tbl_role.uid = tbl_user.uid");
    $query->condition("tbl_role.rid", array(4));
    $query->join("field_data_field_account_transaction_name", "field_account_transaction_name", "field_account_transaction_name.entity_id=tbl_user.uid");
    $query->join("field_data_field_account_code", "field_account_code", "field_account_code.entity_id=tbl_user.uid");
    $query->addField("field_account_transaction_name", "field_account_transaction_name_value", "agent_transaction_name");
    $query->addField("field_account_code", "field_account_code_value", "agent_code");
    $result = $query->execute()->fetchAll();
    $options = array();
    $options['all'] = "Chọn";
    if (!empty($result)) {
        foreach ($result as $value) {
            $options[$value->uid] = $value->agent_code . " - " . $value->agent_transaction_name;
        }
    }

    $form['month'] = array(
        '#type' => 'select',
        '#title' => 'Tháng',
        '#options' => array(
            1       => "Tháng 1",
            2       => "Tháng 2",
            3       => "Tháng 3",
            4       => "Tháng 4",
            5       => "Tháng 5",
            6       => "Tháng 6",
            7       => "Tháng 7",
            8       => "Tháng 8",
            9       => "Tháng 9",
            10      => "Tháng 10",
            11      => "Tháng 11",
            12      => "Tháng 12",
        ),
    );
    if (!empty($data['month'])) {
        $form['month']['#default_value'] = $data['month'];
    }
    $year_options = array();
    for($i=date("Y",REQUEST_TIME);$i>=2022;$i--){
        $year_options[$i] = $i;
    }
    $form['year'] = array(
        '#type' => 'select',
        '#title' => 'Năm',
        '#options' => $year_options,
        '#default_value' => $data['year']
    );
    global $theme;
    if($theme!="cassiopeia_theme"){
        $form['agent'] = array(
            '#type' => 'select',
            '#title' => t('Đại lý'),
            '#options' => $options,
            '#chosen' => TRUE,
            '#default_value' => !empty($data['agent'])?$data['agent']:'all'
        );
    }
    $form['sort_direction'] = [
        '#type' => 'select',
        '#title' => t('Sắp xếp'),
        '#options' => [
            '_none' => t('Mặc định'),
            'ASC' => t('Tích điểm tăng dần'),
            'DESC' => t('Tích điểm giảm dần'),
        ],
        '#default_value' => '_none',
//        '#attributes' => ["class" => ["hidden"]],
    ];
    if (!empty($data['sort_direction'])) {
        $form['sort_direction']['#default_value'] = $data['sort_direction'];
    }
    $form['submit'] = array(
        '#type' => 'submit',
        '#prefix' => "<div class='form-buttons'>",
        '#suffix' => "</div>",
        '#value' => t('Lọc'),
        '#attributes'   => array("class"=>array("btn bg-secondary clr-white ff-semibold radius-4 btn-filter"))
    );
    $form['export'] = array(
        '#type' => 'submit',
        '#submit' => array('cassiopeia_admin_point_report_filter_form_export'),
        '#value' => t('Xuất excel'),
        '#attributes'   => array("class"=>array("btn bg-secondary clr-white ff-semibold radius-4 btn-filter"))
    );
    return $form;
}
function cassiopeia_admin_point_report_filter_form_export($form,&$form_state){
    $arg = arg();
    $options = array(
        'query' => array(
            'data' => $form_state['values'],
        )
    );
    $form_state['redirect'] = array('admin/manager/bao-cao-tich-diem/export', "data" => $options);
}
function cassiopeia_admin_point_report_filter_form_submit($form, &$form_state)
{
    $arg = arg();
    $options = array(
        'query' => array(
            'data' => $form_state['values'],
        )
    );
    $form_state['redirect'] = array($form_state['#redirect'], "data" => $options);
}
function cassiopeia_admin_airline_edit_form($form, &$form_state, $data = ["airline"]) {
  $form_state['#airline'] = $form['#airline'] = $airline = !empty($data['airline']) ? $data['airline'] : NULL;
  $form['iata'] = [
    '#type' => 'textfield',
    '#title' => t('Code'),
    '#default_value' => !empty($airline) ? $airline->iata : "",
  ];
  $form['name'] = [
    '#type' => 'textfield',
    '#title' => t('Hãng'),
    '#default_value' => !empty($airline) ? $airline->name : "",
  ];
  $form['type'] = [
    '#type' => 'textfield',
    '#title' => t('Kiểu'),
    '#default_value' => !empty($airline) ? $airline->type : "",
  ];
  $form['image'] = [
    '#title' => 'Logo',
    '#type' => 'managed_file',
    '#upload_location' => 'public://',
  ];
  if (!empty($airline->fid)) {
    $form['image']['#default_value'] = $airline->fid;
  }
  $form['submit'] = [
    '#type' => 'submit',
    '#value' => 'Cập nhật',
    '#ajax' => [
      "callback" => "cassiopeia_admin_airline_edit_form_ajax_submit",
    ],
    '#prefix' => "<div style='margin-top: 15px;;'>",
    '#suffix' => "</div>",
  ];
  return $form;
}

function cassiopeia_admin_airline_edit_form_submit($form, &$form_state) {
  global $user;
  if (!empty($form_state['#airline']->iata)) { // edit
    if (!empty($form_state['values']['image'])) {
      // Load the file via file.fid.
      $file = file_load($form_state['values']['image']);
      // Change status to permanent.
      $file->status = FILE_STATUS_PERMANENT;
      // Save.
      file_save($file);
      // Record that the module (in this example, user module) is using the file.
      file_usage_add($file, 'user', 'user', $user->uid);
      try {
        db_update("tbl_airlines")->fields([
          "iata" => $form_state['values']['iata'],
          "name" => $form_state['values']['name'],
          "type" => $form_state['values']['type'],
          "fid" => $file->fid,
        ])->condition("iata", $form_state['#airline']->iata)->execute();
      } catch (Exception $e) {
      }
    }
    else {
      try {
        db_update("tbl_airlines")->fields([
          "iata" => $form_state['values']['iata'],
          "name" => $form_state['values']['name'],
          "type" => $form_state['values']['type'],
          "fid" => 0,
        ])->condition("iata", $form_state['#airline']->iata)->execute();
      } catch (Exception $e) {
      }
    }
  }
}

function cassiopeia_admin_airline_edit_form_ajax_submit($form, &$form_state) {
  ctools_include('ajax');
  ctools_include('modal');
  $commands[] = ctools_modal_command_dismiss();
  $commands[] = ctools_ajax_command_reload();
  return [
    '#type' => 'ajax',
    '#commands' => $commands,
  ];
}
