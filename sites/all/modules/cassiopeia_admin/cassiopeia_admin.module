function cassiopeia_admin_report_AG_filter_form($form, &$form_state, $caches)
{
    global $user;
    $form = array();
    $form['#redirect'] = $caches['redirect'];
    $query = db_select("users", "tbl_user");
    $query->fields("tbl_user");
    $query->join("users_roles", "tbl_role", "tbl_role.uid = tbl_user.uid");
    $query->condition("tbl_role.rid", 4);
    $query->leftJoin("field_data_field_account_sale", "tbl_sale", "tbl_sale.entity_id = tbl_user.uid");
    $query->join("field_data_field_account_transaction_name", "field_account_transaction_name", "field_account_transaction_name.entity_id=tbl_user.uid");
    $query->join("field_data_field_account_code", "field_account_code", "field_account_code.entity_id=tbl_user.uid");
    $query->addField("field_account_code", "field_account_code_value", "field_account_code_value");
    $query->addField("field_account_transaction_name", "field_account_transaction_name_value", "field_account_transaction_name_value");
    $result = $query->execute()->fetchAll();
    $agent_options = array();
    $agent_options['all'] = "Chọn Đại lý";
    if (!empty($result)) {
        foreach ($result as $value) {
            $transaction_name = !empty($value->field_account_transaction_name_value) ? $value->field_account_transaction_name_value : "";
            $account_code = !empty($value->field_account_code_value) ? $value->field_account_code_value : "";
            $agent_options[$value->uid] = $account_code . " - " . $transaction_name;
        }
    }
    $form['#attributes'] = array("class" => array("filter_form"));
    if (user_has_role(3, $user) || user_has_role(7, $user)) {
        $form['agent'] = array(
            '#type' => 'select',
            '#title' => t('Đại lý'),
            '#options' => $agent_options,
            '#chosen' => TRUE,
            '#attributes' => array("onchange" => "this.form.submit();"),
        );
        if (!empty($caches['agent'])) {
            $form['agent']['#default_value'] = $caches['agent'];
        }
        $query = db_select("users", "tbl_user");
        $query->fields("tbl_user");
        $query->join("users_roles", "tbl_role", "tbl_role.uid = tbl_user.uid");
        $query->condition("tbl_role.rid", 5);
        $query->join("field_data_field_account_transaction_name", "field_account_transaction_name", "field_account_transaction_name.entity_id=tbl_user.uid");
        $query->join("field_data_field_account_code", "field_account_code", "field_account_code.entity_id=tbl_user.uid");
        $query->addField("field_account_transaction_name", "field_account_transaction_name_value", "agent_transaction_name");
        $query->addField("field_account_code", "field_account_code_value", "agent_code");
        $result = $query->execute()->fetchAll();
        $options = array();
        $options['all'] = "Chọn sale";
        if (!empty($result)) {
            foreach ($result as $value) {
                $options[$value->uid] = $value->agent_code . " - " . $value->agent_transaction_name;
            }
        }
        $form['sale'] = array(
            '#type' => 'select',
            '#title' => t('Sale'),
            '#options' => $options,
            '#chosen' => TRUE,
            '#attributes' => array("onchange" => "this.form.submit();"),
        );
        if (!empty($caches['sale'])) {
            $form['sale']['#default_value'] = $caches['sale'];
        }
    }
    $month_options = array();
    for ($i = 11; $i >= 0; $i--) {
        $check_point = strtotime(date("01-m-Y", REQUEST_TIME));
        $month_options[date("m-Y", strtotime(date("d-m-Y", $check_point) . " - " . $i . " months"))] = date("m/Y", strtotime(date("d-m-Y", $check_point) . " - " . $i . " months"));
    }
    $form['date_filter'] = array(
        '#type' => 'select',
        '#title' => t('Chọn tháng'),
        '#options' => $month_options,
//        '#attributes'   => array("onchange"=>"this.form.submit();"),
        '#default_value' => !empty($caches['date_filter']) ? $caches['date_filter'] : date("m-Y", REQUEST_TIME),
        '#attributes' => array("onchange" => "this.form.submit();"),
    );
    $form['order_by'] = array(
        '#type' => 'select',
        '#title' => t(''),
        '#options' => array(
            "agent_code" => "Tên giao dịch",
            "transaction_name" => "Tên giao dịch",
            "quantity" => "Tên giao dịch",
            "partner_price" => "Tên giao dịch",
            "price" => "Tên giao dịch",
            "revenue" => "Tên giao dịch",
        ),
        '#resquired' => TRUE,
        '#attributes' => array("class" => array("hidden")),
    );
    if (!empty($caches['order_by'])) {
        $form['order_by']['#default_value'] = $caches['order_by'];
    }
    $form['direction'] = array(
        '#type' => 'select',
        '#title' => t(''),
        '#options' => array(
            "none" => "Không",
            "ASC" => "Tăng dần",
            "DESC" => "Giảm dần",
        ),
        '#resquired' => TRUE,
        '#attributes' => array("class" => array("hidden")),
    );
    if (!empty($caches['direction'])) {
        $form['direction']['#default_value'] = $caches['direction'];
    }


//    $form['num_per_page'] = array(
//        '#type' => 'select',
//        '#title' => t('Hiển thị'),
//        '#options' => array(
//            "50" => "50",
//            "100" => "100",
//            "200" => "200",
//        ),
//        '#attributes' => array("onchange" => "this.form.submit();"),
//        '#resquired' => TRUE,
//    );
//    if (!empty($caches['num_per_page'])) {
//        $form['num_per_page']['#default_value'] = $caches['num_per_page'];
//    }
    $form['submit'] = array(
        '#type' => 'submit',
        '#value' => t('Lọc'),
        '#attributes' => array("class" => array("hidden")),
//        '#prefix' => '<div class="buttons">',
//        '#suffix' => '<span class="btn btn-default btn-close-modal">Đóng</span></div>',
    );
    return $form;
}

