        '#title' => t(''),
        '#size' => 60,
        '#maxlength' => 128,
        '#required' => TRUE,
        '#default_value'    => !empty($service_fee)?number_format($service_fee->VJ_OTHER,0,",","."):0,
    );
    $form['S_VT_ECO'] = array(
        '#type' => 'textfield',
        '#title' => t(''),
        '#size' => 60,
        '#maxlength' => 128,
        '#required' => TRUE,
        '#default_value'    => !empty($service_fee)?number_format($service_fee->VT_ECO,0,",","."):0,
    );
    $form['S_VT_OTHER'] = array(
        '#type' => 'textfield',
        '#title' => t(''),
        '#size' => 60,
        '#maxlength' => 128,
        '#required' => TRUE,
        '#default_value'    => !empty($service_fee)?number_format($service_fee->VT_OTHER,0,",","."):0,
    );
    $form['S_SPA_ECO'] = array(
        '#type' => 'textfield',
        '#title' => t(''),
        '#size' => 60,
        '#maxlength' => 128,
        '#required' => TRUE,
        '#default_value'    => !empty($service_fee)?number_format($service_fee->SPA_ECO,0,",","."):0,
    );
    $form['S_SPA_OTHER'] = array(
        '#type' => 'textfield',
        '#title' => t(''),
        '#size' => 60,
        '#maxlength' => 128,
        '#required' => TRUE,
        '#default_value'    => !empty($service_fee)?number_format($service_fee->SPA_OTHER,0,",","."):0,
    );
    $form['S_percent'] = array(
        '#type' => 'textfield',
        '#title' => t(''),
        '#size' => 60,
        '#maxlength' => 128,
        '#required' => TRUE,
        '#default_value'    => !empty($service_fee)?number_format($service_fee->international_percent,0,",","."):0,
    );
    $form['S_amount'] = array(
        '#type' => 'textfield',
        '#title' => t(''),
        '#size' => 60,
        '#maxlength' => 128,
        '#required' => TRUE,
        '#default_value'    => !empty($service_fee)?number_format($service_fee->international_fee,0,",","."):0,
    );
    $form['S_amount_domestic'] = array(
        '#type' => 'textfield',
        '#title' => t(''),
        '#size' => 60,
        '#maxlength' => 128,
        '#required' => TRUE,
        '#default_value'    => !empty($service_fee)?number_format($service_fee->international_domestic_fee,0,",","."):0,
    );
    
    // end service fee
    $form['submit'] = array(
        '#type' => 'submit',
        '#value' => t('Lưu'),
        '#attributes' => array("class" => array("btn btn-primary"))
    );
//    _print_r($service_fee);
    return $form;
}
function cassiopeia_admin_fee_config_form_submit($form,&$form_state){
    global $user;
    $_user = user_load($user->uid);
    $uid = user_has_role(3)?0:$user->uid;
    $_tid = !empty($_user->field_tx_rank['und'][0]['tid'])?$_user->field_tx_rank['und'][0]['tid']:0;
    $tid = isset($_REQUEST['tx'])?$_REQUEST['tx']:$_tid;
    if(user_has_role(8)){
        $_user->field_tx_rank['und'][0]['tid'] = $tid;
        user_save($_user);
    }
    $agent_fee_config = !empty($form_state['#agent_fee'])?$form_state['#agent_fee']:new stdClass();
    $agent_fee_config->VN_ECO = !empty($form_state['values']['VN_ECO'])?str_replace(".","",$form_state['values']['VN_ECO']):0;
    $agent_fee_config->VN_OTHER = !empty($form_state['values']['VN_OTHER'])?str_replace(".","",$form_state['values']['VN_OTHER']):0;
    $agent_fee_config->QH_ECO = !empty($form_state['values']['QH_ECO'])?str_replace(".","",$form_state['values']['QH_ECO']):0;
    $agent_fee_config->QH_OTHER = !empty($form_state['values']['QH_OTHER'])?str_replace(".","",$form_state['values']['QH_OTHER']):0;
    $agent_fee_config->VJ_ECO = !empty($form_state['values']['VJ_ECO'])?str_replace(".","",$form_state['values']['VJ_ECO']):0;
    $agent_fee_config->VJ_OTHER = !empty($form_state['values']['VJ_OTHER'])?str_replace(".","",$form_state['values']['VJ_OTHER']):0;
    $agent_fee_config->VT_ECO = !empty($form_state['values']['VT_ECO'])?str_replace(".","",$form_state['values']['VT_ECO']):0;
    $agent_fee_config->VT_OTHER = !empty($form_state['values']['VT_OTHER'])?str_replace(".","",$form_state['values']['VT_OTHER']):0;
    $agent_fee_config->SPA_ECO = !empty($form_state['values']['SPA_ECO'])?str_replace(".","",$form_state['values']['SPA_ECO']):0;
    $agent_fee_config->SPA_OTHER = !empty($form_state['values']['SPA_OTHER'])?str_replace(".","",$form_state['values']['SPA_OTHER']):0;
    $agent_fee_config->international_percent = !empty($form_state['values']['percent'])?str_replace(".","",$form_state['values']['percent']):0;
    $agent_fee_config->international_fee = !empty($form_state['values']['amount'])?str_replace(".","",$form_state['values']['amount']):0;
    $agent_fee_config->infant = $form_state['values']['infant'];
    $agent_fee_config->tid = $tid;
    $agent_fee_config->uid = $uid;
    cassiopeia_qt_agent_fee_config_save($agent_fee_config);

    $service_fee_config = !empty($form_state['#service_fee'])?$form_state['#service_fee']:new stdClass();
    $service_fee_config->VN_ECO = !empty($form_state['values']['S_VN_ECO'])?str_replace(".","",$form_state['values']['S_VN_ECO']):0;
    $service_fee_config->VN_OTHER = !empty($form_state['values']['S_VN_OTHER'])?str_replace(".","",$form_state['values']['S_VN_OTHER']):0;
    $service_fee_config->QH_ECO = !empty($form_state['values']['S_QH_ECO'])?str_replace(".","",$form_state['values']['S_QH_ECO']):0;
    $service_fee_config->QH_OTHER = !empty($form_state['values']['S_QH_OTHER'])?str_replace(".","",$form_state['values']['S_QH_OTHER']):0;
    $service_fee_config->VJ_ECO = !empty($form_state['values']['S_VJ_ECO'])?str_replace(".","",$form_state['values']['S_VJ_ECO']):0;
    $service_fee_config->VJ_OTHER = !empty($form_state['values']['S_VJ_OTHER'])?str_replace(".","",$form_state['values']['S_VJ_OTHER']):0;
    $service_fee_config->VT_ECO = !empty($form_state['values']['S_VT_ECO'])?str_replace(".","",$form_state['values']['S_VT_ECO']):0;
    $service_fee_config->VT_OTHER = !empty($form_state['values']['S_VT_OTHER'])?str_replace(".","",$form_state['values']['S_VT_OTHER']):0;
    $service_fee_config->SPA_ECO = !empty($form_state['values']['S_SPA_ECO'])?str_replace(".","",$form_state['values']['S_SPA_ECO']):0;
    $service_fee_config->SPA_OTHER = !empty($form_state['values']['S_SPA_OTHER'])?str_replace(".","",$form_state['values']['S_SPA_OTHER']):0;
    $service_fee_config->international_percent = !empty($form_state['values']['S_percent'])?str_replace(".","",$form_state['values']['S_percent']):0;
    $service_fee_config->international_fee = !empty($form_state['values']['S_amount'])?str_replace(".","",$form_state['values']['S_amount']):0;
    $service_fee_config->international_domestic_fee = !empty($form_state['values']['S_amount_domestic'])?str_replace(".","",$form_state['values']['S_amount_domestic']):0;
    $service_fee_config->infant = $form_state['values']['S_infant'];
    $service_fee_config->tid = $tid;
    $service_fee_config->uid = $uid;
    cassiopeia_qt_service_fee_config_save($service_fee_config);
}
