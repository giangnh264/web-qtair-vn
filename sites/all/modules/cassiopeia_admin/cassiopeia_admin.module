function cassiopeia_qt_alepay_fee_config_load($type){
    try{
        $query = db_select("cassiopeia_qt_alepay_fee_config","cassiopeia_qt_alepay_fee_config");
        $query->fields("cassiopeia_qt_alepay_fee_config");
        $query->condition("cassiopeia_qt_alepay_fee_config.type",$type);
        $result = $query->execute()->fetchObject();
        return $result;
    }catch (Exception $e){
        return null;
    }
}

function cassiopeia_admin_hotel_rating_filter_form($form, &$form_state, $cache){
    $form = array();
    $form['#attributes']['class'][] = "custom-filter-form";
    $form['from_date'] = array(
        '#type' => 'date_popup',
        '#default_value' => $cache['from_date'],
        '#date_type' => DATE_DATETIME,
        '#date_timezone' => date_default_timezone(),
        '#date_format' => 'd-m-Y',
        '#date_increment' => 1,
        '#date_year_range' => '-10:+10',
        '#attributes' => array( "class" => array("form_date")),
        '#prefix'           => "<div class='date-filter-group'>",
        '#suffix'           => "</div>"
    );
    $form['to_date'] = array(
        '#type' => 'date_popup',
        '#default_value' => $cache['to_date'],
        '#date_type' => DATE_DATETIME,
        '#date_timezone' => date_default_timezone(),
        '#date_format' => 'd-m-Y',
        '#date_increment' => 1,
        '#date_year_range' => '-10:+10',
        '#attributes' => array("class" => array("to_date")),
        '#prefix'           => "<div class='date-filter-group'>",
        '#suffix'           => "</div>"
    );
    $hotels = cassiopeia_get_nodes_by_category("hotel");
    $options = array();
    $options['all'] = "Chọn khách sạn";
    foreach($hotels as $hotel){
        $options[$hotel->nid] = $hotel->title;
    }
    $form['hotel'] = array(
        '#type' => 'select',
        '#title' => t('Khách sạn'),
        '#options' => $options,
        '#chosen' => TRUE,
    );
    if(isset($cache['hotel'])){
        $form['hotel']['#default_value'] = $cache['hotel'];
    }
    $form['point'] = array(
        '#type' => 'select',
        '#title' => t('Đánh giá'),
        '#options' => array(
            "all" => "Tất cả",
            1 => "1 sao",
            2 => "2 sao",
            3 => "3 sao",
            4 => "4 sao",
            5 => "5 sao",
        ),
    );
    if(isset($cache['point'])){
        $form['point']['#default_value'] = $cache['point'];
    }
    $form['status'] = array(
        '#type' => 'select',
        '#title' => t('Tình trạng'),
        '#options' => array(
            "all" => "Tất cả",
            0 => "Chưa duyệt",
            1 => "Đã duyệt",
            2 => "Hủy",
        ),
    );
    if(isset($cache['status'])){
        $form['status']['#default_value'] = $cache['status'];
    }
    $form['submit'] = array(
        '#type' => 'submit',
        '#value' => 'Lọc',
        '#suffix'   => "<button class='btn btn-warning btn-change-status-all'>Duyệt tất cả</button>"
    );
    return $form;
}
