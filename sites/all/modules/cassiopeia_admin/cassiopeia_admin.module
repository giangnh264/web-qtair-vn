    $month_options = array();
    $year_options = array();
    for($i=2019;$i<=date("Y",REQUEST_TIME);$i++){
        $year_options[$i] = $i;
    }
    $month_options['all'] = "Tất cả";
    for ($i = 1; $i <= 12; $i++) {
        $month_options[$i] = $i;
    }
    $form['year'] = array(
        '#type' => 'select',
        '#title' => t('Chọn Năm'),
        '#options' => $year_options,
        '#default_value' => !empty($caches['year']) ? $caches['year'] : date("m-Y", REQUEST_TIME),
    );
    $form['month'] = array(
        '#type' => 'select',
        '#title' => t('Chọn tháng'),
        '#options' => $month_options,
        '#attributes' => array("onchange" => "this.form.submit();"),
        '#default_value' => !empty($caches['month']) ? $caches['month'] : date("m-Y", REQUEST_TIME),
    );
    $form['submit'] = array(
        '#type' => 'submit',
        '#value' => 'Lọc',
        '#attributes' => array("class" => array("hidden")),
    );
    return $form;
}

