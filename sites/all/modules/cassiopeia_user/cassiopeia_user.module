function cassiopeia_user_user_topup_form_submit($form,&$form_state){
    global $user;
	if(!empty($user->uid)){
		try{
			$query = db_insert("tbl_user_topup")->fields(array("created","uid","amount","bank","note","status"));
			$query->values(array(REQUEST_TIME,$user->uid,str_replace(".","",$form_state['values']['amount']),$form_state['values']['bank'],$form_state['values']['note'],0));
			$query->execute();		
			$data_mail = (object)[];
			$data_mail->created = REQUEST_TIME;
			$data_mail->uid = $user->uid;
			$data_mail->amount = str_replace(".","",$form_state['values']['amount']);
			$data_mail->bank = $form_state['values']['bank'];
			$data_mail->note = $form_state['values']['note'];
//			cassiopeia_send_mail_topup($data_mail,'topup.augroup@gmail.com');
			drupal_set_message("Vui lòng đợi 5 - 10 phút để kế toán duyệt tiền tự động lên tài khoản Đại lý!");
		}catch (Exception $e){
			_print_r($e);
			die;
		}
	}else{
		$message = "Phiên làm việc đã hết hạn, vui lòng đăng nhập lại!";
		$flag = false;
	}
}
function cassiopeia_send_mail_topup($data_mail, $_mail)
{
	global $user;
		if(!empty($user->uid)){
			$site_mail = variable_get("site_mail");
			$mail_content = _cassiopeia_render_theme("module", "cassiopeia_user", "templates/mail/mail_noti_topup.tpl.php", array("data_topup" => $data_mail));
			$headers['From'] = $headers['Sender'] = $headers['Return-Path'] = $site_mail;
			$body[] = $mail_content;
			$headers['MIME-Version'] = '1.0';
			$headers['Content-Type'] = 'text/html; charset=UTF-8; format=flowed; delsp=yes';
			$params = array(
				'body' => $body,
				'subject' => "Thông báo topup",
				'headers' => $headers,
			);
			if (drupal_mail('cassiopeia', 'custom_key', $_mail, language_default(), $params)) {
		};
	}
}
