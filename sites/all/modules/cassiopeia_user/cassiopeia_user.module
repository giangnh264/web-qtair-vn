function cassiopeia_user_manager_access(){
    if(user_has_role(3)||user_has_role(ROLE_SALE)||user_has_role(ROLE_KE_TOAN)||user_has_role(ROLE_MARKETING)){
        return true;
    }
    return false;
}
function cassiopeia_user_user_load_by_code($code){
    try{
        $query = db_select("users","users");
        $query->fields("users");
        $query->join("field_data_field_account_code","field_account_code","field_account_code.entity_id=users.uid");
        $query->condition("field_account_code.field_account_code_value",$code);
        $result = $query->execute()->fetchObject();
        if(!empty($result)){
            $result = user_load($result->uid);
        }
        return $result;
    }catch (Exception $E){
        return null;
    }
}