        'file' => 'cassiopeia_user.inc',
    );
    $items['user/manager/customer/%cassiopeia_qt_customer/delete'] = array(
        'type' => MENU_CALLBACK,
        'page callback' => 'cassiopeia_user_manager_customer_delete_page_callback',
        'page arguments' => array(3),
        'title' => t('Xóa khách hàng'),
        'access callback'   => 'cassiopeia_agent_accept',
        'file' => 'cassiopeia_user.inc',
    );
    $items['user/manager/customer/%cassiopeia_qt_customer/edit'] = array(
        'type' => MENU_CALLBACK,
        'page callback' => 'cassiopeia_user_manager_customer_edit_page_callback',
        'page arguments' => array(3),
        'title' => t('Sửa khách hàng'),
        'access callback'   => 'cassiopeia_agent_accept',
        'file' => 'cassiopeia_user.inc',
    );
    $items['user/manager/customer/add'] = array(
        'type' => MENU_CALLBACK,
        'page callback' => 'cassiopeia_user_manager_customer_add_page_callback',
        'title' => t('Thêm khách hàng'),
        'access callback'   => 'cassiopeia_agent_accept',
        'file' => 'cassiopeia_user.inc',
    );
    $items['user/manager/customer'] = array(
        'type' => MENU_CALLBACK,
        'page callback' => 'cassiopeia_user_manager_customer_page_callback',
        'title' => t('Danh sách khách hàng'),
        'access callback'   => 'cassiopeia_agent_accept',
        'file' => 'cassiopeia_user.inc',
    );
    $items['user/manager/notify'] = array(
        'type' => MENU_CALLBACK,
        'page callback' => 'cassiopeia_user_manager_notify_callback',
        'title' => t('Thông báo'),
        'access callback'   => 'cassiopeia_agent_accept',
        'file' => 'cassiopeia_user.inc',
    );
    $items['user/manager/ticketIssue'] = array(
        'type' => MENU_CALLBACK,
        'page callback' => 'cassiopeia_ticketIssue_call_back',
        'title' => t('Xuất vé & mở mặt vé'),
        'access callback' => 'cassiopeia_user_issue_ticket_access',
        'file' => 'cassiopeia_user.inc',
    );
    $items['user/manager/ticketReview'] = array(
        'type' => MENU_CALLBACK,
        'page callback' => 'cassiopeia_ticketReview_call_back',
        'title' => t('Mở mặt vé'),
        'access callback' => 'cassiopeia_ticket_issue_accept',
        'access arguments' => array('cassiopeia content'),
        'file' => 'cassiopeia_user.inc',
    );
    $items['user/manager/bao-cao-tich-diem'] = array(
        'type' => MENU_CALLBACK,
        'page callback' => 'cassiopeia_user_agent_point_report_callback',
        'title' => t('Báo cáo tích điểm'),
        'access callback' => 'cassiopeia_agent_accept',
        'file' => 'cassiopeia_user.inc',
    );
  return $items;
}

function cassiopeia_agent_accept(){
    global $user;
    if(user_has_role(3,$user) || user_has_role(4,$user) || user_has_role(5,$user)|| user_has_role(8,$user)){
        return true;
    }else{
        return false;
    }
}

/**
 * Implements hook_menu_alter().
 */
function cassiopeia_user_menu_alter(&$items) {
    global $user;
    $items['user']['page callback'] = '_cassiopeia_user_user_page';
//    $items['user/%user/edit']['access callback'] = 'cassiopeia_user_user_edit_access';
//    $items['user/%user/edit']['theme callback'] = '_cassiopeia_admin_theme_white';
    $items['user/%user/cancel']['access callback'] = '_cassiopeia_user_delete_access';
    $items['admin/people/create']['access callback'] = '_cassiopeia_add_people_access';
    $items['admin/people/create']['theme callback'] = '_cassiopeia_admin_theme_white';
}

function _cassiopeia_add_people_access() {
    return cassiopeia_check_permission("cassiopeia_user_permission_user","p_add");
}

function _cassiopeia_user_delete_access($op){
    return cassiopeia_check_permission("cassiopeia_user_permission_user","p_delete");
}

function cassiopeia_theme_callback () {
  return 'cassiopeia_theme';
}

function _cassiopeia_user_user_page() {
  global $user;
  if (!empty($user->uid)) {
    drupal_goto('user/' . $user->uid);
  }
  else {
    return drupal_get_form('user_login');
  }
}


function cassiopeia_user_user_change_password_form($form, &$form_state, $account) {
  $form = array();
  if (!isset($form_state['user'])) {
    $form_state['user'] = $account;
  }

  if (empty($_SESSION['pass_reset_' . $account->uid])) {
    $form['curent-pass'] = array(
      '#type' => 'password',
      '#title' => 'Mặt khẩu cũ',
      '#element_validate' => array('cassiopeia_user_change_password_form_validate_curent_password'),
      '#required' => TRUE,
    );
  }

  $form['news-pass'] = array(
    '#type' => 'password_confirm',
    '#required' => TRUE,
  );

  $form['submit'] = array(
    '#type' => 'submit',
    '#value' => 'Lưu',
    '#prefix' => '<div id="user-change-password-actions">',
    '#suffix' => '</div>',
  );

  return $form;
}

function cassiopeia_user_change_password_form_validate_curent_password($element, &$form_state) {
  global $user;
  $account = $form_state['user'];
  if ($account->uid == $user->uid) {
    require_once DRUPAL_ROOT . '/' . variable_get('password_inc', 'includes/password.inc');
    $current_pass_failed = strlen(trim($form_state['values']['curent-pass'])) == 0 || !user_check_password($form_state['values']['curent-pass'], $account);
    if ($current_pass_failed) {
      form_error($element, 'Mạt khẩu không đúng');
    }
  }
  else {
    form_error($element, 'Bạn không có quyền thay đổi mật khẩu');
  }
}

function cassiopeia_user_user_change_password_form_submit($form, $form_state) {
  global $user;
//  print_r($form_state['user']);
//  die;
  $account = $form_state['user'];
  if (strlen($form_state['values']['news-pass']) < 6) {
    form_error($form['news-pass'], 'Mật khẩu phải  lớn hơn hoặc bàng 6 ký tự');
  }
  else {
    if (!empty($user->uid) && ($user->uid == $account->uid)) {
      require_once DRUPAL_ROOT . '/includes/bootstrap.inc';
      drupal_bootstrap(DRUPAL_BOOTSTRAP_FULL);
      require_once DRUPAL_ROOT . '/includes/password.inc';

      $newhash = user_hash_password($form_state['values']['news-pass']);
      try {
        $updatepass = db_update('users')
          ->fields(array('pass' => $newhash))
          ->condition('uid', $account->uid, '=')
          ->execute();
        if ($updatepass) {
          cache_clear_all();
          if ($_SESSION['pass_reset_' . $form_state['user']->uid]) {
            unset($_SESSION['pass_reset_' . $form_state['user']->uid]);
          }
          drupal_set_message('Thay đổi mật khẩu thành công');
          drupal_goto("/");
        }

      } catch (Exception $e) {
        drupal_set_message('Hệ thống đang bận vui lòng quai lại sau ít phút', 'error');
      }
    }

  }
}

