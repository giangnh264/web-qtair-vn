function cassiopeia_user_form_user_register_form_alter(&$form, &$form_state) {
    $arg = arg();
    global $user,$theme;
    $_is_admin = FALSE;

    if (!empty($user->roles)) {
        foreach ($user->roles as $_key => $_value) {
            if ($_value == 'administrator') {
                $_is_admin = TRUE;
                break;
            }
        }
    }
    $form['#attributes']['class'][] = "user-register-form";
    $form['account']['name']['#description'] = '';
    $form['account']['name']['#title'] = 'Số điện thoại';
    $form['account']['name']['#attributes']['placeholder'] = "Số điện thoại";

    unset($form['account']['mail']['#description']);
    if(!$_is_admin){
        $form['account']['pass']['#type'] = "hidden";
        $form['account']['pass']['#required'] = false;
    }else{
        $form['account']['pass']['#process'] = array(
            'form_process_password_confirm',
            'cassiopeia_user_password_confirm_process',
            'user_form_process_password_confirm'
        );
    }
    $form['account']['mail']['#title'] = "Email";
    $form['account']['mail']['#attributes']['placeholder'] = "Email";
    $form['field_account_full_name']['und'][0]['value']['#attributes']['placeholder'] = "Nhập họ và tên";
    $form['field_account_full_name']['und'][0]['value']['#title'] = "Họ và tên";

    $form['name']['#element_validate'][] = 'cassiopeia_register_validation';
	
    $form['actions']['submit']['#attributes'] = array("data-value"=>t("Đăng ký"));

    $form['account']['roles']['#options'] = array(
         3  => "Administrator",
         4  => "Đại lý",
         5  => "Sale",
         7  => "Kế toán",
         8  => "Booker",
         9  => "Marketing",
    );
    if($theme!="cassiopeia_admin_theme_white"){
        $form['#theme'][] = 'cassiopeia_user_form_user_register_form';
        $form['terms_of_service'] = array(
            '#type'     =>'checkbox',
            '#prefix'       => "<div class=\"terms-services\">",
            '#suffix'       => "<span class='get_terms_service'>Tôi đồng ý điều khoản & điều kiện của ".SITE_NAME."</span></div>",
            '#title'    => t(''),
            '#default_value'    => 1,
            '#required'    => TRUE,
        );
    }
    $form['#submit'] = array("_cassiopeia_user_register_submit");
}
