function cassiopeia_user_customer_form($form,&$form_state,$customer = null){
    $form_state['#customer'] = $customer;
    $form['name'] = array(
        '#type'     => 'textfield',
        '#title'    => t('Họ và tên'),
        '#default_value'    => !empty($customer)?$customer->name:""
    );
    $form['mail'] = array(
        '#type'     => 'textfield',
        '#title'    => t('Email'),
        '#default_value'    => !empty($customer)?$customer->mail:""
    );
    $form['tel'] = array(
        '#type'     => 'textfield',
        '#title'    => t('Số điện thoại'),
        '#default_value'    => !empty($customer)?$customer->tel:""
    );
    $form['birthday'] = array(
        '#type' => 'date_popup',
        '#date_type' => DATE_DATETIME,
        '#date_timezone' => date_default_timezone(),
        '#date_format' => 'd-m-Y',
        '#date_increment' => 1,
        '#date_year_range' => '-70:+0',
        '#prefix'   => "<div class='item birthday'>",
        '#suffix'   => "<i class='fa fa-calendar'></i></div>",
        '#default_value'    => !empty($customer)?date("Y-m-d H:i",$customer->birthday):""
    );
    $form['gender'] = array(
        '#type' => 'select',
        '#title' => t('Giới tính'),
        '#options' => array(
            1 => "Nam",
            0 => "Nữ",
        ),
        '#default_value'    => !empty($customer)?$customer->gender:""
    );
    $form['note'] = array(
        '#title' => t(''),
        '#type' => 'textarea',
        '#attributes'   => array("placeholder"=>array("Ghi chú")),
        '#default_value'    => !empty($customer)?$customer->note:""
    );
    $form['VN'] = array(
        '#type'     => 'textfield',
        '#title'    => t('Mã KHTX VN'),
        '#default_value'    => !empty($customer)?$customer->VN:""
    );
    $form['QH'] = array(
        '#type'     => 'textfield',
        '#title'    => t('Mã KHTX QH'),
        '#default_value'    => !empty($customer)?$customer->QH:""
    );
    $form['submit'] = array(
        '#type'     => 'submit',
        '#value'    => t('Xác nhận'),
        '#prefix'   => "<div class='form-buttons'>",
        '#suffix'   => "</div>"
    );
    return $form;
}
function cassiopeia_user_customer_form_submit($form,&$form_state){
    global $user;
    $customer = !empty($form_state['#customer'])?$form_state['#customer']:new stdClass();
    $customer->name = !empty($form_state['values']['name'])?$form_state['values']['name']:"";
    $customer->tel = !empty($form_state['values']['tel'])?$form_state['values']['tel']:"";
    $customer->mail = !empty($form_state['values']['mail'])?$form_state['values']['mail']:"";
    $customer->note = !empty($form_state['values']['note'])?$form_state['values']['note']:"";
    $customer->VN = !empty($form_state['values']['VN'])?$form_state['values']['VN']:"";
    $customer->QH = !empty($form_state['values']['QH'])?$form_state['values']['QH']:"";
    $customer->birthday = !empty($form_state['values']['birthday'])?strtotime($form_state['values']['birthday']):"";
    $customer->gender = $form_state['values']['gender'];
    if(!empty($customer) && !empty($customer->id)){
        $customer->changed = REQUEST_TIME;
        drupal_write_record("tbl_customer",$customer,array("id"));
        drupal_set_message("Cập nhật thành công!");
    }else{
        $customer->uid = $user->uid;
        $customer->created = REQUEST_TIME;
        $customer->changed = REQUEST_TIME;
        drupal_write_record("tbl_customer",$customer);
        drupal_set_message("Thêm mới thành công!");
    }
}

function cassiopeia_user_customer_delete_form ($form, &$form_state, $customer) {
    $customer = $form_state['#customer'] = $customer;
    $form = confirm_form($form,
        t('Bạn có chắc chắn muốn xóa khách hàng %name?', array('%name' => $customer->name)),
        'user/manager/customer',
        '<p>' . t('This action cannot be undone.') .'</p>',
        t('Delete'),
        t('Cancel'),
        'confirm'
    );
    $form['actions']['cancel']['#attributes'] = array('class'=>array('btn btn-icon-before btn-open-search bg-primary c-white'), 'style'=>array('display: inline-block;'));
    $form['actions']['cancel']['#options']['html']  = true;
//  $form['actions']['cancel']['#options']['text']  = '<i class="fal fa-magnifying-glass fa-fw" aria-hidden="true"></i> Cancel';
    $form['actions']['cancel']['#title']  = '<i class="fal fa-ban fa-fw" aria-hidden="true"></i> '. t('Cancel');
    $form['actions']['submit']['#icon'] ='<span class="fal fa-trash fa-fw"></span>';
    $form['#submit'][] = 'cassiopeia_user_customer_delete_form_submit';
    return $form;
}
function cassiopeia_user_customer_delete_form_submit($form, &$form_state) {
    try{
        db_delete("tbl_customer")->condition("id",$form_state['#customer']->id)->execute();
        drupal_set_message("Đã xóa khách hàng ".$form_state['#customer']->name);
    }catch (Exception $e){
        print_r($e);
        die;
    }
}
function cassiopeia_user_check_permission($account,$permission_type,$permission){
    global $user;
    $account = !empty($account)?$account:$user;
    if(empty($account->uid)){ // chưa đăng nhập thì không kiểm tra quyền nữa
        return false;
    }
    if(!empty($user->uid)&&user_has_role(3)){ // admin full quyền
        return true;
    }
    return cassiopeia_user_role_check_permission($account,$permission_type,$permission);
    if(cassiopeia_user_role_check_permission($account,$permission_type,$permission)){
        return true;
    }
    $USER_PERMISSIONS_LIST = unserialize(USER_PERMISSIONS_LIST);
    $permission_table = $USER_PERMISSIONS_LIST[$permission_type]['table'];
    $query = db_select($permission_table, 'p');
    $query->fields('p');
    $query->condition('p.uid', $account->uid,'=');
    $query->condition('p.permission', $permission,'=');
    $permissions = $query->execute()->fetchObject();
    if(!empty($permissions) && $permissions->status==1){
        return true; // kiểm tra quyền đơn
    }
    return false;
}
function cassiopeia_user_role_check_permission($account,$permission_type,$permission){
    global $user;
    $account = !empty($account)?$account:$user;

    $USER_ROLE_PERMISSIONS_LIST = unserialize(USER_ROLE_PERMISSIONS_LIST);
    $permission_table = $USER_ROLE_PERMISSIONS_LIST[$permission_type]['table'];
    foreach($account->roles as $role => $name){
        if($role>3){
            $query = db_select($permission_table, 'p');
            $query->fields('p');
            $query->condition('p.rid', $role,'=');
            $query->condition('p.permission', $permission,'=');
            $permissions = $query->execute()->fetchObject();
            if(!empty($permissions) && $permissions->status==1){
                return true; // kiểm tra quyền đơn
            }
        }
    }
    return false;
}
function cassiopeia_user_permissions_form ($form, &$form_state, $data = array('user' => NULL, 'type' => 'f1')) {
    $form = array();
    $type = $data['type'];
    $form['#user'] = $form_state['#user'] = $data['user'];
    $permissions = array();
    $form['#permissiontype'] = $form_state['#permissiontype'] = $type;
    $USER_PERMISSIONS_LIST = unserialize(USER_PERMISSIONS_LIST);
    if(!empty($USER_PERMISSIONS_LIST[$type])){
        $list_permissions = $USER_PERMISSIONS_LIST[$type]['list'];
        $permission_table = $USER_PERMISSIONS_LIST[$type]['table'];
        $form['#permission_table'] = $permission_table;
        if(!empty($list_permissions)){
            foreach ($list_permissions as $_list_permission_key_ => $_list_permission_value_) {
                $permissions[$_list_permission_key_]=(object)$_list_permission_value_;
            }

            if (!empty($permissions)) {
                usort($permissions, function($a, $b) {
                    return strcmp(mb_strtoupper($a->mark) .' '. $a->title, mb_strtoupper($b->mark) .' '.$b->title);
                });

                foreach ($permissions as $key => $permission) {
                    $query = db_select($permission_table, 'p');
                    $query->fields('p');
                    $query->condition('p.permission', $permission->permission, '=');
                    $query->condition('p.uid', $form_state['#user']->uid, '=');
                    $user_permission = $query->execute()->fetchObject();
                    $form[$key] = array(
                        '#type' => 'markup',
                        '#tree' => TRUE,
                    );
                    $form[$key]['title'] = array(
                        '#markup' =>  mb_strtoupper($permission->mark) .' '. $permission->title,
                    );
                    $form[$key]['description'] = array(
                        '#markup' => !empty($permission->description) ? $permission->description : '',
                    );
                    $form[$key]['expired'] = array(
                        '#markup' => !empty($permission->expired) ? date('d/m/Y H:i', $permission->expired) : '',
                    );
                    $form[$key]['check'] = array(
                        '#type' => 'checkbox',
                        '#title' => '',
                        '#default_value' => !empty($user_permission->status) ? $user_permission->status : 0,
                        '#checkmark' =>TRUE,

                    );
                }
            }

        }

        $form['submit'] = array('#type' => 'submit', '#value' => 'Lưu', '#attributes'=> array('class'=> array('btn','btn-border','btn-small','btn-icon')));
    }
    $form['#permissions'] = $form_state['#permissions'] = $permissions;

    return $form;
}
function cassiopeia_user_permissions_form_submit($form, &$form_state) {
    $transaction = db_transaction();
    try {
//        if ($form['#permissiontype'] == 'f1') {
        $updates = array();
        $inserts = array();
        foreach ($form_state['#permissions'] as $key => $permission) {
            $query = db_select($form['#permission_table'], 'p');
            $query->fields('p');
            $query->condition('p.permission', $permission->permission, '=');
            $query->condition('p.uid', $form_state['#user']->uid, '=');
            $user_permission = $query->execute()->fetchObject();
            if (!empty($user_permission)) {
                $updates[] = array(
                    'uid' => $user_permission->uid,
                    'permission' => $user_permission->permission,
                    'status' => $form_state['values'][$key]['check'],
                );
            }
            else {
                $inserts[] = array(
                    'uid' => $form_state['#user']->uid,
                    'permission' => $permission->permission,
                    'status' => $form_state['values'][$key]['check'],
                );
            }
        }
        if (!empty($updates)) {
            foreach ($updates as $update) {
                db_update($form['#permission_table'])
                    ->fields(array(
                        'status' => $update['status'],
                    ))
                    ->condition('permission', $update['permission'], '=')
                    ->condition('uid', $update['uid'], '=')
                    ->execute();
            }
        }
        if (!empty($inserts)) {
            $query = db_insert($form['#permission_table'])->fields(array(
                'uid',
                'permission',
                'status',
            ));
            foreach ($inserts as $insert) {
                $query->values($insert);
            }
            $query->execute();
        }
//        }
    } catch (Exception $e) {
        $transaction->rollback();
    }
}
