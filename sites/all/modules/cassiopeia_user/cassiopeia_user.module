function cassiopeia_agent_fee_config_form_submit($form,&$form_state){
    global $user;
    $_user = user_load($user->uid);
    $uid = user_has_role(3)?0:$user->uid;
    $_tid = !empty($_user->field_tx_rank['und'][0]['tid'])?$_user->field_tx_rank['und'][0]['tid']:0;
    $tid = isset($_REQUEST['tx'])?$_REQUEST['tx']:$_tid;
    $agent_fee_config = !empty($form_state['#config'])?$form_state['#config']:new stdClass();
    $agent_fee_config->VN_ECO = !empty($form_state['values']['VN_ECO'])?str_replace(".","",$form_state['values']['VN_ECO']):0;
    $agent_fee_config->VN_OTHER = !empty($form_state['values']['VN_OTHER'])?str_replace(".","",$form_state['values']['VN_OTHER']):0;
    $agent_fee_config->QH_ECO = !empty($form_state['values']['QH_ECO'])?str_replace(".","",$form_state['values']['QH_ECO']):0;
    $agent_fee_config->QH_OTHER = !empty($form_state['values']['QH_OTHER'])?str_replace(".","",$form_state['values']['QH_OTHER']):0;
    $agent_fee_config->VJ_ECO = !empty($form_state['values']['VJ_ECO'])?str_replace(".","",$form_state['values']['VJ_ECO']):0;
    $agent_fee_config->VJ_OTHER = !empty($form_state['values']['VJ_OTHER'])?str_replace(".","",$form_state['values']['VJ_OTHER']):0;
    $agent_fee_config->VT_ECO = !empty($form_state['values']['VT_ECO'])?str_replace(".","",$form_state['values']['VT_ECO']):0;
    $agent_fee_config->VT_OTHER = !empty($form_state['values']['VT_OTHER'])?str_replace(".","",$form_state['values']['VT_OTHER']):0;
    $agent_fee_config->SPA_ECO = !empty($form_state['values']['SPA_ECO'])?str_replace(".","",$form_state['values']['SPA_ECO']):0;
    $agent_fee_config->SPA_OTHER = !empty($form_state['values']['SPA_OTHER'])?str_replace(".","",$form_state['values']['SPA_OTHER']):0;
    $agent_fee_config->international_percent = !empty($form_state['values']['percent'])?str_replace(".","",$form_state['values']['percent']):0;
    $agent_fee_config->international_fee = !empty($form_state['values']['amount'])?str_replace(".","",$form_state['values']['amount']):0;
    $agent_fee_config->infant = $form_state['values']['infant'];
    $agent_fee_config->tid = $tid;
    $agent_fee_config->uid = $uid;
    cassiopeia_qt_agent_fee_config_save($agent_fee_config);
}

function cassiopeia_user_agent_fee_load_by_class($Airline,$_Class){
    global $user;
    $Price = 0;
    $config = cassiopeia_qt_agent_fee_config_load($user);
//    _print_r($config);
    if(!empty($config)){
        switch ($Airline){
            case "VN" :
                switch (strtoupper($_Class)){
                    case "J" :
                    case "C" :
                    case "I" :
                    case "D" :
                        $Price=$config->VN_OTHER;
                        break;
                    default :
                        $Price=$config->VN_ECO;;
                }
                break;
            case "QH" :
                switch (strtoupper($_Class)){
                    case "BUSINESS" :
                        $Price=$config->QH_OTHER;
                        break;
                    default :
                        $Price=$config->QH_ECO;;
                }
                break;
            case "VJ" :
                switch (strtoupper($_Class)){
                    case "ECO" :
                    case "DELUXE" :
                        $Price=$config->VJ_ECO;
                        break;
                    default : $Price=$config->VJ_OTHER;;
                }
                break;
            case "VU" :
                $Price=$config->VT_ECO;;
                break;
            case "9G" :
                switch (strtoupper($_Class)){
                    case "J" :
                    case "C" :
                    case "I" :
                    case "D" :
                        $Price=$config->SPA_OTHER;
                        break;
                    default :
                        $Price=$config->SPA_ECO;
                        break;
                }
                break;
        }
    }
    if(in_array($Airline,unserialize(DOMESTIC_AIRLINES))){ // hãng nội địa -> phí nội địa
        $config->international_fee = $Price;
    }
    if(!empty($config) && $config->infant==1){
        $return = array(
            "infant"    => $Price,
            "fee"       => $Price,
            "international_fee"       => $config->international_fee,
            "international_percent"       => $config->international_percent,
        );
    }else{
        $return = array(
            "infant"    => 0,
            "fee"       => $Price,
            "international_fee"       => $config->international_fee,
            "international_percent"       => $config->international_percent,
        );
    }
    return $return;
}
function cassiopeia_user_service_fee_load_by_class($Airline,$_Class){
    global $user;
    $Price = 0;
    $config = cassiopeia_qt_service_fee_config_load($user);
    if(!empty($config)){
        switch ($Airline){
            case "VN" :
                switch (strtoupper($_Class)){
                    case "J" :
                    case "C" :
                    case "I" :
                    case "D" :
                        $Price=$config->VN_OTHER;
                        break;
                    default :
                        $Price=$config->VN_ECO;;
                }
                break;
            case "QH" :
                switch (strtoupper($_Class)){
                    case "BUSINESS" :
                        $Price=$config->QH_OTHER;
                        break;
                    default :
                        $Price=$config->QH_ECO;;
                }
                break;
            case "VJ" :
                switch (strtoupper($_Class)){
                    case "ECO" :
                    case "DELUXE" :
                        $Price=$config->VJ_ECO;
                        break;
                    default : $Price=$config->VJ_OTHER;;
                }
                break;
            case "VU" :
                $Price=$config->VT_ECO;;
                break;
            case "9G" :
                switch (strtoupper($_Class)){
                    case "J" :
                    case "C" :
                    case "I" :
                    case "D" :
                        $Price=$config->SPA_OTHER;
                        break;
                    default : $Price=$config->SPA_ECO;
                }
                break;
        }
    }
    if(in_array($Airline,unserialize(DOMESTIC_AIRLINES))){ // hãng nội địa -> phí nội địa
        $config->international_fee = $Price;
    }
    if(!empty($config) && $config->infant==1){
        $return = array(
            "infant"    => $Price,
            "fee"       => $Price,
            "international_fee"       => $config->international_fee,
            "international_percent"       => $config->international_percent,
            "international_domestic_fee"       => $config->international_domestic_fee,
        );
    }else{
        $return = array(
            "infant"    => 0,
            "fee"       => $Price,
            "international_fee"       => $config->international_fee,
            "international_percent"       => $config->international_percent,
            "international_domestic_fee"       => $config->international_domestic_fee,
        );
    }

    return $return;
}
