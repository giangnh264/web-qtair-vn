}
function cassiopeia_user_user_presave(&$edit, $account, $category) {
    global $user;
    if(!empty($edit)&&!empty($edit['change_sale'])){
        if(!empty($edit['_sale'])){
            $edit['field_account_sale']['und'][0]['target_id'] = $edit['_sale'];
        }
    }
//    }
}
function cassiopeia_user_theme($existing, $type, $theme, $path) {
    $themes = array(
        'cassiopeia_user_profile_form' => array(
            'render element' => 'form',
            'template' => 'cassiopeia_user_profile_form',
            'path' => drupal_get_path('module', 'cassiopeia_user') . '/templates/forms'
        ),
        'cassiopeia_custom_user_login_form' => array(
            'render element' => 'form',
            'template' => 'cassiopeia_custom_user_login_form',
            'path' => drupal_get_path('module', 'cassiopeia_user') . '/templates/forms'
        ),
        'cassiopeia_user_form_user_register_form' => array(
            'render element' => 'form',
            'template' => 'cassiopeia_user_form_user_register_form',
            'path' => drupal_get_path('module', 'cassiopeia_user') . '/templates/forms'
        ),
        'cassiopeia_agent_fee_config_form' => array(
            'render element' => 'form',
            'template' => 'cassiopeia_agent_fee_config_form',
            'path' => drupal_get_path('module', 'cassiopeia_user') . '/templates/forms'
        ),

    );
    return $themes;
}
function cassiopeia_custom_user_login_form($form,&$form_state){
    $form = array();
    $form['agent_code'] = array(
        '#type'         => 'textfield',
        '#title'        => t('Mã đại lý'),
        '#size'         => 60,
        '#maxlength'    => 128,
        '#required'     => TRUE,
        '#attributes'   => array("placeholder"=>array(t("Mã đại lý"))),
//        '#prefix'       => "<div class=\"input-group mail\"><img src='/sites/all/themes/cassiopeia_theme/img/icons/agent.png'></span>",
//        '#suffix'       => "</div>",
    );
    $form['username'] = array(
        '#type'         => 'textfield',
        '#title'        => t('Nhập số điện thoại'),
        '#size'         => 60,
        '#maxlength'    => 128,
        '#required'     => TRUE,
        '#attributes'   => array("placeholder"=>array(t("Số điện thoại"))),
//        '#prefix'       => "<div class=\"input-group mail\"><img src='/sites/all/themes/cassiopeia_theme/img/icons/fullname.png'></span>",
//        '#suffix'       => "</div>",
    );
    $form['password'] = array(
        '#type'         => 'password',
        '#title'        => t('Nhập mật khẩu'),
        '#size'         => 60,
        '#maxlength'    => 128,
        '#required'     => TRUE,
        '#attributes'   => array("placeholder"=>array(t("Nhập mật khẩu"))),
//        '#prefix'       => "<div class=\"input-group mail\"><img src='/sites/all/themes/cassiopeia_theme/img/icons/password.png'></span>",
//        '#suffix'       => "</div>",
    );
    $form['remember_me'] = array(
        '#type'     => 'checkbox',
        '#title'    => "<span>Ghi nhớ mật khẩu</span>",
    );
    if(isset($_COOKIE['agent_username'])){
        $form['username']['#default_value'] = $_COOKIE['agent_username'];
    }
    if(isset($_COOKIE['agent_code'])){
        $form['agent_code']['#default_value'] = $_COOKIE['agent_code'];
    }
    if(isset($_COOKIE['agent_password'])){
        $form['password']['#type'] = "textfield";
        $form['password']['#default_value'] = $_COOKIE['agent_password'];
    }
    $form['submit'] = array(
        '#type'         => 'submit',
        '#value'        => t('Đăng nhập'),
        '#attributes'   => array("class"=>array("btn bg-secondary ff-semibold clr-white radius-36"))
    );
    return $form;
}
function cassiopeia_custom_user_login_form_submit($form,&$form_state){
    try{
        if(user_authenticate($form_state['values']['username'], $form_state['values']['password']))
        {
            $query = db_select("users","tbl_user");
            $query -> fields("tbl_user");
            $query -> join("field_data_field_account_code","tbl_account_code","tbl_account_code.entity_id = tbl_user.uid");
            $query -> condition("tbl_account_code.field_account_code_value",$form_state['values']['agent_code']);
            $query -> condition("tbl_user.name",$form_state['values']['username']);
            $result = $query -> execute() -> fetchAssoc();
            if(!empty($result)){
                $user_obj = user_load_by_name($form_state['values']['username']);
                $form_state = array();
                $form_state['uid'] = $user_obj->uid;
                user_login_submit(array(), $form_state);
                drupal_set_message("Đăng nhập thành công");
                if(!empty($form_state['values']['remember_me'])){
                    setcookie("agent_username", $form_state['values']['agent_username'], time() + (86400 * 30), "/");
                    setcookie("agent_password", $form_state['values']['password'], time() + (86400 * 30), "/");
                    setcookie("agent_code", $form_state['values']['agent_code'], time() + (86400 * 30), "/");
                }else{
                    setcookie("agent_username", "", 1, "/");
                    setcookie("agent_password", "", 1, "/");
                    setcookie("agent_code", "", 1, "/");
                }
                drupal_goto("/");
            }else{
                drupal_set_message("Không tìm thấy tài khoản phù hợp!");
            }
        }
        else
        {
           drupal_set_message("Không tìm thấy tài khoản phù hợp!");
        }
    }catch (Exception $e){
        print("Lỗi");
        die;
    }
//    $form_state['redirect'] = "/";
}
