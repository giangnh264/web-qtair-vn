//        drupal_goto("/");
//    }

    // Try loading by username.
//    if ($user = user_load_by_name($name_input)) {
//        return FALSE;
//    }
//print("jkl");die;
    return TRUE;
}
function cassiopeia_user_password_confirm_process($element) {
    $element['pass1']['#attributes']['placeholder'] = 'Nhập mật khẩu';
    $element['pass1']['#title'] = 'Nhập mật khẩu';
    $element['pass2']['#title'] = 'Nhập lại mật khẩu';
    $element['pass2']['#attributes']['placeholder'] = 'Nhập lại mật khẩu';
    return $element;
}
function _cassiopeia_user_register_submit($form, &$form_state) {
    $arg = arg();

    $admin = $form_state['values']['administer_users'];

    if (!variable_get('user_email_verification', TRUE) || $admin) {
        $pass = $form_state['values']['pass'];
    }
    else {
        $pass = user_password();
    }
    $notify = !empty($form_state['values']['notify']);

    // Remove unneeded values.
    form_state_values_clean($form_state);

    $form_state['values']['pass'] = $pass;
    $form_state['values']['init'] = $form_state['values']['mail'];

    $account = $form['#user'];

    entity_form_submit_build_entity('user', $account, $form, $form_state);

    // Populate $edit with the properties of $account, which have been edited on
    // this form by taking over all values, which appear in the form values too.
    $edit = array_intersect_key((array) $account, $form_state['values']);
    $account = user_save($account, $edit);

    // Terminate if an error occurred during user_save().
    if (!$account) {
        drupal_set_message(t("Error saving user account."), 'error');
        $form_state['redirect'] = '';
        return;
    }
    $form_state['user'] = $account;
    $form_state['values']['uid'] = $account->uid;

    watchdog('user', 'New user: %name (%email).', array('%name' => $form_state['values']['name'], '%email' => $form_state['values']['mail']), WATCHDOG_NOTICE, l(t('edit'), 'user/' . $account->uid . '/edit'));

    // Add plain text password into user account to generate mail tokens.
    $account->password = $pass;

    // New administrative account without notification.
    $uri = entity_uri('user', $account);
//    print(1);
//    die;
    if ($admin && !$notify) {
//        print(2);
//        die;
        drupal_set_message(t('Created a new user account for <a href="@url">%name</a>. No e-mail has been sent.', array('@url' => url($uri['path'], $uri['options']), '%name' => $account->name)));
    }
    // No e-mail verification required; log in user immediately.
    elseif (!$admin && !variable_get('user_email_verification', TRUE) && $account->status) {
//        print(3);
//        die;
        _user_mail_notify('register_no_approval_required', $account);
        $form_state['uid'] = $account->uid;
        user_login_submit(array(), $form_state);
        drupal_set_message(t('Registration successful. You are now logged in.'));
        $form_state['redirect'] = '';
    }
    // No administrator approval required.
    elseif ($account->status || $notify) {
//        print(4);
//        die;
//        $op = $notify ? 'register_admin_created' : 'register_no_approval_required';
        $op = "register_no_approval_required";
        _user_mail_notify($op, $account);
        if ($notify) {
            drupal_set_message(t('A welcome message with further instructions has been e-mailed to the new user <a href="@url">%name</a>.', array('@url' => url($uri['path'], $uri['options']), '%name' => $account->name)));
        }
        else {
            drupal_set_message(t('A welcome message with further instructions has been sent to your e-mail address.'));
            $form_state['redirect'] = '';
        }
    }
    // Administrator approval required.
    else {
       try{
           $existingUser = user_load($account->uid);
           $existingUser -> roles[4] = 1;
           $existingUser->field_account_transaction_name['und'][0]['value'] = $form_state['values']['field_account_full_name']['und'][0]['value'];
           $existingUser->field_account_status['und'][0]['tid'] = 10;
           $existingUser->field_tx_rank['und'][0]['tid'] = 120;
           if($arg[0]=="node" || $arg[0]=="partner" || $arg[0]=="partner-new"){
               $existingUser->field_account_source['und'][0]['value'] = 2;
           }
           $data = new stdClass();
           $data->phone_office = $existingUser->name;
           $data->account_name = $form_state['values']['field_account_full_name']['und'][0]['value'];
           $data->email = $existingUser->mail;
           cassiopeia_get_fly_create_account($data);
           user_save($existingUser);
       }catch (Exception $e){
           print_r($e);
           die;
       }
        drupal_set_message(t('Cảm ơn Quý Đại lí đã đăng kí hợp tác làm thêm vé máy bay với Quang Trang. Chúng tôi sẽ liên hệ để xác minh thông tin và hướng dẫn chi tiết trong vòng 24h tới.'));
        drupal_goto("/");

    }
}

function cassiopeia_user_form_user_profile_form_alter(&$form, &$form_state, $form_id)
{
    $arg = arg();
    global $user;
    global $theme_key;
    global $theme;
    $_is_admin = FALSE;
    if (!empty($user->roles)) {
        foreach ($user->roles as $_key => $_value) {
            if ($_value == 'administrator') {
                $_is_admin = TRUE;
                break;
            }
        }
    }
    $form['account']['roles']['#options'] = array(
        3   => "administrator",
        4   => "Đại lí",
        5   => "Sale",
        6   => "Cộng tác viên",
        7   => "Kế toán",
        8   => "Booker",
        9   => "Marketing",
    );
    if(!user_has_role(3) && !user_has_role(5)){
        $form['account']['#access'] = FALSE;
        unset($form['field_account_sale']);

        unset($form['field_account_balance']);

        unset($form['field_partner_code']);
        unset($form['account']['mail']['#description']);
        unset($form['account']['pass']['#description']);
        $form['#theme'] = array('cassiopeia_user_profile_form');
    }
    unset($form['field_account_sale']);
    if(user_has_role(3)){
        $query = db_select("users","tbl_user");
        $query -> fields("tbl_user");
        $query -> join("users_roles","tbl_role","tbl_role.uid = tbl_user.uid");
        $query -> condition("tbl_role.rid",array(3,5),"IN");
        $result  = $query -> execute() -> fetchAll();
        $sale_options = array();
        $sale_options['_none'] = "Tất cả";
        if(!empty($result)){
            foreach($result as $value){
                $sale = user_load($value->uid);
                $sale_code = !empty($sale->field_account_code['und'][0]['value'])?$sale->field_account_code['und'][0]['value']:"";
                $sale_transaction_name = !empty($sale->field_account_transaction_name['und'][0]['value'])?$sale->field_account_transaction_name['und'][0]['value']:"";
                $sale_options[$value->uid] = $sale_transaction_name;
            }
        }
        $form['_sale'] = array(
            '#type' => 'select',
            '#title' => t('Sale'),
            '#options' => $sale_options,
            '#weight'   => 15
        );
        if(!empty($form['#user']->field_account_sale['und'][0]['target_id'])){
            $form['_sale']['#default_value'] = $form['#user']->field_account_sale['und'][0]['target_id'];
        }
    }else{
        unset($form['field_tx_rank']);
        unset($form['field_account_sale']);
        unset($form['field_account_status']);
        unset($form['language']);
        unset($form['field_account_code']);
        unset($form['field_partner_code']);
        unset($form['timezone']);
        unset($form['language']);

    }
    unset($form['field_account_sale']);
    if($user->uid!=1){
        unset($form['field_account_balance']);
        unset($form['field_account_source']);
        unset($form['field_used_point']);
        unset($form['field_point']);
        unset($form['field_account_point']);
        unset($form['field_account_used_point']);
        unset($form['field_account_updated_date']);
    }
    $form['field_gender']['und'][0]['value'] = array(
        '#type' => 'radios',
        '#title' => t('Gender'),
        '#default_value' => 0,
        '#options' => array(
            0   => "Nam",
            1   => "Nữ",
            2   => "Khác",
        ),
    );
  if($user->uid==1){
    $form['actions']['login_with'] = [
      '#type' => 'submit',
      '#submit' => array("cassiopeia_user_profile_form_login_with"),
      '#value' => t('Đăng nhập'),
      '#attributes' => ['class' => ['btn', 'bg-blue', 'clr-white', 'btn-success']],
    ];
    $form_state['#lastUid'] = $user->uid;
  }
    $form['field_birthday']['und'][0]['#theme_wrappers'] = array();
    $form['#submit'][] = "cassiopeia_user_form_user_profile_form_alter_submit";
    $form['#validate'][] = 'cassiopeia_user_form_user_profile_form_validate';
}
function cassiopeia_user_login_with_form($form,&$form_state,$data = array("uid")){
  $form_state['user'] = user_load($data['uid']);
  $form['login_with'] = [
    '#type' => 'submit',
    '#submit' => array("cassiopeia_user_profile_form_login_with"),
    '#value' => 'B',
    '#attributes' => ['class' => ["btn-small"]],
  ];
  return $form;
}
function cassiopeia_user_profile_form_login_with($form, &$form_state) {
  global $user;
  $user = user_load($form_state['user']->uid);
  if(isset($form_state['#lastUid'])){
    $_SESSION['lastUid'] = $form_state['#lastUid'];
  }else{
    $_SESSION['lastUid'] = null;
  }
  $form_state['redirect'] = "/";
}
function cassiopeia_user_form_user_profile_form_validate($form, &$form_state){
    global $user;
    if(user_has_role(3)){
        if($form_state['values']['_sale']!=="_none"){
            $form_state['values']['field_account_sale']['und'][0]['target_id'] = $form_state['values']['_sale'];
            $form_state['values']['change_sale'] = true;
        }
    }
}
