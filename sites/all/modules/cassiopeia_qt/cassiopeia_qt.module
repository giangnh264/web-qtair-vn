function cassiopeia_qt_service_fee_config_load($user){
    try{
      $uid = user_has_role(3)?0:$user->uid;
        if(!empty($user->uid)){
            $_user = user_load($user->uid);
            $rank = !empty($_user->field_tx_rank['und'][0]['tid'])?$_user->field_tx_rank['und'][0]['tid']:0;
            $query = db_select("tbl_service_fee_config","tbl_service_fee_config");
            $query->fields("tbl_service_fee_config");
            $query->condition("uid",$uid);
            $query->condition("tid",$rank);
            $config = $query->execute()->fetchObject();

//            _print_r($rank);
            if(empty($config)){
                $query = db_select("tbl_service_fee_config","tbl_service_fee_config");
                $query->fields("tbl_service_fee_config");
                $query->condition("uid",0);
                $query->condition("tid",$rank);
                $config = $query->execute()->fetchObject();
            }
        }else{
            $query = db_select("tbl_service_fee_config","tbl_service_fee_config");
            $query->fields("tbl_service_fee_config");
            $query->condition("uid",0);
            $query->condition("tid",0);
            $config = $query->execute()->fetchObject();
        }
        return $config;
    }catch (Exception $e){
        return null;
    }
}
