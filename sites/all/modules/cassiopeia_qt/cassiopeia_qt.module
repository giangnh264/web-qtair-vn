function cassiopeia_qt_ticket_load_by_bid($bid){
    $return = null;
    try{
        $query = db_select("tbl_ticket","tbl_ticket");
        $query -> fields("tbl_ticket");
        $query -> condition("bid",$bid,"=");
        $query->orderBy("leg","ASC");
        $tickets = $query->execute()->fetchAll();
        $return = $tickets;
    }catch (Exception $e){
        _print_r($e);
    }
    return $return;
}
