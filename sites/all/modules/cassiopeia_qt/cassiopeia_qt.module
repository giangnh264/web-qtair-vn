            ),
        ));
        if($user->uid==1){
//          echo $postdata;
//          die;
        }
        $response = curl_exec($curl);
//        echo 111;
        return (json_decode($response));
//    }
}
function cassiopeia_qt_meta_CancelBooking($data){
    $url = MetaURL . "CancelBooking";
    $dataPost = array(
        "Username"  => MetaUsername,
        "Password"  => MetaPassword,
        "Data"      => $data
    );
    $postdata = json_encode($dataPost);
    $curl = curl_init();

    curl_setopt_array($curl, array(
        CURLOPT_URL => $url,
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_ENCODING => '',
        CURLOPT_MAXREDIRS => 10,
        CURLOPT_TIMEOUT => 0,
        CURLOPT_FOLLOWLOCATION => true,
        CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
        CURLOPT_CUSTOMREQUEST => 'POST',
        CURLOPT_POSTFIELDS => $postdata,
        CURLOPT_HTTPHEADER => array(
            'Content-Type: application/json'
        ),
    ));

    $response = curl_exec($curl);
    return (json_decode($response));
}
function cassiopeia_qt_meta_AddSegment($data){
    $url = MetaURL . "AddSegment";
    $dataPost = array(
        "Username"  => MetaUsername,
        "Password"  => MetaPassword,
        "Data"      => $data
    );
    $postdata = json_encode($dataPost);
    $curl = curl_init();

    curl_setopt_array($curl, array(
        CURLOPT_URL => $url,
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_ENCODING => '',
        CURLOPT_MAXREDIRS => 10,
        CURLOPT_TIMEOUT => 0,
        CURLOPT_FOLLOWLOCATION => true,
        CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
        CURLOPT_CUSTOMREQUEST => 'POST',
        CURLOPT_POSTFIELDS => $postdata,
        CURLOPT_HTTPHEADER => array(
            'Content-Type: application/json'
        ),
    ));

    $response = curl_exec($curl);
    return (json_decode($response));
}
function cassiopeia_qt_theme($existing, $type, $theme, $path)
{
    $themes = array(
        'cassiopeia_qt_search_flight_form' => array(
            'render element' => 'form',
            'template' => 'cassiopeia_qt_search_flight_form',
            'path' => drupal_get_path('module', 'cassiopeia_qt') . '/templates/forms'
        ),
        'cassiopeia_qt_edit_booking_vn_form' => array(
            'render element' => 'form',
            'template' => 'cassiopeia_qt_edit_booking_vn_form',
            'path' => drupal_get_path('module', 'cassiopeia_qt') . '/templates/forms'
        ),
    );
    return $themes;
}
function cassiopeia_qt_search_flight_form($form,&$form_state,$PNR){
    $form = array();
    $form['#PNR'] = $PNR;
    $form['#attributes']['class'][] = "cassiopeia-qt-search-flight-form";
    $form['#attributes']['class'][] = "custom-filter-form";
    $form_wrapper = "custom-filter-form-wrapper";
    $form['#prefix'] = "<div id='".$form_wrapper."'>";
    $form['#suffix'] = "</div>";
    $search_airports = array();
    $search_airports['HAN'] = "Hà Nội (HAN)";
    $search_airports['HPH'] = "Hải Phòng (HPH)";
    $search_airports['DIN'] = "Điện Biên (DIN)";
    $search_airports['VDO'] = "Vân Đồn (VDO)";
    $search_airports['SGN'] = "Hồ Chí Minh (SGN)";
    $search_airports['PQC'] = "Phú Quốc (PQC)";
    $search_airports['VCS'] = "Côn Đảo (VCS)";
    $search_airports['VCA'] = "Cần Thơ (VCA)";
    $search_airports['CAH'] = "Cà Mau (CAH)";
    $search_airports['VKG'] = "Rạch Giá (VKG)";
    $search_airports['DAD'] = "Đà Nẵng (DAD)";
    $search_airports['CXR'] = "Nha Trang (CXR)";
    $search_airports['DLI'] = "Đà Lạt (DLI)";
    $search_airports['VII'] = "Vinh (VII)";
    $search_airports['HUI'] = "Huế (HUI)";
    $search_airports['THD'] = "Thanh Hóa (THD)";
    $search_airports['BMV'] = "Buôn Ma Thuột (BMV)";
    $search_airports['PXU'] = "Pleiku (PXU)";
    $search_airports['UIH'] = "Quy Nhơn (UIH)";
    $search_airports['VDH'] = "Đồng Hới (VDH)";
    $search_airports['TBB'] = "Tuy Hòa (TBB)";
    $search_airports['VCL'] = "Chu Lai (VCL)";
    $form['start_point'] = array(
        '#type' => 'select',
        '#title' => t('Điểm đi'),
        '#options' => $search_airports,
        '#attributes'   => array("class"=>array("select-2")),
        '#required' => TRUE
    );
    $form['end_point'] = array(
        '#type' => 'select',
        '#title' => t('Điểm đến'),
        '#options' => $search_airports,
        '#attributes'   => array("class"=>array("select-2")),
        '#required' => TRUE
    );
    $form['start_date'] = array(
        '#type' => 'date_popup',
        '#date_type' => DATE_DATETIME,
        '#date_timezone' => date_default_timezone(),
        '#date_format' => 'd/m/Y',
        '#date_increment' => 1,
        '#date_year_range' => '-3:+3',
        '#required' => FALSE,
        '#attributes' => array("class" => array("start_date")),
        '#default_value' => !empty($value) ? date("Y-m-d H:i:s", $value->from_date) : date("Y-m-d H:i:s", REQUEST_TIME),
    );
    $form['submit'] = array(
        '#type'         => 'submit',
        '#value'        => t('Tìm kiếm'),
        '#attributes'   => array('class'=>array('btn-primary btn-search-flight color-white')),
        '#ajax' => array(
            'callback' => 'cassiopeia_qt_search_flight_form_ajax_submit',
            'wrapper' => $form_wrapper,
        ),
        '#submit' => array('cassiopeia_qt_search_flight_form_submit'),
    );
    $form['#attached']['js'] = array(
        drupal_get_path('module', 'cassiopeia_qt') . '/js/cassiopeia_qt_search_flight_form.js'
    );
    if(!empty($form_state['#search_result'])){
        $DataSession = $form_state['#search_result']->Data->DataSession;
        $form['#search_result'] = $form_state['#search_result'];
        $form['#DataSession'] = $form_state['#DataSession'] = $DataSession;
        $Flights = $form_state['#search_result']->Data->DepartureFlights;
        foreach($Flights as $FlightSession => $Flight){
            $key = $DataSession."-".$FlightSession;
            $form['Flight'][$key] = array(
                '#type' => 'container',
                '#tree' =>true
            );
            $options = array();
            $index=1;
            $default_value = 0;
            foreach($Flight->FareOptions as $FareOption){
                if($index==1){
                    $default_value = $FareOption->FareOptionSession;
                }
                $Price = $FareOption->PriceAdult+$FareOption->FeeAdult+$FareOption->TaxAdult;
                $options[$FareOption->FareOptionSession] = "<div><span class='airline-class'>".$FareOption->Class."</span><span class='price'>".number_format($Price,0,",",".")."</span></div>";
                $index++;
            }
            $form['Flight'][$key]['FareOption'] = array(
                '#type' => 'radios',
                '#title' => t(''),
                '#options' => $options,
                '#default_value'    => $default_value,
                '#ajax' => array(
                    'callback' => 'cassiopeia_qt_search_flight_form_ajax_submit',
                    'wrapper' => $form_wrapper,
                    'progress' => array('type' => 'fullscreen')
                ),
            );
            $form['#ChoseFlightSession'] = !empty($form_state['#ChoseFlightSession'])?$form_state['#ChoseFlightSession']:null;
            $form['#ChoseFareOptionSession'] = !empty($form_state['#ChoseFareOptionSession'])?$form_state['#ChoseFareOptionSession']:null;
            if(empty($form['#ChoseFlightSession'])){
                $form['Flight'][$key]['choose'] = array(
                    '#type'         => 'submit',
                    '#value'        => "chose_".$key,
                    '#attributes'   => array('class'=>array('btn-primary btn-choose-flight')),
                    '#ajax' => array(
                        'callback' => 'cassiopeia_qt_search_flight_form_ajax_choose',
                        'wrapper' => $form_wrapper,
                    ),
                    '#submit' => array('cassiopeia_qt_search_flight_form_choose'),
                );
            }else{
                if($form['#ChoseFlightSession']==$FlightSession){
                    $form['Flight'][$key]['un_choose'] = array(
                        '#type'         => 'submit',
                        '#value'        => "un_choose_".$key,
                        '#attributes'   => array('class'=>array('btn-primary btn-un-choose-flight')),
                        '#ajax' => array(
                            'callback' => 'cassiopeia_qt_search_flight_form_ajax_un_choose',
                            'wrapper' => $form_wrapper,
                        ),
                        '#submit' => array('cassiopeia_qt_search_flight_form_un_choose'),
                    );
                }
            }
        }
    }
    if(!empty($form['#ChoseFlightSession'])){
        $form['add_segment'] = array(
            '#type'         => 'submit',
            '#value'        => "Thêm hành trình",
            '#attributes'   => array('class'=>array('btn-primary btn-add-segment')),
            '#ajax' => array(
                'callback' => 'cassiopeia_qt_search_flight_form_ajax_add_segment',
                'wrapper' => $form_wrapper,
            ),
            '#submit' => array('cassiopeia_qt_search_flight_form_add_segment'),
        );
    }
    return $form;
}
function cassiopeia_qt_search_flight_form_ajax_add_segment($form,&$form_state){
    return $form;
}
function cassiopeia_qt_search_flight_form_ajax_un_choose($form,&$form_state){
    return $form;
}
function cassiopeia_qt_search_flight_form_ajax_choose($form,&$form_state){
    return $form;
}
function cassiopeia_qt_search_flight_form_ajax_submit($form,&$form_state){
    return $form;
}
function cassiopeia_qt_search_flight_form_choose($form,&$form_state){
    $key = $form_state['triggering_element']['#parents'][0];
    $splitter = explode("-",$key);
    $FlightSession = $splitter[1];
    $FareOption = $form_state['values'][$key];
    $form_state['#ChoseFlightSession'] = $FlightSession;
    $form_state['#ChoseFareOptionSession'] = $FareOption['FareOption'];
    $form_state['rebuild'] = TRUE;
}
function cassiopeia_qt_search_flight_form_un_choose($form,&$form_state){
    $form_state['#ChoseFlightSession'] = null;
    $form_state['#ChoseFareOptionSession'] = null;
    $form_state['rebuild'] = TRUE;
}
function cassiopeia_qt_search_flight_form_submit($form,&$form_state){
    $data = new stdClass();
    $data->ItineraryType = 1;
    $data->StartPoint = $form_state['values']['start_point'];
    $data->EndPoint = $form_state['values']['end_point'];
    $data->DepartureDate = date("d/m/Y",strtotime($form_state['values']['start_date']));
    $data->ReturnDate = "";
    $data->Adult = $_SESSION[strtoupper(trim($form_state['values']['code'])).'-count_adult'];
    $data->Children = $_SESSION[strtoupper(trim($form_state['values']['code'])).'-count_children'];
    $data->Infant = $_SESSION[strtoupper(trim($form_state['values']['code'])).'-count_infant'];
    $data->ClientVia = "Agent";
    $result = cassiopeia_meta_ExtDOMSearchFlights($data);
    $form_state['#search_result'] = $result;
    $form_state['#ChoseFlightSession'] = null;
    $form_state['#ChoseFareOptionSession'] = null;
    $form_state['rebuild'] = TRUE;
}
function cassiopeia_qt_search_flight_form_add_segment($form,&$form_state){
    $PNR = $form['#PNR'];
    $AirlineCode = "VN";
    $FlightSession = $form_state['#ChoseFareOptionSession'];
    $DataSession = $form_state['#DataSession'];
    $data = new stdClass();
    $data->PNRCode = $PNR;
    $data->AirlineCode = $AirlineCode;
    $data->FlightSession = $FlightSession;
    $data->DataSession = $DataSession;
    $result = cassiopeia_qt_meta_AddSegment($data);
    if($result->Code==0){
        drupal_set_message("Thêm hành trình thành công!");
    }else{
        drupal_set_message("Thêm hành trình thất bại, vui lòng hiên hệ bộ phận Booker để được hỗ trợ!","error");
    }
    $form_state['#search_result'] = null;
    $form_state['rebuild'] = TRUE;
}
function cassiopeia_qt_edit_booking_vn_form($form, &$form_state){
    $form = array();
    $form['#attributes']['class'][] = "cassiopeia-edit-booking-vn-form";
