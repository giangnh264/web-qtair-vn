									))->execute();
									db_insert("tbl_report")->fields(array(
										"created"           => REQUEST_TIME,
										"tran_code"         => REQUEST_TIME,
										"type"         => "payment",
									))->execute();
									db_insert("tbl_log")->fields(array(
										"created"   => REQUEST_TIME,
										"uid"   => $agent->uid,
										"value"   => "Thêm báo cáo",
										"booking_code"   => REQUEST_TIME,
									))->execute();
								}catch (Exception $e){

								}
//                $top_up = new stdClass();
//                $top_up->payment = 1;
//                $top_up->bank = 2684;
//                $top_up->amount = $_record->amount;
//                $top_up->status = 1;
//                $top_up->uid = $agent->uid;
//                $top_up->tran_user = 1;
//                $top_up->note = "Chuyền khoản nhanh";
//                cassiopeia_qt_top_up_request_save($top_up);
                $response_record->custName = vn_to_str($agent->field_account_full_name['und'][0]['value']);
                $response_record->status->code = "00";
                $response_record->status->message = "Receive Notify Transaction Successful";
            }else{
                $response_record->custName = "";
                $response_record->status->code = "00";
                $response_record->status->message = "Receive Notify Transaction Successful";
            }
            $response_record->custAcct = "";
            $response_record->amount = "";
            $response_record->currencyCode = "VND";
            $response_record->idCard = "";
            $response_record->idCardType = "";

            $response_record->addInfo = "";
            $response_record->preseve1 = "";
            $response_record->preseve2 = "";
            $response_record->preseve3 = "";
            $_response->data->records[] = $response_record;
        }
    }
    if($signature!==VIETINBANK_SIGNATURE){
//           $response->data->errors->errorCode = "02";
//           $response->data->errors->errorDesc = "Signature is incorrect";
    }

    $_response->header = new stdClass();
    $_response->header->msgId = "";
    $_response->header->msgType = "1210";
    $_response->header->providerId = "9081";
    $_response->header->timestamp = date("mdYHis",REQUEST_TIME);
    $_response->header->recordNum = "".count($_response->data->records)."";
    $_response->header->signature = "";


    $response = new stdClass();
    $response->header = $_response->header;
    $response->data = $_response->data;
    drupal_add_http_header('Content-Type', 'application/json');
    echo str_replace('[^\\n\\r\\t\\p{Print}]"',"",json_encode($response));
}
function get_client_ip() {
    $ipaddress = '';
    if (getenv('HTTP_CLIENT_IP'))
        $ipaddress = getenv('HTTP_CLIENT_IP');
    else if(getenv('HTTP_X_FORWARDED_FOR'))
        $ipaddress = getenv('HTTP_X_FORWARDED_FOR');
    else if(getenv('HTTP_X_FORWARDED'))
        $ipaddress = getenv('HTTP_X_FORWARDED');
    else if(getenv('HTTP_FORWARDED_FOR'))
        $ipaddress = getenv('HTTP_FORWARDED_FOR');
    else if(getenv('HTTP_FORWARDED'))
        $ipaddress = getenv('HTTP_FORWARDED');
    else if(getenv('REMOTE_ADDR'))
        $ipaddress = getenv('REMOTE_ADDR');
    else
        $ipaddress = 'UNKNOWN';
    return $ipaddress;
}
function cassiopeia_qt_ticket_booking_save($booking){
    $return = null;
    $db_transaction = db_transaction();
    try{
        if(!empty($booking->id)){
            $booking_saved = drupal_write_record("tbl_booking",$booking,array("id"));
        }else{
            $booking_saved = drupal_write_record("tbl_booking",$booking);
        }
        if(!empty($booking->passengers)){
            foreach($booking->passengers as $passenger){
                if(!empty($passenger->id)){
                    drupal_write_record("tbl_passenger",$ticket,array("id"));
                }else{
                    $passenger->bid = $booking->id;
                    drupal_write_record("tbl_passenger",$passenger);
                }
            }
        }
        if(!empty($booking->tickets)){
            foreach($booking->tickets as $ticket){
                if(!empty($ticket->id)){
                    drupal_write_record("tbl_ticket",$ticket,array("id"));
                }else{
                    $ticket->bid = $booking->id;
                    drupal_write_record("tbl_ticket",$ticket);
                }
            }
        }
    }catch (Exception $E){
        print_r($E);
        die;
        $db_transaction->rollback();
    }
    return $return;
}
function cassiopeia_qt_ticket_booking_load_by_transactionCode($code){
    $return = null;
    try{
        if(!empty($code)){
            $query = db_select("tbl_booking","tbl_booking");
            $query -> fields("tbl_booking");
            $query -> condition("transactionCode",trim($code),"=");
            $booking = $query->execute()->fetchObject();
            if(!empty($booking)){
                $tickets = cassiopeia_qt_ticket_load_by_bid($booking->id);
                $booking->tickets = $tickets;
                $passengers = cassiopeia_qt_passenger_load_by_bid($booking->id);
                $booking->passengers = $passengers;
            }

            $return = $booking;
        }
    }catch (Exception $e){
        _print_r($e);
    }
    return $return;
}
