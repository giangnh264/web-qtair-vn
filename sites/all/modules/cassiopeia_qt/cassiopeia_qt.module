function cassiopeia_qt_airline_class_load($Airline,$class){
    $text = "";
    switch ($Airline){
        case "VN" :
            switch (strtoupper($class)){
                case "J" :
                case "C" :
                case "I" :
                    $text = "Thương gia";
                    break;
                default :
                    $text = "Phổ thông";
            }
            break;
        case "QH" :
            switch (strtoupper($class)){
                case "BUSINESS" :
                    $text = "Thương gia";
                    break;
                default :
                    $text = "Phổ thông";
            }
            break;
        case "VJ" :
            switch (strtoupper($class)){
                case "ECO" :
                case "DELUXE" :
                    $text = "Phổ thông";
                    break;
                default: $text = "Thương gia";
            }
            break;
        case "VU" :
            $text = "Phổ thông";
            break;
    }
    return $text;
}
function cassiopeia_qt_customer_load($id){
    try{
        $query = db_select("tbl_customer","tbl_customer");
        $query->fields("tbl_customer");
        $query->condition("id",$id);
        $customer = $query->execute()->fetchObject();
        return $customer;
    }catch (Exception $e){
        return null;
    }
}
function cassiopeia_qt_customer_save($customer){
    global $user;
    try{
        if(!empty($customer->id)){
            $customer->changed = REQUEST_TIME;
            drupal_write_record("tbl_customer",$customer,array("id"));
        }else{
            $customer->uid = $user->uid;
            $customer->created = REQUEST_TIME;
            $customer->changed = REQUEST_TIME;
            drupal_write_record("tbl_customer",$customer);
        }
    }catch (Exception $e){
        return null;
    }
}
function cassiopeia_qt_node_counter($node){
    try{
        $query = db_select("node_counter","node_counter");
        $query->fields("node_counter");
        $query->condition("nid",$node->nid);
        $result = $query->execute()->fetchObject();
        return $result;
    }catch (Exception $e){
        return 0;
    }
}
function cassiopeia_qt_partner_change_status_accept(){
    if(user_has_role(3)||user_has_role(ROLE_SALE)){
        return true;
    }
    return false;
}

