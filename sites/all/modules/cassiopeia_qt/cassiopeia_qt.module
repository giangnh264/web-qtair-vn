        _print_r($e);
    }
    return $return;
}
function cassiopeia_qt_ticket_booking_load_by_PNR($pnr_code){
    $return = null;
    try{
        $ticket_query = db_select("tbl_ticket","tbl_ticket");
        $ticket_query->fields("tbl_ticket",array("bid"));
        $ticket_query->condition("tbl_ticket.pnr_code",$pnr_code);

        $query = db_select("tbl_booking","tbl_booking");
        $query -> fields("tbl_booking");
        $query->join($ticket_query,"tbl_ticket","tbl_ticket.bid=tbl_booking.id");

        $booking = $query->execute()->fetchObject();
        if(!empty($booking)){
            $tickets = cassiopeia_qt_ticket_load_by_PNR($pnr_code);
            $booking->tickets = $tickets;
            $passengers = cassiopeia_qt_passenger_load_by_bid($booking->id);
            $booking->passengers = $passengers;
        }

        $return = $booking;
    }catch (Exception $e){
        _print_r($e);
    }
    return $return;
}
