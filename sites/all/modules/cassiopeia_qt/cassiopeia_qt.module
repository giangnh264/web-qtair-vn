function cassiopeia_qt_menu()
{
    $items = array();
    $items['vietinbank/inqCustom'] = array(
        'type' => MENU_CALLBACK,
        'page callback' => 'cassiopeia_qt_inqCustom_callback',
        'title' => t('Vấn tin Vietinbank'),
//        'delivery callback' => 'drupal_json_output',
        'access arguments' => array('access content'),
    );
    $items['vietinbank/notifytrans'] = array(
        'type' => MENU_CALLBACK,
        'page callback' => 'cassiopeia_qt_notifytrans_callback',
        'title' => t('Vấn tin Vietinbank'),
//        'delivery callback' => 'drupal_json_output',
        'access arguments' => array('access content'),
    );

    return $items;
}
function cassiopeia_qt_inqCustom_callback(){
    try{
        $signature = $_SERVER['HTTP_SIGNATURE'];
        $_response = new stdClass();
        $_response->data = new stdClass();
        $_response->data->errors = new stdClass();
        $_response->data->errors->errorCode = "00";
        $_response->data->errors->errorDesc = "Successful";
        $json = file_get_contents('php://input');

        $request = json_decode($json);
        $data = $request->data;
        $records = $data->records;
        if(!empty($records)){
            foreach($records as $record){
                $_record = new stdClass();
                $_record->transId = $record->transId;
                $_record->custCode = $record->custCode;
                $_record->transTime = $record->transTime;
                $_record->channelId = $record->channelId;
                $_record->data = serialize($records);
                $_record->data_s = serialize($_SERVER);
                $_record->errorCode = "";
                $_record->errorDesc = "";
                $_record->type = 1;
                $_record->created = REQUEST_TIME;
                $_record->changed = REQUEST_TIME;
                $saved_record = drupal_write_record("cassiopeia_qt_vietinbank_inqCustom",$_record);
                $agent_code = str_replace(VIETINBANK_PRE,"",$record->custCode);
                $agent = cassiopeia_user_user_load_by_code($agent_code);

                $response_record = new stdClass();
                $response_record->transId = "";
                $response_record->transTime = "".REQUEST_TIME."";
                $response_record->serviceType = "";
                $response_record->custCode = $record->custCode;
                $response_record->status = new stdClass();
                if(!empty($agent)){
                    $response_record->custName = vn_to_str($agent->field_account_full_name['und'][0]['value']);
                    $response_record->status->code = "00";
                    $response_record->status->message = "Van tin thong tin khach hang thanh cong";
                }else{
                    $response_record->custName = "";
                    $response_record->status->code = "00";
                    $response_record->status->message = "Van tin thong tin khach hang thanh cong";
                }
                $response_record->custAcct = "";
                $response_record->amount = "";
                $response_record->currencyCode = "VND";
                $response_record->idCard = "";
                $response_record->idCardType = "";

                $response_record->addInfo = "";
                $response_record->preseve1 = "";
                $response_record->preseve2 = "";
                $response_record->preseve3 = "";
                $_response->data->records[] = $response_record;
            }
        }
        if($signature!==VIETINBANK_SIGNATURE){
//           $response->data->errors->errorCode = "02";
//           $response->data->errors->errorDesc = "Signature is incorrect";
        }

        $_response->header = new stdClass();
        $_response->header->msgId = "";
        $_response->header->msgType = "1310";
        $_response->header->providerId = "9081";
        $_response->header->timestamp = date("mdYHis",REQUEST_TIME);
        $_response->header->recordNum = "".count($_response->data->records)."";
        $_response->header->signature = "";




        $response = new stdClass();
        $response->header = $_response->header;
        $response->data = $_response->data;
    }catch (Exception $E){
        return $E;
    }
    drupal_add_http_header('Content-Type', 'application/json');
    echo str_replace('[^\\n\\r\\t\\p{Print}]"',"",json_encode($response));
}
function cassiopeia_qt_notifytrans_callback(){
    $signature = $_SERVER['HTTP_SIGNATURE'];
    $_response = new stdClass();
    $_response->data = new stdClass();
    $_response->data->errors = new stdClass();
    $_response->data->errors->errorCode = "00";
    $_response->data->errors->errorDesc = "Successful";
    $json = file_get_contents('php://input');

    $request = json_decode($json);
