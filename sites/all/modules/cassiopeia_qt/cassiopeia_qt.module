    return $form;
}
function cassiopeia_qt_edit_booking_vn_cancel_booking_ajax_callback($form,&$form_state){
    return $form;
}
function cassiopeia_qt_edit_booking_vn_form_ajax_callback($form,&$form_state){
    return $form;
}
function cassiopeia_qt_edit_booking_vn_cancel_booking_submit($form,&$form_state){
    $data = array();
    $data['AirlineCode'] = "VN";
    $data['PNRCode'] = $form['#PNR'];
    $result = cassiopeia_qt_meta_CancelBooking($data);
    if($result->code==0){
        drupal_set_message("Hủy hành trình thành công!");
    }
}
function cassiopeia_qt_edit_booking_vn_send_mail_validation($form,&$form_state){
    if(empty($form_state['values']['mail'])){
        form_set_error('mail', t('Bạn chưa nhập email!'));
    }
}
function cassiopeia_qt_edit_booking_vn_send_mail_submit($form,&$form_state){
    $sendMailData = new stdClass();
    $sendMailData->PNRCode = $form['#PNR'];
    $sendMailData->AirlineCode = "VN";
    $sendMailData->Language = "VN";
    $sendMailData->Emails = $form_state['values']['mail'];
    cassiopeia_qt_meta_SendMail($sendMailData);
    drupal_set_message("Gửi mail thành công");
}
function cassiopeia_qt_edit_booking_vn_form_submit($form,&$form_state){
    $_data = new stdClass();
    $_data->PNRCode = strtoupper(trim($form_state['values']['code']));
    $_data->AirlineCode = "VN";
    $result = cassiopeia_meta_api_open_pnr($_data);
    $str = str_replace("\n","<br>",$result->Data->PNRContent);
    $array1 = explode(strtoupper($_data->PNRCode),$str);
    if(!empty($array1[1])){
        $array2 = explode("1 VN",$array1[1]);
        $array4 = explode("TKT/TIME LIMIT",$array2[1]);
        $count_leg = (substr_count($array4[0],"VN"))+1;
        $VN_splitter = explode("VN",$array4[0]);
        $Itineraries = array();
        $month_array = array(
            "JAN"   => "/01",
            "FEB"   => "/02",
            "MAR"   => "/03",
            "APR"   => "/04",
            "MAY"   => "/05",
            "JUN"   => "/06",
            "JUL"   => "/07",
            "AUG"   => "/08",
            "SEP"   => "/09",
            "OCT"   => "/10",
            "NOV"   => "/11",
            "DEC"   => "/12",
        );
        foreach($VN_splitter as $item){
            $item = trim($item);
            $Itinerary = explode(" ",$item);
            $Class = mb_substr($Itinerary[0], -1);
            $FlightNumber = str_replace($Class,"",$Itinerary[0]);
            $Date = $Itinerary[1];
            foreach($month_array as $key => $value){
                $Date = str_replace($key,$value,$Date);
            }
            $Itineraries[] = array(
                "FLightNumber"  => $FlightNumber,
                "Class"  => $Class,
                "Date"  => $Date,
                "Itinerary"  => $Itinerary[3],
            );
        }
        $form_state['#Itineraries'] = $Itineraries;
        $newstr = $array2[0];
        $words = preg_replace('/\d+/u', '', $newstr);
        $array3 = explode(".I",$words);
        $count_infant = count($array3)-1;
        $str_adult = $array3[0];
        $count_guest = (substr_count($str_adult,"."));
        $count_children = (substr_count($str_adult,"MSTR"));
        $count_adult = $count_guest-$count_children;
        $_SESSION[strtoupper(trim($_data->PNRCode)).'-count_leg'] = $count_leg;
        $_SESSION[strtoupper(trim($_data->PNRCode)).'-count_adult'] = $count_adult;
        $_SESSION[strtoupper(trim($_data->PNRCode)).'-count_children'] = $count_children;
        $_SESSION[strtoupper(trim($_data->PNRCode)).'-count_infant'] = $count_infant;
        $_SESSION[strtoupper(trim($_data->PNRCode)).'-Airline'] = $_REQUEST['data']['airline'];
        $_SESSION[strtoupper(trim($_data->PNRCode)).'-PNR'] = $_REQUEST['data']['code'];
    }
    $form_state['#open-pnr-result'] = $result;
    $form_state['#search_result'] = null;
    $form_state['#ChoseFlightSession'] = null;
    $form_state['#ChoseFareOptionSession'] = null;
    $form_state['rebuild'] = TRUE;
}
function cassiopeia_qt_preprocess_radio (&$variables) {
    $element = &$variables['element'];
    $element['#prefix'] = "<div class=''>";
    $element['#suffix'] = "</div>";

    if($element['#return_value']==$element['#value']){
        $element['#attributes']['class'][] = "";
    }
//    _print_r($element);
//    if ((isset($element['#name'])) && substr($element['#name'],0,18) == 'mymodule_imglayout') {
//        $variables['theme_hook_suggestion'] = 'radio__imglayout';
//    }
}
function cassiopeia_qt_price_fix($price){
    return round($price/1000)*1000;
}
function cassiopeia_qt_payment_report_save($report){
    try{
        $id = db_insert("tbl_payment_report")->fields(array(
            "created"       => $report->created,
            "date"          => $report->date,
            "tran_code"     => $report->created,
            "amount"        => $report->amount,
            "content"       => $report->content,
            "agent"         => $report->agent,
            "tran_kind"     => $report->tran_kind,
            "tran_user"     => $report->uid,
            "balance"       => $report->balance,
            "status"        => 0, // chưa sử dụng
            "category"      => "payment",
        ))->execute();
        db_insert("tbl_report")->fields(array(
            "created"       => $report->created,
            "tran_code"     => $report->created,
            "type"          => "payment",
        ))->execute();
        db_insert("tbl_log")->fields(array(
            "created"       => $report->created,
            "uid"           => $report->uid,
            "value"         => "Thêm báo cáo",
            "booking_code"  => $report->created,
        ))->execute();
    }catch (Exception $e){

    }
}
function cassiopeia_qt_top_up_request_load($id){
    try{
        $query = db_select("tbl_top_up_request","tbl_top_up_request");
        $query->fields("tbl_top_up_request");
        $query->condition("id",$id);
        $result = $query->execute()->fetchObject();
        if(!empty($result)){
            $bank = node_load($result->bank);
            $result->bank = $bank;
        }
        return $result;
    }catch (Exception $e){
        return null;
    }
}
function cassiopeia_qt_top_up_request_save($top_up){
    try{
        if(!empty($top_up->id)){
            drupal_write_record("tbl_top_up_request",$top_up,array("id"));
        }else{
            $query = db_select("tbl_top_up_request","tbl_top_up_request");
            $query->fields("tbl_top_up_request");
            $query->range(0,1);
            $query->orderBy("created","DESC");
            $last = $query->execute()->fetchObject();
            if(!empty($last)){
                $code_number = str_replace("T","",$last->code);
                $code_number++;
            }else{
                $code_number = "100000";
            }
            $code = "T".$code_number;
            $top_up->code = $code;
            $top_up->created = REQUEST_TIME;
            drupal_write_record("tbl_top_up_request",$top_up);
        }
        return $top_up;
    }catch (Exception $e){
        return null;
    }
}
function cassiopeia_qt_alepay_transaction_save($transaction){
    try{
        if(!empty($transaction->id)){
            $transaction->changed = REQUEST_TIME;
            drupal_write_record("cassiopeia_qt_alepay_transaction",$transaction,array("id"));
        }else{
            $transaction->created = REQUEST_TIME;
            $transaction->changed = REQUEST_TIME;
            drupal_write_record("cassiopeia_qt_alepay_transaction",$transaction);
        }
    }catch (Exception $e){

    }
}
function cassiopeia_qt_alepay_transaction_load($transactionCode){
    try{
        $query = db_select("cassiopeia_qt_alepay_transaction","cassiopeia_qt_alepay_transaction");
        $query->fields("cassiopeia_qt_alepay_transaction");
        $query->condition("cassiopeia_qt_alepay_transaction.transactionCode",trim($transactionCode));
        $result = $query->execute()->fetchObject();
        return $result;
    }catch (Exception $e){
        return null;
    }
}
