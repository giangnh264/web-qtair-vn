# Ignore configuration files that may contain sensitive information.
sites/*/settings*.php

# Ignore paths that contain user-generated content.
sites/*/files
sites/*/private

# Local environment and sensitive key material.
.env
.env.*
*.key
*.p12
*.cer
encrypted.txt
cacert.pem

# Runtime log artifacts.
*.log

# Local planning documents.
docs/ANTIGRAVITY.md
docs/Task_List.md
docs/*

# Local PHP test scripts.
*_test.php
AGENTS.md